---
import PolityChapter from '../../layouts/PolityChapter.astro';
import ChapterEnd from '../../components/geo/ChapterEnd.astro';
import Quiz from '../../components/Quiz.astro';
import questions from '../../data/quizzes/polity-legislative-assembly.json';
import { OFFICE, VERIFIED_ON } from '../../data/polity';

// Structural facts reuse the verified DASH/TIMELINE/TRAPS data in src/data/polity.ts; office-holders come from OFFICE.
const who = (post: string) => OFFICE.find((o) => o.post === post);
const speaker = who('विधानसभा अध्यक्ष');
const lop = who('नेता प्रतिपक्ष');
const fmt = (d: string) => new Date(d).toLocaleDateString('hi-IN', { day: 'numeric', month: 'long', year: 'numeric' });

const toc = [
  { id: 'shuruaat', label: 'विधानसभा क्या करती है' },
  { id: 'banawat', label: 'बनावट: 70 सीटें, एक सदन' },
  { id: 'safar', label: 'पाँच विधानसभाएँ और मुख्यमंत्री' },
  { id: 'adhyaksh', label: 'अध्यक्ष और उपाध्यक्ष' },
  { id: 'kaam', label: 'विधानसभा के पाँच काम' },
  { id: 'kanoon', label: 'कानून कैसे बनता है' },
  { id: 'dalbadal', label: 'दल-बदल कानून' },
  { id: 'gairsain', label: 'देहरादून और गैरसैंण' },
  { id: 'jaal', label: 'उलझाने वाले प्रश्न' },
  { id: 'seekha', label: 'सार और याद रखें' },
  { id: 'quiz', label: 'क्विज़ (12 प्रश्न)' },
  { id: 'faq', label: 'सवाल-जवाब' },
];

const facts = [
  { k: 'सदन', v: '<b>एक सदन</b> (विधानसभा); विधान परिषद नहीं' },
  { k: 'सीटें', v: '<b>70</b>: 13 अनुसूचित जाति, 2 अनुसूचित जनजाति (चकराता, नानकमत्ता)' },
  { k: 'कार्यकाल', v: '<b>5 साल</b> (अनुच्छेद 172)' },
  { k: 'अध्यक्ष', v: `<b>${speaker?.name ?? ''}</b> (${speaker?.since ?? ''})` },
  { k: 'नेता प्रतिपक्ष', v: `<b>${lop?.name ?? ''}</b>` },
  { k: 'भवन', v: '<b>देहरादून</b> और <b>भराड़ीसैंण (गैरसैंण)</b>, जो 8 जून 2020 से ग्रीष्मकालीन राजधानी है' },
];

const faq = [
  { q: 'उत्तराखंड विधानसभा में कितनी सीटें हैं?', a: '70 सीटें। इनमें 13 अनुसूचित जाति और 2 अनुसूचित जनजाति (चकराता और नानकमत्ता) के लिए आरक्षित हैं। 2002 से 2020 तक एक एंग्लो-इंडियन सदस्य भी मनोनीत होता था, जो 104वें संशोधन के बाद ख़त्म हो गया।' },
  { q: 'उत्तराखंड की पहली महिला विधानसभा अध्यक्ष कौन हैं?', a: 'ऋतु खंडूड़ी भूषण, जो कोटद्वार से विधायक हैं। वे 26 मार्च 2022 को अध्यक्ष चुनी गईं।' },
  { q: 'उत्तराखंड में विधान परिषद क्यों नहीं है?', a: 'राज्य बनाने वाले कानून में एक सदन वाली विधानसभा ही बनाई गई। विधान परिषद बनाने के लिए अनुच्छेद 169 के तहत विधानसभा का विशेष बहुमत से प्रस्ताव और फिर संसद का कानून चाहिए, जो अब तक नहीं हुआ।' },
  { q: 'उत्तराखंड में ज़्यादा से ज़्यादा कितने मंत्री हो सकते हैं?', a: 'मुख्यमंत्री समेत 12। संविधान कहता है कि मंत्री विधानसभा के 15% से ज़्यादा नहीं होंगे, पर 12 से कम भी नहीं। 70 का 15% सिर्फ़ 10.5 होता है, इसलिए 12 की न्यूनतम सीमा ही ऊपरी सीमा बन जाती है।' },
  { q: 'गैरसैंण उत्तराखंड की राजधानी है?', a: 'भराड़ीसैंण (गैरसैंण) को 8 जून 2020 को ग्रीष्मकालीन राजधानी घोषित किया गया। वहाँ विधानसभा भवन है और कुछ सत्र होते हैं। देहरादून अस्थायी राजधानी है, जहाँ ज़्यादातर काम होता है।' },
];

const sources = [
  { label: 'उत्तराखंड विधानसभा: आधिकारिक वेबसाइट (अध्यक्ष, सदस्य, परिचय)', url: 'https://ukvidhansabha.uk.gov.in/' },
  { label: 'भारत का संविधान: अनुच्छेद 164(1A), 168–212, 213, 200, 201, दसवीं अनुसूची (विधायी विभाग)', url: 'https://legislative.gov.in/constitution-of-india/' },
  { label: 'India Code: उत्तर प्रदेश पुनर्गठन अधिनियम, 2000 (अधिनियम सं. 29), धारा 13–14 (विधानसभा, अस्थायी सदन)', url: 'https://www.indiacode.nic.in/handle/123456789/1983' },
  { label: 'मुख्य निर्वाचन अधिकारी, उत्तराखंड: विधानसभा क्षेत्र और आरक्षित सीटें', url: 'https://ceo.uk.gov.in/' },
  { label: 'Aaj Tak (26 मार्च 2022): ऋतु खंडूड़ी राज्य की पहली महिला विधानसभा अध्यक्ष', url: 'https://www.aajtak.in/india/uttarakhand/story/ritu-khanduri-becomes-first-woman-speaker-of-uttarakhand-assembly-ntc-1435305-2022-03-26' },
  { label: 'Drishti IAS (मार्च 2022): बंशीधर भगत पाँचवीं विधानसभा के प्रोटेम स्पीकर', url: 'https://drishtiias.com/hindi/pdf/1722817170.pdf' },
  { label: 'पहाड़ परीक्षा: उत्तराखंड राजव्यवस्था हब (सत्यापित तथ्य, समयरेखा, उलझाने वाले प्रश्न)', url: '/polity/' },
];

const speakers = [
  ['प्रकाश पंत', 'अंतरिम विधानसभा (2000–02)', 'राज्य के पहले विधानसभा अध्यक्ष'],
  ['यशपाल आर्य', 'पहली विधानसभा (2002–07)', 'पहली निर्वाचित विधानसभा के अध्यक्ष'],
  ['हरबंस कपूर', 'दूसरी विधानसभा (2007–12)', ''],
  ['गोविंद सिंह कुंजवाल', 'तीसरी विधानसभा (2012–17)', '2016 में 9 बागी विधायकों को अयोग्य ठहराया'],
  ['प्रेमचंद अग्रवाल', 'चौथी विधानसभा (2017–22)', ''],
  ['ऋतु खंडूड़ी भूषण', 'पाँचवीं विधानसभा (2022 से)', 'पहली महिला अध्यक्ष'],
];
---
<PolityChapter
  name="उत्तराखंड विधानसभा" nameEn="Uttarakhand Legislative Assembly: structure, officers, powers and functions" slug="legislative-assembly"
  sub="70 सीटों वाली एक सदन की विधानसभा कैसे बनी, कौन अध्यक्ष रहे, विधानसभा क्या-क्या करती है, कानून कैसे बनता है, और दल-बदल कानून। आसान भाषा में, उदाहरणों के साथ।"
  title="उत्तराखंड विधानसभा: 70 सीटें, अध्यक्ष, शक्तियाँ और कार्य, कानून निर्माण, दल-बदल | UKPSC Polity"
  description="उत्तराखंड विधानसभा आसान हिंदी में: 70 सीटें, 13 SC और 2 ST, अध्यक्षों की सूची, पाँच विधानसभाएँ और मुख्यमंत्री, शक्तियाँ और कार्य, कानून बनने के चरण, दल-बदल कानून, गैरसैंण। 12 प्रश्नों की क्विज़।"
  published="2026-11-21"
  toc={toc} facts={facts} faq={faq} sources={sources}
>
  <section id="shuruaat">
    <h2>विधानसभा क्या करती है</h2>
    <p>विधानसभा राज्य की <b>कानून बनाने वाली संस्था</b> है। इसके सदस्य (विधायक, MLA) जनता सीधे चुनती है। जिस दल या गठबंधन के पास विधानसभा में बहुमत होता है, उसी की सरकार बनती है, और मुख्यमंत्री समेत पूरी मंत्रिपरिषद विधानसभा के प्रति <b>ज़िम्मेदार</b> रहती है।</p>
    <p>लोअर PCS के मुख्य परीक्षा पाठ्यक्रम में साफ़ लिखा है: <b>"उत्तराखंड में विधानसभा: शक्तियाँ और कार्य"</b>। यह अध्याय यही समझाता है।</p>
  </section>

  <section id="banawat">
    <h2>बनावट: 70 सीटें, एक सदन</h2>
    <div class="cards4">
      <div class="hl"><span class="num">70</span><b>कुल सीटें</b><p>सभी सीटों पर जनता सीधे चुनाव करती है। सीमाएँ 2008 के परिसीमन से तय हैं।</p></div>
      <div><span class="num">13</span><b>अनुसूचित जाति</b><p>13 सीटें SC के लिए आरक्षित हैं (अनुच्छेद 332)।</p></div>
      <div><span class="num">2</span><b>अनुसूचित जनजाति</b><p><b>चकराता</b> (देहरादून) और <b>नानकमत्ता</b> (ऊधम सिंह नगर)।</p></div>
      <div><span class="num">1</span><b>एक ही सदन</b><p>विधान परिषद नहीं है। उत्तर प्रदेश में दो सदन हैं, उत्तराखंड में एक।</p></div>
    </div>
    <div class="table-wrap"><table>
      <thead><tr><th>बात</th><th>उत्तराखंड में</th><th>संविधान में कहाँ</th></tr></thead>
      <tbody>
        <tr><td>विधायक बनने की उम्र</td><td>कम से कम 25 साल, भारत का नागरिक</td><td>अनुच्छेद 173</td></tr>
        <tr><td>कार्यकाल</td><td>5 साल, पहले भंग भी हो सकती है</td><td>अनुच्छेद 172</td></tr>
        <tr><td>कोरम (बैठक के लिए कम से कम सदस्य)</td><td><b>10</b> (70 का दसवाँ हिस्सा 7 है, पर कम से कम 10 चाहिए)</td><td>अनुच्छेद 189(3)</td></tr>
        <tr><td>मंत्रियों की सीमा</td><td>मुख्यमंत्री समेत <b>12</b></td><td>अनुच्छेद 164(1A)</td></tr>
        <tr><td>दो सत्रों के बीच अंतर</td><td>6 महीने से ज़्यादा नहीं</td><td>अनुच्छेद 174</td></tr>
        <tr><td>एंग्लो-इंडियन मनोनीत सदस्य</td><td>2002 से 2020 तक 1; 25 जनवरी 2020 से ख़त्म (104वाँ संशोधन)</td><td>पुराना अनुच्छेद 333</td></tr>
      </tbody>
    </table></div>
    <div class="box-exam"><strong><span class="tag exam">परीक्षा बिंदु</span></strong>9 नवंबर 2000 को बनी <b>अंतरिम विधानसभा</b> में उत्तर प्रदेश विधानसभा के 22 विधायक और विधान परिषद के 9 सदस्य थे (कानून की धारा 14 के अनुसार कुल 31)। पहला आम चुनाव <b>14 फ़रवरी 2002</b> को हुआ।</div>
  </section>

  <section id="safar">
    <h2>पाँच विधानसभाएँ और मुख्यमंत्री</h2>
    <div class="table-wrap"><table>
      <thead><tr><th>विधानसभा</th><th>मुख्यमंत्री</th></tr></thead>
      <tbody>
        <tr><td>अंतरिम (2000–02)</td><td>नित्यानंद स्वामी, फिर भगत सिंह कोश्यारी</td></tr>
        <tr><td>पहली (2002–07)</td><td>नारायण दत्त तिवारी (अब तक पूरे 5 साल पद पर रहने वाले अकेले मुख्यमंत्री)</td></tr>
        <tr><td>दूसरी (2007–12)</td><td>भुवन चंद्र खंडूड़ी, रमेश पोखरियाल "निशंक", फिर खंडूड़ी</td></tr>
        <tr><td>तीसरी (2012–17)</td><td>विजय बहुगुणा, फिर हरीश रावत (बीच में 2016 का राष्ट्रपति शासन)</td></tr>
        <tr><td>चौथी (2017–22)</td><td>त्रिवेंद्र सिंह रावत, तीरथ सिंह रावत, फिर पुष्कर सिंह धामी</td></tr>
        <tr><td>पाँचवीं (2022 से)</td><td>पुष्कर सिंह धामी (23 मार्च 2022 से दूसरा कार्यकाल)</td></tr>
      </tbody>
    </table></div>
    <p class="muted">पाँचवीं विधानसभा का कार्यकाल 2027 में पूरा होगा।</p>
  </section>

  <section id="adhyaksh">
    <h2>अध्यक्ष और उपाध्यक्ष</h2>
    <p>नई विधानसभा की पहली बैठक में राज्यपाल एक वरिष्ठ विधायक को <b>प्रोटेम (अस्थायी) अध्यक्ष</b> बनाते हैं, जो नए विधायकों को शपथ दिलाता है। फिर विधायक अपने में से <b>अध्यक्ष</b> और <b>उपाध्यक्ष</b> चुनते हैं (अनुच्छेद 178)। 2022 में बंशीधर भगत प्रोटेम अध्यक्ष थे।</p>
    <div class="table-wrap"><table>
      <thead><tr><th>अध्यक्ष</th><th>किस विधानसभा में</th><th>ख़ास बात</th></tr></thead>
      <tbody>{speakers.map(([n, t, x]) => <tr><td><b>{n}</b></td><td>{t}</td><td>{x}</td></tr>)}</tbody>
    </table></div>
    <h3>अध्यक्ष के मुख्य काम</h3>
    <ul>
      <li>सदन चलाना और अनुशासन रखना; किसे बोलने देना है, यह तय करना।</li>
      <li>कोई विधेयक <b>धन विधेयक</b> है या नहीं, इस पर अध्यक्ष का फ़ैसला अंतिम (अनुच्छेद 199(3))।</li>
      <li><b>दल-बदल</b> पर विधायक की अयोग्यता का फ़ैसला (दसवीं अनुसूची)।</li>
      <li>बराबर वोट होने पर <b>निर्णायक वोट</b> (अनुच्छेद 189)।</li>
    </ul>
    <div class="box-myth"><strong><span class="tag myth">अभी की स्थिति</span></strong>उपाध्यक्ष का पद 2022 से ख़ाली बताया जाता है; इसकी पुष्टि विधानसभा की वेबसाइट से बाकी है। जानकारी {fmt(VERIFIED_ON)} तक जाँची गई।</div>
  </section>

  <section id="kaam">
    <h2>विधानसभा के पाँच काम</h2>
    <div class="cards4">
      <div><span class="num">1</span><b>कानून बनाना</b><p>राज्य सूची और समवर्ती सूची के विषयों पर। जैसे पुलिस, ज़मीन, पंचायत, शिक्षा।</p></div>
      <div><span class="num">2</span><b>पैसे पर नियंत्रण</b><p>बजट पास करना, कर लगाना। विधानसभा की मंज़ूरी के बिना सरकार ख़र्च नहीं कर सकती (अनुच्छेद 202–207)।</p></div>
      <div><span class="num">3</span><b>सरकार पर नज़र</b><p>प्रश्नकाल, ध्यानाकर्षण, स्थगन और अविश्वास प्रस्ताव से सरकार से जवाब माँगना।</p></div>
      <div><span class="num">4</span><b>चुनाव में भूमिका</b><p>राज्यसभा के 3 सदस्य चुनना; राष्ट्रपति चुनाव में वोट देना।</p></div>
      <div><span class="num">5</span><b>संविधान संशोधन</b><p>कुछ संशोधनों (जैसे केंद्र-राज्य संबंध) पर आधे राज्यों की मंज़ूरी चाहिए; उसमें उत्तराखंड का वोट।</p></div>
    </div>
  </section>

  <section id="kanoon">
    <h2>कानून कैसे बनता है</h2>
    <ul class="tl">
      <li><span class="d">1. पेश</span>मंत्री (सरकारी विधेयक) या कोई विधायक (निजी विधेयक) सदन में विधेयक रखता है।</li>
      <li><span class="d">2. चर्चा</span>सदन में बहस होती है; ज़रूरत हो तो इसे <b>प्रवर समिति</b> को भेजा जाता है। जैसे 2023 में राज्य आंदोलनकारी आरक्षण विधेयक।</li>
      <li><span class="d">3. पारित</span>हर धारा पर वोट, फिर पूरा विधेयक पास।</li>
      <li><span class="d">4. राज्यपाल</span>राज्यपाल मंज़ूरी दे सकते हैं, रोक सकते हैं, लौटा सकते हैं या <b>राष्ट्रपति के विचार के लिए</b> भेज सकते हैं (अनुच्छेद 200)।</li>
      <li><span class="d">5. कानून</span>मंज़ूरी के बाद राजपत्र में छपकर अधिनियम बनता है।</li>
    </ul>
    <div class="box-exam"><strong><span class="tag exam">उदाहरण</span></strong><b>समान नागरिक संहिता</b> का विधेयक 7 फ़रवरी 2024 को पास हुआ। इसके विषय समवर्ती सूची में हैं और केंद्रीय कानूनों से टकराते हैं, इसलिए इसे <b>राष्ट्रपति</b> के पास भेजा गया (अनुच्छेद 254(2)), और मार्च 2024 में मंज़ूरी मिली।</div>
    <h3>धन विधेयक: तीन बातें</h3>
    <ul>
      <li>सिर्फ़ विधानसभा में और <b>राज्यपाल की सिफ़ारिश</b> से पेश होता है।</li>
      <li>उत्तराखंड में विधान परिषद नहीं है, इसलिए यह सीधे राज्यपाल के पास जाता है।</li>
      <li>राज्यपाल धन विधेयक को पुनर्विचार के लिए नहीं लौटाते।</li>
    </ul>
  </section>

  <section id="dalbadal">
    <h2>दल-बदल कानून (दसवीं अनुसूची)</h2>
    <p>अगर कोई विधायक अपनी पार्टी अपनी मर्ज़ी से छोड़ दे, या पार्टी के निर्देश (व्हिप) के ख़िलाफ़ वोट करे, तो वह <b>अयोग्य</b> हो सकता है। इस पर फ़ैसला <b>विधानसभा अध्यक्ष</b> करते हैं।</p>
    <div class="box-exam"><strong><span class="tag exam">उत्तराखंड का उदाहरण (2016)</span></strong>मार्च 2016 में कांग्रेस के 9 बागी विधायकों ने बजट पर सरकार के ख़िलाफ़ रुख़ लिया। अध्यक्ष गोविंद सिंह कुंजवाल ने उन्हें दल-बदल कानून में <b>अयोग्य</b> ठहराया। इसी संकट में <b>27 मार्च 2016</b> को राज्य में पहली बार राष्ट्रपति शासन लगा, जिसे बाद में अदालत के आदेश और 10 मई के बहुमत परीक्षण के बाद हटाया गया।</div>
    <div class="box-trap"><strong><span class="tag trap">फ़र्क़ याद रखें</span></strong>दल-बदल की अयोग्यता पर फ़ैसला <b>अध्यक्ष</b> का। बाकी अयोग्यताओं (जैसे लाभ का पद, अनुच्छेद 191(1)) पर फ़ैसला <b>राज्यपाल</b> का, चुनाव आयोग की राय से।</div>
  </section>

  <section id="gairsain">
    <h2>देहरादून और गैरसैंण</h2>
    <p>राज्य आंदोलन के समय से माँग थी कि राजधानी पहाड़ के बीच <b>गैरसैंण</b> (चमोली) में बने। विधानसभा का भवन <b>भराड़ीसैंण</b> में बना, जहाँ सत्र होते हैं। <b>8 जून 2020</b> को भराड़ीसैंण (गैरसैंण) को <b>ग्रीष्मकालीन राजधानी</b> घोषित किया गया। देहरादून अस्थायी राजधानी है, जहाँ सचिवालय और ज़्यादातर काम है।</p>
    <p>उदाहरण: अल्पसंख्यक शिक्षा विधेयक 2025 गैरसैंण में मानसून सत्र (अगस्त 2025) के दौरान पास हुआ।</p>
  </section>

  <section id="jaal">
    <h2>उलझाने वाले प्रश्न</h2>
    <ul>
      <li>"उत्तराखंड में 71 विधायक हैं" — 2020 के बाद <b>ग़लत</b>। अब 70 निर्वाचित, कोई मनोनीत नहीं।</li>
      <li>"ST के लिए आरक्षित सीटें धारचूला और चकराता" — <b>ग़लत</b>। सही: <b>चकराता और नानकमत्ता</b>।</li>
      <li>"शून्यकाल नियमों में लिखा है" — <b>ग़लत</b>। यह सिर्फ़ परंपरा है; प्रश्नकाल नियमों में है।</li>
      <li>"कोरम 7 है" — <b>ग़लत</b>। 10 या दसवाँ हिस्सा, जो ज़्यादा हो, यानी 10।</li>
    </ul>
  </section>

