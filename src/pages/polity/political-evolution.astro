  <section id="jan">
    <h2>जनता ने शासन कैसे बदला</h2>
    <p>राजाओं और अंग्रेज़ों के शासन से लोकतंत्र तक का रास्ता अपने-आप नहीं बना। पहाड़ के लोगों ने आंदोलनों से कई व्यवस्थाएँ बदलवाईं। इनमें से कई आज की संस्थाओं की शुरुआत हैं:</p>
    <ul class="tl">
      <li><span class="yr">1916</span><span class="ev"><b>कुमाऊँ परिषद</b> बनी, जिसने पहाड़ के मुद्दे संगठित तरीक़े से उठाए।</span></li>
      <li><span class="yr">14 जनवरी 1921</span><span class="ev"><b>कुली बेगार आंदोलन</b>, बागेश्वर: लोगों ने बेगार के रजिस्टर सरयू में बहा दिए। आज संविधान का अनुच्छेद 23 बेगार पर रोक लगाता है।</span></li>
      <li><span class="yr">1921 और 1931</span><span class="ev">जंगलों पर अधिकार के आंदोलन के बाद कुमाऊँ फ़ॉरेस्ट ग्रीवेंसेज़ कमेटी (1921), और फिर <b>वन पंचायत नियमावली (1931)</b>, जिससे गाँवों को अपने जंगल सँभालने का अधिकार मिला। वन पंचायतें आज भी चलती हैं।</span></li>
      <li><span class="yr">30 मई 1930</span><span class="ev"><b>तिलाड़ी कांड</b> (टिहरी रियासत): वन-नियमों का विरोध कर रहे लोगों पर गोली चली।</span></li>
      <li><span class="yr">23 जनवरी 1939</span><span class="ev"><b>टिहरी राज्य प्रजामंडल</b> बना, जिसकी माँग थी कि रियासत में जनता की ज़िम्मेदार सरकार हो। श्रीदेव सुमन ने इसी माँग के लिए 25 जुलाई 1944 को बलिदान दिया।</span></li>
      <li><span class="yr">10 जनवरी 1948</span><span class="ev"><b>कीर्तिनगर</b> में रियासत के अधिकारियों ने हार मानी और "आज़ाद पंचायत" बनी। जनवरी 1948 में प्रजामंडल का अंतरिम मंत्रिमंडल बना।</span></li>
      <li><span class="yr">1 अगस्त 1949</span><span class="ev">टिहरी रियासत का भारत में <b>विलय</b>।</span></li>
    </ul>
    <Figure file="e/e3/Royal_Palace_of_Narendra_Nagar%2C_Uttarakhand_WTK20150913-DSC00029.jpg" alt="नरेंद्रनगर राजमहल का अग्रभाग" caption="नरेंद्रनगर का राजमहल। यहीं से टिहरी रियासत का शासन चलता था, जो 1949 में विलय के साथ ख़त्म हुआ।" author="Dibendu Nandi" license="CC BY-SA 4.0" w={960} />
  </section>

  <section id="samvidhan">
    <h2>पुरानी समस्या, संविधान का जवाब</h2>
    <p>संविधान के कई प्रावधान ठीक उन्हीं समस्याओं का जवाब हैं जो पहाड़ के लोगों ने राजशाही और अंग्रेज़ी शासन में झेलीं। परीक्षा में यह जोड़ बहुत काम आता है:</p>
    <div class="ans">
      <div><p class="old">बेगार: कत्यूरी काल की "विष्टि", गोरखा काल की बेगार, अंग्रेज़ों की कुली बेगार</p><p class="new"><b>अनुच्छेद 23</b>: बेगार, जबरन मज़दूरी और मानव तस्करी पर रोक</p></div>
      <div><p class="old">राजा की मर्ज़ी के कर: चंदों के 36 कर, गोरखाओं के भारी कर</p><p class="new"><b>अनुच्छेद 265</b>: कानून के बिना कोई कर नहीं</p></div>
      <div><p class="old">एक ही अफ़सर लगान वसूलने वाला भी और जज भी (कुमाऊँ कमिश्नर)</p><p class="new"><b>अनुच्छेद 50</b>: न्यायपालिका को कार्यपालिका से अलग रखने का निर्देश</p></div>
      <div><p class="old">अग्नि-परीक्षा ("दिव्य") से फ़ैसले, व्यक्ति के हिसाब से अलग सज़ा</p><p class="new"><b>अनुच्छेद 14 और 21</b>: कानून के सामने सब बराबर, और कानूनी प्रक्रिया के बिना जीवन या आज़ादी नहीं छीनी जा सकती</p></div>
      <div><p class="old">शासक वंश या जीत से तय होता था</p><p class="new"><b>अनुच्छेद 326</b>: 18 साल से ऊपर हर नागरिक को वोट; सरकार विधानसभा के प्रति ज़िम्मेदार (<b>अनुच्छेद 164</b>)</p></div>
      <div><p class="old">गाँव पर थोकदार और सयानों का दबदबा</p><p class="new"><b>अनुच्छेद 40 और 243</b>: चुनी हुई पंचायतें, ग्राम सभा, महिलाओं और SC/ST के लिए आरक्षण</p></div>
    </div>
  </section>

  <section id="patwari">
    <h2>पटवारी पुलिस: 1819 से आज तक</h2>
    <p>यह उत्तराखंड का ऐसा उदाहरण है जहाँ अंग्रेज़ों की बनाई व्यवस्था लगभग 200 साल तक चली। 1819 में ट्रेल के बनाए पटवारी लगान वसूलने के साथ अपराध की रिपोर्ट और गिरफ़्तारी भी करते थे। 1898 के कानून ने कानूनगो को इंस्पेक्टर और पटवारी को सब-इंस्पेक्टर जैसे पुलिस अधिकार दिए। इसे <b>"राजस्व पुलिस"</b> कहा जाने लगा, और आज़ादी के बाद भी पहाड़ के हज़ारों गाँवों में यही व्यवस्था चलती रही।</p>
    <ul class="tl">
      <li><span class="yr">सितंबर 2022</span><span class="ev">अंकिता भंडारी हत्याकांड की जाँच के दौरान राजस्व पुलिस पर देर से शिकायत दर्ज करने के आरोप लगे, और इस व्यवस्था को ख़त्म करने की माँग तेज़ हुई।</span></li>
      <li><span class="yr">अक्टूबर 2022</span><span class="ev">राज्य कैबिनेट ने राजस्व पुलिस को चरणों में ख़त्म करने का फ़ैसला लिया।</span></li>
      <li><span class="yr">जनवरी 2023</span><span class="ev">पहले चरण में लगभग <b>1,800</b> राजस्व गाँव नियमित पुलिस को सौंपने की अधिसूचना आई। सबसे ज़्यादा गाँव पिथौरागढ़ (595) के थे।</span></li>
      <li><span class="yr">मई 2024</span><span class="ev">उच्च न्यायालय ने सरकार को एक साल में राजस्व पुलिस पूरी तरह ख़त्म करने का निर्देश दिया।</span></li>
      <li><span class="yr">जुलाई 2025</span><span class="ev">समाचार रिपोर्टों के अनुसार यह व्यवस्था अब भी राज्य के लगभग आधे क्षेत्र और करीब एक-चौथाई आबादी पर लागू थी।</span></li>
    </ul>
    <div class="box-exam"><strong><span class="tag exam">परीक्षा के लिए</span></strong>उत्तराखंड देश का अकेला राज्य माना जाता है जहाँ नियमित पुलिस के साथ <b>राजस्व पुलिस</b> भी चलती रही। इसकी शुरुआत <b>1819</b> में कमिश्नर <b>ट्रेल</b> के 9 पटवारी पदों से हुई।</div>
    <div class="box-myth"><strong><span class="tag myth">स्थिति बदल रही है</span></strong>राजस्व पुलिस ख़त्म करने का काम चरणों में चल रहा है। आज कितने गाँव बाकी हैं, इसका ताज़ा सरकारी आँकड़ा हमें नहीं मिला, इसलिए हमने कोई संख्या नहीं दी। जानकारी 20 नवंबर 2026 तक जाँची गई।</div>
  </section>

