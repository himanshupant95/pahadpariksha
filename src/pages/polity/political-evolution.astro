const faq = [
  { q: 'क्या कत्यूरी या चंद राजाओं के ज़माने में पंचायतें थीं?', a: 'गाँव के स्तर पर पधान, सयाने और बूढ़े जैसे मुखिया थे, और चंद काल में "पंचनवीसी" जैसी पंचायती कचहरी का ज़िक्र मिलता है। पर ये चुनी हुई संस्थाएँ नहीं थीं, और आख़िरी फ़ैसला राजा का होता था। आज की ग्राम पंचायत संविधान के भाग IX से बनी चुनी हुई संस्था है।' },
