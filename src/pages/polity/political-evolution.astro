<script>
  // era time-travel tabs
  const tt = document.getElementById('tt');
  if (tt) {
    const tabs = tt.querySelectorAll<HTMLButtonElement>('[role="tab"]');
    tabs.forEach((t) => t.addEventListener('click', () => {
      tabs.forEach((o) => o.setAttribute('aria-selected', String(o === t)));
      tt.querySelectorAll<HTMLElement>('.tt-panel').forEach((p) => { p.hidden = p.dataset.k !== t.dataset.k; });
    }));
  }
  // "किस काल का शब्द?" game
  const game = document.getElementById('game');
  if (game) {
    let score = 0;
    const rowsEl = game.querySelectorAll<HTMLElement>('.g-row');
    rowsEl.forEach((row) => {
      row.querySelectorAll<HTMLButtonElement>('button').forEach((b) => b.addEventListener('click', () => {
        const right = b.dataset.v === row.dataset.a;
        row.querySelectorAll<HTMLButtonElement>('button').forEach((x) => { x.disabled = true; if (x.dataset.v === row.dataset.a) x.classList.add('ok'); });
        if (!right) b.classList.add('no');
        const e = row.querySelector<HTMLElement>('.g-e')!;
        e.textContent = (right ? 'सही! ' : `ग़लत। सही उत्तर: ${row.dataset.a}। `) + e.textContent;
        e.hidden = false;
        if (right) score++;
        document.getElementById('g-score')!.textContent = `स्कोर: ${score} / ${rowsEl.length}`;
      }));
    });
  }
</script>
