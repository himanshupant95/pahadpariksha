---
import PolityChapter from '../../layouts/PolityChapter.astro';
import ChapterEnd from '../../components/geo/ChapterEnd.astro';
import Quiz from '../../components/Quiz.astro';
import questions from '../../data/quizzes/polity-judiciary.json';
import { OFFICE, VERIFIED_ON } from '../../data/polity';

const cj = OFFICE.find((o) => o.post === 'मुख्य न्यायाधीश, उच्च न्यायालय');
const fmt = (d: string) => new Date(d).toLocaleDateString('hi-IN', { day: 'numeric', month: 'long', year: 'numeric' });

const toc = [
  { id: 'shuruaat', label: 'अदालतों की सीढ़ी' },
  { id: 'uchch', label: 'उत्तराखंड उच्च न्यायालय' },
  { id: 'niyukti', label: 'न्यायाधीश कैसे बनते हैं' },
  { id: 'shakti', label: 'उच्च न्यायालय की शक्तियाँ' },
  { id: 'nichli', label: 'ज़िला और निचली अदालतें' },
  { id: 'lok-adalat', label: 'लोक अदालत और मुफ़्त कानूनी मदद' },
  { id: 'adhikaran', label: 'लोक सेवा अधिकरण' },
  { id: 'lokayukta', label: 'लोकायुक्त' },
  { id: 'faisle', label: 'चर्चित फ़ैसले और हल्द्वानी का मामला' },
  { id: 'seekha', label: 'सार और याद रखें' },
  { id: 'quiz', label: 'क्विज़ (12 प्रश्न)' },
  { id: 'faq', label: 'सवाल-जवाब' },
];

const facts = [
  { k: 'उच्च न्यायालय', v: '<b>नैनीताल</b>, 9 नवंबर 2000 से (अनुच्छेद 214)' },
  { k: 'पहले मुख्य न्यायाधीश', v: '<b>अशोक ए. देसाई</b> (6 दिसंबर 2000 को शपथ)' },
  { k: 'पहली महिला मुख्य न्यायाधीश', v: '<b>ऋतु बाहरी</b> (2024)' },
  { k: 'न्यायाधीशों के पद', v: 'शुरुआत में 7, अब <b>11</b> स्वीकृत (9 स्थायी, 2 अपर)' },
  { k: 'अभी मुख्य न्यायाधीश', v: `<b>${cj?.name ?? ''}</b>, ${cj?.since ?? ''}` },
  { k: 'लोक सेवा अधिकरण', v: '<b>28 मार्च 2001</b>, देहरादून; नैनीताल में पीठ' },
  { k: 'लोकायुक्त', v: 'कानून <b>2014</b> का है, पर लोकायुक्त की नियुक्ति अब तक नहीं हुई' },
];

const faq = [
  { q: 'उत्तराखंड उच्च न्यायालय कहाँ है?', a: 'नैनीताल में, पुराने सचिवालय भवन में। इसे हल्द्वानी ले जाने का फ़ैसला हो चुका है। सर्वोच्च न्यायालय ने 15 जुलाई 2026 को इसका रास्ता साफ़ किया, और नई ज़मीन तय करने का काम चल रहा है।' },
  { q: 'उत्तराखंड उच्च न्यायालय के पहले मुख्य न्यायाधीश कौन थे?', a: 'न्यायमूर्ति अशोक ए. देसाई। वे 9 नवंबर 2000 को कार्यवाहक बने और 6 दिसंबर 2000 को मुख्य न्यायाधीश की शपथ ली।' },
  { q: 'उत्तराखंड के किन मुख्य न्यायाधीशों ने आगे भारत के मुख्य न्यायाधीश का पद सँभाला?', a: 'एस. एच. कपाड़िया और जे. एस. खेहर। के. एम. जोसेफ भी यहाँ के मुख्य न्यायाधीश रहे और फिर सर्वोच्च न्यायालय के न्यायाधीश बने।' },
  { q: 'लोक अदालत के फ़ैसले के ख़िलाफ़ अपील हो सकती है?', a: 'नहीं। लोक अदालत का फ़ैसला (अवार्ड) दोनों पक्षों की सहमति से होता है, इसलिए यह अंतिम होता है और इसके ख़िलाफ़ किसी अदालत में अपील नहीं होती। यह दीवानी अदालत की डिक्री जैसा माना जाता है।' },
  { q: 'क्या उत्तराखंड में अभी लोकायुक्त है?', a: 'नहीं। उत्तराखंड लोकायुक्त अधिनियम 2014 पास हुआ, पर यह लोकायुक्त की नियुक्ति के दिन से लागू होना है, और नियुक्ति अब तक नहीं हुई है।' },
];

const sources = [
  { label: 'उत्तराखंड उच्च न्यायालय: About us (स्वीकृत पद 7 से 11, पहली महिला मुख्य न्यायाधीश, कपाड़िया-खेहर)', url: 'https://highcourtofuttarakhand.gov.in/about-department/about-us/' },
  { label: 'उत्तराखंड उच्च न्यायालय: न्यायमूर्ति अशोक ए. देसाई, संस्थापक मुख्य न्यायाधीश (6 दिसंबर 2000 से 31 मार्च 2003)', url: 'https://highcourtofuttarakhand.gov.in/whoswho/honble-mr-justice-ashok-a-desai-founder-chief-justice/' },
  { label: 'उत्तराखंड उच्च न्यायालय: न्यायमूर्ति मनोज कुमार गुप्ता (8 जनवरी 2026 की अधिसूचना, अनुच्छेद 217(1))', url: 'https://highcourtofuttarakhand.gov.in/whoswho/honble-mr-justice-manoj-kumar-gupta/' },
  { label: 'SCC Online (8 अक्टूबर 2026): न्यायमूर्ति मनोज कुमार तिवारी 9 अक्टूबर 2026 से कार्यवाहक मुख्य न्यायाधीश', url: 'https://www.scconline.com/blog/post/2026/10/08/manoj-kumar-tiwari-appointed-acting-chief-justice-uttaranchal-high-court/' },
  { label: 'उत्तराखंड लोक सेवा अधिकरण: परिचय (28 मार्च 2001, UP Public Services (Tribunal) Act 1976)', url: 'https://ukpst.uk.gov.in/?p=345' },
  { label: 'उत्तराखंड राज्य विधिक सेवा प्राधिकरण', url: 'https://uttarakhand.nalsa.gov.in/' },
  { label: 'LiveLaw (15 जुलाई 2026): सर्वोच्च न्यायालय ने उच्च न्यायालय को हल्द्वानी ले जाने का रास्ता साफ़ किया', url: 'https://www.livelaw.in/top-stories/supreme-court-uttarakhand-high-court-to-shift-to-haldwani-land-to-be-handed-over-hc-decision-on-relocation-referendum-set-aside-541390' },
  { label: 'LiveLaw (7 सितंबर 2026): ज़मीन चिह्नित करने के चरण में याचिका समय से पहले, ख़ारिज', url: 'https://www.livelaw.in/high-court/uttarakhand-high-court/uttarakhand-high-court-dismisses-challenge-proposed-uttarakhand-high-court-shift-548985' },
  { label: 'भारत का संविधान: अनुच्छेद 214–237, 39A (विधायी विभाग)', url: 'https://legislative.gov.in/constitution-of-india/' },
  { label: 'पहाड़ परीक्षा राजव्यवस्था हब: समयरेखा (2016 राष्ट्रपति शासन, 2017 गंगा-यमुना फ़ैसला, लोकायुक्त 2014)', url: '/polity/' },
];
---
<PolityChapter
  name="उत्तराखंड उच्च न्यायालय और निचली अदालतें" nameEn="Judiciary in Uttarakhand: High Court, subordinate courts, Lok Adalat, tribunal and Lokayukta" slug="judiciary"
  sub="नैनीताल का उच्च न्यायालय, न्यायाधीशों की नियुक्ति, रिट और जनहित याचिका, ज़िला अदालतें, लोक अदालत, लोक सेवा अधिकरण और लोकायुक्त। पाठ्यक्रम की हर लाइन, आसान भाषा में।"
  title="उत्तराखंड उच्च न्यायालय, निचली अदालतें और लोकायुक्त"
  description="उत्तराखंड उच्च न्यायालय (नैनीताल, 2000): न्यायाधीशों की नियुक्ति, अनुच्छेद 226-227, ज़िला अदालतें, लोक अदालत, लोक सेवा अधिकरण और लोकायुक्त।"
  published="2026-11-21"
  toc={toc} facts={facts} faq={faq} sources={sources}
>
  <section id="shuruaat">
    <h2>अदालतों की सीढ़ी</h2>
    <p>भारत में अदालतें एक सीढ़ी की तरह हैं। सबसे ऊपर <b>सर्वोच्च न्यायालय</b> (दिल्ली), फिर हर राज्य का <b>उच्च न्यायालय</b>, और उसके नीचे ज़िलों की अदालतें। उत्तराखंड में यह सीढ़ी ऐसी है:</p>
    <ol>
      <li><b>उच्च न्यायालय, नैनीताल</b>: पूरे राज्य का सबसे बड़ा न्यायालय।</li>
      <li><b>ज़िला एवं सत्र न्यायाधीश</b>: हर ज़िले में; दीवानी मामलों में "ज़िला न्यायाधीश", फ़ौजदारी में "सत्र न्यायाधीश"।</li>
      <li><b>सिविल जज (सीनियर और जूनियर डिवीज़न), न्यायिक मजिस्ट्रेट</b>: रोज़ के छोटे-बड़े मामले।</li>
      <li><b>विशेष अदालतें और अधिकरण</b>: परिवार न्यायालय, लोक अदालत, लोक सेवा अधिकरण आदि।</li>
    </ol>
  </section>

  <section id="uchch">
    <h2>उत्तराखंड उच्च न्यायालय</h2>
    <p>राज्य बनने के दिन, <b>9 नवंबर 2000</b> को ही नैनीताल में उच्च न्यायालय शुरू हुआ। इससे पहले यह इलाका इलाहाबाद उच्च न्यायालय के अधीन था। पहले मुख्य न्यायाधीश <b>अशोक ए. देसाई</b> इलाहाबाद उच्च न्यायालय से आए थे।</p>
    <div class="cards4">
      <div class="hl"><span class="num">2000</span><b>स्थापना</b><p>9 नवंबर 2000, नैनीताल। उत्तर प्रदेश पुनर्गठन अधिनियम, 2000 से।</p></div>
      <div><span class="num">11</span><b>स्वीकृत पद</b><p>शुरुआत में 7 पद थे, जो बढ़कर 11 हुए (9 स्थायी, 2 अपर)।</p></div>
      <div><span class="num">2</span><b>भारत के मुख्य न्यायाधीश</b><p>यहाँ के मुख्य न्यायाधीश रहे <b>एस. एच. कपाड़िया</b> और <b>जे. एस. खेहर</b> आगे CJI बने।</p></div>
      <div><span class="num">1</span><b>पहली महिला CJ</b><p><b>ऋतु बाहरी</b> (2024) राज्य की पहली महिला मुख्य न्यायाधीश बनीं।</p></div>
    </div>
    <div class="box-myth"><strong><span class="tag myth">अभी की स्थिति</span></strong>मुख्य न्यायाधीश <b>मनोज कुमार गुप्ता</b> (10 जनवरी 2026 से) <b>8 अक्टूबर 2026</b> को सेवानिवृत्त हुए। अब {cj?.name} {cj?.since?.split(' (')[0]} हैं। नए स्थायी मुख्य न्यायाधीश की नियुक्ति होते ही यह जानकारी बदलेगी। जाँच की तारीख़: {fmt(VERIFIED_ON)}।</div>
  </section>

  <section id="niyukti">
    <h2>न्यायाधीश कैसे बनते हैं</h2>
    <div class="table-wrap"><table>
      <thead><tr><th>बात</th><th>नियम</th><th>अनुच्छेद</th></tr></thead>
      <tbody>
        <tr><td>नियुक्ति कौन करता है</td><td><b>राष्ट्रपति</b>, भारत के मुख्य न्यायाधीश और राज्यपाल से परामर्श के बाद (व्यवहार में सर्वोच्च न्यायालय का कॉलेजियम नाम तय करता है)</td><td>217</td></tr>
        <tr><td>शपथ कौन दिलाता है</td><td><b>राज्यपाल</b> (जैसे 10 जनवरी 2026 को लोक भवन, देहरादून में)</td><td>219</td></tr>
        <tr><td>सेवानिवृत्ति</td><td><b>62 साल</b> की उम्र में</td><td>217(1)</td></tr>
        <tr><td>हटाना</td><td>संसद के दोनों सदनों के विशेष बहुमत से, सर्वोच्च न्यायालय के न्यायाधीश की तरह (महाभियोग जैसी प्रक्रिया)</td><td>217, 124(4)</td></tr>
        <tr><td>कार्यवाहक मुख्य न्यायाधीश</td><td>पद ख़ाली होने पर राष्ट्रपति किसी न्यायाधीश को कार्यवाहक बनाते हैं</td><td>223</td></tr>
        <tr><td>तबादला</td><td>राष्ट्रपति, भारत के मुख्य न्यायाधीश की सलाह से</td><td>222</td></tr>
      </tbody>
    </table></div>
    <div class="box-trap"><strong><span class="tag trap">उलझाने वाला प्रश्न</span></strong>"उच्च न्यायालय के न्यायाधीश की नियुक्ति राज्यपाल करते हैं" — <b>ग़लत</b>। नियुक्ति <b>राष्ट्रपति</b> करते हैं; राज्यपाल सिर्फ़ परामर्श देते हैं और शपथ दिलाते हैं। पर <b>ज़िला न्यायाधीश</b> की नियुक्ति राज्यपाल करते हैं (अनुच्छेद 233)।</div>
  </section>

  <section id="shakti">
    <h2>उच्च न्यायालय की शक्तियाँ</h2>
    <div class="cards4">
      <div><span class="num">226</span><b>रिट जारी करना</b><p>बंदी प्रत्यक्षीकरण, परमादेश, प्रतिषेध, उत्प्रेषण, अधिकार-पृच्छा। मौलिक अधिकारों के साथ <b>दूसरे कानूनी अधिकारों</b> के लिए भी।</p></div>
      <div><span class="num">227</span><b>निगरानी</b><p>राज्य की सभी अदालतों और अधिकरणों पर देखरेख (सैन्य अधिकरण छोड़कर)।</p></div>
      <div><span class="num">215</span><b>अभिलेख न्यायालय</b><p>इसके फ़ैसले मिसाल बनते हैं, और यह अपनी अवमानना पर सज़ा दे सकता है।</p></div>
      <div><span class="num">PIL</span><b>जनहित याचिका</b><p>आम लोगों के हित में कोई भी अर्ज़ी दे सकता है। उत्तराखंड में पर्यावरण, खनन, राजस्व पुलिस जैसे कई मामले PIL से उठे।</p></div>
    </div>
    <div class="box-exam"><strong><span class="tag exam">अनुच्छेद 32 बनाम 226</span></strong>अनुच्छेद <b>32</b> (सर्वोच्च न्यायालय) सिर्फ़ मौलिक अधिकारों के लिए है और ख़ुद एक मौलिक अधिकार है। अनुच्छेद <b>226</b> (उच्च न्यायालय) का दायरा <b>बड़ा</b> है: मौलिक और दूसरे कानूनी अधिकार दोनों।</div>
  </section>

  <section id="nichli">
    <h2>ज़िला और निचली अदालतें</h2>
    <ul>
      <li><b>ज़िला न्यायाधीश</b> की नियुक्ति <b>राज्यपाल</b> उच्च न्यायालय से परामर्श करके करते हैं (अनुच्छेद 233)।</li>
      <li><b>सिविल जज (जूनियर डिवीज़न)</b> की भर्ती परीक्षा <b>उत्तराखंड लोक सेवा आयोग</b> कराता है; नियुक्ति राज्यपाल करते हैं, उच्च न्यायालय से परामर्श के बाद (अनुच्छेद 234)।</li>
      <li>इन सब अदालतों पर <b>नियंत्रण उच्च न्यायालय</b> का होता है: तबादला, छुट्टी, पदोन्नति (अनुच्छेद 235)।</li>
      <li>परिवार न्यायालय, फ़ास्ट ट्रैक और विशेष अदालतें (जैसे POCSO) भी ज़िलों में हैं।</li>
    </ul>
  </section>

  <section id="lok-adalat">
    <h2>लोक अदालत और मुफ़्त कानूनी मदद</h2>
    <p>संविधान का <b>अनुच्छेद 39A</b> कहता है कि ग़रीबी के कारण किसी को न्याय से वंचित नहीं होना चाहिए। इसी के लिए <b>विधिक सेवा प्राधिकरण अधिनियम, 1987</b> बना।</p>
    <ul>
      <li><b>उत्तराखंड राज्य विधिक सेवा प्राधिकरण</b> (नैनीताल): इसके संरक्षक (Patron-in-Chief) उच्च न्यायालय के मुख्य न्यायाधीश होते हैं। हर ज़िले में ज़िला विधिक सेवा प्राधिकरण।</li>
      <li><b>लोक अदालत</b>: दोनों पक्षों की सहमति से समझौता। कोई कोर्ट फ़ीस नहीं; अगर पहले फ़ीस दी हो तो लौट जाती है।</li>
      <li>लोक अदालत का फ़ैसला <b>अंतिम</b> है, इसके ख़िलाफ़ <b>अपील नहीं</b> होती।</li>
      <li>महिलाएँ, बच्चे, SC/ST, आपदा पीड़ित और कम आय वाले लोग <b>मुफ़्त वकील</b> पा सकते हैं।</li>
    </ul>
  </section>

  <section id="adhikaran">
    <h2>उत्तराखंड लोक सेवा अधिकरण</h2>
    <p>सरकारी कर्मचारियों के नौकरी से जुड़े झगड़े (वेतन, पदोन्नति, निलंबन, वरिष्ठता) पहले अदालतों में बहुत समय लेते थे। इसके लिए अलग <b>अधिकरण</b> (ट्रिब्यूनल) है।</p>
    <ul>
      <li>स्थापना: <b>28 मार्च 2001</b>, <b>देहरादून</b> में।</li>
      <li>कानून: <b>उत्तर प्रदेश लोक सेवा (अधिकरण) अधिनियम, 1976</b>, जैसा उत्तराखंड में लागू है।</li>
      <li>मुख्य पीठ देहरादून में और एक पीठ <b>नैनीताल</b> में। यह RERA (रियल एस्टेट) की अपीलें भी सुनता है।</li>
    </ul>
  </section>

  <section id="lokayukta">
    <h2>लोकायुक्त</h2>
    <p>लोकायुक्त भ्रष्टाचार की शिकायतें सुनने वाली स्वतंत्र संस्था है। उत्तराखंड में इसका इतिहास उतार-चढ़ाव वाला है:</p>
    <ul class="tl">
      <li><span class="d">2011</span>भुवन चंद्र खंडूड़ी सरकार ने सख़्त लोकायुक्त कानून पास किया, जिसमें मुख्यमंत्री भी दायरे में थे।</li>
      <li><span class="d">2014</span>नया <b>उत्तराखंड लोकायुक्त अधिनियम, 2014</b> पास हुआ।</li>
      <li><span class="d">आज</span>कानून लोकायुक्त की <b>नियुक्ति के दिन से</b> लागू होना है, और नियुक्ति अब तक <b>नहीं हुई</b>।</li>
    </ul>
    <div class="box-exam"><strong><span class="tag exam">भ्रष्टाचार से जुड़ी दूसरी संस्थाएँ</span></strong><b>सतर्कता अधिष्ठान (Vigilance Establishment)</b> सरकारी कर्मचारियों के भ्रष्टाचार की जाँच करता है, और शिकायत के लिए <b>1064</b> हेल्पलाइन है। ये पाठ्यक्रम में "प्रशासनिक नियंत्रण" के तहत लिखे हैं; विस्तार <a href="/polity/special-laws/">ख़ास कानून</a> अध्याय में।</div>
  </section>

  <section id="faisle">
    <h2>चर्चित फ़ैसले और हल्द्वानी का मामला</h2>
    <ul class="tl">
      <li><span class="d">21 अप्रैल 2016</span>उच्च न्यायालय ने राज्य में लगे राष्ट्रपति शासन को रद्द किया। सर्वोच्च न्यायालय ने रोक लगाई और 10 मई 2016 को बहुमत परीक्षण हुआ।</li>
      <li><span class="d">20 मार्च 2017</span>गंगा और यमुना को "जीवित इकाई" माना गया। सर्वोच्च न्यायालय ने 7 जुलाई 2017 को इस पर रोक लगाई।</li>
      <li><span class="d">2018 और मई 2024</span>राजस्व पुलिस ख़त्म करने के आदेश।</li>
      <li><span class="d">15 सितंबर 2022</span>उच्च न्यायालय की पूर्ण पीठ ने नैनीताल से बाहर जाने का प्रस्ताव पास किया। 2022 में राज्य कैबिनेट ने हल्द्वानी के लिए सैद्धांतिक मंज़ूरी दी।</li>
      <li><span class="d">8 मई 2024</span>उच्च न्यायालय ने गौलापार (हल्द्वानी) की ज़मीन को जंगल होने के कारण नामंज़ूर किया और नई जगह व राय लेने को कहा।</li>
      <li><span class="d">15 जुलाई 2026</span><b>सर्वोच्च न्यायालय</b> ने 2024 का आदेश रद्द किया और हल्द्वानी जाने का रास्ता साफ़ किया। अब ज़मीन तय करने और वन-मंज़ूरी का काम चल रहा है।</li>
    </ul>
  </section>

