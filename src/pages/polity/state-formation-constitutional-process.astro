      {parts.map((x, i) => (
        <details open={i === 1}><summary><span class="pp">{x.p}</span><b>{x.t}</b><span class="ps">धारा {x.s}</span></summary><p>{x.b}</p></details>
      ))}
    </div>
    <div class="box-exam"><strong><span class="tag exam">परीक्षा के लिए</span></strong>सबसे ज़्यादा पूछी जाने वाली धाराएँ: <b>3</b> (13 ज़िले), <b>5</b> (पहली अनुसूची), <b>7</b> (राज्यसभा 3), <b>9</b> (लोकसभा 5), <b>12</b> (विधानसभा 70), <b>14</b> (अस्थायी विधानसभा), <b>26</b> (उच्च न्यायालय), <b>80</b> (गंगा प्रबंधन बोर्ड)।</div>
  </section>

  <section id="pehle-baad">
    <h2>सीटें: बँटवारे से पहले और बाद में</h2>
    <p>नीचे बटन दबाकर देखिए कि बँटवारे से संसद और विधानसभा की सीटें कैसे बदलीं:</p>
    <div class="ba" id="ba">
      <div class="ba-tabs" role="tablist"><button type="button" role="tab" aria-selected="true" data-k="before">2000 से पहले</button><button type="button" role="tab" aria-selected="false" data-k="after">9 नवंबर 2000 के बाद</button></div>
      <div class="ba-grid">
        <div><small>लोकसभा</small><b data-before="उत्तर प्रदेश 85" data-after="उत्तर प्रदेश 80 + उत्तरांचल 5">उत्तर प्रदेश 85</b><span>धारा 9</span></div>
        <div><small>राज्यसभा</small><b data-before="उत्तर प्रदेश 34" data-after="उत्तर प्रदेश 31 + उत्तरांचल 3">उत्तर प्रदेश 34</b><span>धारा 7, चौथी अनुसूची</span></div>
        <div><small>विधानसभा</small><b data-before="उत्तर प्रदेश 425" data-after="उत्तर प्रदेश 403 + उत्तरांचल 70">उत्तर प्रदेश 425</b><span>धारा 12</span></div>
        <div><small>उत्तरांचल की पहली विधानसभा</small><b data-before="—" data-after="अस्थायी: 22 विधायक + 9 विधान परिषद सदस्य">—</b><span>धारा 13, 14</span></div>
      </div>
    </div>
    <p>ध्यान दीजिए: उत्तर प्रदेश की विधानसभा में इस इलाके के <b>22</b> विधायक थे (425 − 403 = 22)। पर नए राज्य को <b>70</b> सीटें दी गईं, ताकि छोटे राज्य की विधानसभा ठीक से काम कर सके। 2002 के पहले चुनाव तक वही 22 विधायक और उत्तर प्रदेश विधान परिषद के 9 सदस्य मिलकर <b>अस्थायी विधानसभा</b> बने।</p>
    <h3>राज्यसभा की 3 सीटें कैसे बँटीं</h3>
    <p>राज्यसभा के सदस्य अलग-अलग समय पर रिटायर होते हैं, इसलिए उत्तर प्रदेश के मौजूदा सदस्यों को तीन समूहों से बाँटा गया (अधिनियम की पहली अनुसूची): जिनका कार्यकाल 25 नवंबर 2002 को ख़त्म होना था, उनमें से 1 सीट; 4 जुलाई 2004 वालों में से 1 सीट (लॉटरी से); और 2 अप्रैल 2006 वालों में से 1 सीट (लॉटरी से)।</p>
