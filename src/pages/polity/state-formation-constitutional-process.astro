<script>
  // "अनुच्छेद 2 या 3?" game
  const game = document.getElementById('game');
  if (game) {
    let score = 0;
    const rows = game.querySelectorAll<HTMLElement>('.g-row');
    rows.forEach((row) => {
      row.querySelectorAll<HTMLButtonElement>('button').forEach((b) => b.addEventListener('click', () => {
        const right = b.dataset.v === row.dataset.a;
        row.querySelectorAll<HTMLButtonElement>('button').forEach((x) => { x.disabled = true; if (x.dataset.v === row.dataset.a) x.classList.add('ok'); });
        if (!right) { b.classList.add('no'); }
        const e = row.querySelector<HTMLElement>('.g-e')!;
        if (!right) e.textContent = 'ग़लत। ' + e.textContent!.replace(/^सही:\s*/, 'सही उत्तर: ');
        e.hidden = false;
        if (right) score++;
        document.getElementById('g-score')!.textContent = `स्कोर: ${score} / ${rows.length}`;
      }));
    });
  }

  // bill journey stepper
  const st = document.getElementById('stepper');
  if (st) {
    const cards = st.querySelectorAll<HTMLElement>('.st-card');
    const dots = st.querySelectorAll<HTMLElement>('.st-track span');
    const prev = st.querySelector<HTMLButtonElement>('#st-prev')!;
    const next = st.querySelector<HTMLButtonElement>('#st-next')!;
    let i = 0;
    const show = () => {
      cards.forEach((c, k) => { c.hidden = k !== i; });
      dots.forEach((d, k) => d.classList.toggle('on', k <= i));
      prev.disabled = i === 0;
      next.textContent = i === cards.length - 1 ? 'शुरू से ↺' : 'आगे →';
    };
    next.addEventListener('click', () => { i = i === cards.length - 1 ? 0 : i + 1; show(); });
    prev.addEventListener('click', () => { if (i > 0) { i--; show(); } });
  }

  // before / after seats
  const ba = document.getElementById('ba');
  if (ba) {
    const tabs = ba.querySelectorAll<HTMLButtonElement>('[data-k]');
    tabs.forEach((t) => t.addEventListener('click', () => {
      tabs.forEach((o) => o.setAttribute('aria-selected', String(o === t)));
      ba.querySelectorAll<HTMLElement>('.ba-grid b').forEach((b) => {
        b.textContent = (t.dataset.k === 'after' ? b.dataset.after : b.dataset.before) ?? '';
        b.classList.toggle('flash', t.dataset.k === 'after');
      });
    }));
  }
</script>
