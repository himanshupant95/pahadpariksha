---
import Base from '../../layouts/Base.astro';
import Quiz from '../../components/Quiz.astro';
import ArticleExplorer from '../../components/polity/ArticleExplorer.astro';
import StateFormation from '../../components/polity/diagrams/StateFormation.astro';
import GovCM from '../../components/polity/diagrams/GovCM.astro';
import BillFlow from '../../components/polity/diagrams/BillFlow.astro';
import LocalTiers from '../../components/polity/diagrams/LocalTiers.astro';
import AdminHierarchy from '../../components/polity/diagrams/AdminHierarchy.astro';
import ThreeLists from '../../components/polity/diagrams/ThreeLists.astro';
import '../../styles/longform.css';
import '../../styles/polity.css';
import questions from '../../data/quizzes/polity-hub.json';
import { PSERIES, PUNITS, PCHAPTERS, HISTORY_LINKS, DASH, OFFICE, TIMELINE, CONFLICTS, TRAPS, GLOSSARY, SOURCES, GAPS, FAQ, VERIFIED_ON, pHref } from '../../data/polity';
import { ARTICLES } from '../../data/polity-articles';

const url = 'https://pahadpariksha.in/polity/';
const fmt = (d: string) => new Date(d).toLocaleDateString('hi-IN', { day: 'numeric', month: 'long', year: 'numeric' });
const live = PCHAPTERS.filter((c) => c.live);
const schema: Record<string, unknown>[] = [
  { '@context': 'https://schema.org', '@type': 'CollectionPage', name: `${PSERIES.name} (Uttarakhand Polity)`, url, inLanguage: 'hi-IN', dateModified: VERIFIED_ON,
    about: [{ '@type': 'Thing', name: 'Government and politics of Uttarakhand' }, { '@type': 'Legislation', name: 'Constitution of India' }],
    ...(live.length ? { mainEntity: { '@type': 'ItemList', itemListElement: live.map((c) => ({ '@type': 'ListItem', position: c.part, url: `https://pahadpariksha.in${pHref(c)}`, name: c.title })) } } : {}) },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'होम', item: 'https://pahadpariksha.in/' },
    { '@type': 'ListItem', position: 2, name: 'उत्तराखंड GK', item: 'https://pahadpariksha.in/gk/' },
    { '@type': 'ListItem', position: 3, name: 'राजव्यवस्था', item: url } ] },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: FAQ.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
const jump = [
  ['dashboard', 'एक नज़र में'], ['roadmap', 'कैसे पढ़ें'], ['nirman', 'राज्य कैसे बना'], ['aarekh', 'चित्रों में समझें'],
  ['explorer', 'अनुच्छेद एक्सप्लोरर'], ['pravdhan', 'अनुच्छेद, खंड, परंतुक'], ['tulna', 'फ़र्क़ समझें'], ['samayrekha', 'समयरेखा'],
  ['saavdhan', 'उलझाने वाले प्रश्न'], ['matbhed', 'जहाँ स्रोत अलग हैं'], ['quiz', 'क्विज़'], ['shabdavali', 'शब्दावली'], ['satyapan', 'स्रोत'], ['faq', 'सवाल-जवाब'],
];
const kinds = ['संवैधानिक', 'वैधानिक', 'प्रशासनिक', 'न्यायिक', 'समसामयिक'];
const mustCount = ARTICLES.filter((a) => a.lvl === 'must').length;
---
<Base title="उत्तराखंड राजव्यवस्था (Uttarakhand Polity) — संविधान, राज्यपाल, विधानसभा, पंचायत, अनुच्छेद एक्सप्लोरर | UKPSC" description="Uttarakhand Polity in Hindi — राज्य निर्माण (अनु. 3, UP पुनर्गठन अधिनियम 2000), राज्यपाल, मुख्यमंत्री, 70 सदस्यीय विधानसभा, उच्च न्यायालय, पंचायत-नगर निकाय, UCC; खोजने योग्य अनुच्छेद एक्सप्लोरर, आरेख, क्विज़ — प्राथमिक स्रोतों से।" schema={schema}>
  <nav class="crumbs" aria-label="ब्रेडक्रम्ब"><a href="/">होम</a> › <a href="/gk/">उत्तराखंड GK</a> › राजव्यवस्था</nav>

  <header class="pl-hero">
    <p class="kick">शृंखला · Uttarakhand Polity</p>
    <h1>{PSERIES.name} <span>{PSERIES.tagline}</span></h1>
    <p>{PSERIES.blurb}</p>
    <p class="ver">✔ जानकारी <time datetime={VERIFIED_ON}>{fmt(VERIFIED_ON)}</time> तक जाँची गई। जो तथ्य बदल सकते हैं, उनके साथ स्रोत दिया गया है।</p>
    <div class="row">
      <a class="pl-start" href="#roadmap">पढ़ाई शुरू करें ↓</a>
      <div class="pl-prog" id="pl-prog">आपकी प्रगति: <b id="pl-prog-n">0</b> / {ARTICLES.length} अनुच्छेद पढ़े<div class="bar"><div id="pl-prog-bar"></div></div></div>
    </div>
  </header>

  <nav class="chips" aria-label="इस पेज पर" style="margin:12px 0">
    {jump.map(([id, t]) => <a class="chip" href={`#${id}`} style="text-decoration:none">{t}</a>)}
  </nav>

  <div class="legend" aria-label="तथ्य-प्रकार">
    {kinds.map((k) => <span class={`kind k-${k}`}>{k} तथ्य</span>)}
    <span class="tag myth">स्रोतों में अंतर</span><span class="tag trap">उलझाने वाला प्रश्न</span>
  </div>

  <section id="dashboard">
    <h2>एक नज़र में: उत्तराखंड की राजव्यवस्था</h2>
    <dl class="dash">
      {DASH.map((f) => (
        <div><dt>{f.k} <span class={`kind k-${f.kind}`}>{f.kind}</span></dt><dd set:html={f.v} /><a class="src" href={f.src.u} target="_blank" rel="noopener nofollow">स्रोत: {f.src.t} ↗</a></div>
      ))}
    </dl>
    <div class="office">
      <h3>अभी कौन किस पद पर <span class="kind k-समसामयिक">समसामयिक</span></h3>
      <p class="muted" style="margin:0 0 6px;font-size:.85rem">ये नाम बदलते रहते हैं, इसलिए इन्हें इतिहास वाले तथ्यों से अलग रखा है। आख़िरी जाँच: {fmt(VERIFIED_ON)}। किसी पद पर नया व्यक्ति आते ही यह तालिका बदली जाएगी।</p>
      <table>
        <thead><tr><th>पद</th><th>नाम</th><th>कब से</th><th>स्रोत</th></tr></thead>
        <tbody>{OFFICE.map((o) => <tr><td>{o.post}</td><td><b>{o.name}</b>{o.note && <span class="tag myth"> {o.note}</span>}</td><td>{o.since}</td><td><a href={o.src.u} target="_blank" rel="noopener nofollow">{o.src.t}</a></td></tr>)}</tbody>
      </table>
    </div>
  </section>

  <section id="roadmap">
    <h2>कैसे पढ़ें: शुरुआत से परीक्षा तक</h2>
    <ol class="road">
      <li><b>बिल्कुल शुरुआत</b>संस्था क्या है और किसलिए है, आसान शब्दों में</li>
      <li><b>संस्था को समझना</b>इसे कौन चलाता है, इसके पास क्या शक्ति है और क्या सीमा</li>
      <li><b>संविधान में कहाँ</b>कौन-सा अनुच्छेद, खंड, कानून या अदालत का फ़ैसला</li>
      <li><b>उत्तराखंड में</b>राज्य के असली उदाहरण और तारीख़ें</li>
      <li><b>परीक्षा की तैयारी</b>MCQ, कथन वाले प्रश्न, अभिकथन-कारण, मुख्य परीक्षा के प्रश्न</li>
      <li><b>दोहराव</b>तालिकाएँ, चित्र, समयरेखा और उलझाने वाले प्रश्न</li>
    </ol>
    <p>हर अध्याय इन्हीं छह क़दमों में लिखा जाएगा। अगर आप अभी शुरू कर रहे हैं, तो पहले नीचे के चित्र देखें। फिर अनुच्छेद एक्सप्लोरर में <b>"ज़रूर जानें"</b> वाले {mustCount} अनुच्छेद पक्के कर लें।</p>

    {PUNITS.map((u) => {
      if (u.id === '0') return (
        <section>
          <h3 class="unit-h">{u.name}</h3>
          <p class="muted" style="margin-top:0">पुराने राजवंशों का शासन, ब्रिटिश कुमाऊँ, टिहरी रियासत, जन-आंदोलन और राज्य आंदोलन हमारी इतिहास शृंखला में विस्तार से हैं। इसलिए उन्हें यहाँ दोहराया नहीं गया, नीचे सीधे वहाँ के लिंक हैं।</p>
          <ul class="hist-links">{HISTORY_LINKS.map((h) => <li><a href={h.href}><b>{h.t}</b><span>{h.d}</span></a></li>)}</ul>
        </section>
      );
      const list = PCHAPTERS.filter((c) => c.unit === u.id);
      return (
        <section>
          <h3 class="unit-h">{u.name}</h3>
          <ol class="chs">
            {list.map((c) => c.live ? (
              <li><a class="pch" href={pHref(c)}><small>अध्याय {c.part}</small><strong>{c.title}</strong><span>{c.hook}</span><br /><span class="arts">{c.arts}</span></a></li>
            ) : (
              <li><div class="pch soon"><small>अध्याय {c.part} · जल्द आ रहा है</small><strong>{c.title}</strong><span>{c.hook}</span><br /><span class="arts">{c.arts}</span></div></li>
            ))}
          </ol>
        </section>
      );
    })}
  </section>

  <section id="nirman">
    <h2>उत्तराखंड कैसे बना: संविधान का रास्ता</h2>
    <p>लोगों के लंबे आंदोलन ने अलग राज्य की माँग खड़ी की (पढ़ें <a href="/history/statehood-movement/">राज्य आंदोलन का अध्याय</a>)। पर राज्य किसी घोषणा से नहीं बना। वह <b>संसद के एक कानून</b> से बना, जो अनुच्छेद 3 के तहत पास हुआ। परीक्षा में यही बात सबसे ज़्यादा पूछी जाती है।</p>
    <StateFormation />
    <h3>उत्तर प्रदेश पुनर्गठन अधिनियम, 2000: परीक्षा के लिए ज़रूरी धाराएँ</h3>
    <div class="table-wrap">
      <table>
        <thead><tr><th>धारा</th><th>इसमें क्या है</th></tr></thead>
        <tbody>
          <tr><td>3</td><td>उत्तर प्रदेश के 13 ज़िलों को मिलाकर "उत्तरांचल" राज्य बना</td></tr>
          <tr><td>7, 8</td><td>उत्तरांचल को राज्यसभा की 3 सीटें मिलीं और उत्तर प्रदेश की सीटें 34 से 31 हुईं। उस समय के सदस्यों को दोनों राज्यों में बाँटा गया</td></tr>
          <tr><td>9, 11</td><td>लोकसभा में उत्तर प्रदेश की 80 और उत्तरांचल की 5 सीटें</td></tr>
          <tr><td>12</td><td>विधानसभा में उत्तर प्रदेश की 403 और उत्तरांचल की 70 सीटें</td></tr>
          <tr><td>14</td><td>अस्थायी विधानसभा: इस इलाके के 22 विधायक और उत्तर प्रदेश विधान परिषद के 9 सदस्य</td></tr>
          <tr><td>16</td><td>अस्थायी विधानसभा अपना अध्यक्ष और उपाध्यक्ष चुनेगी। तब तक राज्यपाल किसी सदस्य को अध्यक्ष का काम सौंपेंगे</td></tr>
          <tr><td>22</td><td>चुनाव आयोग सीटों की सीमाएँ तय करेगा और SC/ST की सीटें तय करेगा। हर क्षेत्र से एक ही सदस्य चुना जाएगा</td></tr>
          <tr><td>26, 28</td><td>उत्तरांचल का अपना उच्च न्यायालय बनेगा। मुख्य पीठ कहाँ होगी, यह राष्ट्रपति तय करेंगे। जो मामले इलाहाबाद उच्च न्यायालय सुनता था, वे यहाँ आएँगे</td></tr>
          <tr><td>78</td><td>उत्तर प्रदेश लोक सेवा आयोग उत्तर प्रदेश का ही रहा। उत्तरांचल ने 2001 में अनुच्छेद 315 के तहत अपना आयोग बनाया</td></tr>
          <tr><td>79, 80</td><td>गंगा और ऊपरी यमुना की परियोजनाओं पर किसका क्या अधिकार और ज़िम्मेदारी होगी। साथ ही "गंगा प्रबंधन बोर्ड" बनाने की बात</td></tr>
        </tbody>
      </table>
    </div>
    <p class="muted" style="font-size:.85rem">यह सार अधिनियम के मूल पाठ से लिया गया है (India Code), और Indian Kanoon पर उपलब्ध पाठ से मिलाया गया है।</p>
  </section>

  <section id="aarekh">
    <h2>चित्रों में समझें</h2>
    <h3>राज्यपाल, मुख्यमंत्री और मंत्रिपरिषद का रिश्ता</h3>
    <GovCM />
    <h3>उत्तराखंड में कानून कैसे बनता है</h3>
    <BillFlow />
    <h3>पंचायत और नगर निकाय का ढाँचा</h3>
    <LocalTiers />
    <h3>सचिवालय से गाँव तक प्रशासन</h3>
    <AdminHierarchy />
    <h3>केंद्र और राज्य: तीन सूचियाँ, उत्तराखंड के उदाहरणों के साथ</h3>
    <ThreeLists />
  </section>

  <section id="explorer">
    <h2>अनुच्छेद एक्सप्लोरर: उत्तराखंड के लिए ज़रूरी अनुच्छेद</h2>
    <p>यहाँ {ARTICLES.length} अनुच्छेद हैं। हर एक पर क्लिक करके पढ़ें: आसान भाषा में मतलब, <b>उत्तराखंड में इसका उदाहरण</b>, और परीक्षा में कहाँ ग़लती होती है। हर कार्ड में खंड-दर-खंड व्याख्या, संशोधन और अदालत के फ़ैसले भी हैं। अगर अभी सिर्फ़ मूल बात पढ़नी है, तो "सिर्फ़ आसान बातें दिखाएँ" चुन लें। अनुच्छेद का नंबर या कोई शब्द लिखकर खोज सकते हैं। जो पढ़ लें, उस पर "पढ़ लिया" लगाते जाएँ, आपकी प्रगति इसी ब्राउज़र में सहेजी रहेगी। व्याख्या हमारे अपने शब्दों में है, संविधान का असली पाठ पढ़ने के लिए हर कार्ड पर <b>मूल पाठ</b> का सरकारी लिंक है।</p>
    <ArticleExplorer />
  </section>

  <section id="pravdhan">
    <h2>अनुच्छेद, खंड, उप-खंड, परंतुक, स्पष्टीकरण: इनमें फ़र्क़ क्या है</h2>
    <p>परीक्षा में अक्सर "अनुच्छेद 164(1A)" या "अनुच्छेद 3 का परंतुक" जैसे शब्द आते हैं। अनुच्छेद 3 के उदाहरण से समझिए कि संविधान के ये हिस्से कैसे बँटे होते हैं:</p>
    <div class="anat">
      <span class="p"><span class="lb a">अनुच्छेद</span><b>अनुच्छेद 3</b>: नए राज्यों का निर्माण…</span>
      <span class="p" style="--d:1"><span class="lb sc">उप-खंड</span>(a) किसी राज्य से इलाका अलग करके नया राज्य। उत्तराखंड इसी से बना</span>
      <span class="p" style="--d:1"><span class="lb sc">उप-खंड</span>(e) किसी राज्य का नाम बदलना। उत्तरांचल का नाम उत्तराखंड इसी से हुआ</span>
      <span class="p" style="--d:1"><span class="lb pv">परंतुक</span>"परंतु" से शुरू होने वाली शर्त: राष्ट्रपति की सिफ़ारिश और राज्य की विधानसभा की राय</span>
      <span class="p" style="--d:1"><span class="lb ex">स्पष्टीकरण</span>I और II: यहाँ "राज्य" शब्द में क्या-क्या आता है (18वाँ संशोधन, 1966)</span>
      <span class="p"><span class="lb c">खंड</span>अनुच्छेद के अंदर नंबर वाले हिस्से, जैसे <b>164(4)</b> यानी छह महीने का नियम, या <b>189(3)</b> यानी कोरम</span>
      <span class="p"><span class="lb sh">अनुसूची</span>संविधान के आख़िर में दी गई सूचियाँ, जैसे पहली (राज्यों के नाम), चौथी (राज्यसभा की सीटें), सातवीं (तीन सूचियाँ), दसवीं (दल-बदल)</span>
      <span class="p"><span class="lb am">संशोधन</span>अनुच्छेद 368 के तहत संविधान में बदलाव। जैसे 91वें संशोधन (2003) ने 164(1A) जोड़ा। पर अनुच्छेद 3 और 4 वाले कानून संशोधन नहीं माने जाते</span>
    </div>
  </section>

  <section id="tulna">
    <h2>फ़र्क़ समझें: परीक्षा में पूछी जाने वाली तुलनाएँ</h2>
    <h3>अनुच्छेद 32 बनाम अनुच्छेद 226</h3>
    <div class="table-wrap"><table>
