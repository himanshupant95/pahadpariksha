<script>
  // hero progress mirrors the explorer's "पढ़ लिया" count
  document.addEventListener('polity-progress', (e) => {
    const { done, total } = (e as CustomEvent<{ done: number; total: number }>).detail;
    const n = document.getElementById('pl-prog-n'); const bar = document.getElementById('pl-prog-bar');
    if (n) n.textContent = String(done);
    if (bar) bar.style.width = `${total ? (done / total) * 100 : 0}%`;
  });
  // timeline filter by fact-kind
  const btns = document.querySelectorAll<HTMLButtonElement>('[data-tk]');
  btns.forEach((b) => b.addEventListener('click', () => {
    btns.forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
    document.querySelectorAll<HTMLLIElement>('#tl li').forEach((li) => { li.hidden = !!b.dataset.tk && li.dataset.k !== b.dataset.tk; });
  }));
</script>
