---
import Base from '../layouts/Base.astro';
import { SITE } from '../data/site';
---
<Base title="संपर्क करें" description={`${SITE.name} से संपर्क करें — सुझाव, त्रुटि सूचना या सहयोग के लिए।`}>
  <h1>संपर्क करें</h1>
  <p>सुझाव, किसी तथ्य में त्रुटि की सूचना, या सहयोग के लिए हमें ईमेल करें:</p>
  <p><a class="btn" href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a></p>
  {SITE.telegram && <p>टेलीग्राम चैनल: <a href={SITE.telegram} rel="noopener" target="_blank">{SITE.telegram}</a></p>}
  <p class="muted">त्रुटि बताते समय पेज का लिंक और सही जानकारी का स्रोत ज़रूर लिखें। हम आमतौर पर 2–3 दिन में जवाब देते हैं।</p>
</Base>
