---
import Base from '../layouts/Base.astro';
import { SITE } from '../data/site';
---
<Base title="अस्वीकरण (Disclaimer)" description={`${SITE.name} का अस्वीकरण — यह एक स्वतंत्र शैक्षिक वेबसाइट है।`}>
  <h1>अस्वीकरण (Disclaimer)</h1>
  <ul>
    <li>{SITE.name} एक <strong>स्वतंत्र शैक्षिक वेबसाइट</strong> है। इसका UKSSSC, UKPSC या किसी भी सरकारी विभाग से कोई संबंध नहीं है।</li>
    <li>हम सामग्री की सटीकता का पूरा प्रयास करते हैं, फिर भी त्रुटि संभव है। परीक्षा तिथि, योग्यता, सिलेबस और परिणाम के लिए हमेशा आयोग की <strong>आधिकारिक वेबसाइट और विज्ञप्ति</strong> को ही अंतिम मानें।</li>
    <li>इस साइट की जानकारी के आधार पर लिए गए किसी भी निर्णय के लिए {SITE.name} उत्तरदायी नहीं है।</li>
    <li>पिछले वर्षों के प्रश्न पत्र केवल शैक्षिक अभ्यास हेतु दिए जाते हैं; उनका स्वामित्व संबंधित आयोग का है।</li>
    <li>कुछ लिंक एफिलिएट लिंक हो सकते हैं।</li>
  </ul>
  <p>किसी त्रुटि की सूचना के लिए <a href="/contact/">संपर्क करें</a>।</p>
</Base>
