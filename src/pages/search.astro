---
import Base from '../layouts/Base.astro';
---
<Base title="खोजें" description="पहाड़ परीक्षा पर उत्तराखंड GK, क्विज़ और परीक्षा जानकारी खोजें।" noindex>
  <link slot="head" href="/pagefind/pagefind-ui.css" rel="stylesheet" />
  <h1>खोजें</h1>
  <div id="search"></div>
  <script is:inline src="/pagefind/pagefind-ui.js"></script>
  <script is:inline>
    window.addEventListener('DOMContentLoaded', () => {
      new PagefindUI({ element: '#search', showSubResults: true, translations: { placeholder: 'टॉपिक खोजें, जैसे: पंच प्रयाग', zero_results: '"[SEARCH_TERM]" के लिए कोई परिणाम नहीं मिला' } });
    });
  </script>
</Base>
