---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import DailyQuestion from '../components/DailyQuestion.astro';
import NoticeList from '../components/NoticeList.astro';
import RecruitmentList from '../components/RecruitmentList.astro';
import PointList from '../components/PointList.astro';
import { points, dayAnchor, fmtDay } from '../lib/digest';
const news5 = points().slice(0, 4);
const caDay = news5[0]?.date;
import SeriesGrid from '../components/SeriesGrid.astro';
import { SERIES, liveCount } from '../data/districts';
const done = liveCount();
import { openRecruitments, admitCards, otherNotices } from '../lib/notices';
const open = openRecruitments();
const latest5 = [...admitCards(), ...otherNotices()].slice(0, 4);
const open2 = open.slice(0, 2);
import { SITE } from '../data/site';

const topics = [
  { icon: 'history', t: 'इतिहास', d: 'प्रागैतिहासिक से राज्य आंदोलन तक, 9 अध्याय', href: '/history/' },
  { icon: 'geography', t: 'भूगोल', d: 'मानचित्रों सहित 8 अध्याय', href: '/geography/' },
  { icon: 'shield', t: 'राजव्यवस्था', d: 'विधानसभा, न्यायालय, ख़ास कानून, भूमि व्यवस्था', href: '/polity/' },
  { icon: 'district', t: 'जिले', d: '13 जिलों के पूरे पेज', href: '/gk/districts/' },
  { icon: 'culture', t: 'संस्कृति', d: 'जनजातियाँ, पर्व, मेले, लोक नृत्य', href: '/gk/uttarakhand-sanskriti-janjatiyan/' },
  { icon: 'exam', t: 'पिछले प्रश्नपत्र', d: 'आधिकारिक उत्तर-कुंजी के साथ', href: '/pyq/' },
  { icon: 'quiz', t: 'क्विज़', d: 'सभी अध्यायों के MCQ एक जगह', href: '/quiz/' },
  { icon: 'paper', t: 'करेंट अफेयर्स', d: 'रोज़ का संस्करण, तथ्य व क्विज़', href: '/current-affairs/' },
];
// LSS-2026 syllabus gaps (Uttarakhand units 7–10). live: link list; otherwise "जल्द आ रहा है".
const syllabus = [
  { n: 1, t: 'भूमि व्यवस्था और राजस्व प्रशासन', d: 'थोकदारी, बेनाप, नजूल, नयाबाद, सिविल-सोयम वन, वन पंचायत, ज़मींदारी उन्मूलन, राजस्व पुलिस, भू-कानून 2025', unit: 'इकाई 9', links: [['/polity/land-revenue-system/', 'अध्याय पढ़ें']] },
  { n: 2, t: 'राज्य की राजव्यवस्था', d: 'विधानसभा, उच्च न्यायालय, लोकायुक्त, अधिकरण, सेवा का अधिकार, आरक्षण के कानून, UCC', unit: 'इकाई 9', links: [['/polity/legislative-assembly/', 'विधानसभा'], ['/polity/judiciary/', 'न्यायपालिका'], ['/polity/special-laws/', 'ख़ास कानून']] },
  { n: 3, t: 'उत्तराखंड की अर्थव्यवस्था', d: 'राज्य GDP, प्रति व्यक्ति आय, बजट, उद्योग, जलविद्युत, पर्यटन, खनिज और सभी 29 GI टैग', unit: 'इकाई 10', links: [['/gk/uttarakhand-arthvyavastha/', 'अध्याय पढ़ें'], ['/gk/uttarakhand-arthvyavastha/#gi', 'GI टैग']] },
  { n: 4, t: 'कृषि और बागवानी', d: 'मुख्य फ़सलें, फ़सल चक्र, सिंचाई के साधन, जोतें, बागवानी', unit: 'इकाई 8 · भूगोल अध्याय 10' },
  { n: 5, t: 'आपदा और पर्यावरण आंदोलन', d: 'आपदा प्रबंधन, जल संकट, चिपको, मैती, बीज बचाओ, शराबबंदी आंदोलन', unit: 'इकाई 8 · भूगोल अध्याय 12–15' },
  { n: 6, t: 'जनसंख्या और पलायन', d: 'घनत्व, लिंगानुपात, साक्षरता, पलायन के कारण और असर', unit: 'इकाई 8 · भूगोल अध्याय 9' },
  { n: 7, t: 'संस्कृति भाग 2', d: 'वेशभूषा, आभूषण, वाद्य यंत्र, खान-पान, साहित्यकार, खेल और पुरस्कार', unit: 'इकाई 7' },
];
const liveSyl = syllabus.filter((x) => x.links).length;
const garhwal = ['देहरादून', 'हरिद्वार', 'टिहरी गढ़वाल', 'उत्तरकाशी', 'चमोली', 'रुद्रप्रयाग', 'पौड़ी गढ़वाल'];
const districtPages: Record<string, string> = { 'देहरादून': '/gk/districts/dehradun/', 'हरिद्वार': '/gk/districts/haridwar/', 'नैनीताल': '/gk/districts/nainital/', 'अल्मोड़ा': '/gk/districts/almora/', 'पौड़ी गढ़वाल': '/gk/districts/pauri-garhwal/', 'टिहरी गढ़वाल': '/gk/districts/tehri-garhwal/', 'ऊधम सिंह नगर': '/gk/districts/udham-singh-nagar/', 'चमोली': '/gk/districts/chamoli/', 'पिथौरागढ़': '/gk/districts/pithoragarh/', 'उत्तरकाशी': '/gk/districts/uttarkashi/', 'रुद्रप्रयाग': '/gk/districts/rudraprayag/', 'बागेश्वर': '/gk/districts/bageshwar/', 'चंपावत': '/gk/districts/champawat/' };
const kumaon = ['नैनीताल', 'अल्मोड़ा', 'पिथौरागढ़', 'बागेश्वर', 'चंपावत', 'ऊधम सिंह नगर'];
const latest = [
  { href: '/gk/uttarakhand-arthvyavastha/', tag: 'नया अध्याय · लोअर PCS', t: 'उत्तराखंड की अर्थव्यवस्था: GSDP, बजट, उद्योग, ऊर्जा, पर्यटन, खनिज और सभी 29 GI टैग', img: '/images/uttarakhand-hills-thumb.webp' },
  { href: '/polity/land-revenue-system/', tag: 'नया अध्याय · लोअर PCS', t: 'भूमि व्यवस्था और राजस्व प्रशासन: थोकदारी, बेनाप, नजूल, नयाबाद, वन पंचायत, भू-कानून 2025', img: '/images/uttarakhand-hills-thumb.webp' },
  { href: '/polity/legislative-assembly/', tag: 'नया अध्याय · राजव्यवस्था', t: 'उत्तराखंड विधानसभा: 70 सीटें, अध्यक्ष, शक्तियाँ, कानून कैसे बनता है, दल-बदल', img: '/maps/uttarakhand-political-800.webp' },
  { href: '/polity/judiciary/', tag: 'नया अध्याय · राजव्यवस्था', t: 'उच्च न्यायालय और निचली अदालतें: नियुक्ति, लोक अदालत, लोक सेवा अधिकरण, लोकायुक्त', img: '/maps/uttarakhand-political-800.webp' },
  { href: '/polity/special-laws/', tag: 'नया अध्याय · राजव्यवस्था', t: 'उत्तराखंड के ख़ास कानून: सेवा का अधिकार, आरक्षण, UCC, नकल विरोधी कानून, अल्पसंख्यक शिक्षा', img: '/maps/uttarakhand-political-800.webp' },
  { href: '/pyq/', tag: 'पिछले प्रश्नपत्र', t: 'UKPSC के 8 प्रश्नपत्र, आधिकारिक उत्तर-कुंजी के साथ', img: '/images/mountain-study-thumb.webp' },
  { href: '/gk/uttarakhand-varsh-2025-26/', tag: 'करेंट · वर्ष की समीक्षा', t: 'उत्तराखंड वर्ष 2025–26: बजट, अर्थव्यवस्था, कानून, नियुक्तियाँ एक जगह', img: '/images/uttarakhand-hills-thumb.webp' },
  { href: '/gk/uttarakhand-tulnatmak-talikayen/', tag: 'उत्तराखंड GK', t: 'तुलनात्मक तालिकाएँ: जिलों की जनसंख्या, क्षेत्रफल, वन आवरण की रैंक', img: '/maps/uttarakhand-political-800.webp' },
  { href: '/gk/uttarakhand-sanskriti-janjatiyan/', tag: 'उत्तराखंड GK', t: 'संस्कृति और जनजातियाँ: पाँच जनजातियाँ, पर्व, मेले, लोक नृत्य, GI टैग', img: '/images/uttarakhand-hills-thumb.webp' },
];
---
<Base title={SITE.name} description={SITE.description}>
  <section class="hero">
    <picture>
      <source type="image/webp" srcset="/images/uttarakhand-hills-480.webp 480w, /images/uttarakhand-hills-640.webp 640w, /images/uttarakhand-hills-800.webp 800w, /images/uttarakhand-hills.webp 1200w" sizes="(max-width: 1040px) calc(100vw - 36px), 1004px" />
      <img class="hero-img" src="/images/uttarakhand-hills.webp" alt="" width="1200" height="630" fetchpriority="high" decoding="async" />
    </picture>
    <div class="hero-inner">
      <p class="kicker">UKSSSC · UKPSC · पटवारी · VDO · लोअर PCS</p>
      <h1>पहाड़ की परीक्षा, <span>पहाड़ जैसी तैयारी</span></h1>
      <p class="lead">उत्तराखंड सामान्य ज्ञान, पिछले प्रश्न पत्र और प्रैक्टिस क्विज़ — हिंदी में, बिल्कुल मुफ्त।</p>
      <div class="hero-cta">
        <a class="btn cta" href="/gk/">तैयारी शुरू करें</a>
        <a class="btn ghost" href="/quiz/">क्विज़ हल करें</a>
      </div>
    </div>
  </section>

  <ul class="trust">
    <li><Icon name="hindi" size={22} /> पूरी तरह हिंदी में</li>
    <li><Icon name="shield" size={22} /> स्रोतों से मिलान किए तथ्य</li>
    <li><Icon name="free" size={22} /> 100% मुफ्त</li>
    <li><Icon name="paper" size={22} /> परीक्षा-केंद्रित सामग्री</li>
  </ul>

  <section class="updates" aria-label="आज की ताज़ा जानकारी">
    <div class="up-col">
      <div class="ln-head"><h2>आवेदन चालू</h2><a href="/notices/#open">सभी →</a></div>
      {open2.length ? <RecruitmentList items={open2} compact /> : <p class="muted">अभी कोई भर्ती खुली नहीं।</p>}
    </div>
    <div class="up-col">
      <div class="ln-head"><h2>नवीनतम सूचनाएँ</h2><a href="/notices/">सभी →</a></div>
      <NoticeList items={latest5} compact />
    </div>
    <div class="up-col">
      <div class="ln-head"><h2>करेंट अफेयर्स</h2><a href={caDay ? `/current-affairs/#${dayAnchor(caDay)}` : '/current-affairs/'}>{caDay ? `${fmtDay(caDay).replace(/ \d{4}$/, '')} के सभी →` : 'सभी →'}</a></div>
      {news5.length ? <PointList items={news5} compact showCat={false} /> : <p class="muted">जल्द।</p>}
      <p class="ca-arch"><a href="/current-affairs/#archive">साप्ताहिक और मासिक संकलन →</a></p>
    </div>
  </section>

  <section class="series-band">
    <div class="sb-head">
      <div>
        <p class="kick">नई शृंखला · {SERIES.nameEn}</p>
        <h2>{SERIES.name} <span>— {SERIES.tagline}</span></h2>
        <p>{SERIES.blurb}</p>
      </div>
      <div class="sb-side">
        <div class="prog"><div style={`width:${(done / 13) * 100}%`}></div></div>
        <p>{done} / 13 भाग प्रकाशित</p>
        <a class="btn light" href={SERIES.href}>पूरी शृंखला देखें →</a>
      </div>
    </div>
    <SeriesGrid compact />
  </section>

  <section class="syl" aria-labelledby="syl-h">
    <div class="syl-head">
      <div>
        <p class="kick">लोअर PCS 2026 पाठ्यक्रम · उत्तराखंड</p>
        <h2 id="syl-h">पाठ्यक्रम के 7 नए अध्याय</h2>
        <p>UKPSC के LSS-2026 विज्ञापन का पाठ्यक्रम पढ़कर हमने देखा कि उत्तराखंड के कौन-से विषय अभी तक हमारी साइट पर नहीं थे। ये सात अध्याय उसी कमी को भरेंगे, एक-एक करके।</p>
      </div>
      <div class="syl-prog"><b>{liveSyl} / 7</b><span>प्रकाशित</span><div class="bar"><div style={`width:${(liveSyl / 7) * 100}%`}></div></div></div>
    </div>
    <ol class="syl-grid">
      {syllabus.map((x) => (
        <li class={x.links ? 'live' : 'soon'}>
          <span class="no">{x.n}</span>
          <small>{x.unit} · {x.links ? 'नया' : 'जल्द आ रहा है'}</small>
          <strong>{x.t}</strong>
          <p>{x.d}</p>
          {x.links ? <span class="go">{x.links.map(([h, l]) => <a href={h}>{l} →</a>)}</span> : <span class="wait">तैयार हो रहा है</span>}
        </li>
      ))}
    </ol>
  </section>

  <div class="two-col">
    <div>
      <h2>विषय चुनें</h2>
      <div class="topics">
        {topics.map((x) => (
          <a class="topic" href={x.href}><span class="ic"><Icon name={x.icon} /></span><strong>{x.t}</strong><small>{x.d}</small></a>
        ))}
      </div>
    </div>
    <aside>
      <DailyQuestion />
    </aside>
  </div>

  <h2>नवीनतम सामग्री</h2>
  <div class="latest">
    {latest.map((x) => (
      <a class="post" href={x.href}>
        <img class="thumb" src={x.img} alt="" width="104" height="78" loading="lazy" decoding="async" />
        <span class="post-body"><small>{x.tag}</small><strong>{x.t}</strong></span>
      </a>
    ))}
  </div>

  <section class="cta-band">
    <div>
      <h2>रोज़ 10 मिनट, परीक्षा में पूरे अंक</h2>
      <p>हर दिन एक नया प्रश्न, हर हफ्ते नए टॉपिक। इस साइट को बुकमार्क करें और नियमित अभ्यास करें।</p>
    </div>
    <a class="btn light" href="/quiz/">अभ्यास शुरू करें →</a>
  </section>
</Base>

<style>
  .ca-arch { margin: 6px 0 0; font-size: .85rem; font-weight: 600; }
  .syl { margin: 28px 0; padding: 20px; border-radius: 18px; background: linear-gradient(135deg, #eef2ff, #f0fdf4); border: 1px solid var(--line); }
  .syl-head { display: flex; gap: 18px; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; }
  .syl-head h2 { margin: 2px 0 6px; }
  .syl-head p { margin: 0; max-width: 640px; }
  .syl .kick { margin: 0; font-size: .8rem; font-weight: 700; color: #4f46e5; }
  .syl-prog { min-width: 150px; text-align: right; }
  .syl-prog b { font-size: 1.6rem; color: #3730a3; display: block; line-height: 1; }
  .syl-prog span { font-size: .85rem; }
  .syl-prog .bar { height: 8px; background: #e0e7ff; border-radius: 99px; margin-top: 6px; overflow: hidden; }
  .syl-prog .bar div { height: 100%; background: #4f46e5; }
  .syl-grid { list-style: none; padding: 0; margin: 16px 0 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 12px; }
  .syl-grid li { position: relative; background: var(--card); border: 1px solid var(--line); border-radius: 14px; padding: 14px 14px 12px 52px; display: flex; flex-direction: column; gap: 4px; }
  .syl-grid li.live { border: 2px solid #4f46e5; box-shadow: 0 4px 14px rgba(79,70,229,.12); }
  .syl-grid li.soon { opacity: .8; }
  .syl-grid .no { position: absolute; left: 12px; top: 14px; width: 30px; height: 30px; border-radius: 50%; display: grid; place-items: center; font-weight: 700; background: #e0e7ff; color: #3730a3; }
  .syl-grid li.live .no { background: #4f46e5; color: #fff; }
  .syl-grid small { font-size: .75rem; font-weight: 700; color: #6b7280; }
  .syl-grid li.live small { color: #15803d; }
  .syl-grid strong { font-size: 1.02rem; }
  .syl-grid p { margin: 0; font-size: .88rem; color: var(--muted, #555); line-height: 1.5; }
  .syl-grid .go { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 6px; }
  .syl-grid .go a { font-size: .85rem; font-weight: 700; padding: 4px 10px; border-radius: 99px; background: #4f46e5; color: #fff; text-decoration: none; }
  .syl-grid .go a:hover { background: #3730a3; }
  .syl-grid .wait { margin-top: 6px; font-size: .82rem; color: #6b7280; }
  .hero { position: relative; overflow: hidden; border-radius: 18px; min-height: 400px; display: flex; align-items: center; background: #14532d; }
  .hero-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 60%; }
  .hero::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(10,30,18,.78) 0%, rgba(10,30,18,.5) 45%, rgba(10,30,18,.05) 80%); }
  .hero-inner { position: relative; z-index: 1; padding: 44px 28px 60px; max-width: 620px; }
  @media (max-width: 640px) { .hero::after { background: linear-gradient(180deg, rgba(10,30,18,.55), rgba(10,30,18,.8)); } }
  .kicker { margin: 0; font-size: .82rem; font-weight: 600; color: #fdba74; letter-spacing: .02em; }
  .hero h1 { margin: 6px 0 8px; font-size: clamp(1.7rem, 4.6vw, 2.6rem); line-height: 1.3; color: #fff; text-shadow: 0 2px 12px rgba(0,0,0,.35); }
  .hero h1 span { color: #fdba74; }
  .lead { font-size: 1.05rem; color: #ecfdf3; margin: 0 0 18px; }
  .hero-cta { display: flex; gap: 10px; flex-wrap: wrap; }
  .ghost { background: rgba(255,255,255,.12); color: #fff; border: 2px solid rgba(255,255,255,.8); }
  .ghost:hover { background: #fff; color: var(--green); }

  .trust { list-style: none; padding: 0; margin: 16px 0 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 10px; }
  .trust li { display: flex; align-items: center; gap: 8px; background: var(--card); border: 1px solid var(--line); border-radius: 10px; padding: 10px 12px; font-size: .92rem; font-weight: 600; color: var(--green); }

  .two-col { display: grid; grid-template-columns: 1.6fr 1fr; gap: 22px; align-items: start; }
  .two-col aside { margin-top: 3.1em; }
  @media (max-width: 820px) { .two-col { grid-template-columns: 1fr; } .two-col aside { margin-top: 0; } }

  .topics { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 10px; }
  .topic { position: relative; display: flex; flex-direction: column; gap: 2px; background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 14px; text-decoration: none; color: var(--ink); transition: transform .15s, border-color .15s, box-shadow .15s; }
  a.topic:hover { transform: translateY(-2px); border-color: var(--green-2); box-shadow: 0 6px 18px rgba(20,83,45,.08); color: var(--ink); }
  .topic .ic { width: 46px; height: 46px; border-radius: 12px; display: grid; place-items: center; background: var(--green-soft); color: var(--green-2); margin-bottom: 6px; }
  .topic strong { color: var(--green); }
  .topic small { color: var(--muted); font-size: .82rem; line-height: 1.5; }
  .topic.soon { opacity: .65; }
