---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import DailyQuestion from '../components/DailyQuestion.astro';
import NoticeList from '../components/NoticeList.astro';
import RecruitmentList from '../components/RecruitmentList.astro';
import PointList from '../components/PointList.astro';
import { points } from '../lib/digest';
const news5 = points().slice(0, 5);
import { openRecruitments, admitCards, otherNotices } from '../lib/notices';
const open = openRecruitments();
const latest5 = [...admitCards(), ...otherNotices()].slice(0, 4);
import { SITE } from '../data/site';

const topics = [
  { icon: 'district', t: 'जिले', d: '13 जिले, मुख्यालय, सीमाएँ', href: '/gk/uttarakhand-districts/' },
  { icon: 'river', t: 'नदियाँ', d: 'उद्गम, संगम, पंच प्रयाग', href: '/gk/uttarakhand-rivers/' },
  { icon: 'quiz', t: 'क्विज़', d: 'टॉपिक-वाइज MCQ अभ्यास', href: '/quiz/' },
  { icon: 'exam', t: 'परीक्षाएँ', d: 'UKSSSC व UKPSC भर्तियाँ', href: '/exams/' },
  { icon: 'history', t: 'इतिहास', d: 'कत्यूरी, चंद, परमार वंश', soon: true },
  { icon: 'geography', t: 'भूगोल', d: 'हिमनद, दर्रे, झीलें', soon: true },
  { icon: 'culture', t: 'कला-संस्कृति', d: 'लोक नृत्य, मेले, वाद्य', soon: true },
  { icon: 'paper', t: 'पिछले प्रश्न पत्र', d: 'हल सहित, टॉपिक-वाइज', soon: true },
];
const garhwal = ['देहरादून', 'हरिद्वार', 'टिहरी गढ़वाल', 'उत्तरकाशी', 'चमोली', 'रुद्रप्रयाग', 'पौड़ी गढ़वाल'];
const districtPages: Record<string, string> = { 'देहरादून': '/gk/districts/dehradun/', 'हरिद्वार': '/gk/districts/haridwar/', 'नैनीताल': '/gk/districts/nainital/' };
const kumaon = ['नैनीताल', 'अल्मोड़ा', 'पिथौरागढ़', 'बागेश्वर', 'चंपावत', 'ऊधम सिंह नगर'];
const latest = [
  { href: '/gk/uttarakhand-districts/', tag: 'उत्तराखंड GK', t: 'उत्तराखंड के 13 जिले: मंडल, मुख्यालय और महत्वपूर्ण तथ्य', img: '/images/uttarakhand-hills-800.webp' },
  { href: '/gk/uttarakhand-rivers/', tag: 'उत्तराखंड GK', t: 'उत्तराखंड की प्रमुख नदियाँ: उद्गम, संगम और पंच प्रयाग', img: '/images/river-confluence-800.webp' },
  { href: '/quiz/uttarakhand-districts-rivers/', tag: 'क्विज़', t: 'उत्तराखंड जिले और नदियाँ क्विज़ (12 प्रश्न)', img: '/images/mountain-study-800.webp' },
];
---
<Base title={SITE.name} description={SITE.description}>
  <section class="hero">
    <picture>
      <source type="image/webp" srcset="/images/uttarakhand-hills-800.webp 800w, /images/uttarakhand-hills.webp 1200w" sizes="(max-width: 1040px) 100vw, 1040px" />
      <img class="hero-img" src="/images/uttarakhand-hills.webp" alt="" width="1200" height="630" fetchpriority="high" decoding="async" />
    </picture>
    <div class="hero-inner">
      <p class="kicker">UKSSSC · UKPSC · पटवारी · VDO · लोअर PCS</p>
      <h1>पहाड़ की परीक्षा, <span>पहाड़ जैसी तैयारी</span></h1>
      <p class="lead">उत्तराखंड सामान्य ज्ञान, पिछले प्रश्न पत्र और प्रैक्टिस क्विज़ — हिंदी में, बिल्कुल मुफ्त।</p>
      <div class="hero-cta">
        <a class="btn cta" href="/gk/">तैयारी शुरू करें</a>
        <a class="btn ghost" href="/quiz/">क्विज़ हल करें</a>
      </div>
    </div>
  </section>

  <ul class="trust">
    <li><Icon name="hindi" size={22} /> पूरी तरह हिंदी में</li>
    <li><Icon name="shield" size={22} /> स्रोतों से मिलान किए तथ्य</li>
    <li><Icon name="free" size={22} /> 100% मुफ्त</li>
    <li><Icon name="paper" size={22} /> परीक्षा-केंद्रित सामग्री</li>
  </ul>

  <div class="two-col">
    <div>
      <h2>विषय चुनें</h2>
      <div class="topics">
        {topics.map((x) => x.soon ? (
          <div class="topic soon"><span class="ic"><Icon name={x.icon} /></span><strong>{x.t}</strong><small>{x.d}</small><em>जल्द</em></div>
        ) : (
          <a class="topic" href={x.href}><span class="ic"><Icon name={x.icon} /></span><strong>{x.t}</strong><small>{x.d}</small></a>
        ))}
      </div>
    </div>
    <aside>
      <DailyQuestion />
      <section class="latest-notices">
        <div class="ln-head"><h2>आवेदन चालू</h2><a href="/notices/">सभी सूचनाएँ →</a></div>
        <RecruitmentList items={open} compact />
        {latest5.length > 0 && (<>
          <div class="ln-head"><h2>नवीनतम सूचनाएँ</h2></div>
          <NoticeList items={latest5} compact />
        </>)}
        {news5.length > 0 && (<>
          <div class="ln-head"><h2>उत्तराखंड करेंट अफेयर्स</h2><a href="/current-affairs/">सभी →</a></div>
          <PointList items={news5} compact />
        </>)}
      </section>
    </aside>
  </div>

  <h2>नवीनतम सामग्री</h2>
  <div class="latest">
    {latest.map((x) => (
      <a class="post" href={x.href}>
        <img class="thumb" src={x.img} alt="" width="800" height="450" loading="lazy" decoding="async" />
        <span class="post-body"><small>{x.tag}</small><strong>{x.t}</strong></span>
      </a>
    ))}
  </div>

  <h2>जिलेवार उत्तराखंड</h2>
  <div class="districts">
    <div class="division">
      <h3>गढ़वाल मंडल <small>(7 जिले · मुख्यालय पौड़ी)</small></h3>
      <div class="chips">{garhwal.map((d) => <a href={districtPages[d] ?? '/gk/uttarakhand-districts/'} class={districtPages[d] ? 'has-page' : undefined}>{d}</a>)}</div>
    </div>
    <div class="division kumaon">
      <h3>कुमाऊँ मंडल <small>(6 जिले · मुख्यालय नैनीताल)</small></h3>
      <div class="chips">{kumaon.map((d) => <a href={districtPages[d] ?? '/gk/uttarakhand-districts/'} class={districtPages[d] ? 'has-page' : undefined}>{d}</a>)}</div>
    </div>
  </div>

  <section class="cta-band">
    <div>
      <h2>रोज़ 10 मिनट, परीक्षा में पूरे अंक</h2>
      <p>हर दिन एक नया प्रश्न, हर हफ्ते नए टॉपिक। इस साइट को बुकमार्क करें और नियमित अभ्यास करें।</p>
    </div>
    <a class="btn light" href="/quiz/">अभ्यास शुरू करें →</a>
  </section>
</Base>

<style>
  .hero { position: relative; overflow: hidden; border-radius: 18px; min-height: 400px; display: flex; align-items: center; background: #14532d; }
  .hero-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 60%; }
  .hero::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(10,30,18,.78) 0%, rgba(10,30,18,.5) 45%, rgba(10,30,18,.05) 80%); }
  .hero-inner { position: relative; z-index: 1; padding: 44px 28px 60px; max-width: 620px; }
  @media (max-width: 640px) { .hero::after { background: linear-gradient(180deg, rgba(10,30,18,.55), rgba(10,30,18,.8)); } }
  .kicker { margin: 0; font-size: .82rem; font-weight: 600; color: #fdba74; letter-spacing: .02em; }
  .hero h1 { margin: 6px 0 8px; font-size: clamp(1.7rem, 4.6vw, 2.6rem); line-height: 1.3; color: #fff; text-shadow: 0 2px 12px rgba(0,0,0,.35); }
  .hero h1 span { color: #fdba74; }
  .lead { font-size: 1.05rem; color: #ecfdf3; margin: 0 0 18px; }
  .hero-cta { display: flex; gap: 10px; flex-wrap: wrap; }
  .ghost { background: rgba(255,255,255,.12); color: #fff; border: 2px solid rgba(255,255,255,.8); }
  .ghost:hover { background: #fff; color: var(--green); }

  .trust { list-style: none; padding: 0; margin: 16px 0 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 10px; }
  .trust li { display: flex; align-items: center; gap: 8px; background: var(--card); border: 1px solid var(--line); border-radius: 10px; padding: 10px 12px; font-size: .92rem; font-weight: 600; color: var(--green); }

  .two-col { display: grid; grid-template-columns: 1.6fr 1fr; gap: 22px; align-items: start; }
  .two-col aside { margin-top: 2.2em; }
  @media (max-width: 820px) { .two-col { grid-template-columns: 1fr; } .two-col aside { margin-top: 0; } }

  .topics { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 10px; }
  .topic { position: relative; display: flex; flex-direction: column; gap: 2px; background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 14px; text-decoration: none; color: var(--ink); transition: transform .15s, border-color .15s, box-shadow .15s; }
  a.topic:hover { transform: translateY(-2px); border-color: var(--green-2); box-shadow: 0 6px 18px rgba(20,83,45,.08); color: var(--ink); }
  .topic .ic { width: 46px; height: 46px; border-radius: 12px; display: grid; place-items: center; background: var(--green-soft); color: var(--green-2); margin-bottom: 6px; }
  .topic strong { color: var(--green); }
  .topic small { color: var(--muted); font-size: .82rem; line-height: 1.5; }
  .topic.soon { opacity: .65; }
  .topic em { position: absolute; top: 10px; right: 10px; font-style: normal; font-size: .72rem; background: #fff7ed; color: var(--accent); border-radius: 20px; padding: 1px 8px; }

  .latest { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 12px; }
  .post { display: flex; gap: 12px; align-items: center; background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 12px; text-decoration: none; color: var(--ink); }
  .post:hover { border-color: var(--green-2); color: var(--ink); }
  .thumb { flex: 0 0 104px; width: 104px; height: 78px; object-fit: cover; border-radius: 10px; background: var(--green-soft); }
  .post-body small { display: block; color: var(--accent); font-weight: 600; font-size: .78rem; }
  .post-body strong { font-size: .98rem; line-height: 1.5; color: var(--green); }

  .districts { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  @media (max-width: 720px) { .districts { grid-template-columns: 1fr; } }
  .division { background: var(--card); border: 1px solid var(--line); border-left: 5px solid var(--green-2); border-radius: 12px; padding: 12px 16px; }
  .division.kumaon { border-left-color: var(--accent); }
  .division h3 { margin: 0 0 8px; font-size: 1.05rem; }
  .division h3 small { color: var(--muted); font-weight: 400; font-size: .8rem; }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .chips a { background: var(--green-soft); color: var(--green); text-decoration: none; padding: 3px 12px; border-radius: 20px; font-size: .9rem; }
  .kumaon .chips a { background: #fff7ed; color: #9a3412; }
  .chips a:hover { filter: brightness(.95); }
  .chips a.has-page { background: var(--green-2); color: #fff; font-weight: 600; }
  .chips a.has-page::after { content: ' →'; }

  .btn.cta { background: #ea580c; }
  .btn.cta:hover { background: #c2410c; color: #fff; }
  .latest-notices { margin-top: 18px; }
  .ln-head { display: flex; justify-content: space-between; align-items: baseline; }
  .ln-head h2 { margin: 0 0 8px; font-size: 1.15rem; border: 0; }
  .ln-head a { font-size: .88rem; }
  .cta-band { margin-top: 2.2em; background: linear-gradient(120deg, #14532d, #166534 60%, #4d7c5f); color: #ecfdf3; border-radius: 16px; padding: 22px 24px; display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; }
  .cta-band h2 { color: #fff; border: 0; margin: 0 0 4px; }
  .cta-band p { margin: 0; }
  .btn.light { background: #fff; color: var(--green); }
  .btn.light:hover { background: #fef3c7; color: var(--green); }
</style>
