import HistoryChapter from '../../layouts/HistoryChapter.astro';
import Figure from '../../components/Figure.astro';
import Quiz from '../../components/Quiz.astro';
import questions from '../../data/quizzes/history-chand.json';

const toc = [
  { id: 'at-a-glance', label: 'एक नज़र में' },
  { id: 'sansthapak', label: 'सोमचंद और स्थापना-तिथि' },
