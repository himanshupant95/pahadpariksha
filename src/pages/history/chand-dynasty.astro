const facts = [
  { k: 'क्षेत्र', v: 'कुमाऊँ (कूर्मांचल); समय-समय पर तराई-भाबर और पश्चिमी नेपाल के कुछ भाग' },
  { k: 'संस्थापक', v: 'परंपरा में <b>सोमचंद</b> (झूसी, प्रयाग से आगमन); फ्रेज़र-हर्षदेव जोशी के विवरण में <b>थोहरचंद</b>' },
  { k: 'स्थापना-तिथि', v: '<b>विवादित</b> — 685 / 700 ई. (वंशावलियाँ), 953 ई., या 1019–21 ई. के आसपास' },
  { k: 'पहली राजधानी', v: '<b>चंपावत</b> — सोमचंद का किला <b>राजबुंगा</b>' },
  { k: 'दूसरी राजधानी', v: '<b>अल्मोड़ा</b> (आलमनगर) — <b>बालो कल्याणचंद</b>, लगभग <b>1563 ई.</b>' },
  { k: 'प्रमुख राजा', v: 'गरुड़ ज्ञानचंद, रत्नचंद, कीर्तिचंद, रुद्रचंद, लक्ष्मीचंद, <b>बाज बहादुर चंद</b>, उद्योतचंद, जगतचंद' },
  { k: 'मुगल संपर्क', v: 'रुद्रचंद — अकबर (लाहौर, 1587–88); बाज बहादुर — शाहजहाँ से "बहादुर" उपाधि' },
  { k: 'अंतिम राजा', v: '<b>महेंद्रचंद</b> (1788–1790)' },
  { k: 'अंत', v: '<b>1790 ई.</b> — गोरखा आक्रमण; अल्मोड़ा पर गोरखा अधिकार' },
];

const faq = [
  { q: 'चंद राजवंश का संस्थापक कौन था?', a: 'परंपरागत वंशावलियों और बद्रीदत्त पांडे के अनुसार सोमचंद, जो झूसी (प्रयाग) से आए थे और चंपावत में राजबुंगा किला बनवाया। विलियम फ्रेज़र और हर्षदेव जोशी के विवरणों पर आधारित एक मत थोहरचंद (थोरचंद) को संस्थापक मानता है। परीक्षा में प्रायः "सोमचंद" ही अपेक्षित उत्तर होता है।' },
  { q: 'चंद राजवंश की स्थापना कब हुई?', a: 'तिथि विवादित है। वंशावलियाँ 685 ई. और बद्रीदत्त पांडे 700 ई. देते हैं, पर ये तिथियाँ कत्यूरी कालक्रम से मेल नहीं खातीं। चंपावत जिला प्रशासन की ऐतिहासिक टिप्पणी 953 ई. को सबसे संभावित मानती है, जबकि कृष्णपाल सिंह ने इसे 1019–21 ई. के आसपास रखा है। अधिकांश आधुनिक इतिहासकार चंद सत्ता का वास्तविक आरंभ 11वीं सदी के आसपास मानते हैं।' },
  { q: 'चंदों ने राजधानी अल्मोड़ा कब और किसने स्थानांतरित की?', a: 'बालो कल्याणचंद (1560–1568) ने लगभग 1563 ई. में राजधानी चंपावत से अल्मोड़ा स्थानांतरित की। नगर की नींव उनसे पहले भीष्मचंद ने रखी थी और इसे "आलमनगर" नाम दिया था। कुछ स्रोत अल्मोड़ा की स्थापना 1568 ई. भी लिखते हैं।' },
  { q: 'किस चंद राजा ने अकबर से भेंट की थी?', a: 'रुद्रचंद ने। अकबरनामा के अनुसार वे लाहौर में अकबर से मिले (1587–88 ई.)। आइन-ए-अकबरी में "सरकार कुमाऊँ" के 21 महालों का उल्लेख मिलता है। रुद्रपुर नगर का नाम भी रुद्रचंद से जुड़ा है।' },
  { q: 'बाज बहादुर चंद को "बहादुर" उपाधि किसने दी?', a: 'मुगल बादशाह शाहजहाँ ने। 1654–55 ई. के गढ़वाल अभियान में मुगलों का साथ देने और वीरता दिखाने पर उन्हें "बहादुर" उपाधि और रत्नजड़ित खिलअत मिली। उन्होंने भीमताल में भीमेश्वर महादेव मंदिर बनवाया और बाजपुर नगर बसाया।' },
];

const sources = [
  { label: 'डॉ. हीरा सिंह भाकुनी, "चंद कालीन कुमाऊँ" — BAHI-302 "उत्तराखण्ड का इतिहास", उत्तराखण्ड मुक्त विश्वविद्यालय (खंड 4, इकाई 1; चंद राजाओं का कालक्रम)', url: 'https://elearning.uou.ac.in/pluginfile.php/424/mod_resource/content/1/BAHI302.pdf' },
  { label: 'चंपावत जिला प्रशासन (NIC) — History: सोमचंद, राजबुंगा किला, 953 ई. की तिथि', url: 'https://champawat.nic.in/history/' },
  { label: 'Chand kings — Wikipedia (स्रोत: कृष्णपाल सिंह 1973; बद्रीदत्त पांडे, "कुमाऊँ का इतिहास"; Imperial Gazetteer of India 1909; अकबरनामा; आइन-ए-अकबरी)', url: 'https://en.wikipedia.org/wiki/Chand_kings' },
  { label: 'Baz Bahadur Chand — Wikipedia (स्रोत: बद्रीदत्त पांडे, History of Kumaon, खंड 1; जदुनाथ सरकार, History of Aurangzib, खंड 3)', url: 'https://en.wikipedia.org/wiki/Baz_Bahadur_Chand' },
  { label: 'Rohilla — Wikipedia: अली मोहम्मद खाँ का कुमाऊँ आक्रमण (1743–44)', url: 'https://en.wikipedia.org/wiki/Rohilla' },
  { label: 'Almora — Wikipedia: आलमनगर, मल्ला महल, लालमंडी किला', url: 'https://en.wikipedia.org/wiki/Almora' },
  { label: 'E.T. Atkinson, "The Himalayan Gazetteer" (1882–86), खंड 2 — चंद इतिहास का प्रारंभिक ब्रिटिश विवरण' },
  { label: 'चित्र: Wikimedia Commons — WhiteRaven335 (CC BY-SA 4.0), Pranavspn (CC BY-SA 3.0), Ashwini Kesharwani (Public domain), John Edward Saché / British Library (Public domain)' },
];

const hero = '8/8c/Champawat_town.jpg';
const img = (w: number) => `https://upload.wikimedia.org/wikipedia/commons/thumb/${hero}/${w}px-${hero.split('/').pop()}`;
---
<HistoryChapter
  name="कुमाऊँ का चंद राजवंश" nameEn="Chand Dynasty of Kumaon" slug="chand-dynasty"
  sub="चंपावत से अल्मोड़ा तक — लगभग सात सौ वर्ष का कुमाऊँनी राज्य"
  title="चंद राजवंश (कुमाऊँ): सोमचंद, चंपावत-अल्मोड़ा, रुद्रचंद, बाज बहादुर चंद, रुहेला व गोरखा आक्रमण"
  description="कुमाऊँ का चंद राजवंश — संस्थापक सोमचंद और स्थापना-तिथि का मत-भेद, चंपावत (राजबुंगा) से अल्मोड़ा राजधानी (1563), गरुड़ ज्ञानचंद, रुद्रचंद-अकबर, बाज बहादुर चंद-शाहजहाँ, रुहेला आक्रमण 1743–44, जोशी गुट, 1790 का गोरखा आक्रमण और चंद कालीन मंदिर। समयरेखा, One-liners व क्विज़ के साथ।"
  image={img(1280)}
  heroSrcset={`${img(960)} 960w, ${img(1280)} 1280w`}
  imageAlt="पहाड़ियों के बीच बसा चंपावत नगर — चंदों की पहली राजधानी"
  heroCredit={{ text: 'चंपावत नगर — WhiteRaven335, CC BY-SA 4.0, Wikimedia Commons', url: 'https://commons.wikimedia.org/wiki/File:Champawat_town.jpg' }}
  published="2026-11-18" toc={toc} facts={facts} faq={faq} sources={sources}
>

<section id="parichay">
  <h2>कत्यूरियों के बाद कुमाऊँ</h2>
  <p class="pull">कार्तिकेयपुर (कत्यूरी) सत्ता के बिखरने के बाद कुमाऊँ में अनेक छोटे राज्य और ठकुराइयाँ उभरीं। इन्हीं के बीच काली नदी के पास चंपावत से एक वंश उठा, जिसने धीरे-धीरे पूरे कुमाऊँ को एक राज्य बना दिया।</p>
  <p>यह <b>चंद राजवंश</b> था। <a href="/history/kartikeyapur-katyuri/">कत्यूरी अध्याय</a> की तरह यहाँ ताम्रपत्रों जैसे समकालीन स्रोत कम हैं; इतिहास मुख्यतः इन पर टिका है:</p>
  <ul>
    <li><b>वंशावलियाँ</b> — जो 19वीं सदी में संकलित हुईं, इसलिए पूरी तरह विश्वसनीय नहीं।</li>
    <li>ब्रिटिश अधिकारियों के विवरण — <b>विलियम फ्रेज़र</b> (1813), <b>हर्षदेव जोशी</b> से मिली सूचनाएँ (1818), बाद में <b>एटकिंसन</b> का हिमालयन गजेटियर।</li>
    <li>मुगल ग्रंथ — <b>अकबरनामा</b>, <b>आइन-ए-अकबरी</b>; और बाद के इतिहासकार — बद्रीदत्त पांडे, डॉ. शिवप्रसाद डबराल।</li>
  </ul>
  <p>इसलिए चंद इतिहास में <b>तिथियों पर मत-भेद</b> बहुत हैं। इस अध्याय में राजाओं का शासनकाल उत्तराखण्ड मुक्त विश्वविद्यालय की पाठ्य-सामग्री में दिए कालक्रम (बद्रीदत्त पांडे परंपरा) के अनुसार है।</p>
</section>

<section id="sansthapak">
  <h2>संस्थापक और स्थापना-तिथि: मत-भेद</h2>
  <div class="box-myth"><strong><span class="tag myth">मत-भेद: संस्थापक</span></strong>
    <ul>
      <li><b>सोमचंद</b> — परंपरागत वंशावलियाँ, एटकिंसन और बद्रीदत्त पांडे इन्हें पहला चंद राजा मानते हैं। परंपरा के अनुसार वे <b>झूसी</b> (प्रयाग के पास) से आए और कन्नौज राजपरिवार से संबंधित थे।</li>
      <li><b>थोहरचंद (थोरचंद)</b> — विलियम फ्रेज़र और हर्षदेव जोशी के विवरणों पर आधारित मत इन्हें संस्थापक मानता है।</li>
    </ul>
    परीक्षा में सामान्यतः <b>सोमचंद</b> ही अपेक्षित उत्तर है।</div>
  <h3>स्थापना-तिथि के चार मत</h3>
  <table>
    <thead><tr><th>तिथि</th><th>किसका मत</th><th>टिप्पणी</th></tr></thead>
    <tbody>
      <tr><td><b>685 ई.</b> (742 वि.सं.)</td><td>परंपरागत वंशावलियाँ, 1849 की एक ब्रिटिश रिपोर्ट</td><td>कत्यूरी कालक्रम से टकराव</td></tr>
      <tr><td><b>700 ई.</b> (757 वि.सं.)</td><td>बद्रीदत्त पांडे (पं. रुद्रदत्त पंत के आधार पर)</td><td>सोमचंद का शासन 700–721 ई.</td></tr>
      <tr><td><b>953 ई.</b></td><td>चंपावत जिले का आधिकारिक इतिहास-विवरण</td><td>"सबसे संभावित" तिथि; शासन लगभग 974 ई. तक</td></tr>
      <tr><td><b>1019–21 ई.</b></td><td>कृष्णपाल सिंह (1973)</td><td>महमूद गज़नवी के कन्नौज आक्रमण (1018–19) की उथल-पुथल में आगमन</td></tr>
    </tbody>
  </table>
  <div class="box-trap"><strong><span class="tag trap">सावधान</span></strong>सोमचंद को अंतिम कत्यूरी राजा <b>ब्रह्मदेव</b> का समकालीन बताया जाता है। अगर कत्यूरी सत्ता लगभग 1050 ई. तक चली (अध्याय 3), तो 685 या 700 ई. की तिथि सही नहीं बैठती। इसीलिए आधुनिक इतिहासकार चंद सत्ता का वास्तविक आरंभ <b>11वीं सदी</b> के आसपास मानते हैं।</div>
</section>

<section id="champawat">
  <h2>चंपावत काल (राजबुंगा)</h2>
  <ul>
    <li><b>सोमचंद</b> ने काली कुमाऊँ में लगभग 15 एकड़ भूमि पर किला बनवाया — नाम <b>राजबुंगा</b>, जो बाद में <b>चंपावत</b> कहलाया।</li>
    <li>उन्होंने अपने राज्य को <b>कूर्मांचल</b> ही कहा। क्षेत्र "काली कुमाऊँ" कहलाता था, क्योंकि यह <b>काली नदी</b> के निकट है।</li>
    <li>उत्तराधिकारी — <b>आत्मचंद</b> (सत्ता का सुदृढ़ीकरण), <b>पूर्णचंद</b>, <b>इंद्रचंद</b>।</li>
  </ul>
  <div class="box-myth"><strong><span class="tag myth">जनश्रुति</span></strong>
    <ul>
      <li>सोमचंद ने कत्यूरी राजा <b>ब्रह्मदेव</b> की पुत्री से विवाह किया और चंपावत क्षेत्र उन्हें मिला।</li>
      <li><b>इंद्रचंद</b> ने संभवतः नेपाल से रेशम के कीड़े मँगवाकर काली कुमाऊँ में <b>रेशम उत्पादन</b> शुरू किया।</li>
    </ul>
  </div>
  <h3>प्रमुख राजा (चंपावत काल)</h3>
  <table>
    <thead><tr><th>राजा</th><th>शासनकाल</th><th>मुख्य तथ्य</th></tr></thead>
    <tbody>
      <tr><td><b>गरुड़ ज्ञानचंद</b></td><td>1374–1419</td><td>मुस्लिम इतिहासकारों के अनुसार <b>दिल्ली सल्तनत</b> से गंगा तक के <b>भाबर-तराई</b> क्षेत्र का अनुदान प्राप्त किया; बाद में संभल के नवाब से ये क्षेत्र खो दिए।</td></tr>
      <tr><td><b>भारतीचंद</b></td><td>1437–1450</td><td>—</td></tr>
      <tr><td><b>रत्नचंद</b></td><td>1450–1488</td><td>चंदों से संबंधित पाँच राजपूत कुलों (<b>"पंच-पुरबिया"</b>) को जागीरें देकर कुमाऊँ में बसाया।</td></tr>
      <tr><td><b>कीर्तिचंद</b></td><td>1488–1503</td><td>शेष कुमाऊँ के साथ <b>तराई</b> पर शासन करने वाले पहले चंद राजा।</td></tr>
    </tbody>
  </table>
  <div class="box-myth"><strong><span class="tag myth">जनश्रुति: "गरुड़" उपाधि</span></strong>कथा है कि ज्ञानचंद ने सुल्तान के साथ शिकार में साँप ले जाते एक बाज/चील को तीर से गिरा दिया, जिससे प्रसन्न होकर सुल्तान ने तराई-भाबर लौटाया और "गरुड़" उपाधि दी। सुल्तान कौन था — इस पर भी स्रोत एकमत नहीं हैं।</div>
  <Figure file="8/8a/Baleshwar_temple%2C_champawat.JPG" alt="चंपावत के बालेश्वर मंदिर समूह का चौड़ा दृश्य" caption="बालेश्वर मंदिर समूह, चंपावत — प्रांगण में बिखरे पत्थर के मंदिर।" author="Pranavspn" license="CC BY-SA 3.0" w={960} />
  <Figure file="1/12/Baleshwarmahadev.jpg" alt="चंपावत का बालेश्वर महादेव मंदिर" caption="बालेश्वर महादेव मंदिर, चंपावत — चंदों की पहली राजधानी का प्रमुख मंदिर-समूह।" author="Ashwini Kesharwani" license="Public domain" orig narrow />
</section>

<section id="almora">
  <h2>राजधानी अल्मोड़ा</h2>
  <ul>
    <li><b>भीष्मचंद</b> (1555–1560) ने अल्मोड़ा क्षेत्र में नगर की नींव रखी और इसका नाम <b>"आलमनगर"</b> रखा।</li>
    <li><span class="tag exam">परीक्षा बिंदु</span> <b>बालो कल्याणचंद</b> (1560–1568) ने लगभग <b>1563 ई.</b> में राजधानी <b>चंपावत से अल्मोड़ा</b> स्थानांतरित की।</li>
    <li>आज जहाँ अल्मोड़ा का कलेक्ट्रेट है, वहाँ चंद राजाओं का <b>मल्ला महल</b> (ऊपरी दरबार) था। वर्तमान छावनी क्षेत्र पहले <b>लालमंडी</b> कहलाता था; इसका किला अंग्रेज़ों ने बाद में "फोर्ट मोयरा" नाम से जाना।</li>
    <li>अल्मोड़ा के बीच में होने से पूरे कुमाऊँ पर नियंत्रण आसान हुआ — यहीं से चंद राज्य का बड़ा विस्तार शुरू हुआ।</li>
  </ul>
  <div class="box-trap"><strong><span class="tag trap">सावधान</span></strong>अल्मोड़ा की स्थापना की तिथि अलग-अलग स्रोतों में <b>1560, 1563 या 1568</b> मिलती है। राजधानी-स्थानांतरण के लिए सबसे प्रचलित उत्तर <b>1563 ई., कल्याणचंद</b> है।</div>
  <Figure file="9/94/Almora%2C_1860s.jpg" alt="1860 के दशक का अल्मोड़ा नगर — पहाड़ी पर बसा पुराना शहर" caption="1860 के दशक का अल्मोड़ा — घोड़े की काठी जैसी पहाड़ी पर बसा चंदों का राजधानी नगर।" author="John Edward Saché (British Library)" license="Public domain" orig narrow />
</section>

<section id="rudrachand">
  <h2>रुद्रचंद और मुगल संपर्क</h2>
  <p><b>रुद्रचंद</b> (1568–1597; कुछ स्रोतों में 1565 से), कल्याणचंद के पुत्र, अकबर के समकालीन थे।</p>
  <ul>
    <li><b>1581 ई.</b> — <b>सीरा</b> पर अधिकार, वहाँ के रैका राजा <b>हरिमल्ल</b> को हराकर। इसी समय गढ़वाल पर पहला चंद आक्रमण हुआ, जिसे गढ़वाल नरेश <b>दुलाराम शाह</b> ने विफल किया।</li>
    <li><span class="tag exam">परीक्षा बिंदु</span> <b>अकबर से भेंट</b> — अकबरनामा के अनुसार रुद्रचंद <b>लाहौर</b> में अकबर से मिले (1587–88)। अकबरनामा उन्हें भारत के "बड़े ज़मींदारों" में गिनता है।</li>
    <li><b>आइन-ए-अकबरी</b> में <b>"सरकार कुमाऊँ"</b> का उल्लेख है, जिसमें <b>21 महाल</b> और उनसे प्राप्त राजस्व दर्ज हैं (मुख्यतः तराई क्षेत्र)।</li>
    <li><b>रुद्रपुर</b> नगर (आज ऊधम सिंह नगर जिले का मुख्यालय) रुद्रचंद के नाम पर बसा माना जाता है।</li>
    <li>विद्वत्ता — उन्हें <b>"धर्मनिर्णय"</b> नामक ग्रंथ का श्रेय दिया जाता है, जिसमें सामाजिक-धार्मिक व्यवस्था का वर्णन है।</li>
  </ul>
  <h3>लक्ष्मीचंद (1597–1621)</h3>
  <ul>
    <li>रुद्रचंद के पुत्र; गढ़वाल पर <b>बार-बार आक्रमण</b> किए, पर सफल नहीं हुए।</li>
    <li><b>1602 ई.</b> — बागेश्वर में <b>बागनाथ मंदिर</b> का निर्माण।</li>
  </ul>
  <p>लक्ष्मीचंद के बाद दिलीपचंद (1621–24), विजयचंद (1624–25) और त्रिमलचंद (1625–38) के समय दरबारी षड्यंत्र बढ़े।</p>
</section>

<section id="bazbahadur">
  <h2>बाज बहादुर चंद (1638–1678): चरम उत्कर्ष</h2>
  <p>त्रिमलचंद के दत्तक पुत्र <b>बाज बहादुर चंद</b> 1638 ई. में अल्मोड़ा के मल्ला महल में गद्दी पर बैठे। उनके समय चंद राज्य अपने सबसे बड़े विस्तार पर पहुँचा।</p>
  <ul>
    <li><span class="tag exam">परीक्षा बिंदु</span> <b>शाहजहाँ और "बहादुर" उपाधि</b> — तराई के कठेड़िया सरदारों की शिकायत लेकर वे शाहजहाँ के दरबार गए। <b>1654–55</b> के मुगल गढ़वाल अभियान में साथ दिया; वीरता पर शाहजहाँ ने <b>"बहादुर"</b> उपाधि और रत्नजड़ित खिलअत दी, और तराई की ज़मींदारी का फ़रमान मिला।</li>
    <li><b>विस्तार</b> — देहरादून सहित तराई का भाग गढ़वाल से अलग हुआ; पूर्व में राज्य <b>करनाली नदी</b> तक फैला।</li>
    <li><b>तिब्बत अभियान</b> — कैलास-मानसरोवर के तीर्थयात्रियों पर हमलों की खबर पर तिब्बती क्षेत्र में अभियान; <b>1670</b> में <b>तकलाकोट</b> का किला जीता। भोटिया व्यापारियों पर तिब्बती लगान रुकवाया और तीर्थयात्रियों के भोजन-आवास के लिए गाँवों का राजस्व लगाया।</li>
    <li><b>प्रति व्यक्ति कर</b> — 1672 ई. में एक poll-tax लगाया, जिसकी आय दिल्ली को नज़राने के रूप में भेजी जाती थी।</li>
    <li><b>नगर व मंदिर</b> — <b>बाजपुर</b> नगर बसाया; <b>भीमताल</b> में <b>भीमेश्वर महादेव</b> मंदिर बनवाया; जागेश्वर मंदिर पर ताम्रपत्र मढ़वाए।</li>
    <li><b>नंदा देवी</b> — गढ़वाल अभियान के बाद नंदा देवी की मूर्ति अल्मोड़ा लाकर मल्ला महल में स्थापित की। बाद में कुमाऊँ के कमिश्नर <b>जॉर्ज विलियम ट्रेल</b> ने इसे वर्तमान स्थान पर पहुँचाया।</li>
    <li><b>दरबार</b> — मुस्लिम दरबारों जैसी नौबत और चोबदार की प्रथा शुरू की। साल्ट के कत्यूरी किले को नष्ट कर साल्ट को कुमाऊँ में मिलाया।</li>
  </ul>
  <div class="box-myth"><strong><span class="tag myth">जनश्रुति</span></strong>भीमताल के पास <b>घोड़ाखाल</b> का <b>गोलू देवता मंदिर</b> बाज बहादुर चंद से जोड़ा जाता है — कथा के अनुसार गोलू उनकी सेना के एक वीर सेनापति थे, जो युद्ध में मारे गए।</div>
  <p>1678 ई. में वृद्धावस्था के कारण उन्होंने पुत्र <b>उद्योतचंद</b> के पक्ष में गद्दी छोड़ दी।</p>
</section>

<section id="baad">
  <h2>उद्योतचंद से कल्याणचंद तक</h2>
  <table>
    <thead><tr><th>राजा</th><th>शासनकाल</th><th>मुख्य तथ्य</th></tr></thead>
    <tbody>
      <tr><td><b>उद्योतचंद</b></td><td>1678–1698</td><td>गढ़वाल और डोटी पर विजयों की स्मृति में <b>1688</b> में अल्मोड़ा में <b>त्रिपुर सुंदरी</b>, <b>उद्योतचंदेश्वर</b> और <b>पार्वतेश्वर</b> मंदिर बनवाए।</td></tr>
      <tr><td><b>ज्ञानचंद (द्वितीय)</b></td><td>1698–1708</td><td>1699 में गढ़वाल (राजा फतेह शाह) पर आक्रमण।</td></tr>
      <tr><td><b>जगतचंद</b></td><td>1708–1720</td><td>गढ़वाल नरेश को हराकर <b>श्रीनगर</b> से हटाया; श्रीनगर एक ब्राह्मण को दे दिया।</td></tr>
      <tr><td><b>देवीचंद</b></td><td>1720–1726</td><td>अपने ही मंत्री के एजेंट द्वारा हत्या; इसके बाद <b>गैड़ा बिष्ट</b> भाइयों का प्रशासन पर नियंत्रण।</td></tr>
