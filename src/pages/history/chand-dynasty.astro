  { k: 'अंत', v: '<b>1790 ई.</b> — गोरखा आक्रमण; अंतिम राजा <b>महेंद्रचंद</b>' },
];

const faq = [
  { q: 'चंद राजवंश का संस्थापक कौन था और यह कब स्थापित हुआ?', a: 'सोमचंद, जो प्रयाग के पास गंगा पार झूसी से आए थे। डॉ. श्याम लाल (उत्तराखण्ड मुक्त विश्वविद्यालय की पुस्तक) के अनुसार वे 1019–20 ई. में आए, इसलिए चंद वंश की स्थापना 1020–25 ई. के बीच (सुविधा के लिए 1025 ई.) माननी चाहिए। परंपरागत वंशावलियाँ 685 या 700 ई. देती हैं, जो कत्यूरी कालक्रम से मेल नहीं खातीं।' },
  { q: 'राजधानी चंपावत से अल्मोड़ा किसने स्थानांतरित की?', a: 'भीष्मचंद ने 16वीं सदी में राजधानी अल्मोड़ा ले जाने का प्रयास किया, पर उसे स्थायी नहीं कर सके। उनके पुत्र बालो कल्याणचंद ने अल्मोड़ा को नई राजधानी के रूप में स्थापित किया और मणकोट को भी चंद राज्य में मिलाया। प्रचलित तिथि लगभग 1563 ई. है।' },
  { q: '"छत्तीसी" क्या थी?', a: 'चंद राजाओं के समय 36 प्रकार के राजकर होते थे, जिन्हें "छत्तीसी" कहा जाता था। मुख्य भूमि-कर उपज का छठा भाग था, जिसे "गल्ला छहाड़ा" कहते थे। अन्य करों में ज्यूलिया (पुल-कर), सिरती (नकद कर), कटक (सेना-कर), न्यौवाली (न्याय-कर) आदि थे।' },
  { q: 'न्यौवाली और बिष्टाली कचहरी में क्या अंतर था?', a: 'लक्ष्मीचंद के समय बनी "न्यौवाली" कचहरी आम जनता के न्याय के लिए थी, जबकि "बिष्टाली" केवल सैनिक मामलों के लिए। इसके अलावा "पंचनवीसी" (चारथान) नाम की पंचायती कचहरी भी थी।' },
  { q: 'नंदा देवी की मूर्ति अल्मोड़ा कौन लाया?', a: 'इस पर मत-भेद है। डॉ. श्याम लाल के अनुसार ज्ञानचंद 1699 ई. में बधानगढ़ जीतकर नंदा देवी की स्वर्ण-प्रतिमा अल्मोड़ा लाए। बद्रीदत्त पांडे पर आधारित विवरण इसका श्रेय बाज बहादुर चंद को देते हैं।' },
];

const sources = [
  { label: 'डॉ. श्याम लाल, "कुमाऊँ का चन्द राज्य वंश" — डॉ. अजय सिंह रावत (सं.), "उत्तराखण्ड का राजनीतिक इतिहास", उत्तराखण्ड मुक्त विश्वविद्यालय, अध्याय 2 (पुस्तक पृ. 43–81) — मुख्य स्रोत', url: 'https://uou.ac.in/' },
  { label: 'डॉ. पंकज प्रियदर्शी, "गोरखा शासन" — वही पुस्तक, अध्याय 4 (पृ. 149–150): 1790 का गोरखा आक्रमण' },
  { label: 'डॉ. हीरा सिंह भाकुनी, "चंद कालीन कुमाऊँ" — BAHI-302, उत्तराखण्ड मुक्त विश्वविद्यालय (खंड 4, इकाई 1)', url: 'https://elearning.uou.ac.in/pluginfile.php/424/mod_resource/content/1/BAHI302.pdf' },
  { label: 'चंपावत जिला प्रशासन (NIC) — History', url: 'https://champawat.nic.in/history/' },
  { label: 'Chand kings; Baz Bahadur Chand; Rohilla; Almora — Wikipedia (स्रोत: बद्रीदत्त पांडे, कृष्णपाल सिंह, Imperial Gazetteer 1909, अकबरनामा, आइन-ए-अकबरी)', url: 'https://en.wikipedia.org/wiki/Chand_kings' },
  { label: 'चित्र: Wikimedia Commons — WhiteRaven335 (CC BY-SA 4.0), Pranavspn (CC BY-SA 3.0), Ashwini Kesharwani (Public domain), John Edward Saché / British Library (Public domain)' },
];

const hero = '8/8c/Champawat_town.jpg';
const img = (w: number) => `https://upload.wikimedia.org/wikipedia/commons/thumb/${hero}/${w}px-${hero.split('/').pop()}`;
---
<HistoryChapter
  name="कुमाऊँ का चंद राजवंश" nameEn="Chand Dynasty of Kumaon" slug="chand-dynasty"
  sub="चंपावत से अल्मोड़ा तक — कर-व्यवस्था, प्रशासन और लगभग सात सौ वर्ष का कुमाऊँनी राज्य"
  title="चंद राजवंश (कुमाऊँ): सोमचंद, भारतीचंद, रुद्रचंद, बाज बहादुर, प्रशासन, छत्तीसी कर व 1790"
  description="कुमाऊँ का चंद राजवंश: सोमचंद, चंपावत से अल्मोड़ा राजधानी, रुद्रचंद-अकबर, बाज बहादुर चंद, प्रशासन, कर व्यवस्था और गोरखा आक्रमण।"
  image={img(1280)}
  heroSrcset={`${img(960)} 960w, ${img(1280)} 1280w`}
  imageAlt="पहाड़ियों के बीच बसा चंपावत नगर — चंदों की पहली राजधानी"
  heroCredit={{ text: 'चंपावत नगर — WhiteRaven335, CC BY-SA 4.0, Wikimedia Commons', url: 'https://commons.wikimedia.org/wiki/File:Champawat_town.jpg' }}
  published="2026-11-18" updated="2026-11-21" toc={toc} facts={facts} faq={faq} sources={sources}
>

<section id="sansthapak">
  <h2>सोमचंद और स्थापना-तिथि</h2>
  <p class="pull">कत्यूरी सत्ता के बिखरने के समय, जब कत्यूरी राजकुमार मणकोट, अस्कोट, डोटी, लखनपुर-बैराट और मानिला-सल्ट की ओर जा रहे थे, काली नदी के पास चंपावत में एक नया वंश जमा — चंद राजवंश।</p>
  <ul>
    <li><b>मूल:</b> चंद्रवंशी राजपूत, प्रयाग में गंगा पार <b>झूसी</b> के निवासी। कुमाऊँ में मूल पुरुष <b>सोमचंद</b> — उन्हीं के "चंद" नामांत को पूरे वंश ने अपनाया।</li>
    <li><b>आगमन:</b> उस समय कुमाऊँ में कत्यूरी नरेश <b>ब्रह्मदेव</b> का आधिपत्य था (टनकपुर-नेपाल के बीच <b>ब्रह्मदेव मंडी</b> उन्हीं से जुड़ी है)। उन्होंने अपनी एकमात्र पुत्री का विवाह सोमचंद से किया।</li>
    <li><b>राजधानी:</b> <b>चंपावत</b> — नाम <b>चंपावती देवी</b> से जुड़ा, जो डोटी के मल्ल राजाओं की इष्ट देवी थीं। चंद ताम्रपत्रों में राजधानी के लिए "बुंगा", "राजबुंगा", "राजपुर" और "राजधाई" शब्द मिलते हैं।</li>
  </ul>
  <h3>स्थापना-तिथि: मत-भेद</h3>
  <table>
    <thead><tr><th>तिथि</th><th>किसका मत</th></tr></thead>
    <tbody>
      <tr><td>685 ई. / 700 ई.</td><td>परंपरागत वंशावलियाँ; बद्रीदत्त पांडे (700 ई.) — कत्यूरी कालक्रम से टकराव</td></tr>
      <tr><td>953 ई.</td><td>चंपावत जिले का आधिकारिक इतिहास-विवरण</td></tr>
      <tr><td><b>1020–1025 ई.</b></td><td><b>डॉ. श्याम लाल (UOU पुस्तक)</b> — सोमचंद 1019–20 में महमूद गज़नवी के कन्नौज आक्रमण की उथल-पुथल में आए; सुविधा के लिए <b>1025 ई.</b> (कृष्णपाल सिंह का मत भी यही काल)</td></tr>
    </tbody>
  </table>
  <div class="box-myth"><strong><span class="tag myth">मत-भेद: थोहरचंद</span></strong>फ्रेज़र-हर्षदेव जोशी के विवरणों पर आधारित एक मत <b>थोहरचंद</b> को संस्थापक मानता है। पुस्तक के अनुसार थोहरचंद वास्तव में बाद के राजा थे, जो <b>1261 ई.</b> में गद्दी पर बैठे। परीक्षा में संस्थापक के लिए <b>सोमचंद</b> ही अपेक्षित उत्तर है।</div>
  <h3>सोमचंद की व्यवस्था</h3>
  <ul>
    <li>सोमचंद एक छोटे <b>मांडलिक राजा</b> थे और <b>डोटी</b> (नेपाल) के मल्लवंशी "रैका" राजा को कर देते थे।</li>
    <li>सबसे पहले <b>दोणकोट</b> के रावत राजा को हराया; ध्यानीरौ, चौभैंसी, सालम और रंगोड़ पट्टियाँ मिलाईं। वे <b>शिव के उपासक</b> थे।</li>
    <li><span class="tag exam">परीक्षा बिंदु</span> <b>चार किलेदार</b> — कार्की, बोरा, तड़ागी, चौधरी (मूलतः नेपाल के); इनके किले "<b>चार आल</b>" कहलाए — आज का "<b>चाराल</b>"।</li>
    <li><b>महरा</b> और <b>फर्त्याल</b> — दो प्रभावशाली धड़े; उन्हें मंत्री और सेनापति बनाया। आगे पूरा चंद दरबार इन्हीं दो "आलों" (दलों) पर टिका रहा।</li>
    <li>गाँवों में <b>बूढ़े</b> और <b>सयाने</b> नियुक्त किए — यही पुलिस का काम करते और लगान वसूल कर राजा तक पहुँचाते थे।</li>
    <li>शासनकाल लगभग <b>1025–1046 ई.</b></li>
  </ul>
</section>

<section id="champawat">
  <h2>चंपावत काल: डोटी की अधीनता से मुक्ति</h2>
  <ul>
    <li><b>आत्मचंद</b> (लगभग 20 वर्ष), <b>पूर्णचंद</b> (1066–1084), फिर <b>इंद्रचंद</b> — एटकिंसन के अनुसार इंद्रचंद ने मैदानों से <b>पट्टवाय</b> (रेशम बुनकर) बुलाकर <b>रेशम-उत्पादन</b> और रेशमी वस्त्र बनाना शुरू कराया; नेपाल के रास्ते चीन से व्यापार जुड़ा।</li>
    <li><b>वीणाचंद</b> — विलासी राजा; खस राजाओं ने सिर उठाया। 1191 ई. के बाद कुमाऊँ में डोटी (नेपाल) के "<b>चल्ल</b>" नामांत राजाओं के प्रमाण मिलते हैं:
      <ul>
        <li><b>अशोकचल्ल</b> — गोपेश्वर त्रिशूल लेख (1191 ई.)।</li>
        <li><b>क्राचल्लदेव</b> — चंपावत के बालेश्वर मंदिर से 1223 ई. का लेख, जिसमें 10 मांडलिक राजाओं के नाम हैं (कम से कम तीन चंदवंशी)।</li>
      </ul>
    </li>
    <li><b>वीरचंद</b> ने अशोकचल्ल की सहायता से विद्रोह शांत किया (मृत्यु लगभग 1206 ई.)। फिर नरचंद, <b>थोहरचंद</b> (1261 ई. से) और त्रिलोकचंद (मृत्यु 1303 ई.)।</li>
  </ul>
  <h3>प्रमुख राजा</h3>
  <table>
    <thead><tr><th>राजा</th><th>शासनकाल</th><th>मुख्य तथ्य</th></tr></thead>
    <tbody>
      <tr><td><b>गरुड़ ज्ञानचंद</b></td><td>1365–1420</td><td>दिल्ली सुल्तान <b>फ़िरोज़शाह तुगलक</b> के दरबार में भेंट लेकर जाने वाला <b>पहला चंद राजा</b>। सुल्तान ने <b>तराई</b> का क्षेत्र सौंपा और "<b>गरुड़</b>" उपाधि दी। <b>सोर</b> (पिथौरागढ़) का विजेता भी यही था। बाद में संभल के नवाब ने तराई छीन ली।</td></tr>
      <tr><td><b>विक्रमचंद</b></td><td>1423–1434</td><td>बालेश्वर मंदिर (1423) और चंपावत (1434) ताम्रपत्र।</td></tr>
      <tr><td><b>भारतीचंद</b></td><td>1437–1477</td><td><span class="tag exam">परीक्षा बिंदु</span> <b>डोटी की दासता से मुक्ति।</b> सभी जातियों की "कटक" (सेना) बनाई; <b>12 वर्ष</b> के घेरे के बाद मल्ल राजा हारा — लगभग <b>1451–52 ई.</b></td></tr>
      <tr><td><b>रत्नचंद</b></td><td>1477–1488</td><td>युवराज रहते पिता के साथ सोर, सीरा, थल, जुमला, बजांग की विजय में भाग लिया।</td></tr>
      <tr><td><b>कीर्तिचंद</b></td><td>1488–लगभग 1506</td><td>वृद्ध रत्नचंद के समय से ही शासन की बागडोर इन्हीं के हाथ में थी।</td></tr>
    </tbody>
  </table>
  <div class="box-trap"><strong><span class="tag trap">सावधान</span></strong>ज्ञानचंद का शासनकाल कुछ सूचियों में <b>1374–1419</b> भी मिलता है। एटकिंसन ने सुल्तान को मुहम्मद बिन तुगलक या दौलत खाँ लोदी माना था, पर पुस्तक <b>फ़िरोज़शाह तुगलक</b> लिखती है।</div>
  <div class="box-myth"><strong><span class="tag myth">जनश्रुति</span></strong>भारतीचंद के पंवाड़ों में कुमाऊँ की वीरांगना <b>भागा धौन्यान</b> के साथ उनके द्वंद्व-युद्ध का गुणगान होता है। पिथौरागढ़ में देवसिंह मैदान के पास का "<b>कटकू नौला</b>" उनकी सेना के पड़ाव का स्मारक माना जाता है।</div>
  <Figure file="8/8a/Baleshwar_temple%2C_champawat.JPG" alt="चंपावत के बालेश्वर मंदिर समूह का चौड़ा दृश्य" caption="बालेश्वर मंदिर समूह, चंपावत — यहीं से क्राचल्लदेव का 1223 ई. का लेख और विक्रमचंद का ताम्रपत्र मिला।" author="Pranavspn" license="CC BY-SA 3.0" w={960} />
</section>

<section id="almora">
  <h2>राजधानी अल्मोड़ा</h2>
  <ul>
    <li>कीर्तिचंद के बाद प्रतापचंद, ताराचंद, माणिकचंद, कल्याणचंद, पूर्णचंद और <b>भीष्मचंद</b> राजा हुए।</li>
    <li><b>भीष्मचंद</b> ने 16वीं सदी में राजधानी चंपावत से अल्मोड़ा ले जाने का प्रयास किया (नगर का आरंभिक नाम "<b>आलमनगर</b>"), पर इसे स्थायी नहीं कर पाए।</li>
    <li><span class="tag exam">परीक्षा बिंदु</span> उनके पुत्र <b>बालो कल्याणचंद</b> ने <b>अल्मोड़ा</b> को नई राजधानी के रूप में स्थापित किया (प्रचलित तिथि लगभग <b>1563 ई.</b>)।
      <ul>
        <li><b>मणकोट</b> राज्य को चंद राज्य में मिलाया; वहाँ के <b>उप्रेती</b> और <b>पंतों</b> को राज्य-कर्मचारी बनाकर अल्मोड़ा ले गए।</li>
        <li>चंपावत के झिझाड़, सेलाखोला आदि गाँवों के दीवान <b>जोशियों</b> को उन्हीं गाँव-नामों पर अल्मोड़ा में बसाया।</li>
        <li>सीरा के मल्ल राजा शोभामल्ल की पुत्री से विवाह किया।</li>
      </ul>
    </li>
  </ul>
  <div class="box-trap"><strong><span class="tag trap">सावधान</span></strong>बालो कल्याणचंद का शासनकाल पुस्तक में <b>1545–1565</b> (भेटा ताम्रपत्र, 1545 ई.) है, जबकि कई सूचियों में <b>1560–1568</b>। अल्मोड़ा की स्थापना की तिथि भी 1560, 1563 और 1568 — तीनों रूपों में मिलती है।</div>
  <Figure file="9/94/Almora%2C_1860s.jpg" alt="1860 के दशक का अल्मोड़ा नगर — पहाड़ी पर बसा पुराना शहर" caption="1860 के दशक का अल्मोड़ा — चंदों का राजधानी नगर, जहाँ उनका राजमहल (चौमहल) और मल्ला महल था।" author="John Edward Saché (British Library)" license="Public domain" orig narrow />
</section>

<section id="rudrachand">
  <h2>रुद्रचंद (1565–1597) और लक्ष्मीचंद (1597–1621)</h2>
  <h3>रुद्रचंद — अकबर के समकालीन</h3>
  <ul>
    <li>1565–87 तक स्वतंत्र राजा; <b>1587 के बाद अकबर की अधीनता</b> स्वीकार कर कुमाऊँ को करद-राज्य बनाया। अकबरनामा के अनुसार वे <b>लाहौर</b> में अकबर से मिले।</li>
    <li>हुसैन खाँ ने तराई पर कब्ज़ा किया था; रुद्रचंद ने तराई पर अधिकार कर <b>रुद्रपुर</b> नगर की स्थापना की। अकबर को तिब्बती याक, कस्तूरी, हिरन की खालें भेंट कीं; बादशाह ने "<b>चौरासी माल परगना</b>" का फ़रमान दिया और उन्हें "<b>ज़मींदार</b>" कहा। आइन-ए-अकबरी में "सरकार कुमाऊँ" के 21 महाल दर्ज हैं।</li>
    <li>अल्मोड़ा का <b>मल्ला महल</b> रुद्रचंद का बनवाया हुआ है।</li>
    <li><span class="tag exam">परीक्षा बिंदु</span> <b>"धर्म-निर्णय"</b> नामक पुस्तक लिखवाई — ब्राह्मणों के गोत्र और संबंध तय किए: ऊँचे <b>चौथानी</b>, उनसे नीचे <b>पचबिड़िये (तिथानी)</b>, फिर <b>हलिये/पितलिये</b>। गुरु, पुरोहित, वैद्य, सईस (बखरिया), टम्टा आदि पद निर्धारित किए।</li>
    <li><b>सीरा विजय</b> — रैका राजा <b>हरिमल्ल</b> को हराकर सीरा (डीडीहाट) चंद राज्य में मिलाया; इसकी स्मृति में <b>थल</b> में शिव मंदिर बनवाया। फलस्वरूप अस्कोट, दारमा और जोहार भी अधिकार में आए।</li>
  </ul>
  <div class="box-trap"><strong><span class="tag trap">सावधान</span></strong>सीरा-विजय की तिथि पुस्तक में <b>लगभग 1590 ई.</b> है, जबकि अन्य विवरणों में <b>1581 ई.</b> (उसी समय गढ़वाल पर असफल आक्रमण)।</div>
  <h3>लक्ष्मीचंद — प्रशासनिक सुधारक</h3>
  <ul>
    <li>रुद्रचंद के छोटे पुत्र; अन्य नाम — लछिमीचंद, लछिमन चंद। प्रशासन वास्तव में उनके जन्मांध बड़े भाई <b>शक्ति गुसाईं</b> चलाते थे।</li>
    <li>राजधानी में <b>बंदोबस्ती कार्यालय</b> बनाया; ज्यूला, सिरती, बैकर, रछया, कूत, भात, कनक आदि कर तय किए।</li>
    <li><span class="tag exam">परीक्षा बिंदु</span> दो कचहरियाँ — <b>न्यौवाली</b> (आम जनता के लिए) और <b>बिष्टाली</b> (केवल सैनिक मामलों के लिए)।</li>
    <li>राज्य-कर्मचारियों की तीन श्रेणियाँ — <b>सरदार</b> (परगने का शासक), <b>फ़ौजदार</b> (सेना अधिकारी), <b>नेगी</b> (छोटे कर्मचारी, "नेग" में अनाज)।</li>
    <li>नरसिंह बाड़ी, पांडे खोला, कबीना, लक्ष्मीश्वर जैसे बाग लगवाए। <b>1602 ई.</b> में बागेश्वर के <b>बागनाथ मंदिर</b> का <b>जीर्णोद्धार</b> किया (मूल मंदिर कत्यूरी कालीन)।</li>
    <li>गढ़वाल पर बार-बार आक्रमण किए, पर मुगलों के सामने झुके रहे — इसीलिए उपनाम "<b>लखुली बिराली</b>"। वाकियात-ए-जहाँगीरी के अनुसार जहाँगीर के दरबार में भी गए।</li>
  </ul>
  <div class="box-trap"><strong><span class="tag trap">सावधान</span></strong>बागनाथ मंदिर लक्ष्मीचंद ने <b>बनवाया नहीं</b>, उसका <b>जीर्णोद्धार</b> (1602) किया। विकल्प में "निर्माण" और "जीर्णोद्धार" दोनों हों तो दूसरा चुनें।</div>
  <p>इसके बाद <b>दिलीपचंद</b> (1621–24), <b>विजयचंद</b> (1625 में षड्यंत्र में मारे गए) और <b>त्रिमलचंद</b> (1625–1638) ने शासन किया।</p>
</section>

<section id="bazbahadur">
  <h2>बाज बहादुर चंद (1638–1678)</h2>
  <ul>
    <li><b>तराई की वापसी</b> — "नौलखिया माल" या "चौरासी माल" (तराई) पर कटेहरी राजपूतों का कब्ज़ा था, जहाँ से चंदों को सालाना लगभग <b>नौ लाख रुपये</b> मिलते थे। बाज बहादुर भेंट लेकर <b>शाहजहाँ</b> के पास गए।</li>
    <li><span class="tag exam">परीक्षा बिंदु</span> गढ़वाल-युद्ध में साथ देने पर शाहजहाँ ने "<b>बहादुर</b>" और "<b>ज़मींदार</b>" उपाधियाँ दीं; मुरादाबाद के सूबेदार <b>रुस्तम खाँ</b> की मदद से माल (तराई) वापस मिला। यादगार में <b>बाजपुर</b> नगर बसाया।</li>
    <li>औरंगज़ेब से भी मित्रता (1665–73); सुलेमान शिकोह को शरण नहीं दी, जो फिर गढ़वाल गया।</li>
    <li><b>मानिला-गढ़</b> से कत्यूरी कुँवरों को खदेड़ा, जो गढ़वाल की ओर लूटपाट करने लगे — इसी संघर्ष में गढ़वाल की वीरांगना <b>तीलू रौतेली</b> उभरीं (<a href="/history/parmar-dynasty/#vir">अगला अध्याय</a>)।</li>
    <li><b>कैलास-मानसरोवर</b> — 1673 ई. में यात्रियों के लिए "<b>गूंठ</b>" भूमि दान दी और भोजन-आवास के लिए पाँच गाँवों की मालगुजारी तय की। ब्यांस के दर्रों पर अधिकार कर भोटियों व हुणियों (तिब्बतियों) पर नकद कर "<b>सिरती</b>" लगाया। (बद्रीदत्त पांडे के अनुसार 1670 में तकलाकोट किला भी जीता।)</li>
    <li>दरबार को मुगल दरबार जैसा बनाया; पदों के नाम — <b>पनेरू</b> (पानी भरने वाला), <b>फुलेरिया</b>, <b>हरबोला</b>, <b>मठपाल</b> (मंदिर-रक्षक)।</li>
    <li><b>मंदिर</b> — थल (पिथौरागढ़) का "<b>एक हथिया देवाल</b>" (एक ही चट्टान से तराशा, एलोरा के कैलाश मंदिर जैसा); भीमताल का <b>भीमेश्वर महादेव</b> मंदिर।</li>
  </ul>
  <div class="box-myth"><strong><span class="tag myth">जनश्रुति</span></strong>भीमताल के पास <b>घोड़ाखाल</b> का <b>गोलू देवता मंदिर</b> बाज बहादुर से जोड़ा जाता है। पुस्तक के अनुसार कुमाऊँ के "गोरिल" (गोल/गोलू देवता) का मूल नेपाल है।</div>
</section>

<section id="utkarsh">
  <h2>उद्योतचंद से जगतचंद: स्वर्ण काल</h2>
  <h3>उद्योतचंद (1678–1698)</h3>
  <ul>
    <li>भारतीचंद के बाद नेपाल पर आक्रमण कर डोटी की ग्रीष्मकालीन राजधानी <b>अजमेरगढ़</b> (लगभग 1683) को ध्वस्त किया।</li>
    <li><b>1688</b> में डोटी का <b>खैरागढ़</b> जीता; संधि में डोटी नरेश ने कर देना स्वीकार किया। खुशी में अल्मोड़ा में महल और <b>त्रिपुर सुंदरी</b>, <b>पार्वतेश्वर</b>, <b>उद्योतचंदेश्वर</b> मंदिर बनवाए।</li>
    <li>1696 में डोटी ने कर बंद किया; तीसरे आक्रमण में जुराइल-दिपाइल कोट में कुमाऊँनी सेना हारी।</li>
  </ul>
  <h3>ज्ञानचंद (1698–1708)</h3>
  <ul>
    <li>पिंडर घाटी में थराली तक आक्रमण; <b>1699</b> में <b>बधानगढ़</b> जीता।</li>
  </ul>
  <div class="box-myth"><strong><span class="tag myth">मत-भेद: नंदा देवी की मूर्ति</span></strong>डॉ. श्याम लाल के अनुसार <b>ज्ञानचंद</b> 1699 में बधानगढ़ से <b>नंदा देवी की स्वर्ण-प्रतिमा</b> लाकर अल्मोड़ा के नंदा देवी मंदिर में स्थापित की। बद्रीदत्त पांडे पर आधारित विवरण इसका श्रेय <b>बाज बहादुर चंद</b> को देते हैं। उद्योतचंद का <b>पार्वतेश्वर</b> मंदिर 1760 में दीपचंदेश्वर कहलाया और आज के नंदा देवी मंदिर परिसर का हिस्सा है।</div>
  <h3>जगतचंद (1708–1720) — "कुमाऊँ का स्वर्ण काल"</h3>
  <ul>
    <li><span class="tag exam">परीक्षा बिंदु</span> विद्वान जगतचंद के काल को कुमाऊँ का <b>स्वर्ण काल</b> कहते हैं — तराई-भाबर से 9 लाख रुपये की आय इसी समय होती थी।</li>
    <li>लोहबागढ़ और बधानगढ़ जीतकर <b>श्रीनगर</b> पहुँचे; गढ़नरेश <b>फतेहशाह</b> हारकर चले गए और श्रीनगर पर जगतचंद का अधिकार हुआ (फतेहशाह ने बाद में उनके प्रतिनिधि को भगा दिया)।</li>
    <li>मुगल बादशाह बहादुरशाह को भेंटें भेजीं; बदले में फ़रमान और खिलअत मिली। जुआरियों पर कर लगाया; चेचक से मृत्यु।</li>
  </ul>
</section>

<section id="avnati">
  <h2>अवनति, रुहेला आक्रमण और अंत</h2>
  <ul>
    <li><b>देवीचंद</b> (1720–26) — चाटुकार पंडितों को दान में खजाना लुटाया; "<b>कुमाऊँ का मुहम्मद तुगलक</b>" कहलाए।</li>
    <li><b>कल्याणचंद</b> (1730–1747) — गद्दी खाली होने पर <b>अनूप सिंह तड़ागी</b> उन्हें <b>डोटी</b> से लाकर राजा बनाया। गद्दी पर बैठते ही मान गैड़ा और उसके पुत्र को मरवा दिया; अत्याचारी राजा माने जाते हैं।</li>
  </ul>
  <h3>रुहेला आक्रमण (1743–44)</h3>
  <ul>
    <li>रुहेलखंड (कटेहर) के सरदार <b>अली मोहम्मद खाँ</b> ने आक्रमण किया; उसी समय अवध के नवाब मंसूर अली खाँ (सफ़दरजंग) ने तराई के बिलारी-सरबना पर कब्ज़ा किया।</li>
    <li>भीमताल के नीचे <b>विजयपुर</b> (परगना छखाता) की लड़ाई में कुमाऊँनी सेना भाग खड़ी हुई; रुहेले रामगढ़-प्यूड़ा होते हुए <b>अल्मोड़ा</b> पहुँचे। कल्याणचंद गढ़वाल की ओर भागे।</li>
    <li>अल्मोड़ा में राजप्रासाद, कचहरी और <b>मंदिर तोड़े गए</b>; बहुत से लोगों को दास बनाकर मैदानों में भेजा गया।</li>
    <li>अन्य स्रोतों के अनुसार गढ़नरेश <b>प्रदीप शाह</b> ने सहायता दी; रुहेले लगभग सात महीने बाद धन लेकर लौटे और दूसरी बार <b>बाराखेड़ी</b> में हारे।</li>
  </ul>
  <h3>जोशी दीवान और गोरखा आक्रमण</h3>
  <ul>
    <li><b>दीपचंद</b> (1748–1777) — दीवान/बक्सी <b>शिवदेव जोशी</b> का प्रभाव; 1761 में पानीपत के तीसरे युद्ध में कुमाऊँनी टुकड़ी रुहेलों के साथ लड़ी। दीपचंद और उनके दो पुत्र अंततः <b>सीराकोट</b> के किले में मारे गए।</li>
    <li>फिर <b>मोहनचंद</b>, <b>प्रद्युम्नचंद</b> (गढ़नरेश प्रद्युम्न शाह), शिवचंद और अंतिम राजा <b>महेंद्रचंद</b> (1788–1790)। दरबार महरा-फर्त्याल गुटबंदी और जोशी दीवानों (शिवदेव, फिर <b>हर्षदेव/हरकदेव जोशी</b>) में उलझा रहा।</li>
  </ul>
  <div class="box-exam"><strong><span class="tag exam">1790: गोरखा आक्रमण</span></strong>
    <ul>
      <li><b>जनवरी 1790</b> — चौतरिया बहादुर शाह, काजी <b>जगजीत पांडे</b>, सेनापति <b>अमर सिंह थापा</b> और शूरवीर थापा के नेतृत्व में गोरखों ने काली नदी पार की — एक दल झूलाघाट-सोर-गंगोलीहाट होकर, दूसरा बिसुंग होकर अल्मोड़ा की ओर।</li>
      <li>महेंद्रचंद गंगोली की ओर बढ़े; चाचा <b>लाल सिंह</b> काली कुमाऊँ में <b>गैतोड़ा</b> (कटोलगढ़ के पास) में हारे। दोनों भागकर <b>कोटाबाग</b> पहुँचे।</li>
      <li><b>चैत्र कृष्ण प्रतिपदा, 1790</b> को गोरखों ने बिना प्रतिरोध अल्मोड़ा में प्रवेश किया; <b>हरकदेव जोशी</b> उनके साथ थे। कुमाऊँ में <b>गोरखा शासन 1790–1815</b> रहा।</li>
    </ul>
    परीक्षा-पुस्तकें इस निर्णायक हार को प्रायः "<b>हवालबाग का युद्ध (1790)</b>" कहती हैं; UOU पुस्तक में यह नाम नहीं, बल्कि ऊपर का विवरण है।</div>
</section>

<section id="prashasan">
  <h2>प्रशासन: मंडल से गाँव तक</h2>
  <p>चंद शासन एक तरह का <b>पंचायती राजतंत्र</b> था, पर निरंकुश राजतंत्र के उदाहरण भी मिलते हैं। राजा नाम के अंत में "<b>देव</b>" लगाते थे, सर्वोच्च न्यायाधीश थे और सारी भूमि के स्वामी थे — भूमि "<b>गूंठ</b>", "<b>संकल्प</b>" या "<b>रौत</b>" में केवल राजा या युवराज दे सकते थे।</p>
  <h3>दरबार</h3>
  <ul>
    <li><b>युवराज</b> — "महाराजकुमार" या "गुसाईं"; राजा के बाद सर्वोच्च सेनापति (रत्नचंद, त्रिमलचंद उदाहरण)। छोटे राजकुमार "कुँवर" / "गुसाईं"।</li>
    <li><b>दीवान</b> — प्रधानमंत्री, प्रायः <b>जोशी</b> (जयकृष्ण, शिवदेव, हरकदेव जोशी)। <b>बक्सी</b> — सेनापति। मंत्री और बक्सी वंश-परंपरागत।</li>
    <li>अधिकतम 10 सचिव — पुरोहित, गुरु, ज्योतिषी, भंडारी, प्रहरी, सेज्याली (राजा की निजी वस्तुओं का संरक्षक), चौधरी, सूत्रधार, बिष्ट।</li>
    <li>जिस "आल" (महरा या फर्त्याल) का बहुमत होता, उसी की इच्छा से दीवान और बक्सी चुने जाते।</li>
  </ul>
  <h3>शासन की इकाइयाँ</h3>
  <table>
    <thead><tr><th>इकाई</th><th>प्रमुख</th><th>टिप्पणी</th></tr></thead>
    <tbody>
      <tr><td><b>मंडल</b></td><td>सामंत (राजा/रजवार/ठक्कुर) या राजा</td><td>विजित राज्यों के पुराने शासकों को ही सामंत बनाया जाता</td></tr>
      <tr><td><b>देश</b></td><td>—</td><td>तल्ला देश, मल्ला देश, माल भाबर का देश, पर्वत डोटी का देश</td></tr>
      <tr><td><b>परगना</b></td><td><b>सीकदार / सीरदार</b> (नागरिक); <b>बक्सी</b> (सैनिक परगने)</td><td>काली कुमाऊँ, सोर, सीरा, फल्दाकोट, पाली पछाऊँ, कत्यूर आदि; तराई में "बगसी का परगना"</td></tr>
      <tr><td><b>गर्खा</b> (पट्टी)</td><td><b>नेगी</b></td><td>काली कुमाऊँ व माल में "पट्टी" कहलाता; "नेगी" पद-नाम था, जाति-नाम नहीं</td></tr>
      <tr><td><b>गाँव</b></td><td><b>सयाना / बूढ़ा</b>; उनसे छोटा <b>थोकदार</b></td><td>दारमा-जोहार में "बूढ़ा", पाली व सल्ट में "सयाना"; पंचायत का स्थान "बूढ़ा चौंरा"</td></tr>
    </tbody>
  </table>
  <ul>
    <li>गाँव में <b>पधान</b> (प्रधान) के अधीन <b>कोटाल</b> (लगान का हिसाब) और <b>पहरी</b> (चौकीदार, डाकिया; उपज का छठा भाग वसूलने वाला)।</li>
    <li>परगने के भंडार का प्रभारी <b>भंडारी</b>; अनाज राजधानी पहुँचाने वाले "<b>कैनी</b>" खस।</li>
  </ul>
  <h3>न्याय</h3>
  <ul>
    <li>कचहरियाँ — <b>न्यौवाली</b> (जनता), <b>बिष्टाली</b> (सैनिक मामले), <b>पंचनवीसी</b> या "चारथान" (पंचायती)।</li>
    <li>दंडाधिकारी — "<b>डंडै</b>"; फाँसी ऊँचे पहाड़ पर, जिसे "<b>शूली का डाणा</b>" कहा जाता। <b>सीराकोट</b> कुख्यात कारागार था।</li>
    <li>राजधानी में गुप्तचर प्रणाली — प्रायः राजवैद्य, परिव्राजक आदि जासूसी करते।</li>
  </ul>
</section>

<section id="kar">
  <h2>कर-व्यवस्था और भू-स्वामित्व</h2>
  <div class="box-exam"><strong><span class="tag exam">परीक्षा बिंदु</span></strong>चंद राजाओं के समय <b>36 प्रकार के राजकर</b> थे, जिन्हें "<b>छत्तीसी</b>" कहा जाता था। मुख्य भूमि-कर उपज का <b>छठा भाग</b> — "<b>गल्ला छहाड़ा</b>" — अनाज या नकद में।</div>
  <h3>प्रमुख कर</h3>
  <table>
    <thead><tr><th>कर</th><th>किस पर / किसके लिए</th></tr></thead>
    <tbody>
      <tr><td><b>ज्यूलिया</b> (सांगा)</td><td>नदी के पुलों पर</td></tr>
      <tr><td><b>सिरती</b></td><td>नकद कर — माल-भाबर और भोटिया व्यापारियों से</td></tr>
      <tr><td><b>रछया / राखिया</b></td><td>सावन में रक्षाबंधन-जनेऊ के समय</td></tr>
      <tr><td><b>कूत</b></td><td>नकद के बदले दिया गया अनाज</td></tr>
      <tr><td><b>मांगा</b></td><td>युद्ध के समय</td></tr>
      <tr><td><b>कटक</b></td><td>सेना के लिए</td></tr>
      <tr><td><b>कनक</b></td><td>शौका व्यापारियों से स्वर्ण-धूल</td></tr>
      <tr><td><b>सीकदार नेगी / गर्खा नेगी</b></td><td>परगना / गर्खा अधिकारी के लिए</td></tr>
      <tr><td><b>कमीनचारी-सयानचारी</b></td><td>लगान वसूलने वालों और सयानों के लिए</td></tr>
      <tr><td><b>खेनी-कपीलनी</b></td><td>कुली बेगार</td></tr>
      <tr><td><b>मौ-कर</b></td><td>हर परिवार पर</td></tr>
      <tr><td><b>टांड (तान)</b></td><td>सूती-ऊनी वस्त्रों के बुनकरों से</td></tr>
      <tr><td><b>न्यौवाली</b></td><td>न्याय पाने के लिए</td></tr>
      <tr><td><b>भाग</b></td><td>घराटों (पनचक्कियों) पर</td></tr>
      <tr><td><b>बखरिया / घोड़यालो / कुकुरयालो</b></td><td>राजा के सईस / घोड़ों / कुत्तों के लिए</td></tr>
    </tbody>
  </table>
  <h3>भू-स्वामित्व: चार वर्ग</h3>
  <table>
    <thead><tr><th>वर्ग</th><th>अर्थ</th></tr></thead>
    <tbody>
      <tr><td><b>थातवान</b></td><td>जिसे राजा ने रौत, गूंठ या विष्णुप्रीति में भूमि दी ("थात" = ज़मीन)</td></tr>
      <tr><td><b>खायकर</b></td><td>भूमि जोतने वाला, जो अनाज और नकद दोनों कर देता था</td></tr>
      <tr><td><b>सिरतान</b></td><td>केवल नकद कर देने वाला आसामी; थातवान उसे जब चाहे हटा सकता था</td></tr>
      <tr><td><b>कैनी</b></td><td>भू-दास जैसे खस किसान; दी गई भूमि पर नए थातवान के अधीन काम करते, अनाज और पालकी ढोते</td></tr>
    </tbody>
  </table>
  <p>घरेलू नौकर "<b>छ्यौड़ा</b>", दासियाँ "<b>छ्यौड़ी</b>"। <b>गूंठ</b> — मंदिरों की देखभाल के लिए पुजारियों को दी गई भूमि; <b>रौत</b> — बहादुरी का पुरस्कार।</p>
  <h3>भूमि-माप</h3>
  <ul>
    <li>इकाइयाँ — <b>नाली, ज्यूला, बीसी (विशा), अधाली, पालो, मसा</b>। बीस नाली लगभग एक एकड़; एक "बीसा" = 20 नाली।</li>
    <li>नाली दो तरह की थी — <b>कत्यूर</b> की बड़ी, <b>सोर</b> की उससे आधी। जॉन विकेट ने 1872 के बंदोबस्त में कत्यूर की नाली को पैमाना माना।</li>
  </ul>
  <p>👉 पुरानी इकाइयों को आज के माप में बदलें: <a href="/tools/nali-calculator/"><b>नाली कैलकुलेटर</b></a> • कत्यूरी काल की माप: <a href="/history/kartikeyapur-katyuri/#rajasv">द्रोणवाप और नाली</a>।</p>
</section>

<section id="samaj">
  <h2>समाज, मुद्रा और मंदिर</h2>
  <ul>
    <li><b>ब्राह्मणों के तीन वर्ग</b> — चौथानी, पचबिड़िया, और खस-ब्राह्मण ("पितलिया")। गढ़वाल में चौथानी जैसे वर्ग को "सरोला" कहते थे।</li>
    <li>आम जनता — "<b>पौरी पंद्रह बिस्वा</b>"। राजा ने काम के आधार पर जाति-नाम बना दिए — फुलेरिया, पनेरू, मठपाल, बखरिया, भंडारी आदि।</li>
    <li><b>जोशी</b> और <b>पंत</b> ब्राह्मण मूलतः महाराष्ट्र से (बनारस-नेपाल-डोटी होकर) आए। जोशी लेखक और ज्योतिषी भी थे।</li>
    <li><b>मुद्रा</b> — चंद राजाओं के <b>अपने सिक्के अभी तक नहीं मिले</b>; दिल्ली के सुल्तानों और मुगलों के सिक्के चलते थे। गढ़वाल में फतेपतिशाह, प्रदीप शाह और प्रद्युम्न शाह के सिक्के मिले हैं।</li>
    <li><b>ताम्रपत्र</b> — भाषा नेपाली-मिश्रित कुमाऊँनी (जन-भाषा)। हस्ताक्षर की जगह "सही" शब्द और <b>कटार की मूठ</b> का राज-चिह्न — यह चंदों की देन मानी जाती है। लेखक प्रायः जोशी ("जोइसी")।</li>
  </ul>
