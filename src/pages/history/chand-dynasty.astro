---
import HistoryChapter from '../../layouts/HistoryChapter.astro';
import Figure from '../../components/Figure.astro';
import Quiz from '../../components/Quiz.astro';
import questions from '../../data/quizzes/history-chand.json';

const toc = [
  { id: 'at-a-glance', label: 'एक नज़र में' },
  { id: 'parichay', label: 'कत्यूरियों के बाद कुमाऊँ' },
  { id: 'sansthapak', label: 'संस्थापक और स्थापना-तिथि: मत-भेद' },
  { id: 'champawat', label: 'चंपावत काल (राजबुंगा)' },
  { id: 'almora', label: 'राजधानी अल्मोड़ा' },
  { id: 'rudrachand', label: 'रुद्रचंद और मुगल संपर्क' },
  { id: 'bazbahadur', label: 'बाज बहादुर चंद: चरम उत्कर्ष' },
  { id: 'baad', label: 'उद्योतचंद से कल्याणचंद तक' },
  { id: 'rohilla', label: 'रुहेला आक्रमण (1743–44)' },
  { id: 'patan', label: 'जोशी गुट, गोरखा आक्रमण और अंत' },
  { id: 'prashasan', label: 'शासन और समाज' },
  { id: 'mandir', label: 'चंद कालीन मंदिर' },
  { id: 'samayrekha', label: 'समयरेखा' },
  { id: 'pariksha', label: 'परीक्षा बिंदु (One-liners)' },
  { id: 'quiz', label: 'क्विज़ (15 प्रश्न)' },
  { id: 'faq', label: 'FAQ' },
