const faq = [
  { q: 'क्या कार्तिकेयपुर राजवंश और कत्यूरी राजवंश एक ही हैं?', a: 'सामान्य उपयोग में हाँ — अधिकांश पुस्तकें इन्हें एक मानती हैं, क्योंकि राजधानी कार्तिकेयपुर कत्यूर घाटी में थी। पर इतिहासकार डॉ. यशवंत सिंह कटोच का मत है कि अभिलेखों में केवल "कार्तिकेयपुर" के राजा हैं; "कत्यूरी" नाम लोकगाथाओं से आया है और इसका प्रयोग पहली बार एटकिंसन ने किया।' },
  { q: 'कार्तिकेयपुर की राजधानी कहाँ थी?', a: 'पांडुकेश्वर ताम्रपत्रों में वर्णित स्थान जोशीमठ क्षेत्र में मिलते हैं, जबकि तालेश्वर ताम्रपत्रों के स्थान कत्यूर घाटी में। इसलिए माना जाता है कि राजधानी पहले जोशीमठ क्षेत्र में थी और बाद में कत्यूर घाटी (बैजनाथ, बागेश्वर) में आई। एपिग्राफ़िया इंडिका में कार्तिकेयपुर की पहचान बैजनाथ से की गई है।' },
  { q: 'कत्यूरी राजाओं के सबसे अधिक ताम्रपत्र किसके हैं?', a: 'ललितशूरदेव के। पांडुकेश्वर के योगबदरी मंदिर में रखे ताम्रपत्रों में उनके शासन के 21वें और 22वें वर्ष के लेख हैं। अभिलेखों में उन्हें "महाराजाधिराज" कहा गया है।' },
