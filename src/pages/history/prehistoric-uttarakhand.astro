const faq = [
  { q: 'उत्तराखंड में प्रागैतिहासिक शैलचित्र सबसे पहले कहाँ खोजे गए?', a: 'अल्मोड़ा जिले में सुयाल नदी के तट पर स्थित लखुडियार (लखु उड्यार) में, 1968 में डॉ. एम.पी. जोशी द्वारा। इसे उत्तराखंड के चित्रित शैलाश्रयों की पहली खोज माना जाता है।' },
