const faq = [
  { q: 'गोरखों ने कुमाऊँ पर कब और कैसे अधिकार किया?', a: 'जनवरी 1790 में गोरखा सेना ने काली नदी पार की। एक दल झूलाघाट-सोर-गंगोली की ओर से और दूसरा बिसुंग होकर अल्मोड़ा बढ़ा। चंद राजा महेंद्र चंद हारकर कोटाबाग (मैदान) की ओर भागे और 1790 के चैत्र मास में गोरखों ने बिना बड़े प्रतिरोध के अल्मोड़ा में प्रवेश किया। कुमाऊँ के दरबारी हर्षदेव जोशी इस समय गोरखों के साथ थे।' },
  { q: '"गोरख्याणी" किसे कहते हैं?', a: 'उत्तराखंड में 1790–1815 के गोरखा शासन को लोक-भाषा में "गोरख्याणी" कहा जाता है। यह शब्द आज भी अत्याचार, लूट, भारी कर और दास-प्रथा का पर्याय माना जाता है।' },
  { q: 'खलंगा (नालापानी) का युद्ध क्यों प्रसिद्ध है?', a: 'यह आंग्ल-गोरखा युद्ध (1814–16) का पहला युद्ध था। देहरादून के पास नालापानी की पहाड़ी पर बलभद्र थापा (कुँवर) के नेतृत्व में लगभग 600 गोरखा सैनिकों (महिलाओं-बच्चों सहित) ने 31 अक्टूबर से 30 नवंबर 1814 तक कहीं बड़ी अंग्रेज़ी सेना को रोके रखा। पहले ही दिन मेजर जनरल रॉलो जिलेस्पी मारा गया। अंग्रेज़ों ने बाद में यहाँ अपने शत्रु की वीरता के सम्मान में भी स्मारक बनाया — यह खलंगा युद्ध स्मारक आज भारतीय पुरातत्व सर्वेक्षण के संरक्षण में है।' },
  { q: 'सुगौली की संधि कब हुई — 1815 या 1816?', a: 'दोनों सही हैं। संधि पर 2 दिसंबर 1815 को सुगौली (बिहार) में हस्ताक्षर हुए — कंपनी की ओर से लेफ्टिनेंट कर्नल पेरिस ब्रैडशॉ और नेपाल की ओर से गुरु गजराज मिश्र व चंद्रशेखर उपाध्याय। नेपाल दरबार ने इसे टाल दिया, फिर मकवानपुर की हार के बाद 4 मार्च 1816 को अनुमोदन हुआ। इसके द्वारा काली नदी के पश्चिम का कुमाऊँ-गढ़वाल अंग्रेज़ों को मिला।' },
  { q: 'गोरखा न्याय में "दिव्य" क्या थे?', a: 'जहाँ गवाह या प्रमाण न मिले, वहाँ अग्नि-परीक्षा जैसे "दिव्य" से फैसला होता था — जैसे गोला दीप (गरम लोहे की छड़ लेकर चलना), कढ़ाई दीप (खौलते तेल में हाथ डालना), तराजू का दीप (शाम और सुबह का वज़न मिलाना)। देहरादून के गुरु रामराय दरबार के महंत हरसेवक को हत्या के एक आरोप में कढ़ाई दीप देना पड़ा था।' },
];

