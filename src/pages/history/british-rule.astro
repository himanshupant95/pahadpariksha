---
import HistoryChapter from '../../layouts/HistoryChapter.astro';
import Figure from '../../components/Figure.astro';
import Quiz from '../../components/Quiz.astro';
import questions from '../../data/quizzes/history-british.json';

const toc = [
  { id: 'at-a-glance', label: 'एक नज़र में' },
  { id: 'vibhajan', label: '1815 का बँटवारा' },
  { id: 'commissioner', label: 'कुमाऊँ के कमिश्नर' },
  { id: 'traill', label: 'ट्रेल: पटवारी और "अस्सी साला" बंदोबस्त' },
  { id: 'nonregulation', label: 'नॉन-रेगुलेशन प्रशासन और न्याय' },
  { id: 'jile', label: 'जिलों का बनना-बिगड़ना' },
  { id: 'van', label: 'वन नीति और जन-असंतोष' },
  { id: 'sena', label: 'गढ़वाल राइफल्स और लैंसडाउन' },
  { id: 'shiksha', label: 'हिल स्टेशन, शिक्षा और प्रेस' },
  { id: 'tehri', label: 'टिहरी रियासत (1815–1949)' },
  { id: 'tehri-prashasan', label: 'टिहरी का प्रशासन' },
  { id: 'samayrekha', label: 'समयरेखा' },
  { id: 'pariksha', label: 'परीक्षा बिंदु (One-liners)' },
  { id: 'quiz', label: 'क्विज़ (15 प्रश्न)' },
  { id: 'faq', label: 'FAQ' },
];

const facts = [
  { k: 'अवधि', v: '<b>1815–1947</b> (ब्रिटिश कुमाऊँ-गढ़वाल) · टिहरी रियासत <b>1815–1949</b>' },
  { k: 'पहले कमिश्नर', v: '<b>एडवर्ड गार्डनर</b> — 3 मई 1815; सहायक <b>जी. डब्ल्यू. ट्रेल</b>' },
  { k: 'शासन का स्वरूप', v: '<b>नॉन-रेगुलेशन</b> — कमिश्नर ही राजस्व, दीवानी और फौजदारी का सर्वेसर्वा' },
  { k: 'तीन युग (व्हॉली)', v: '<b>ट्रेल</b> → <b>बैटन</b> → <b>रैमजे</b>' },
  { k: 'पटवारी', v: '<b>1819</b> में ट्रेल ने 9 पद बनाए — राजस्व के साथ पुलिस अधिकार (राजस्व पुलिस)' },
  { k: 'भू-बंदोबस्त', v: '<b>"अस्सी साला"</b> — संवत् 1880 (1823 ई.), ट्रेल' },
  { k: 'नए जिले', v: 'गढ़वाल (1839–40), देहरादून (11 जुलाई 1871), नैनीताल (13 अक्टूबर 1891)' },
  { k: 'टिहरी रियासत', v: '<b>सुदर्शन शाह</b> — राजधानी टिहरी (28 दिसंबर 1815); भारत में विलय <b>1 अगस्त 1949</b>' },
];

const faq = [
  { q: 'कुमाऊँ का पहला ब्रिटिश कमिश्नर कौन था?', a: 'एडवर्ड गार्डनर, जिन्हें 3 मई 1815 को "कुमाऊँ मामलों का कमिश्नर और गवर्नर जनरल का एजेंट" नियुक्त किया गया; जी. डब्ल्यू. ट्रेल उनके सहायक बने। गार्डनर नेपाल के राजनीतिक कामों में व्यस्त रहे, इसलिए असली प्रशासन ट्रेल ने चलाया, जो 1817 से 1835 तक कमिश्नर रहे।' },
  { q: '"अस्सी साला बंदोबस्त" क्या है?', a: 'कमिश्नर ट्रेल का भू-बंदोबस्त, जो विक्रम संवत् 1880 (1823 ई.) में हुआ — इसलिए "अस्सी साला" या "साल अस्सी" कहलाया। इसमें गाँवों की सीमाएँ पहली बार सरकारी अभिलेखों में दर्ज हुईं; यह नाप-जोख पर आधारित वास्तविक सर्वे नहीं था, बल्कि प्राकृतिक चिह्नों के आधार पर भूमि का निर्धारण था।' },
  { q: 'उत्तराखंड में पटवारी के पास पुलिस अधिकार क्यों हैं?', a: 'कुमाऊँ के मैदानी जिलों जैसा पटवारी पद नहीं था। ट्रेल ने 1819 में नौ पटवारी पद बनाए, जिनके पास राजस्व के साथ पुलिस के अधिकार भी थे। 1898 की दंड प्रक्रिया संहिता के अंतर्गत कानूनगो को पुलिस इंस्पेक्टर और पटवारी को सब-इंस्पेक्टर के अधिकार मिले। यही "राजस्व पुलिस" व्यवस्था पहाड़ी क्षेत्रों में लंबे समय तक चली।' },
  { q: 'टिहरी रियासत कब और कैसे बनी?', a: 'आंग्ल-गोरखा युद्ध के बाद अंग्रेज़ों ने पूर्वी गढ़वाल और देहरादून अपने पास रखे, और अलकनंदा-मंदाकिनी के पश्चिम का गढ़वाल प्रद्युम्नशाह के पुत्र सुदर्शन शाह को लौटाया। उन्होंने भागीरथी-भिलंगना संगम पर टिहरी को 28 दिसंबर 1815 को राजधानी बनाया। यह रियासत 1 अगस्त 1949 को भारत में विलीन होकर उत्तर प्रदेश का टिहरी गढ़वाल जिला बनी।' },
  { q: 'देहरादून अलग जिला कब बना?', a: '1815 में दून को सहारनपुर जिले से जोड़ा गया, 1825 में कुमाऊँ मंडल में और 1829 में मेरठ मंडल में स्थानांतरित किया गया। 1842 में यह फिर सहारनपुर के कलेक्टर के अधीन एक अधीक्षक के पास गया। देहरा दून एक्ट, 1871 (11 जुलाई 1871) के बाद से यह अलग जिले के रूप में प्रशासित हुआ।' },
];

const sources = [
  { label: 'डॉ. आर. एस. टोलिया, "प्रशासनिक नवाचारों की प्रयोगशाला: उत्तराखण्ड (1815–1949)"; डॉ. अजय सिंह रावत, "सन् 1815 के पश्चात् गढ़नरेश" व "ब्रिटिश गढ़वाल: एक सिंहावलोकन" — "उत्तराखण्ड का राजनीतिक इतिहास", उत्तराखण्ड मुक्त विश्वविद्यालय (अध्याय 5–7) — मुख्य संदर्भ ग्रंथ', url: 'https://uou.ac.in/' },
  { label: 'इलाहाबाद उच्च न्यायालय — "A Historical Retrospect of the Administration of Justice in Kumaun" (गार्डनर, ट्रेल, Act X 1838, 1864 अधिनियम, नैनीताल जिला 1891, कमिश्नर हाईकोर्ट 1894)', url: 'https://allahabadhighcourt.in/event/AHistoricalRetrospectAdministrationNDPant.html' },
  { label: 'देहरादून जिला प्रशासन (NIC) — History (1815, 1825, 1829, 1842, 1871)', url: 'https://dehradun.nic.in/history/' },
  { label: 'India Code — The Dehra Dun Act, 1871 (Act No. 21 of 1871, 11 जुलाई 1871)', url: 'https://indiacode.nic.in/bitstream/123456789/19098/1/a1871-21.pdf' },
  { label: 'टिहरी गढ़वाल जिला प्रशासन (NIC) — इतिहास', url: 'https://tehri.nic.in/?p=2733' },
  { label: 'GOV.UK — WW1 Indian VC recipient Darwan Singh Negi (case study)', url: 'https://www.gov.uk/government/case-studies/ww1-indian-vc-recipient-darwan-singh-negi' },
  { label: 'चित्र: Wikimedia Commons — Dibendu Nandi (CC BY-SA 4.0); John Edward Saché / British Library (Public domain); Illustrated War News, 1914 (Public domain)' },
];

const hero = 'e/e3/Royal_Palace_of_Narendra_Nagar%2C_Uttarakhand_WTK20150913-DSC00029.jpg';
const img = (w: number) => `https://upload.wikimedia.org/wikipedia/commons/thumb/${hero}/${w}px-${hero.split('/').pop()}`;
---
<HistoryChapter
  name="ब्रिटिश कुमाऊँ-गढ़वाल और टिहरी रियासत" nameEn="British Kumaon-Garhwal and Tehri State" slug="british-rule"
  sub="गार्डनर-ट्रेल से रैमजे तक, अस्सी साला बंदोबस्त, पटवारी, वन कानून, गढ़वाल राइफल्स — और टिहरी के राजा"
  title="ब्रिटिश कुमाऊँ-गढ़वाल व टिहरी रियासत (1815–1949): कमिश्नर, बंदोबस्त, पटवारी, वन नीति, टिहरी के राजा"
  description="उत्तराखंड में ब्रिटिश शासन और टिहरी रियासत: गार्डनर, ट्रेल, बैटन, रैमजे; अस्सी साला बंदोबस्त, पटवारी 1819, वन नीति और गढ़वाल राइफल्स।"
  image={img(1280)}
  heroSrcset={`${img(960)} 960w, ${img(1280)} 1280w`}
  imageAlt="नरेंद्रनगर में टिहरी नरेशों का राजमहल"
  heroCredit={{ text: 'नरेंद्रनगर का राजमहल (टिहरी रियासत की अंतिम राजधानी) — Dibendu Nandi, CC BY-SA 4.0, Wikimedia Commons', url: 'https://commons.wikimedia.org/wiki/File:Royal_Palace_of_Narendra_Nagar,_Uttarakhand_WTK20150913-DSC00029.jpg' }}
  published="2026-11-19" toc={toc} facts={facts} faq={faq} sources={sources}
>

<section id="vibhajan">
  <h2>1815 का बँटवारा</h2>
  <p class="pull">गोरखों के जाने के बाद उत्तराखंड तीन हिस्सों में बँटा — अंग्रेज़ों का सीधा शासन वाला कुमाऊँ और पूर्वी गढ़वाल, मैदान से जुड़ा देहरादून, और पुराने परमार वंश को लौटाया गया पश्चिमी गढ़वाल, जो टिहरी रियासत बना। यही बँटवारा 1949 तक चला।</p>
  <table>
    <thead><tr><th>भाग</th><th>किसके पास</th><th>बाद में</th></tr></thead>
    <tbody>
      <tr><td><b>कुमाऊँ + पूर्वी (ब्रिटिश) गढ़वाल</b></td><td>कंपनी — "कुमाऊँ कमिश्नरी"</td><td>कुमाऊँ मंडल; आज के कुमाऊँ के 6 जिले और पौड़ी, चमोली, रुद्रप्रयाग का अधिकांश</td></tr>
      <tr><td><b>देहरादून</b></td><td>कंपनी — पहले सहारनपुर से जुड़ा</td><td>1871 से अलग जिला; मेरठ मंडल में</td></tr>
      <tr><td><b>पश्चिमी गढ़वाल</b> (अलकनंदा-मंदाकिनी के पश्चिम)</td><td>राजा <b>सुदर्शन शाह</b></td><td>टिहरी रियासत; 1949 में टिहरी गढ़वाल जिला (उत्तरकाशी 1960 में अलग)</td></tr>
    </tbody>
  </table>
  <div class="box-myth"><strong><span class="tag myth">मत-भेद: पूर्वी गढ़वाल क्यों रखा?</span></strong>लोकप्रिय कथन है कि सुदर्शन शाह युद्ध का ख़र्च (लगभग 7 लाख रुपये) नहीं चुका सके, इसलिए अंग्रेज़ों ने पूर्वी गढ़वाल अपने पास रख लिया। ए.आर. गिल की "वैली ऑफ़ दून" में सुदर्शन शाह द्वारा दून का परगना हियरसी को बेचने की कहानी भी मिलती है — पर UOU पुस्तक और "द हियरसेज़" (कर्नल ह्यू पीयर्स) इसे अविश्वसनीय मानते हैं।</div>
</section>

<section id="commissioner">
  <h2>कुमाऊँ के कमिश्नर</h2>
  <table>
    <thead><tr><th>कमिश्नर</th><th>कार्यकाल (लगभग)</th><th>पहचान</th></tr></thead>
    <tbody>
      <tr><td><b>एडवर्ड गार्डनर</b></td><td>3 मई 1815 से</td><td>पहला कमिश्नर व गवर्नर जनरल का एजेंट; 1816 में नेपाल में पहले ब्रिटिश रेज़िडेंट</td></tr>
      <tr><td><b>जॉर्ज विलियम ट्रेल</b></td><td>1815 (सहायक) · 1817–1835 (कमिश्नर)</td><td>ब्रिटिश प्रशासन की असली नींव — पटवारी, बंदोबस्त, सड़कें-पुल</td></tr>
      <tr><td>कर्नल <b>जॉर्ज गोवान</b></td><td>1836–1838</td><td>अनुभवहीन; राजस्व बोर्ड ने कड़ी आलोचना की</td></tr>
      <tr><td><b>जे. एच. लुशिंगटन</b></td><td>1838–1848</td><td>नई राजस्व-दीवानी-फौजदारी व्यवस्था लागू; बैटन के बंदोबस्त की अपीलें सुनीं</td></tr>
      <tr><td><b>जे. एच. बैटन</b></td><td>1848–1856</td><td>पहले गढ़वाल, फिर कुमाऊँ का नियमित बंदोबस्त (1833 के रेगुलेशन के तहत)</td></tr>
      <tr><td>सर <b>हेनरी रैमजे</b></td><td>1856–1884</td><td>"कुमाऊँ का राजा" कहलाए; 1857 में मार्शल लॉ, वन संरक्षण, शिक्षा-अस्पताल</td></tr>
    </tbody>
  </table>
  <div class="box-exam"><strong><span class="tag exam">परीक्षा बिंदु</span></strong> विधिवेत्ता <b>व्हॉली</b> ("Law of Non-Regulation Provinces") ने कुमाऊँ के प्रशासनिक इतिहास को तीन युगों में बाँटा — <b>ट्रेल का कुमाऊँ</b> (पितृसत्तात्मक, निरंकुश पर न्यायप्रिय), <b>बैटन का कुमाऊँ</b> (नियमों का युग) और <b>रैमजे का कुमाऊँ</b> (दोनों का मेल)।</div>
</section>

<section id="traill">
  <h2>ट्रेल: पटवारी और "अस्सी साला" बंदोबस्त</h2>
  <ul>
    <li>ट्रेल ने स्थानीय परंपराओं को आधार बनाकर कुमाऊँ को <b>26 परगनों</b> में बाँटा और 1815 से 1833 के बीच <b>सात भू-बंदोबस्त</b> पूरे किए — जबकि शेष संयुक्त प्रांत में नियमित बंदोबस्त 1833 के रेगुलेशन से शुरू हुए।</li>
    <li><span class="tag exam">परीक्षा बिंदु</span> <b>संवत् 1880 (1823 ई.)</b> का बंदोबस्त — गाँवों की सीमाएँ पहली बार सरकारी अभिलेखों में; लोक-नाम <b>"अस्सी साला"</b> / "साल अस्सी"। यह नाप-जोख वाला सर्वे नहीं, प्राकृतिक चिह्नों से सीमा-निर्धारण ("नज़रअंदाज़ी") था।</li>
    <li><span class="tag exam">परीक्षा बिंदु</span> <b>1819</b> — नॉनकर भूमि से हुई बचत से ट्रेल ने <b>9 पटवारी पद</b> बनाए। पटवारी राजस्व वसूली के साथ अपराध की रिपोर्ट और गिरफ़्तारी भी करता था — यही आगे चलकर <b>"राजस्व पुलिस"</b> बनी।</li>
    <li>गाँव में <b>पधान</b>, उससे ऊपर <b>थोकदार/सयाना</b> — पुरानी व्यवस्था बनी रही; थोकदारों के दुरुपयोग पर रैमजे ने बाद में उन्हें हटाने की सिफ़ारिश की।</li>
    <li><b>1829–30</b> से नदियों पर लोहे के <b>झूला पुल</b>; बद्रीनाथ-केदारनाथ यात्रा मार्ग पर विशेष ध्यान। 1824 में यहाँ आए <b>बिशप हीबर</b> ने लिखा कि ट्रेल लगभग पूरे वर्ष दौरे पर रहते थे।</li>
    <li>पहाड़ के लोग विवाद निपटाते समय कहते थे — "ट्रेल के ज़माने में ऐसा होता था" — यह उनकी लोकप्रियता का प्रमाण माना जाता है।</li>
  </ul>
  <h3>बाद के बंदोबस्त</h3>
  <table>
    <thead><tr><th>बंदोबस्त</th><th>वर्ष</th><th>विशेषता</th></tr></thead>
    <tbody>
      <tr><td>ट्रेल ("अस्सी साला")</td><td>1823</td><td>गाँव-सीमाओं का पहला अभिलेख</td></tr>
      <tr><td>बैटन</td><td>1840 का दशक</td><td>1833 के रेगुलेशन के तहत पहला नियमित बंदोबस्त — पहले गढ़वाल, फिर कुमाऊँ</td></tr>
      <tr><td>बैकेट</td><td>1856–1861 (गढ़वाल)</td><td>खसरा नाप से पहला वास्तविक सर्वे</td></tr>
      <tr><td>पौ (E. K. Pauw)</td><td>1890 का दशक (गढ़वाल)</td><td>जोतों में वृद्धि की जाँच; विस्तृत रिपोर्ट</td></tr>
    </tbody>
  </table>
  <Figure file="9/94/Almora%2C_1860s.jpg" alt="1860 के दशक का अल्मोड़ा नगर" caption="1860 के दशक का अल्मोड़ा — कुमाऊँ कमिश्नरी का मुख्यालय। 1816 में यहीं पहली जेल बनी।" author="John Edward Saché (British Library)" license="Public domain" orig narrow />
</section>

<section id="nonregulation">
  <h2>नॉन-रेगुलेशन प्रशासन और न्याय</h2>
  <p>कुमाऊँ <b>"नॉन-रेगुलेशन"</b> क्षेत्र था — बंगाल के रेगुलेशन यहाँ स्वतः लागू नहीं होते थे। कमिश्नर एक साथ कलेक्टर, जज और मजिस्ट्रेट था; 1829 तक पूरे कुमाऊँ में दीवानी का एकमात्र न्यायालय कमिश्नर का ही था।</p>
  <table>
    <thead><tr><th>वर्ष</th><th>न्याय-व्यवस्था में परिवर्तन</th></tr></thead>
    <tbody>
      <tr><td>1817</td><td><b>रेगुलेशन X, 1817</b> — कुमाऊँ के अधिकारियों को फौजदारी अधिकार; हत्या जैसे मामले विशेष कमिश्नर के लिए</td></tr>
      <tr><td>1829</td><td>पहला <b>मुंसिफ़</b>; सात कानूनगो को मुंसिफ़ के अधिकार</td></tr>
      <tr><td>1838</td><td><b>एक्ट X, 1838</b> — गढ़वाल को कुमाऊँ से अलग किया, तराई जिला बनाया; मामले निज़ामत व सदर दीवानी अदालत के अधीन</td></tr>
      <tr><td>1839</td><td>संशोधित <b>"असम रूल्स"</b> लागू</td></tr>
      <tr><td>1863–64</td><td>"झाँसी रूल्स"; <b>नॉन-रेगुलेशन डिस्ट्रिक्ट्स एक्ट, 1864</b> से नियमों को वैधानिक आधार</td></tr>
      <tr><td>1874</td><td><b>शेड्यूल्ड डिस्ट्रिक्ट्स एक्ट</b> — कुमाऊँ पर कौन-से कानून लागू हों, यह सरकार तय करती (1935 में निरस्त)</td></tr>
      <tr><td>27 जून 1894</td><td>कुमाऊँ कमिश्नर को कुमाऊँ का <b>"हाईकोर्ट"</b> बनाया गया</td></tr>
      <tr><td>1898</td><td>दंड प्रक्रिया संहिता — कानूनगो को इंस्पेक्टर व पटवारी को सब-इंस्पेक्टर के पुलिस अधिकार</td></tr>
    </tbody>
  </table>
  <div class="box-exam"><strong><span class="tag exam">परीक्षा बिंदु</span></strong> 1817 में <b>पत्नी के साथ व्यभिचारी को मार डालने</b> की पति की पुरानी "छूट" अंग्रेज़ों ने समाप्त की। जेल — <b>अल्मोड़ा 1816</b>, <b>पौड़ी 1850</b>।</div>
</section>

<section id="jile">
  <h2>जिलों का बनना-बिगड़ना</h2>
  <ol class="timeline">
    <li><span class="yr">1815</span><span class="ev">दून सहारनपुर जिले में; कुमाऊँ और ब्रिटिश गढ़वाल एक कमिश्नरी।</span></li>
    <li><span class="yr">1825</span><span class="ev">देहरादून कुमाऊँ मंडल में स्थानांतरित।</span></li>
    <li><span class="yr">1829</span><span class="ev">देहरादून कुमाऊँ से मेरठ मंडल में।</span></li>
    <li><span class="yr">1838–39</span><span class="ev">एक्ट X, 1838 — गढ़वाल अलग जिला (वरिष्ठ सहायक कमिश्नर के अधीन, कुमाऊँ कमिश्नर के नियंत्रण में); तराई जिला बना।</span></li>
    <li><span class="yr">1840</span><span class="ev">गढ़वाल जिले का मुख्यालय श्रीनगर से <b>पौड़ी</b>।</span></li>
    <li><span class="yr">1842</span><span class="ev">दून फिर सहारनपुर कलेक्टर के अधीन एक अधीक्षक के पास; तराई कुमाऊँ कमिश्नरी के अधीन।</span></li>
    <li><span class="yr">11 जुलाई 1871</span><span class="ev">देहरा दून एक्ट, 1871 — देहरादून अलग जिला।</span></li>
    <li><span class="yr">13 अक्टूबर 1891</span><span class="ev"><b>नैनीताल जिला</b> बना; कुमाऊँ जिले का नाम अल्मोड़ा। कुमाऊँ मंडल में अल्मोड़ा, नैनीताल, गढ़वाल।</span></li>
  </ol>
  <div class="box-trap"><strong><span class="tag trap">सावधान</span></strong>देहरादून कभी कुमाऊँ में, कभी मेरठ और कभी सहारनपुर के साथ रहा — पर <b>टिहरी रियासत</b> का हिस्सा कभी नहीं बना। रवाईं परगना 1815–1824 तक अंग्रेज़ों के पास रहकर <b>1824</b> में टिहरी को दिया गया।</div>
</section>

<section id="van">
  <h2>वन नीति और जन-असंतोष</h2>
  <ul>
    <li><b>1823</b> — ट्रेल के बंदोबस्त में गाँवों के चराई और लकड़ी के अधिकार दर्ज; जंगल को गाँव की संपत्ति जैसा माना गया।</li>
    <li><b>1856–1859</b> — रैमजे ने रेल-स्लीपरों के लिए हो रहे अंधाधुंध कटान पर रोक और वन संरक्षण के क़दम उठाए; बाद में वन विभाग बना।</li>
    <li><b>1878</b> — भारतीय वन अधिनियम; <b>1893</b> — बिना नापी "बंजर" भूमि को सरकारी (संरक्षित) वन घोषित किया गया।</li>
    <li><b>1911–1917</b> — वन बंदोबस्त; बड़े क्षेत्र <b>आरक्षित वन</b> बने, चराई-लकड़ी के अधिकार घटे। 1910–11 के नैनीताल वन सम्मेलन के बाद वन भूमि की नाप पटवारी से हटाकर वन अधिकारी को दी गई।</li>
    <li>असंतोष का परिणाम — 1916–21 में जंगलों में आग, बेगार-विरोध और फिर <b>कुमाऊँ फ़ॉरेस्ट ग्रीवेंसेज़ कमेटी (1921)</b>; इसके बाद <b>1931</b> में <b>वन पंचायत नियमावली</b> से गाँवों को सामुदायिक वन प्रबंधन का अधिकार।</li>
  </ul>
  <div class="box-exam"><strong><span class="tag exam">परीक्षा बिंदु</span></strong> उत्तराखंड की <b>वन पंचायतें</b> (1931) ब्रिटिश वन नीति के विरुद्ध हुए किसान प्रतिरोध की देन हैं — यही परंपरा आगे <b>चिपको</b> (1973–74) तक दिखती है।</div>
</section>

<section id="sena">
  <h2>गढ़वाल राइफल्स और लैंसडाउन</h2>
  <ul>
    <li>गढ़वालियों की अलग बटालियन <b>1887</b> में अल्मोड़ा में बनी (39वीं गढ़वाल रेजिमेंट) और <b>नवंबर 1887</b> में <b>कालूडांडा</b> पहुँची — जिसका नाम वायसराय <b>लॉर्ड लैंसडाउन</b> के नाम पर <b>लैंसडाउन</b> रखा गया।</li>
    <li>प्रथम विश्व युद्ध में फ़्रांस में दो <b>विक्टोरिया क्रॉस</b>:
      <ul>
        <li><span class="tag exam">परीक्षा बिंदु</span> नायक <b>दरबान सिंह नेगी</b> (1/39 गढ़वाल राइफल्स) — <b>23–24 नवंबर 1914</b>, फ़ेस्टूबर्ट; सिर और बाँह में घाव के बावजूद खाइयाँ वापस लीं। दिसंबर 1914 में किंग जॉर्ज पंचम ने युद्ध-क्षेत्र में स्वयं VC दिया। लैंसडाउन का रेजिमेंटल संग्रहालय "<b>दरबान सिंह संग्रहालय</b>" कहलाता है।</li>
        <li>राइफलमैन <b>गब्बर सिंह नेगी</b> (2/39 गढ़वाल राइफल्स) — <b>10 मार्च 1915</b>, न्यूव शैपल; मरणोपरांत VC। चंबा (टिहरी) में हर वर्ष अप्रैल में उनकी स्मृति में मेला।</li>
      </ul>
    </li>
    <li>युद्ध में वीरता के लिए रेजिमेंट को <b>"रॉयल"</b> उपाधि (1921) — "रॉयल गढ़वाल राइफल्स"; उसी वर्ष लैंसडाउन में रेजिमेंटल सेंटर।</li>
  </ul>
  <Figure file="8/88/Illustrated_War_News%2C_Dec._23%2C_1914%2C_page_38%2C_left_side_-_Darwan_Sing_Negi.jpg" alt="घायल नायक दरबान सिंह नेगी को स्ट्रेचर पर ब्राइटन के रॉयल पवेलियन अस्पताल में ले जाते सैनिक" caption="घायल दरबान सिंह नेगी को ब्राइटन के रॉयल पवेलियन (तब भारतीय सैनिकों का अस्पताल) में ले जाते हुए — द इलस्ट्रेटेड वॉर न्यूज़, 23 दिसंबर 1914।" author="The Illustrated War News (1914)" license="Public domain" w={500} narrow />
  <div class="box-trap"><strong><span class="tag trap">सावधान</span></strong>दरबान सिंह नेगी को अक्सर "पहला भारतीय VC" कहा जाता है; सटीक रूप से वे <b>पहले भारतीय VC विजेताओं में से एक</b> हैं (ख़ुदादाद ख़ान के साथ) — पर किंग से युद्ध-क्षेत्र में स्वयं VC पाने वाले वे पहले भारतीय थे।</div>
</section>

<section id="shiksha">
  <h2>हिल स्टेशन, शिक्षा और प्रेस</h2>
  <ul>
    <li><b>हिल स्टेशन</b> — मसूरी (1820 का दशक), <b>नैनीताल</b> (पी. बैरन, 18 नवंबर 1841), रानीखेत (छावनी, 1869), लैंसडाउन (1887)। अंग्रेज़ बस्तियों के कारण सड़कें, डाक और बाज़ार बढ़े — पर कुली बेगार का बोझ भी।</li>
    <li><b>शिक्षा</b> — 1840 से सरकारी प्रयास; अमेरिकी मेथोडिस्ट मिशन ने <b>1865</b> में पौड़ी के पास <b>चोपड़ा</b> में हाईस्कूल खोला। अल्मोड़ा में रैमजे के समय स्कूल-अस्पताल।</li>
    <li><b>प्रेस</b> — <b>"अल्मोड़ा अख़बार" (1871)</b>, बुद्धिबल्लभ पंत के संपादन में शुरू; 1913 से बद्रीदत्त पांडे; 1918 में बंद होकर "शक्ति" बना — राष्ट्रीय जागरण का माध्यम (अध्याय 8)।</li>
  </ul>
</section>

<section id="tehri">
  <h2>टिहरी रियासत (1815–1949)</h2>
  <table>
    <thead><tr><th>राजा</th><th>शासन</th><th>मुख्य बातें</th></tr></thead>
    <tbody>
      <tr><td><b>सुदर्शन शाह</b></td><td>1815–1859</td><td>प्रद्युम्नशाह के पुत्र; <b>28 दिसंबर 1815</b> को भागीरथी-भिलंगना संगम पर <b>टिहरी</b> राजधानी (उस समय वीरान — 700 रु. से 30 घर बनवाए)। 4 मार्च 1820 की सनद से अंग्रेज़ों ने वंश का अधिकार माना; 1824 में रवाईं परगना मिला। ग्रंथ <b>"सभासार"</b> (7 खंड) के रचयिता; 1848 में "पुराना दरबार" महल; 1857 में अंग्रेज़ों की मदद। मृत्यु जून 1859।</td></tr>
      <tr><td><b>भवानी शाह</b></td><td>1859–1871</td><td>भाई शेर शाह ने गद्दी हथियानी चाही; कुमाऊँ कमिश्नर <b>रैमजे</b> के हस्तक्षेप से भवानी शाह राजा बने। साधु प्रकृति।</td></tr>
      <tr><td><b>प्रताप शाह</b></td><td>1871–1886</td><td><b>प्रतापनगर</b> बसाया; रियासत में <b>अंग्रेज़ी शिक्षा</b> शुरू करने वाले पहले राजा; 1876 में पहला "ख़ैराती शफ़ाख़ाना"; कोर्ट-फ़ीस टिकट।</td></tr>
      <tr><td><b>कीर्ति शाह</b></td><td>1886–1913</td><td>नाबालिग होने से माँ (गुलेरिया रानी) के संरक्षण में समिति ने शासन चलाया; मेयो कॉलेज (अजमेर) में पढ़े। <b>कीर्तिनगर</b>; टिहरी में <b>नगरपालिका</b>, <b>बिजली</b>, प्रताप हाईस्कूल, हीवेट संस्कृत पाठशाला, कैंपबेल बोर्डिंग हाउस, कृषि बैंक, उत्तरकाशी में कोढ़ीख़ाना, वेधशाला। स्वामी <b>रामतीर्थ</b> को जापान के धर्म सम्मेलन में भेजा। CIE (1898), KCSI (1901)। मृत्यु 25 अप्रैल 1913।</td></tr>
      <tr><td><b>नरेंद्र शाह</b></td><td>1913–1946</td><td>3 अगस्त 1898 को जन्म; 1913 में गद्दी, पूर्ण अधिकार 4 अक्टूबर 1919। <b>नरेंद्रनगर</b> बसाकर राजधानी बनाई; सड़कें (नरेंद्रनगर–मुनि की रेती, मुनि की रेती–देवप्रयाग–कीर्तिनगर); प्रताप हाईस्कूल को इंटर कॉलेज; BHU को 1933 में "सर कीर्तिशाह चेयर ऑफ़ इंडस्ट्रियल केमिस्ट्री" हेतु एक लाख रु.; 1938 में <b>हाईकोर्ट</b>। इन्हीं के काल में <b>तिलाड़ी कांड (1930)</b> और <b>श्रीदेव सुमन</b> का बलिदान (1944)।</td></tr>
      <tr><td><b>मानवेंद्र शाह</b></td><td>1946–1949</td><td>अक्टूबर 1946 में शासन; जनवरी 1948 में प्रजामंडल मंत्रिमंडल; <b>1 अगस्त 1949</b> को रियासत का भारत में विलय। बाद में टिहरी से कई बार सांसद।</td></tr>
    </tbody>
  </table>
  <div class="box-myth"><strong><span class="tag myth">मत-भेद</span></strong>
    <ul>
      <li><b>नरेंद्रनगर</b> — कई विवरणों में 1919 में बसाया गया; UOU पुस्तक के अनुसार निर्माण 1921 में शुरू हुआ और राजा 1925 में वहाँ गए (लागत लगभग 30 लाख रु.)।</li>
      <li><b>कीर्ति शाह</b> को पूर्ण अधिकार — कुछ स्रोत 1892, पुस्तक 27 मई 1898 बताती है।</li>
      <li>कीर्ति शाह द्वारा "हिंदी टाइपराइटर के आविष्कार" और "लैंसडाउन द्वारा आदर्श नरेश घोषित" किए जाने के दावे पुस्तक में हैं, पर स्वतंत्र स्रोतों से पुष्ट नहीं — परीक्षा में सावधानी रखें।</li>
    </ul>
  </div>
