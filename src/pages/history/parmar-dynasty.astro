const faq = [
  { q: 'गढ़वाल के परमार (पंवार) वंश की स्थापना किसने और कब की?', a: 'कनकपाल ने, चाँदपुर गढ़ी (चमोली) में। परीक्षाओं में प्रायः 888 ई. पूछा जाता है (पं. हरिकृष्ण रतूड़ी, भक्तदर्शन)। डॉ. अजय सिंह रावत बैकेट की सूची, कवि देवराज की वंशावली और चाँदपुर के एक लेख के आधार पर 688 ई. (संवत् 745) को सबसे प्रामाणिक मानते हैं।' },
  { q: 'कनकपाल कहाँ से आए थे?', a: 'रतूड़ी, एटकिंसन, वाल्टन और भक्तदर्शन के अनुसार मालवा की धारा नगरी से। डॉ. अजय सिंह रावत इसे भ्रम मानते हैं — चाँदपुर के लेख में "गुर्जरातात्" (गुर्जर देश से) लिखा है, और 1927 में धार दरबार ने टिहरी दरबार को लिखित उत्तर दिया कि कनकपाल का धार राजवंश से कोई संबंध नहीं है।' },
  { q: 'गढ़वाल की राजधानी श्रीनगर कब बनी?', a: 'प्रचलित मत (पौड़ी जिले का आधिकारिक इतिहास आदि) के अनुसार अजयपाल ने राजधानी पहले चाँदपुर से देवलगढ़ और फिर लगभग 1506–1519 के बीच (प्रायः 1517 ई.) श्रीनगर स्थानांतरित की। UOU पुस्तक के अनुसार यह परिवर्तन विक्रम संवत् 1415, यानी 1358 ई. में हुआ।' },
  { q: 'रानी कर्णावती को "नाक-कटी रानी" क्यों कहा जाता है?', a: 'महीपतशाह की मृत्यु के बाद नाबालिग पृथ्वीपतशाह की संरक्षिका रानी कर्णावती के समय शाहजहाँ की सेना ने नजाबत खाँ के नेतृत्व में गढ़वाल पर आक्रमण किया। गढ़वाली सैनिकों ने मुगल सेना को पराजित किया और मनूची के अनुसार बचे हुए सैनिकों की नाक काट दी गई।' },
  { q: 'परमार वंश का अंतिम स्वतंत्र राजा कौन था?', a: 'प्रद्युम्नशाह। 1803 में गोरखा आक्रमण के बाद वे बाराहाट, चमुआ में हारे और 14 मई 1804 (रतूड़ी; गिल के अनुसार जनवरी 1804) को देहरादून के पास खुड़बुड़ा के युद्ध में वीरगति को प्राप्त हुए। इसके बाद 1815 तक गढ़वाल पर गोरखा शासन रहा।' },
];

const sources = [
  { label: 'डॉ. अजय सिंह रावत, "गढ़वाल का परमार वंश" — "उत्तराखण्ड का राजनीतिक इतिहास", उत्तराखण्ड मुक्त विश्वविद्यालय, अध्याय 3 (पुस्तक पृ. 89–134) — मुख्य स्रोत; डॉ. श्याम लाल, अध्याय 2 (तीलू रौतेली प्रसंग)', url: 'https://uou.ac.in/' },
  { label: 'पौड़ी गढ़वाल जिला प्रशासन (NIC) — History: अजयपाल की राजधानियाँ', url: 'https://pauri.nic.in/history/' },
  { label: 'टिहरी गढ़वाल जिला प्रशासन (NIC) — 888 ई. से पहले के गढ़, कनकपाल, गोरखा आक्रमण', url: 'https://tehri.nic.in/?p=2733' },
  { label: 'भारतीय पुरातत्व सर्वेक्षण, देहरादून मंडल — चाँदपुर किला (संरक्षित स्मारक)', url: 'https://www.ncf.nic.in/assets/images/Uttarakhand%20under%20Dehradun%20Circle.pdf' },
  { label: 'Garhwal kingdom; Fateh Shah; Battle of Bhangani; Rani Karnavati of Garhwal — Wikipedia', url: 'https://en.wikipedia.org/wiki/Garhwal_kingdom' },
  { label: 'चित्र: Wikimedia Commons — Shikharsaxena1618 (CC BY-SA 3.0), Ms Sarah Welch (CC0), Ashishjalan8 (CC BY-SA 4.0)' },
];

const hero = 'e/e1/Chandpur_Garhi_Ruins.jpg';
const img = (w: number) => `https://upload.wikimedia.org/wikipedia/commons/thumb/${hero}/${w}px-${hero.split('/').pop()}`;
---
<HistoryChapter
  name="गढ़वाल का परमार (पंवार) वंश" nameEn="Parmar (Panwar) Dynasty of Garhwal" slug="parmar-dynasty"
  sub="चाँदपुर गढ़ी से श्रीनगर तक — 52 गढ़, नाक-कटी रानी, भंगाणी और खुड़बुड़ा"
  title="गढ़वाल का परमार (पंवार) वंश: कनकपाल से 52 गढ़ तक"
  description="गढ़वाल का परमार (पंवार) वंश: कनकपाल, चाँदपुर गढ़ी, अजयपाल और 52 गढ़, देवलगढ़-श्रीनगर राजधानी, शाह उपाधि और गोरखा आक्रमण।"
  image={img(1280)}
  heroSrcset={`${img(960)} 960w, ${img(1280)} 1280w`}
  imageAlt="पहाड़ी की चोटी पर चाँदपुर गढ़ी के किले के खंडहर"
  heroCredit={{ text: 'चाँदपुर गढ़ी के खंडहर (ASI स्मारक N-UT-24) — Shikharsaxena1618, CC BY-SA 3.0, Wikimedia Commons', url: 'https://commons.wikimedia.org/wiki/File:Chandpur_Garhi_Ruins.jpg' }}
  published="2026-11-18" toc={toc} facts={facts} faq={faq} sources={sources}
>

<section id="kanakpal">
  <h2>कनकपाल: कहाँ से और कब?</h2>
  <p class="pull">888 ई. से पहले गढ़वाल अनेक छोटे-छोटे "गढ़ों" में बँटा था, जिन पर राणा, राय या ठाकुर कहलाने वाले स्वतंत्र शासक राज करते थे। इन्हीं में से एक — चाँदपुर गढ़ी — से वह वंश उठा जिसने लगभग नौ सौ वर्ष गढ़वाल पर राज किया।</p>
  <ul>
    <li><b>परंपरा:</b> बदरीनाथ की यात्रा पर आए राजकुमार <b>कनकपाल</b> से चाँदपुर गढ़ के राजा प्रभावित हुए, अपनी एकमात्र पुत्री का विवाह उनसे किया और राज्य सौंप दिया। टिहरी जिले का आधिकारिक इतिहास इस राजा का नाम <b>भानुप्रताप</b> लिखता है; एटकिंसन और डॉ. पातीराम <b>सोनपाल</b> नाम देते हैं।</li>
    <li><b>चाँदपुर गढ़ी</b> (चमोली) — आज भारतीय पुरातत्व सर्वेक्षण का <b>संरक्षित स्मारक</b>; ASI इसे कनकपाल का केंद्र और गढ़वाल वंश की असली नींव मानता है।</li>
  </ul>
  <h3>मूल स्थान: मत-भेद</h3>
  <div class="box-myth"><strong><span class="tag myth">मत-भेद</span></strong>
    <ul>
      <li><b>धारा नगरी (मालवा)</b> — पं. हरिकृष्ण रतूड़ी, एटकिंसन, वाल्टन, भक्तदर्शन। परीक्षाओं में प्रायः यही उत्तर।</li>
      <li><b>गुर्जर देश</b> — डॉ. अजय सिंह रावत: चाँदपुर के उत्खनन से मिले लेख में कनकपाल को "<b>गुर्जरातात् प्रसिद्धः</b>" कहा गया है; 1927 में धार दरबार ने टिहरी दरबार को लिखकर बताया कि कनकपाल का धार राजवंश से कोई संबंध नहीं।</li>
      <li>गढ़वाल में दाईं ओर मुड़ी सूँड वाले गणेश और आदिबदरी की सोलंकी शैली को भी गुर्जर (गुजरात-राजस्थान) संबंध का प्रमाण माना गया है।</li>
    </ul>
  </div>
  <h3>स्थापना-तिथि: तीन मत</h3>
  <table>
    <thead><tr><th>तिथि</th><th>किसका मत</th></tr></thead>
    <tbody>
      <tr><td><b>888 ई.</b></td><td>पं. हरिकृष्ण रतूड़ी ("गढ़वाल का इतिहास"), भक्तदर्शन — <b>परीक्षा में प्रचलित</b></td></tr>
      <tr><td><b>688 ई.</b> (संवत् 745)</td><td>रतूड़ी ("गढ़वाल वर्णन" में अपना मत बदला), बैकेट की सूची, कवि देवराज की वंशावली — <b>डॉ. अजय सिंह रावत इसे सबसे प्रामाणिक मानते हैं</b></td></tr>
      <tr><td>823 ई.</td><td>कुछ आधुनिक विवरण</td></tr>
    </tbody>
  </table>
  <div class="box-trap"><strong><span class="tag trap">सावधान</span></strong>राहुल सांकृत्यायन तो कनकपाल के अस्तित्व पर ही संदेह करते हैं और वंश का आदिपुरुष <b>अजयपाल</b> को मानते हैं। डॉ. डबराल के अनुसार चाँदपुर दुर्ग 1425–1500 के बीच बना।</div>
  <Figure file="e/e1/Chandpur_Garhi_Ruins.jpg" alt="चाँदपुर गढ़ी के किले की दीवारें और खंडहर" caption="चाँदपुर गढ़ी (चमोली) — परमार वंश की पहली राजधानी; आज ASI का संरक्षित स्मारक।" author="Shikharsaxena1618" license="CC BY-SA 3.0" w={960} />
</section>

<section id="vanshavali">
  <h2>वंशावली के स्रोत</h2>
  <ul>
    <li>परमार राजाओं की <b>चार सूचियाँ</b> मिलती हैं — कप्तान <b>हार्डविक</b> (1796), एक सरकारी विवरण (1849, जिसे <b>बैकेट</b> ने माना), <b>विलियम</b>, और <b>एटकिंसन</b> (अल्मोड़ा के एक पंडित के संग्रह से)।</li>
    <li><span class="tag exam">परीक्षा बिंदु</span> बैकेट की सूची सबसे प्रामाणिक मानी जाती है, क्योंकि यह राजा <b>सुदर्शन शाह</b> के ग्रंथ "<b>सभासार</b>" (1828) से मेल खाती है। इसमें कनकपाल से प्रद्युम्नशाह तक <b>54</b> राजा हैं।</li>
    <li>गढ़वाल के भाटों के <b>पंवाड़ों</b> (वीरगाथाओं) में भी यही क्रम मिलता है। "पंवाड़ा" शब्द स्वयं "पंवार" (परमार) क्षत्रियों की गाथाओं से जोड़ा जाता है।</li>
  </ul>
</section>

<section id="ajaypal">
  <h2>अजयपाल: 52 गढ़ों का एकीकरण</h2>
  <p>अजयपाल से पहले के परमार राजाओं के बारे में कोई ठोस ऐतिहासिक प्रमाण नहीं मिलता। बैकेट की सूची में वे <b>37वें राजा</b> हैं।</p>
  <ul>
    <li><span class="tag exam">परीक्षा बिंदु</span> गढ़वाल की <b>52 गढ़ियों</b> को जीतकर पहली बार एक विशाल <b>गढ़राज्य</b> बनाया — जिसमें देहरादून, सहारनपुर, टिहरी, उत्तरकाशी, पौड़ी, चमोली और बिजनौर का एक भाग था।</li>
    <li>कुछ प्रमुख गढ़ — <b>चाँदपुर गढ़</b>, कंडार गढ़, <b>देवल गढ़</b>, नागनाथ गढ़, लोहाब गढ़ (लोहबान नेगी), <b>बधाण गढ़</b>, दशोली गढ़, <b>लंगूर गढ़</b>, <b>चौंद कोट गढ़</b>, गढ़कोट (बगड़वाल बिष्ट), जौनपुर गढ़।</li>
    <li><b>देवलगढ़</b> (श्रीनगर से लगभग 8–9 मील) में राजप्रासाद बनवाया और कुलदेवी <b>राजराजेश्वरी</b> की प्रतिष्ठा की।</li>
    <li><b>नाथ पंथ</b> — अजयपाल गोरखनाथ पंथ के अनुयायी थे; तांत्रिक "<b>साँवरी ग्रंथ</b>" में उन्हें "<b>आदिनाथ</b>" कहा गया है। सम्राट अशोक की तरह, विजय के बाद ऐश्वर्य त्यागकर गुरु-पंथ के अनुगामी बने।</li>
    <li>कवि <b>भरत</b> ने "<b>मानोदय</b>" काव्य में उनकी तुलना कृष्ण, युधिष्ठिर, भीम, कुबेर और इंद्र से की।</li>
  </ul>
  <div class="box-myth"><strong><span class="tag myth">मत-भेद: राजधानी कब बदली?</span></strong>
    <ul>
      <li><b>प्रचलित मत</b> (पौड़ी जिले का आधिकारिक इतिहास आदि): अजयपाल ने राजधानी चाँदपुर से <b>देवलगढ़</b> (1506 से पहले) और फिर <b>श्रीनगर</b> (1506–1519 के बीच; प्रायः <b>1517 ई.</b>) स्थानांतरित की।</li>
      <li><b>UOU पुस्तक</b> (बैकेट की सूची के आधार पर): अजयपाल के समय विक्रम संवत् 1415, यानी <b>1358 ई.</b> में राजधानी चाँदपुर से श्रीनगर बनी।</li>
    </ul>
  </div>
  <Figure file="2/26/0052223_Raja_Rajeshwari_temples%2C_Devalgarh_Uttarakhand_018.jpg" alt="देवलगढ़ में राजराजेश्वरी मंदिर समूह" caption="देवलगढ़ (पौड़ी) का मंदिर समूह — अजयपाल ने यहीं कुलदेवी राजराजेश्वरी की प्रतिष्ठा की।" author="Ms Sarah Welch" license="CC0" w={960} />
</section>

<section id="shah">
  <h2>सहजपाल, बलभद्र शाह और "शाह" उपाधि</h2>
  <ul>
    <li>अजयपाल के बाद <b>कल्याण शाह</b>, सुंदरपाल, हंसदेवपाल, विजयपाल — इनके नामों के अलावा विवरण नहीं मिलता।</li>
    <li><b>सहजपाल</b> (लगभग 1548–1575) — देवप्रयाग के क्षेत्रपाल मंदिर का 1548 ई. का शिलालेख और रघुनाथ मंदिर की 1561 ई. की घंटी। अकबर के समकालीन; गढ़राज्य स्वतंत्र बना रहा।</li>
    <li><span class="tag exam">परीक्षा बिंदु</span> <b>बलभद्र शाह</b> (लगभग 1575–1591) — नाम के आगे "<b>शाह</b>" उपाधि की परंपरा चलाने वाले पहले राजा; इनके बाद सभी परमार राजा "शाह" कहलाए।</li>
    <li>वाल्टन के अनुसार 1581 में बलभद्र शाह ने कुमाऊँ के राजा से <b>ग्वालदम</b> में युद्ध किया (डबराल: 1590–91)।</li>
  </ul>
  <div class="box-myth"><strong><span class="tag myth">जनश्रुति: "शाह" उपाधि कैसे मिली?</span></strong>
    <ul>
      <li>एक कथा: गढ़वाल का एक दूत दिल्ली गया, जहाँ उसने मुगल हरम की एक बीमार महिला का इलाज किया और पुरस्कार में अपने राजा के लिए "शाह" उपाधि माँगी (डॉ. पातीराम)।</li>
      <li>दूसरी कथा कि दारा शिकोह को औरंगज़ेब को सौंपने पर उपाधि मिली — पुस्तक इसे गलत मानती है, क्योंकि औरंगज़ेब 1658 में गद्दी पर आया जबकि बलभद्र शाह 16वीं सदी में राज कर चुके थे।</li>
    </ul>
  </div>
</section>

<section id="manshah">
  <h2>मानशाह से महीपतशाह</h2>
  <h3>मानशाह (लगभग 1591–1611)</h3>
  <ul>
    <li>देवप्रयाग के क्षेत्रपाल मंदिर (1608) और रघुनाथ मंदिर (1610) के शिलालेख।</li>
    <li>यूरोपीय यात्री <b>विलियम</b> (1608–11) ने लिखा कि गढ़वाल गंगा-यमुना के बीच फैला प्रतापी राज्य है, राजधानी <b>श्रीनगर</b> है और राजा सोने के बर्तनों में भोजन करते हैं।</li>
    <li>कुमाऊँ के <b>लक्ष्मीचंद</b> ने 1597–1620 के बीच <b>सात आक्रमण</b> किए, पर हर बार हारे। मानशाह के सेनापति <b>नंदी</b> ने कुमाऊँ की राजधानी <b>चंपावत</b> पर भी अधिकार कर लिया। राजकवि भरत ने "<b>मानोदय</b>" में इस विजय का गुणगान किया।</li>
  </ul>
  <h3>श्यामशाह</h3>
  <ul>
    <li>"<b>जहाँगीरनामा</b>" में उल्लेख — जहाँगीर ने श्रीनगर के राजा को घोड़े और हाथी भेंट किए (1621)। 1615 का ताम्रपत्र। निःसंतान थे, इसलिए उनके चाचा महीपतशाह गद्दी पर बैठे।</li>
  </ul>
  <h3>महीपतशाह (1622–1631) — "गर्वभंजन"</h3>
  <ul>
    <li><span class="tag exam">परीक्षा बिंदु</span> लगातार शत्रुओं को पराजित करने के कारण "<b>गर्वभंजन</b>" उपाधि।</li>
    <li><b>तिब्बत पर तीन आक्रमण</b> — पहले में 12,000 सैनिक (11,000 बंदूकधारी, तोपों वाली टुकड़ियाँ), दूसरे में 20,000; भारी हिमपात और कड़े प्रतिरोध के बाद संधि। पुर्तगाली पादरी <b>आंद्रादे</b> (1624 में माणा होकर तिब्बत गए; 1626 में त्सापरांग में चर्च की नींव) के विवरण इसके स्रोत हैं।</li>
    <li>तीन प्रसिद्ध सेनापति — <b>माधोसिंह भंडारी</b>, <b>रिखोला लोदी</b>, <b>बनवारीदास</b>।</li>
    <li><b>मृत्यु</b> — जुलाई 1631; यात्री <b>अजेवेडो</b> श्रीनगर में उनकी अंत्येष्टि में स्वयं उपस्थित था।</li>
  </ul>
  <div class="box-myth"><strong><span class="tag myth">जनश्रुति</span></strong>कहा जाता है कि भूलवश कुछ नागा साधुओं की हत्या के बाद ग्लानि में महीपतशाह ने ऋषिकेश के भरत मंदिर की मूर्ति की आँखें निकाल दीं, और प्रायश्चित के लिए मृत्यु चाहते हुए कुमाऊँ युद्ध में बलिदान हुए।</div>
</section>

<section id="karnavati">
  <h2>रानी कर्णावती और पृथ्वीपतशाह</h2>
  <h3>रानी कर्णावती — "नाक-कटी रानी"</h3>
  <ul>
    <li>महीपतशाह की मृत्यु के समय पुत्र <b>पृथ्वीपतशाह</b> लगभग 7 वर्ष के थे; उनकी माँ <b>रानी कर्णावती</b> ने संरक्षिका के रूप में शासन चलाया। 1640 ई. के ताम्रपत्र में रानी ने "हाट" गाँव के हटवाल ब्राह्मण को भूमि दी — साक्षी थे माधोसिंह भंडारी।</li>
    <li><span class="tag exam">परीक्षा बिंदु</span> शाहजहाँ की सेना ने <b>नजाबत खाँ</b> के नेतृत्व में गढ़वाल पर आक्रमण किया। गढ़वाली सैनिकों ने मुगल सेना को तहस-नहस किया; इतालवी लेखक <b>मनूची</b> ("स्टोरिया डो मोगोर") के अनुसार बचे सैनिकों की <b>नाक काट दी गई</b>। मुगल दरबारी विवरण "<b>मआसिर-उल-उमरा</b>" भी हार की पुष्टि करता है।</li>
  </ul>
  <div class="box-trap"><strong><span class="tag trap">सावधान</span></strong>इस आक्रमण की तिथि स्रोतों में <b>1635 से 1640</b> के बीच मिलती है। पुस्तक के अनुसार अपमानित शाहजहाँ ने 19 वर्ष बाद, 1655 में फिर आक्रमण कराया।</div>
  <h3>पृथ्वीपतशाह — शरणागत की रक्षा</h3>
  <ul>
    <li><b>1655</b> — <b>खलीलुल्ला</b> के नेतृत्व में मुगल सेना ने सिरमौर के मांधाता प्रकाश और कुमाऊँ के <b>बाज बहादुर चंद</b> की मदद से <b>दून घाटी</b> जीत ली, पर <b>श्रीनगर अविजित</b> रहा।</li>
    <li><span class="tag exam">परीक्षा बिंदु</span> सामूगढ़ में दारा शिकोह की हार के बाद उसके पुत्र <b>सुलेमान शिकोह</b> ने गढ़वाल में शरण ली। औरंगज़ेब की धमकियों के बावजूद पृथ्वीपतशाह ने उसे सौंपने से इनकार किया।</li>
    <li>सुलेमान को विष देने का प्रयास करने वाले अपने ब्राह्मण मंत्री का सिर कटवा दिया। पर युवराज <b>मेदिनीशाह</b> ने राजा जयसिंह के पुत्र रामसिंह से मिलकर षड्यंत्र किया; भागते सुलेमान को पकड़कर मुगलों को सौंप दिया गया (औरंगज़ेब के सामने 5 जून 1661 को पेश)।</li>
    <li>पृथ्वीपतशाह ने मेदिनीशाह को <b>देश-निकाला</b> दिया; उसकी 1662 में दिल्ली में मृत्यु हुई।</li>
  </ul>
  <div class="box-myth"><strong><span class="tag myth">मत-भेद: मेदिनीशाह</span></strong>डॉ. डबराल मेदिनीशाह का शासन 1660–1684 मानते हैं। डॉ. अजय सिंह रावत के अनुसार मेदिनीशाह ने <b>कभी शासन नहीं किया</b> — औरंगज़ेब के 1665 के फ़रमान में पृथ्वीपतशाह के <b>पौत्र फतेहशाह</b> को गद्दी सँभालने की बधाई दी गई है; पृथ्वीपतशाह 1667 तक जीवित रहे।</div>
</section>

<section id="fatehshah">
  <h2>फतेहशाह: उत्कर्ष का काल</h2>
  <ul>
    <li>पृथ्वीपतशाह ने जीवनकाल में ही पौत्र फतेहशाह को शासन सौंपा। घोड़े पर सवार उनके चित्र में आयु 33 वर्ष लिखी है — इसलिए पुस्तक बालक राजा वाली धारणा को नहीं मानती।</li>
    <li><b>विजयें</b> — राहुल सांकृत्यायन के अनुसार तिब्बत तक आक्रमण, उनकी तलवार कई वर्ष <b>दाबा</b> के विहार में रखी रही; सिरमौर से पौंटा और जौनसार का भाग जीता; विलियम्स के अनुसार सहारनपुर पर आक्रमण कर <b>फतेहपुर</b> नगर बसाया।</li>
    <li><span class="tag exam">परीक्षा बिंदु</span> <b>भंगाणी का युद्ध (1688)</b> — पौंटा के पास, <b>गुरु गोविंद सिंह</b> से। गुरु की आत्मकथा "<b>बिचित्र नाटक</b>" में इसका वर्णन है। यह निर्णायक युद्ध नहीं था और इसमें गढ़वाल का कोई भू-भाग नहीं गया।</li>
    <li><b>गुरु रामराय</b> को सम्मान सहित बुलाया; <b>देहरादून</b> में गुरुद्वारे (दरबार) के लिए तीन गाँव दिए — <b>खुड़बुड़ा, राजपुर, चामासारी</b> (बाद में प्रदीपशाह ने चार और)।</li>
    <li><b>साहित्य-कला</b> — दरबार में <b>नवरत्न</b> (सुरेशानंद बड़थ्वाल, खेतराम धस्माना, रुद्रीदत्त किमोठी, हरिदत्त नौटियाल, वासवानंद बहुगुणा, शशिधर डंगवाल, सहदेव चंदोला, कीर्तिराम कनठोला, हरिदत्त थपलियाल)। कवि <b>रतन</b> ("फतेहप्रकाश"), जटाधर, सुखदेव मिश्र और <b>मतिराम</b> ("वृत्त कौमुदी", 1701 — फतेहशाह की तुलना शिवाजी से) ने प्रशंसा लिखी।</li>
    <li>फतेहशाह का <b>सिक्का</b> भी मिला है, जिस पर लिखावट गढ़वाल की स्वतंत्र सत्ता का प्रमाण मानी जाती है।</li>
  </ul>
  <div class="box-trap"><strong><span class="tag trap">सावधान</span></strong>फतेहशाह की मृत्यु-तिथि पर भी मत-भेद है — 1708 (बैकेट), 1715 (भक्तदर्शन), 1716, 1717 (वाल्टन) आदि। संवत् 1772 (1715 ई.) के ताम्रपत्र से तय है कि वे कम से कम 1715 तक शासन में थे। उनके बाद थोड़े समय के लिए <b>उपेंद्रशाह</b> राजा बने।</div>
</section>

<section id="pradipshah">
  <h2>प्रदीपशाह से जयकृतशाह</h2>
  <h3>प्रदीपशाह (1716–1772)</h3>
  <ul>
    <li>लगभग 56 वर्ष का शांतिपूर्ण शासन; विलियम्स के अनुसार दून की घाटी हरी-भरी और समृद्ध रही। लखनऊ संग्रहालय में इनका सिक्का है।</li>
    <li><b>रुहेला आक्रमण</b> के समय कुमाऊँ के कल्याणचंद की मदद को सेना भेजी; संधि में रुहेलों ने जो <b>तीन लाख रुपये</b> माँगे, वे प्रदीपशाह ने गढ़वाल के राजकोष से चुकाए।</li>
    <li>रुहेला सेनापति <b>नजीब खाँ</b> ने भाबर और दून छीन लिया; <b>31 अक्टूबर 1770</b> को दून फिर गढ़राज्य के अधिकार में आया।</li>
  </ul>
  <h3>ललितशाह (1772–1780)</h3>
  <ul>
    <li>सिखों ने 1775 और 1778 में दून पर हमले किए।</li>
    <li>कुमाऊँ के <b>हर्षदेव जोशी</b> के आमंत्रण पर कुमाऊँ गए, मोहनचंद को हराया और अपने पुत्र <b>प्रद्युम्नशाह</b> को कुमाऊँ की गद्दी पर बैठाया — जो "<b>प्रद्युम्नचंद</b>" कहलाए। लौटते समय <b>दुलड़ी</b> में मलेरिया से मृत्यु।</li>
  </ul>
  <h3>जयकृतशाह (1780–1786)</h3>
  <ul>
    <li>सौतेले भाई प्रद्युम्नशाह से शत्रुता; दरबार में मंत्री <b>कृपाराम डोभाल</b> का आतंक, जिसे ठा. घमंड सिंह ने खुले दरबार में मार दिया।</li>
    <li>सिरमौर के राजा <b>जगत प्रकाश</b> की मदद से विद्रोहियों को हराया; पर बाद में प्रद्युम्नशाह ने गढ़वाल पर आक्रमण किया। निराश जयकृतशाह की <b>देवप्रयाग के रघुनाथ मंदिर</b> में मृत्यु हुई; उनकी चार रानियाँ सती हुईं।</li>
  </ul>
  <Figure file="e/ee/Devprayag_Confluence_Oct_2019.jpg" alt="देवप्रयाग में अलकनंदा और भागीरथी का संगम, किनारे पर बसा नगर" caption="देवप्रयाग — यहाँ के रघुनाथ और क्षेत्रपाल मंदिरों के शिलालेख सहजपाल, मानशाह और पृथ्वीपतशाह के काल के प्रमाण हैं।" author="Ashishjalan8" license="CC BY-SA 4.0" w={960} />
</section>

<section id="pradyumna">
  <h2>प्रद्युम्नशाह (1786–1804) और खुड़बुड़ा</h2>
  <ul>
    <li>जयकृतशाह के बाद गढ़वाल के राजा बने; भाई <b>पराक्रमशाह</b> की साज़िशों से राज्य गृहयुद्ध में उलझा रहा।</li>
    <li><b>1790</b> में अल्मोड़ा जीतने के बाद गोरखे गढ़वाल की ओर बढ़े, पर <b>1791</b> में <b>लंगूरगढ़</b> में हारे। चीन के नेपाल पर आक्रमण की खबर पर संधि कर लौट गए; प्रद्युम्नशाह ने गोरखों को <b>25,000 रुपये वार्षिक</b> देना स्वीकार किया।</li>
    <li><span class="tag exam">परीक्षा बिंदु</span> <b>1795</b> का भयंकर अकाल — "<b>इकावनी-बावनी</b>" (संवत् 1851-52); गढ़वाल में "बावनी" शब्द ही अकाल का पर्याय बन गया।</li>
    <li><b>1803</b> का विनाशकारी <b>भूकंप</b> — रतूड़ी के अनुसार केवल 20–25% लोग बचे; बद्रीदत्त पांडे के अनुसार झटके सात दिन-रात चले।</li>
    <li><b>1803 का गोरखा आक्रमण</b> — हस्तिदल चौतरिया और <b>अमर सिंह थापा</b> के नेतृत्व में। प्रद्युम्नशाह <b>बाराहाट</b> (उत्तरकाशी) और <b>चमुआ</b> (चंबा) में हारे; सहारनपुर में अपना सिंहासन बेचकर 12,000 सैनिक भर्ती किए (लंढौरा के गुर्जर राजा रामदयाल सिंह ने भी मदद दी)।</li>
    <li><span class="tag exam">परीक्षा बिंदु</span> अंतिम निर्णायक युद्ध <b>खुड़बुड़ा</b> (देहरादून) में — प्रद्युम्नशाह <b>वीरगति</b> को प्राप्त हुए। गोरखों ने <b>हरिद्वार</b> में राजकीय सम्मान के साथ अंत्येष्टि की।</li>
  </ul>
  <div class="box-trap"><strong><span class="tag trap">सावधान</span></strong>प्रद्युम्नशाह की मृत्यु-तिथि — <b>14 मई 1804</b> (पं. हरिकृष्ण रतूड़ी, जो बाद में टिहरी के प्रधानमंत्री रहे) या <b>जनवरी 1804</b> (ए.आर. गिल)। पुस्तक रतूड़ी की तिथि को अधिक विश्वसनीय मानती है। इसके बाद गढ़वाल पर <b>गोरखा शासन (1804–1815)</b> रहा — <a href="/history/gorkha-rule/">अगला अध्याय: गोरखा शासन</a>।</div>
</section>

<section id="vir">
  <h2>वीर और वीरांगनाएँ</h2>
  <h3>माधोसिंह भंडारी</h3>
  <ul>
    <li>महीपतशाह, रानी कर्णावती और पृथ्वीपतशाह — तीनों के सेनापति। तिब्बत के "<b>छोटा चीनी</b>" युद्ध में घातक रूप से घायल होने पर अंगरक्षकों से कहा कि मृत्यु के बाद शरीर को हल्का भूनकर पालथी मुद्रा में पालकी में बैठा दें, ताकि सैनिकों का मनोबल न टूटे।</li>
    <li>डबराल और भक्तदर्शन बलिदान की तिथि <b>1635</b> मानते हैं; पुस्तक 1640 के ताम्रपत्र (जिसमें माधोसिंह साक्षी हैं) के आधार पर इसे <b>लगभग 1640</b> मानती है।</li>
    <li>लोकगीत — "एक सिंघ रैंदो बण, एक सिंघ गाय का; एक सिंघ माधोसिंह, और सिंघ काहे का।"</li>
  </ul>
  <h3>रिखोला लोदी</h3>
  <p>सिरमौर, तिब्बत और गढ़वाल के दक्षिणी भाग की विजय में अद्भुत शौर्य के लिए प्रसिद्ध — गढ़वाल के प्रसिद्ध पंवाड़ों में "रिखोला लोदी" और "माधोसिंह" के पंवाड़े शामिल हैं।</p>
  <h3>तीलू रौतेली</h3>
  <ul>
    <li>गोला रावत <b>भूप सिंह थोकदार</b> की पुत्री। कुमाऊँ के बाज बहादुर चंद द्वारा मानिला-गढ़ से खदेड़े गए कत्यूरी कुँवर गढ़वाल के पूर्वी भागों में लूटपाट करने लगे; पिता और दोनों भाइयों के मारे जाने पर कुँवारी तीलू ने सेना बनाकर उन्हें खदेड़ा।</li>
    <li>खैरागढ़ सहित कई लड़ाइयाँ जीतीं; युद्धों के बाद पूर्वी नयार नदी में स्नान करते समय एक शत्रु ने धोखे से उनकी हत्या कर दी। पुस्तक उन्हें "गढ़वाल की जोन ऑफ आर्क" कहती है।</li>
  </ul>
</section>

<section id="samayrekha">
  <h2>समयरेखा</h2>
  <ol class="timeline">
    <li><span class="yr">688 / 888 ई.</span><span class="ev">कनकपाल द्वारा चाँदपुर गढ़ी में परमार वंश की स्थापना (तिथि विवादित)।</span></li>
    <li><span class="yr">1358 / ~1506–1517</span><span class="ev">अजयपाल — 52 गढ़ों का एकीकरण; राजधानी देवलगढ़, फिर श्रीनगर।</span></li>
    <li><span class="yr">1548–1575</span><span class="ev">सहजपाल — देवप्रयाग शिलालेख (1548); अकबर के समकालीन।</span></li>
    <li><span class="yr">~1575–1591</span><span class="ev">बलभद्र शाह — "शाह" उपाधि की परंपरा; ग्वालदम युद्ध (1581)।</span></li>
    <li><span class="yr">1597–1620</span><span class="ev">मानशाह के समय कुमाऊँ के लक्ष्मीचंद के सात असफल आक्रमण; सेनापति नंदी ने चंपावत जीता।</span></li>
    <li><span class="yr">1622–1631</span><span class="ev">महीपतशाह "गर्वभंजन" — तिब्बत पर तीन आक्रमण; आंद्रादे की यात्राएँ (1624–25)।</span></li>
    <li><span class="yr">~1635–1640</span><span class="ev">रानी कर्णावती — नजाबत खाँ की मुगल सेना पराजित, "नाक-कटी रानी"।</span></li>
    <li><span class="yr">1655</span><span class="ev">खलीलुल्ला का आक्रमण — दून छिना, श्रीनगर अविजित।</span></li>
    <li><span class="yr">1659–1661</span><span class="ev">पृथ्वीपतशाह ने सुलेमान शिकोह को शरण दी; मेदिनीशाह का विश्वासघात।</span></li>
    <li><span class="yr">1688</span><span class="ev">फतेहशाह — भंगाणी का युद्ध (गुरु गोविंद सिंह)।</span></li>
    <li><span class="yr">1716–1772</span><span class="ev">प्रदीपशाह — शांतिपूर्ण शासन; 1770 में दून वापस।</span></li>
    <li><span class="yr">1772–1780</span><span class="ev">ललितशाह — पुत्र प्रद्युम्न कुमाऊँ की गद्दी पर (प्रद्युम्नचंद)।</span></li>
    <li><span class="yr">1791</span><span class="ev">लंगूरगढ़ में गोरखे हारे; 25,000 रु. वार्षिक की संधि।</span></li>
    <li><span class="yr">1795</span><span class="ev">इकावनी-बावनी का अकाल।</span></li>
    <li><span class="yr">1803</span><span class="ev">भीषण भूकंप; गोरखा आक्रमण।</span></li>
    <li><span class="yr">14 मई 1804</span><span class="ev">खुड़बुड़ा का युद्ध — प्रद्युम्नशाह वीरगति को प्राप्त; गढ़वाल पर गोरखा अधिकार।</span></li>
  </ol>
</section>

<section id="pariksha">
  <h2>परीक्षा बिंदु (One-liners)</h2>
  <ol>
    <li>परमार वंश का संस्थापक — कनकपाल; पहली राजधानी — चाँदपुर गढ़ी (चमोली)।</li>
    <li>स्थापना-तिथि — 888 ई. (प्रचलित); 688 ई. (डॉ. अजय सिंह रावत)।</li>
    <li>कनकपाल का मूल — धारा नगरी, मालवा (प्रचलित); गुर्जर देश (पुस्तक)।</li>
    <li>सबसे प्रामाणिक वंशावली — बैकेट की सूची; आधार — सुदर्शन शाह का "सभासार" (1828)।</li>
    <li>52 गढ़ों का एकीकरण — अजयपाल (37वें राजा)।</li>
    <li>अजयपाल की कुलदेवी — राजराजेश्वरी (देवलगढ़); "साँवरी ग्रंथ" में — "आदिनाथ"।</li>
    <li>राजधानी क्रम — चाँदपुर गढ़ी → देवलगढ़ → श्रीनगर।</li>
    <li>"शाह" उपाधि की परंपरा — बलभद्र शाह।</li>
    <li>"मानोदय" काव्य — कवि भरत (मानशाह के राजकवि)।</li>
    <li>चंपावत जीतने वाला गढ़वाली सेनापति — नंदी (मानशाह)।</li>
    <li>"गर्वभंजन" — महीपतशाह।</li>
    <li>महीपतशाह के सेनापति — माधोसिंह भंडारी, रिखोला लोदी, बनवारीदास।</li>
    <li>"नाक-कटी रानी" — रानी कर्णावती; मुगल सेनापति — नजाबत खाँ।</li>
    <li>सुलेमान शिकोह को शरण — पृथ्वीपतशाह; विश्वासघाती पुत्र — मेदिनीशाह।</li>
    <li>भंगाणी का युद्ध (1688) — फतेहशाह बनाम गुरु गोविंद सिंह।</li>
    <li>गुरु रामराय को खुड़बुड़ा, राजपुर, चामासारी गाँव — फतेहशाह।</li>
    <li>नवरत्न दरबार — फतेहशाह।</li>
    <li>रुहेलों को कुमाऊँ की ओर से 3 लाख चुकाए — प्रदीपशाह।</li>
    <li>"प्रद्युम्नचंद" बनकर कुमाऊँ पर राज — प्रद्युम्नशाह (ललितशाह के पुत्र)।</li>
    <li>गोरखों की हार (1791) — लंगूरगढ़।</li>
    <li>इकावनी-बावनी अकाल — 1795; भूकंप — 1803।</li>
    <li>खुड़बुड़ा का युद्ध — 14 मई 1804; प्रद्युम्नशाह वीरगति।</li>
  </ol>
</section>

