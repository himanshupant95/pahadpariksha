  { label: 'राज्यसभा वाद-विवाद, 2, 10 व 17 अगस्त 2000 — विधेयक का पारित होना व लोकसभा द्वारा संशोधनों की स्वीकृति (11 अगस्त 2000)', url: 'https://rsdebate.nic.in/bitstream/123456789/6137/1/PD_190_10082000_14_p243_p249_17.pdf' },
  { label: 'India Code — The Uttaranchal (Alteration of Name) Act, 2006 (लागू 1 जनवरी 2007)', url: 'https://www.indiacode.nic.in/handle/123456789/2047' },
  { label: 'मुख्यमंत्री कार्यालय, उत्तराखंड — पूर्व मुख्यमंत्री व कार्यकाल', url: 'https://cm.uk.gov.in/' },
  { label: 'लोक भवन (राज्यपाल), उत्तराखंड — रजत जयंती विशेष सत्र में राष्ट्रपति का संबोधन (3 नवंबर 2025)', url: 'https://governoruk.gov.in/' },
  { label: 'डॉ. शिवानी रावत, "Uttarakhand State Movement: Its Rise and…", Journal of Acharya Narendra Dev Research Institute (कुमाऊँ विश्वविद्यालय)', url: 'https://andjournal.in/wp-content/uploads/2018/06/2016_1.pdf' },
  { label: 'ETV Bharat — श्रीयंत्र टापू कांड, 10 नवंबर 1995 (यशोधर बेंजवाल, राजेश रावत)', url: 'https://www.etvbharat.com/hindi/uttarakhand/state/pauri-garhwal/role-of-shri-yantra-tapu-incident-is-special-in-uttarakhand-state-movement/uttarakhand20231110204845790790353' },
  { label: 'काफल ट्री — मसूरी गोलीकांड, 2 सितंबर 1994 (सुरेंद्र सिंह पुंडीर, "मसूरी के शहीद")', url: 'https://kafaltree.com/2-september-martyred-in-mussoorie-firing/' },
  { label: 'Deccan Herald — रामपुर तिराहा: PAC के दो पूर्व सिपाहियों को आजीवन कारावास (18 मार्च 2024); राज्य आंदोलनकारी आरक्षण विधेयक को राज्यपाल की स्वीकृति (18 अगस्त 2024)', url: 'https://www.deccanherald.com/india/uttar-pradesh/uttarakhand-bill-providing-10-quota-in-govt-jobs-to-statehood-agitators-gets-guvs-nod-3155134' },
  { label: 'Scroll / Business Today — समान नागरिक संहिता: विधानसभा 7 फरवरी 2024, राष्ट्रपति स्वीकृति 11 मार्च 2024, लागू 27 जनवरी 2025', url: 'https://scroll.in/latest/1078380/uttarakhand-to-implement-uniform-civil-code-on-january-27' },
