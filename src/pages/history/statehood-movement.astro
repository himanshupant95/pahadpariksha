const hero = 'e/e1/Bhararisain-Vidhan-sabha-Uttarakhand.jpg';
const img = (w: number) => `https://upload.wikimedia.org/wikipedia/commons/thumb/${hero}/${w}px-${hero.split('/').pop()}`;
---
<HistoryChapter
  name="उत्तराखंड राज्य आंदोलन और राज्य निर्माण" nameEn="Uttarakhand Statehood Movement and the State since 2000" slug="statehood-movement"
  sub="1938 की श्रीनगर माँग से 1994 के बलिदानों तक, 9 नवंबर 2000 के राज्य गठन से रजत जयंती और 2026 तक"
  title="उत्तराखंड राज्य आंदोलन (1938–2000) और राज्य के 25 वर्ष: खटीमा, मसूरी, रामपुर तिराहा, गैरसैंण, मुख्यमंत्री"
  description="उत्तराखंड राज्य आंदोलन: 1938 श्रीनगर अधिवेशन, उक्रांद 1979, कौशिक समिति, 1994 के खटीमा-मसूरी-रामपुर तिराहा कांड और 9 नवंबर 2000।"
  image={img(960)}
  heroSrcset={`${img(500)} 500w, ${img(960)} 960w`}
  imageAlt="भराड़ीसैंण (गैरसैंण) में उत्तराखंड विधानसभा भवन"
  heroCredit={{ text: 'भराड़ीसैंण (गैरसैंण) विधानसभा भवन — ग्रीष्मकालीन राजधानी — NatashaRostova14, CC0, Wikimedia Commons', url: 'https://commons.wikimedia.org/wiki/File:Bhararisain-Vidhan-sabha-Uttarakhand.jpg' }}
  published="2026-11-19" toc={toc} facts={facts} faq={faq} sources={sources}
>

<p class="pull">1 अगस्त 1949 को टिहरी के विलय के साथ पूरा पहाड़ एक प्रशासन — संयुक्त प्रांत (उत्तर प्रदेश) — में आ गया। पर अगले पचास वर्षों में यही सवाल बार-बार उठा: क्या लखनऊ से पहाड़ की ज़रूरतें समझी जा सकती हैं? इस अध्याय में उस सवाल का पूरा सफ़र है — पहली माँग से लेकर राज्य बनने और उसके बाद के 26 वर्षों तक।</p>

<section id="kyon">
  <h2>अलग राज्य क्यों? (कारण)</h2>
  <table>
    <thead><tr><th>कारण</th><th>क्या था</th></tr></thead>
    <tbody>
      <tr><td><b>भौगोलिक भिन्नता</b></td><td>पहाड़ी कृषि, सड़क, स्वास्थ्य, शिक्षा की समस्याएँ मैदान से बिलकुल अलग; उत्तर प्रदेश की योजनाएँ मैदानी ढाँचे पर बनती थीं।</td></tr>
      <tr><td><b>पलायन व बेरोज़गारी</b></td><td>रोज़गार के अभाव में युवाओं का मैदानों और सेना की ओर पलायन — "मनीऑर्डर अर्थव्यवस्था"।</td></tr>
      <tr><td><b>प्राकृतिक संसाधन</b></td><td>जंगल, पानी, बिजली परियोजनाओं का लाभ बाहर जाता था; चिपको (1973) जैसे वन आंदोलनों ने यह चेतना जगाई।</td></tr>
      <tr><td><b>राजनीतिक प्रतिनिधित्व</b></td><td>अविभाजित UP की 425 सदस्यीय विधानसभा में इस क्षेत्र की केवल 22 सीटें — पहाड़ की आवाज़ कमज़ोर।</td></tr>
      <tr><td><b>सांस्कृतिक पहचान</b></td><td>गढ़वाली-कुमाऊँनी बोली, लोक-संस्कृति, देवभूमि की अलग पहचान।</td></tr>
      <tr><td><b>तात्कालिक कारण (1994)</b></td><td>सरकारी नौकरियों व शिक्षा में <b>27% OBC आरक्षण</b> — पहाड़ में OBC आबादी 2% से भी कम, इसलिए इसे पहाड़ के युवाओं के अवसर छिनने के रूप में देखा गया।</td></tr>
    </tbody>
  </table>
  <div class="box-exam"><strong><span class="tag exam">परीक्षा बिंदु</span></strong>आंदोलन का नारा था — <b>"आरक्षण का एक इलाज, पृथक राज्य-पृथक राज"</b>। 1994 का आरक्षण-विरोध ही पृथक राज्य के जन-आंदोलन में बदल गया।</div>
</section>

<section id="shuruaat">
  <h2>शुरुआती माँगें (1938–1978)</h2>
  <table>
    <thead><tr><th>वर्ष</th><th>घटना</th></tr></thead>
    <tbody>
      <tr><td><b>5–6 मई 1938</b></td><td>कांग्रेस का विशेष राजनीतिक सम्मेलन, <b>श्रीनगर (गढ़वाल)</b> — <b>जवाहरलाल नेहरू</b> ने पहाड़ के लोगों के अपनी परिस्थितियों के अनुसार निर्णय लेने के अधिकार का समर्थन किया। <span class="tag hist">पहली प्रामाणिक माँग</span></td></tr>
      <tr><td>1940 / 1946</td><td><b>हल्द्वानी सम्मेलन</b> — <b>बद्रीदत्त पांडे</b> ने पर्वतीय क्षेत्र के लिए विशेष दर्जे की माँग की; <b>अनुसूया प्रसाद बहुगुणा</b> ने कुमाऊँ-गढ़वाल की अलग इकाई का प्रस्ताव रखा। <span class="tag myth">वर्ष पर मत-भेद</span></td></tr>
      <tr><td><b>1952</b></td><td>भारतीय कम्युनिस्ट पार्टी के महासचिव <b>पी.सी. जोशी</b> ने पर्वतीय क्षेत्र को अलग राज्य बनाने का ज्ञापन/प्रस्ताव केंद्र सरकार को दिया — किसी राष्ट्रीय दल की ओर से पहली औपचारिक माँग।</td></tr>
      <tr><td>1954</td><td>विधान परिषद सदस्य <b>इंद्र सिंह नयाल</b> ने मुख्यमंत्री गोविंद बल्लभ पंत से पहाड़ के लिए अलग विकास योजना की माँग की।</td></tr>
      <tr><td>1955</td><td><b>राज्य पुनर्गठन आयोग</b> (फ़ज़ल अली, के.एम. पणिक्कर, एच.एन. कुंज़रू) — रिपोर्ट 30 सितंबर 1955; UP का विभाजन नहीं हुआ। (देखें नीचे "सावधान")</td></tr>
      <tr><td>1957</td><td>टिहरी के पूर्व नरेश <b>मानवेंद्र शाह</b> ने पृथक राज्य के लिए आंदोलन शुरू किया।</td></tr>
      <tr><td><b>24–25 जून 1967</b></td><td>रामनगर सम्मेलन — <b>पर्वतीय राज्य परिषद</b> का गठन; अध्यक्ष <b>दया कृष्ण पांडे</b>, महासचिव नारायण दत्त सुंदरियाल।</td></tr>
      <tr><td>1968</td><td><b>ऋषिबल्लभ सुंदरियाल</b> के नेतृत्व में दिल्ली में पृथक राज्य के लिए प्रदर्शन।</td></tr>
      <tr><td>1969</td><td>उत्तर प्रदेश सरकार ने <b>पर्वतीय विकास परिषद</b> बनाई (माँग को "विकास" से शांत करने का प्रयास)।</td></tr>
      <tr><td>12 मई 1970</td><td>प्रधानमंत्री इंदिरा गांधी ने माना कि पहाड़ की समस्याओं के लिए राज्य और केंद्र दोनों उत्तरदायी हैं।</td></tr>
      <tr><td>1970–73</td><td>पी.सी. जोशी का "कुमाऊँ राष्ट्रीय मोर्चा" (1970); UP में अलग <b>पर्वतीय विकास विभाग</b> (1973); पर्वतीय राज्य परिषद का पुनर्गठन।</td></tr>
      <tr><td>1973 से</td><td><b>चिपको आंदोलन</b> (मंडल, रैणी 1974) और वन-नीलामी विरोधी आंदोलनों ने संसाधनों पर स्थानीय अधिकार की चेतना फैलाई।</td></tr>
      <tr><td>1978–79</td><td>जनता पार्टी के सांसद <b>त्रेपन सिंह नेगी</b> का "उत्तराखंड राज्य परिषद"; दिल्ली रैलियाँ।</td></tr>
    </tbody>
  </table>
  <div class="box-trap"><strong><span class="tag trap">सावधान</span></strong>
    <ul>
      <li>कई गाइड लिखती हैं कि "1955 में फ़ज़ल अली आयोग ने पर्वतीय राज्य की सिफ़ारिश की"। <b>यह सही नहीं है।</b> आयोग की मुख्य रिपोर्ट ने UP के बँटवारे की सिफ़ारिश नहीं की। सदस्य <b>के.एम. पणिक्कर</b> के असहमति-नोट ("Note on Uttar Pradesh") में UP को दो भागों में बाँटने का सुझाव था — पर वह प्रस्तावित <b>"आगरा राज्य"</b> उत्तर-पश्चिमी मैदानी ज़िलों का था, पहाड़ी राज्य नहीं।</li>
      <li>"1897 में पहली माँग" का उल्लेख कुछ लेखों में है; प्रामाणिक दस्तावेज़ उपलब्ध नहीं। <b>प्रथम प्रामाणिक माँग = 1938, श्रीनगर।</b></li>
    </ul>
  </div>
</section>

<section id="ukd">
  <h2>उक्रांद और संगठित आंदोलन (1979–1993)</h2>
  <div class="fig-row">
    <Figure file="7/79/Flag_of_Uttarakhand_Kranti_Dal.jpg" alt="उत्तराखंड क्रांति दल का झंडा" caption="उत्तराखंड क्रांति दल (उक्रांद) का झंडा — 1979 में बना पहला क्षेत्रीय दल, जिसका एकमात्र मूल लक्ष्य पृथक पहाड़ी राज्य था।" author="Atharvgairola692004" license="CC0" orig />
    <Figure file="8/8a/Mussoorie_l_Uttarakhand.jpg" alt="मसूरी की पहाड़ियों पर बसा शहर" caption="मसूरी — यहीं जुलाई 1979 में उक्रांद बना और 2 सितंबर 1994 को झूलाघर पर गोलीकांड हुआ।" author="Piyush Tripathi" license="CC BY-SA 4.0" w={500} />
  </div>
  <ul>
    <li><span class="tag exam">परीक्षा बिंदु</span> <b>24–25 जुलाई 1979</b>, <b>मसूरी</b> — "पर्वतीय जन विकास सम्मेलन" में <b>उत्तराखंड क्रांति दल (उक्रांद/UKD)</b> का गठन। संस्थापक — <b>डॉ. देवीदत्त (डी.डी.) पंत</b> (कुमाऊँ विश्वविद्यालय के पूर्व कुलपति, <b>पहले अध्यक्ष</b>), <b>बिपिन चंद्र त्रिपाठी</b>, <b>काशी सिंह ऐरी</b>, <b>इंद्रमणि बडोनी</b> आदि। सम्मेलन के संयोजक — पत्रकार द्वारिका प्रसाद उनियाल।</li>
    <li><b>1980</b> — <b>जसवंत सिंह बिष्ट</b> (रानीखेत) उक्रांद के पहले विधायक बने; बाद में UP विधानसभा में पृथक राज्य का प्रस्ताव रखा।</li>
    <li><b>1987</b> — कर्णप्रयाग में उक्रांद का अधिवेशन (जून); <b>23 नवंबर 1987</b> को दिल्ली के <b>बोट क्लब</b> पर प्रदर्शन, राष्ट्रपति को ज्ञापन — <b>हरिद्वार</b> को प्रस्तावित राज्य में शामिल करने की माँग पहली बार। इसी वर्ष दल में विभाजन भी हुआ।</li>
    <li><b>1987</b> — भाजपा के अल्मोड़ा अधिवेशन (लालकृष्ण आडवाणी) ने पृथक राज्य की माँग स्वीकार की और प्रस्तावित नाम <b>"उत्तरांचल"</b> रखा।</li>
    <li><b>1988</b> — <b>इंद्रमणि बडोनी</b> की <b>तवाघाट (पिथौरागढ़) से देहरादून</b> तक <b>105 दिन</b> की पदयात्रा; <b>शोबन सिंह जीना</b> की अध्यक्षता में "उत्तरांचल उत्थान परिषद"।</li>
    <li>1989 — विभिन्न संगठनों ने मिलकर संयुक्त संघर्ष समिति बनाई; डी.डी. पंत व बिपिन त्रिपाठी ने गैरसैंण को प्रस्तावित राजधानी माना।</li>
    <li><b>20 अगस्त 1991</b> — कल्याण सिंह (भाजपा) की उत्तर प्रदेश सरकार ने पृथक "उत्तरांचल" का प्रस्ताव केंद्र को भेजा; केंद्र ने निर्णय नहीं लिया।</li>
    <li><b>1992</b> — उक्रांद ने पृथक राज्य का दस्तावेज़ जारी किया; <b>गैरसैंण</b> को प्रस्तावित राजधानी घोषित कर नाम <b>"चंद्रनगर"</b> (वीर चंद्र सिंह गढ़वाली के नाम पर) रखा। बडोनी ने मकर संक्रांति पर बागेश्वर में यह घोषणा की — ऐसा भी उल्लेख मिलता है।</li>
  </ul>
  <div class="box-trap"><strong><span class="tag trap">सावधान</span></strong>उक्रांद की स्थापना की तिथि <b>24, 25 या 26 जुलाई 1979</b> लिखी मिलती है, और कुछ स्रोत स्थान "नैनीताल" बताते हैं। सम्मेलन मसूरी में 24–25 जुलाई को हुआ — उत्तर में <b>"1979, मसूरी"</b> चुनें।</div>
</section>

<section id="1994">
  <h2>1994: निर्णायक वर्ष</h2>
  <h3>कौशिक समिति</h3>
  <ul>
    <li>दिसंबर 1993 में मुख्यमंत्री बने <b>मुलायम सिंह यादव</b> ने नगर विकास मंत्री <b>रमाशंकर कौशिक</b> की अध्यक्षता में मंत्रिमंडलीय समिति बनाई — प्रस्तावित राज्य की संरचना और राजधानी पर विचार के लिए।</li>
    <li><span class="tag exam">परीक्षा बिंदु</span> <b>5 मई 1994</b> — रिपोर्ट: तत्कालीन <b>8 पर्वतीय ज़िलों</b> को मिलाकर पृथक राज्य, <b>3 मंडल</b>, और राजधानी <b>गैरसैंण</b> (रिपोर्ट के जनमत-सर्वेक्षण में गैरसैंण के पक्ष में लगभग 60% राय)।</li>
    <li><b>21 जून 1994</b> — सरकार ने संस्तुतियाँ स्वीकार कीं; <b>24 अगस्त 1994</b> — UP विधानसभा ने सर्वसम्मति से पृथक राज्य का प्रस्ताव पारित कर केंद्र को भेजा।</li>
    <li>इसी वर्ष <b>विनोद बड़थ्वाल</b> की अध्यक्षता में एक और समिति — बुद्धिजीवियों और ग़ैर-राजनीतिक लोगों की राय जानने के लिए।</li>
  </ul>
  <div class="box-trap"><strong><span class="tag trap">सावधान</span></strong>कई गाइड कौशिक समिति का गठन "जनवरी 1993" लिखती हैं — यह संभव नहीं, क्योंकि उत्तर प्रदेश में 6 दिसंबर 1992 से दिसंबर 1993 तक राष्ट्रपति शासन था और मुलायम सिंह दिसंबर 1993 में मुख्यमंत्री बने। गठन <b>1994 की शुरुआत</b> (एक स्रोत: 4 जनवरी 1994) में हुआ। रिपोर्ट <b>मई 1994</b> — इस पर सभी सहमत हैं।</div>
  <h3>आरक्षण विरोध से जन-आंदोलन तक</h3>
  <ul>
    <li><b>मार्च–जून 1994</b> — UP सरकार ने सरकारी सेवाओं और (17 जून 1994 से) शैक्षिक संस्थानों में <b>27% OBC आरक्षण</b> लागू किया; पूरे पहाड़ में छात्र सड़कों पर।</li>
    <li><span class="tag exam">परीक्षा बिंदु</span> <b>2 अगस्त 1994</b> — <b>इंद्रमणि बडोनी</b> ने <b>पौड़ी</b> (कमिश्नरी) में उक्रांद के साथियों सहित <b>आमरण अनशन</b> शुरू किया; <b>7 अगस्त</b> की रात गिरफ़्तारी के बाद आंदोलन भड़क उठा।</li>
    <li><b>8 अगस्त 1994</b> — पौड़ी में <b>जीत बहादुर गुरुंग</b> — आंदोलन के <b>पहले शहीद</b>।</li>
    <li>"उत्तराखंड संयुक्त संघर्ष समिति", उत्तराखंड महिला मंच, छात्र संघर्ष समितियाँ, पूर्व सैनिक और सरकारी कर्मचारी (लगभग तीन माह की हड़ताल) — आंदोलन दलों से ऊपर उठकर जनता का आंदोलन बना। <b>महिलाओं</b> की भागीदारी इसकी सबसे बड़ी पहचान रही।</li>
  </ul>
</section>

<section id="kand">
  <h2>गोलीकांड और दमन (1994–95)</h2>
  <Figure file="2/2e/Khatima_Chauraha.jpg" alt="खटीमा का मुख्य चौराहा" caption="खटीमा (ऊधम सिंह नगर) — 1 सितंबर 1994 को यहीं पुलिस फ़ायरिंग में 7 आंदोलनकारी शहीद हुए; यह आंदोलन का पहला बड़ा गोलीकांड था।" author="ArmouredCyborg" license="CC BY-SA 4.0" w={960} />
  <table>
    <thead><tr><th>घटना</th><th>तिथि</th><th>क्या हुआ / शहीद</th></tr></thead>
    <tbody>
      <tr><td><b>खटीमा गोलीकांड</b> (तत्कालीन नैनीताल ज़िला, अब ऊधम सिंह नगर)</td><td><b>1 सितंबर 1994</b></td><td>पूर्व सैनिकों, छात्रों व महिलाओं की रैली पर बिना चेतावनी फ़ायरिंग; <b>7 शहीद</b> — प्रचलित सूची: धर्मानंद भट्ट, गोपीचंद, परमजीत सिंह, प्रताप सिंह, रामपाल, सलीम अहमद, भगवान सिंह सिरौला</td></tr>
      <tr><td><b>मसूरी गोलीकांड</b> (झूलाघर)</td><td><b>2 सितंबर 1994</b></td><td>खटीमा के विरोध में मौन जुलूस पर फ़ायरिंग; <b>6 आंदोलनकारी शहीद</b> — <b>बेलमती चौहान, हंसा धनाई</b> (दो महिलाएँ), बलबीर सिंह, राय सिंह बंगारी, मदन मोहन ममगाईं, धनपत सिंह; पुलिस उपाधीक्षक <b>उमाकांत त्रिपाठी</b> की भी मृत्यु; 18 गंभीर घायल</td></tr>
      <tr><td><b>रामपुर तिराहा कांड</b> (मुज़फ़्फ़रनगर, UP)</td><td><b>1–2 अक्टूबर 1994</b> की रात</td><td>दिल्ली रैली (गांधी जयंती) में जा रहे आंदोलनकारियों को रोककर लाठीचार्ज, आँसू गैस, फ़ायरिंग; महिलाओं से अभद्रता व दुष्कर्म; <b>6–7 शहीद</b> (प्रचलित सूची में सूर्यप्रकाश थपलियाल, रवींद्र रावत, राजेश लखेड़ा, गिरीश भद्री, सतेंद्र चौहान, अशोक कुमार कैशिव, राजेश नेगी)। 2 अक्टूबर = <b>"काला दिवस"</b></td></tr>
      <tr><td><b>देहरादून</b></td><td>3 अक्टूबर 1994</td><td>रामपुर तिराहा के शहीद रवींद्र रावत की अंत्येष्टि के बाद हिंसा, फ़ायरिंग में 3 मृत; 7 अक्टूबर को एक महिला आंदोलनकारी की मृत्यु; 15 अक्टूबर को कर्फ़्यू</td></tr>
      <tr><td><b>कोटद्वार</b></td><td>3 अक्टूबर 1994</td><td>पुलिस पिटाई से 2 आंदोलनकारियों की मृत्यु</td></tr>
      <tr><td><b>नैनीताल</b></td><td>3 अक्टूबर 1994</td><td>होटल कर्मचारी <b>प्रताप सिंह</b> को RAF ने होटल मेघदूत के पास गोली मारी</td></tr>
      <tr><td><b>श्रीयंत्र टापू कांड</b> (श्रीनगर गढ़वाल, अलकनंदा)</td><td><b>10 नवंबर 1995</b></td><td>उक्रांद अध्यक्ष <b>दिवाकर भट्ट</b> के नेतृत्व में टापू पर अनशन; पुलिस ने घेरकर पिटाई की; <b>यशोधर बेंजवाल</b> व <b>राजेश रावत</b> अलकनंदा में बहा दिए गए — शव बाद में <b>बगवान</b> के पास मिले</td></tr>
    </tbody>
  </table>
  <Figure file="2/2b/Landscape_view_of_River_Alaknanda_at_Srinagar_Garhwal.jpg" alt="श्रीनगर गढ़वाल में अलकनंदा नदी और घाटी" caption="श्रीनगर गढ़वाल में अलकनंदा — इसी नदी के श्रीयंत्र टापू पर 10 नवंबर 1995 को अनशनकारियों पर पुलिस कार्रवाई हुई।" author="Nitin Maletha" license="CC BY-SA 4.0" w={960} />
  <ul>
    <li><b>2 अक्टूबर 1994</b> — संयुक्त मोर्चे के आह्वान पर दिल्ली में विशाल प्रदर्शन; रामपुर तिराहा की ख़बर से रैली आक्रोश में बदली।</li>
    <li><b>27 अक्टूबर 1994</b> — केंद्रीय गृह राज्य मंत्री <b>राजेश पायलट</b> ने आंदोलनकारियों से वार्ता की।</li>
    <li>रामपुर तिराहा मामले की जाँच <b>CBI</b> को सौंपी गई (इलाहाबाद उच्च न्यायालय के निर्देश पर); <b>18 मार्च 2024</b> — मुज़फ़्फ़रनगर की अदालत ने एक आंदोलनकारी महिला से सामूहिक दुष्कर्म के मामले में PAC के दो पूर्व सिपाहियों को <b>आजीवन कारावास</b> दिया।</li>
    <li>पूरे आंदोलन में लगभग <b>40 से अधिक</b> आंदोलनकारी शहीद हुए (स्रोतों में संख्या भिन्न)।</li>
  </ul>
  <div class="box-trap"><strong><span class="tag trap">सावधान</span></strong>
    <ul>
      <li>श्रीयंत्र टापू कांड — <b>10 नवंबर 1995</b>। अंग्रेज़ी विकिपीडिया इसे 1994 में रखता है, पर श्रीनगर में हर वर्ष की बरसी, स्थानीय समाचार और उक्रांद के कार्यक्रम 1995 ही मानते हैं।</li>
      <li>रामपुर तिराहा उत्तराखंड में नहीं, <b>उत्तर प्रदेश के मुज़फ़्फ़रनगर</b> में है। "मुज़फ़्फ़रनगर कांड" भी इसी को कहते हैं।</li>
      <li>मसूरी में फ़ायरिंग की जगह — <b>झूलाघर</b> (उक्रांद कार्यालय के पास)।</li>
    </ul>
  </div>
</section>

<section id="adhiniyam">
  <h2>घोषणा से अधिनियम तक (1996–2000)</h2>
  <ul>
    <li><b>3 जून 1995</b> — मुलायम सिंह सरकार गई; आंदोलन का दबाव अब केंद्र पर।</li>
    <li><span class="tag exam">परीक्षा बिंदु</span> <b>15 अगस्त 1996</b> — प्रधानमंत्री <b>एच.डी. देवगौड़ा</b> ने <b>लाल किले</b> से उत्तरांचल राज्य बनाने की घोषणा की।</li>
    <li><b>1998</b> — वाजपेयी (NDA) सरकार ने राष्ट्रपति के माध्यम से "उत्तरांचल विधेयक" UP विधानसभा को राय हेतु भेजा; विधानसभा ने <b>26 संशोधनों</b> के साथ लौटाया।</li>
    <li>इंद्रमणि बडोनी — "उत्तराखंड के गांधी" — राज्य बनते नहीं देख पाए; <b>18 अगस्त 1999</b> को उनका निधन हुआ।</li>
  </ul>
