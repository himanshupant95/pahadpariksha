  { id: 'shuruaat', label: 'शुरुआती माँगें (1938–1978)' },
  { id: 'ukd', label: 'उक्रांद और संगठित आंदोलन (1979–1993)' },
  { id: '1994', label: '1994: निर्णायक वर्ष' },
  { id: 'kand', label: 'गोलीकांड और दमन (1994–95)' },
  { id: 'adhiniyam', label: 'घोषणा से अधिनियम तक (1996–2000)' },
  { id: 'gathan', label: '9 नवंबर 2000: नया राज्य' },
  { id: 'rajdhani', label: 'राजधानी प्रश्न: देहरादून बनाम गैरसैंण' },
