  { id: 'aapda', label: 'आपदाएँ और सबक' },
  { id: 'rajat', label: 'रजत जयंती और 2026 तक' },
  { id: 'vyaktitva', label: 'प्रमुख व्यक्तित्व' },
  { id: 'matbhed', label: 'तिथियों में मत-भेद (एक जगह)' },
  { id: 'samayrekha', label: 'समयरेखा' },
  { id: 'pariksha', label: 'परीक्षा बिंदु (One-liners)' },
  { id: 'quiz', label: 'क्विज़ (15 प्रश्न)' },
  { id: 'faq', label: 'FAQ' },
];

const facts = [
  { k: 'पहली माँग', v: 'कांग्रेस का विशेष अधिवेशन, <b>श्रीनगर (गढ़वाल), 5–6 मई 1938</b>' },
  { k: 'मुख्य दल', v: '<b>उत्तराखंड क्रांति दल</b> — मसूरी, <b>24–25 जुलाई 1979</b>; पहले अध्यक्ष डॉ. डी.डी. पंत' },
  { k: 'निर्णायक वर्ष', v: '<b>1994</b> — खटीमा (1 सित.), मसूरी (2 सित.), रामपुर तिराहा (1–2 अक्टू.)' },
  { k: 'घोषणा', v: 'प्रधानमंत्री <b>एच.डी. देवगौड़ा</b>, लाल किले से, <b>15 अगस्त 1996</b>' },
  { k: 'अधिनियम', v: '<b>उत्तर प्रदेश पुनर्गठन अधिनियम, 2000</b> (अधिनियम सं. 29) — राष्ट्रपति स्वीकृति <b>25 अगस्त 2000</b>' },
  { k: 'राज्य गठन', v: '<b>9 नवंबर 2000</b> — भारत का <b>27वाँ राज्य</b>, नाम "उत्तरांचल"' },
  { k: 'नाम परिवर्तन', v: '<b>1 जनवरी 2007</b> से "उत्तराखंड" (उत्तरांचल नाम-परिवर्तन अधिनियम, 2006)' },
  { k: 'राजधानी', v: '<b>देहरादून</b> (अस्थायी/शीतकालीन); <b>गैरसैंण (भराड़ीसैंण)</b> — ग्रीष्मकालीन, अधिसूचना <b>8 जून 2020</b>' },
  { k: 'सीटें', v: 'विधानसभा <b>70</b> · लोकसभा <b>5</b> · राज्यसभा <b>3</b>' },
  { k: 'नवंबर 2026 में', v: 'मुख्यमंत्री <b>पुष्कर सिंह धामी</b> · राज्यपाल <b>डॉ. ढाल सिंह बिसेन</b> (9वें, शपथ 19 अक्टूबर 2026)' },
];

const faq = [
  { q: 'उत्तराखंड राज्य की माँग सबसे पहले कब उठी?', a: 'प्रामाणिक रूप से सबसे पहले 5–6 मई 1938 को श्रीनगर (गढ़वाल) में कांग्रेस के विशेष राजनीतिक सम्मेलन में, जहाँ जवाहरलाल नेहरू ने पहाड़ के लोगों को अपनी परिस्थितियों के अनुसार स्वयं निर्णय लेने के अधिकार का समर्थन किया। कुछ लेखक 1897 (महारानी विक्टोरिया को ज्ञापन) को पहली माँग बताते हैं, पर उसका प्रामाणिक दस्तावेज़ी स्रोत स्पष्ट नहीं है। परीक्षा में "1938, श्रीनगर" सबसे सुरक्षित उत्तर है।' },
  { q: 'रामपुर तिराहा कांड कब और कहाँ हुआ?', a: '1 और 2 अक्टूबर 1994 की रात, मुज़फ़्फ़रनगर (उत्तर प्रदेश) के रामपुर तिराहे पर। गांधी जयंती पर दिल्ली (राजघाट/लाल किला) की रैली में जा रहे आंदोलनकारियों को पुलिस ने रोका, गोली चलाई और महिलाओं के साथ दुर्व्यवहार हुआ; 6–7 आंदोलनकारी शहीद हुए। उत्तराखंड में 2 अक्टूबर "काला दिवस" के रूप में याद किया जाता है। मार्च 2024 में मुज़फ़्फ़रनगर की अदालत ने इससे जुड़े एक मामले में PAC के दो पूर्व सिपाहियों को आजीवन कारावास दिया।' },
  { q: 'उत्तर प्रदेश पुनर्गठन विधेयक 2000 को राष्ट्रपति की स्वीकृति कब मिली — 25 या 28 अगस्त?', a: 'भारत सरकार के India Code में अधिनियम (सं. 29, 2000) की तिथि 25 अगस्त 2000 दर्ज है, जो राष्ट्रपति के. आर. नारायणन की स्वीकृति की तिथि है। कई गाइड और विकिपीडिया 28 अगस्त लिखते हैं। लोकसभा ने विधेयक 1 अगस्त और राज्यसभा ने 10 अगस्त 2000 को (संशोधनों सहित) पारित किया; लोकसभा ने 11 अगस्त को संशोधन स्वीकार किए। अधिनियम 9 नवंबर 2000 से लागू हुआ।' },
  { q: 'गैरसैंण को राजधानी क्यों माना गया और आज उसकी स्थिति क्या है?', a: 'गैरसैंण (चमोली) कुमाऊँ और गढ़वाल के लगभग बीच में है, इसलिए आंदोलनकारियों ने इसे पहाड़ी राज्य की स्वाभाविक राजधानी माना। उक्रांद ने 1992 में इसे प्रस्तावित राजधानी घोषित कर "चंद्रनगर" नाम दिया, और 1994 में कौशिक समिति ने भी गैरसैंण की संस्तुति की। राज्य बनने पर देहरादून अस्थायी राजधानी बना। 4 मार्च 2020 को विधानसभा में भराड़ीसैंण (गैरसैंण) को ग्रीष्मकालीन राजधानी घोषित किया गया और 8 जून 2020 को अधिसूचना जारी हुई। स्थायी राजधानी का प्रश्न अब भी खुला है।' },
  { q: 'उत्तराखंड के अब तक कितने मुख्यमंत्री हुए?', a: '10 व्यक्ति — नित्यानंद स्वामी, भगत सिंह कोश्यारी, नारायण दत्त तिवारी, भुवन चंद्र खंडूड़ी (दो बार), रमेश पोखरियाल "निशंक", विजय बहुगुणा, हरीश रावत (तीन बार), त्रिवेंद्र सिंह रावत, तीरथ सिंह रावत और पुष्कर सिंह धामी (दो कार्यकाल)। 2016 में दो बार राष्ट्रपति शासन लगा। एन.डी. तिवारी पाँच वर्ष का कार्यकाल पूरा करने वाले पहले मुख्यमंत्री थे; जुलाई 2026 में पुष्कर सिंह धामी सबसे लंबे समय तक पद पर रहने वाले मुख्यमंत्री बन गए।' },
];

