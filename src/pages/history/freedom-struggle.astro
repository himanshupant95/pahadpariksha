];

const faq = [
  { q: 'कुली बेगार आंदोलन कब और कहाँ हुआ?', a: 'मकर संक्रांति पर बागेश्वर के उत्तरायणी मेले में, सरयू-गोमती संगम (सरयू बगड़) पर। बद्रीदत्त पांडे, हरगोविंद पंत और चिरंजीलाल साह के नेतृत्व में हज़ारों लोगों ने कुली बेगार के रजिस्टर सरयू में बहा दिए और बेगार न देने की शपथ ली। तिथि प्रायः 14 जनवरी 1921 लिखी जाती है; कुछ स्रोत 13 जनवरी बताते हैं — परीक्षा में विकल्पों को देखकर उत्तर दें। गांधी जी ने इसे "रक्तहीन क्रांति" कहा।' },
  { q: 'पेशावर कांड में क्या हुआ था?', a: '23 अप्रैल 1930 को पेशावर के क़िस्सा ख़्वानी बाज़ार में ख़ान अब्दुल ग़फ़्फ़ार ख़ान के समर्थन में जुटे निहत्थे पठानों पर गोली चलाने का आदेश मिलने पर 2/18 रॉयल गढ़वाल राइफल्स के हवलदार मेजर चंद्र सिंह भंडारी ने "गढ़वाली सीज़ फ़ायर" कहा और सैनिकों ने हथियार नीचे रख दिए। सैनिकों का कोर्ट मार्शल हुआ; चंद्र सिंह को लंबी क़ैद मिली और वे 26 सितंबर 1941 को रिहा हुए। तभी से वे "चंद्र सिंह गढ़वाली" कहलाए।' },
  { q: 'श्रीदेव सुमन की मृत्यु कब हुई — 1944 या 1945?', a: '25 जुलाई 1944। वे 30 दिसंबर 1943 से टिहरी जेल में थे और 3 मई 1944 से आमरण अनशन पर थे; 84वें दिन उनका बलिदान हुआ और शव भिलंगना में बहा दिया गया। UOU की पुस्तक के एक अध्याय में यह तिथि 1945 छपी है — परीक्षा के लिए 1944 ही सही उत्तर है।' },
  { q: '"कुमाऊँ की बारदोली" किसे कहा जाता है?', a: 'अल्मोड़ा जिले के सल्ट क्षेत्र को। 5 सितंबर 1942 को खुमाड़ में भारत छोड़ो आंदोलन के दौरान पुलिस गोलीबारी में गंगाराम और खीमानंद (दो भाई) मौके पर शहीद हुए; चूड़ामणि और बहादुर सिंह मेहरा ने बाद में दम तोड़ा। सल्ट के संघर्ष के कारण इसे "कुमाऊँ की बारदोली" कहा गया; हर वर्ष 5 सितंबर को खुमाड़ में शहीद दिवस मनाया जाता है।' },
  { q: 'तिलाड़ी कांड क्या था?', a: 'टिहरी रियासत की कठोर वन नीति के विरोध में 30 मई 1930 को रवाईं घाटी में यमुना किनारे तिलाड़ी के मैदान में आज़ाद पंचायत के लिए जुटे ग्रामीणों पर रियासत की सेना ने दीवान चक्रधर जुयाल के आदेश पर गोली चलाई। सेनापति सुंदर सिंह ने गोली चलाने से मना किया तो उन्हें हटाकर नत्थू सिंह सजवाण को भेजा गया। सरकारी आँकड़ा 18 मृत्यु का है, स्थानीय विवरण कहीं अधिक बताते हैं; कई लोग यमुना में कूदकर बह गए। राजा नरेंद्र शाह उस समय यूरोप में थे। इसे "गढ़वाल का जलियाँवाला बाग़" कहा जाता है।' },
];

