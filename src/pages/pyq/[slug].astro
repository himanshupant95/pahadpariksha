---
import Article from '../../layouts/Article.astro';
import { PAPERS, LETTER, type PyqPaper } from '../../data/pyq';

export function getStaticPaths() {
  return PAPERS.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props as { p: PyqPaper };
const topics = [...new Set(p.questions.map((q) => q.t))];
const deleted = p.questions.filter((q) => q.a === null).length;
const others = PAPERS.filter((x) => x.slug !== p.slug);
const faq = [
  { q: `${p.short} में उत्तराखंड से जुड़े कितने प्रश्न थे?`, a: `इस पेज पर ${p.questions.length} प्रश्न हैं जो सीधे उत्तराखंड से जुड़े हैं (इतिहास, भूगोल, राजव्यवस्था, अर्थव्यवस्था, संस्कृति और राज्य के करेंट अफेयर्स)। बाकी प्रश्न भारत और विश्व से जुड़े थे।` },
  { q: 'उत्तर कहाँ से लिए गए हैं?', a: `हर उत्तर उत्तराखंड लोक सेवा आयोग की ${p.keyType} (${p.keyDate}, सीरीज़ ${p.series}) से है। व्याख्या हमारी है; जहाँ आयोग का उत्तर किताबों से अलग दिखता है, वहाँ यह साफ़ लिखा है।` },
];
---
<Article
  title={`${p.short}: उत्तराखंड प्रश्न, आधिकारिक उत्तर सहित`}
  description={`${p.title} (${p.examDate}) के उत्तराखंड से जुड़े ${p.questions.length} प्रश्न, UKPSC की ${p.keyType} से उत्तर और सरल हिंदी व्याख्या के साथ।`}
  breadcrumbs={[{ name: 'पिछले वर्षों के प्रश्न', href: '/pyq/' }]}
  published="2026-11-21"
  hideHero={true}
  faq={faq}
>
  <div class="keypoints">
    <h2>इस प्रश्नपत्र के बारे में</h2>
    <ul>
      <li><b>परीक्षा:</b> {p.title}</li>
      <li><b>प्रश्नपत्र:</b> {p.paper}; परीक्षा तिथि {p.examDate}</li>
      <li><b>उत्तर:</b> UKPSC की <a href={p.keyUrl} rel="nofollow noopener" target="_blank">{p.keyType}</a>, {p.keyDate} (प्रश्न-पुस्तिका कोड {p.code}, सीरीज़ {p.series})। {deleted > 0 && <span>आयोग द्वारा हटाए गए प्रश्न: {deleted}।</span>}</li>
      <li>यहाँ केवल <b>उत्तराखंड से जुड़े {p.questions.length} प्रश्न</b> हैं, मूल प्रश्न-क्रमांक के साथ। प्रश्न हिंदी में सरल रूप में लिखे गए हैं; विवाद होने पर आयोग का मूल अंग्रेज़ी रूपांतर मान्य होता है।</li>
    </ul>
  </div>

  <p class="chips">{topics.map((t) => <span>{t} ({p.questions.filter((q) => q.t === t).length})</span>)}</p>
  <p class="small">पहले ख़ुद उत्तर सोचें, फिर "उत्तर देखें" पर क्लिक करें।</p>

  <ol class="pyq">
    {p.questions.map((q) => (
      <li id={`q${q.n}`}>
        <p class="qn"><span class="num">प्रश्न {q.n}</span> <span class="tag">{q.t}</span></p>
        <p class="qq">{q.q}</p>
        {q.st && <ul class="st">{q.st.map(([k, v]) => <li><b>{k}</b> {v}</li>)}</ul>}
        {q.m && (
          <table class="mt">
            <thead><tr><th>सूची-I ({q.m.h[0]})</th><th>सूची-II ({q.m.h[1]})</th></tr></thead>
            <tbody>{q.m.a.map((x, i) => <tr><td>{x}</td><td>{q.m!.b[i] ?? ''}</td></tr>)}</tbody>
          </table>
        )}
        {q.tail && <p class="qq">{q.tail}</p>}
        <ol class="opts" type="a">{q.o.map((o) => <li>{o}</li>)}</ol>
        <details>
          <summary>उत्तर देखें</summary>
          {q.a === null
            ? <p class="ans del">आयोग ने यह प्रश्न हटा दिया (Deleted)।</p>
            : <p class="ans">उत्तर: ({LETTER[q.a].toLowerCase()}) {q.o[q.a]}</p>}
          <p>{q.e} {q.link && <a href={q.link}>विस्तार से पढ़ें</a>}</p>
        </details>
      </li>
    ))}
  </ol>

  <h2 id="aur">दूसरे प्रश्नपत्र</h2>
  <ul>{others.map((x) => <li><a href={`/pyq/${x.slug}/`}>{x.short}</a> ({x.questions.length} प्रश्न)</li>)}</ul>
  <p><a href="/pyq/">सभी प्रश्नपत्र एक जगह →</a></p>
</Article>

<style>
  .chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .chips span { background: #ecfdf5; border: 1px solid #a7f3d0; border-radius: 999px; padding: 2px 10px; font-size: .9rem; }
  .small { font-size: .9rem; color: #475569; }
  ol.pyq { list-style: none; padding: 0; }
  ol.pyq > li { border: 1px solid #e2e8f0; border-radius: 12px; padding: 12px 16px; margin: 12px 0; background: #fff; }
  .qn { margin: 0 0 4px; font-size: .85rem; }
  .qn .num { font-weight: 700; color: #14532d; }
  .qn .tag { background: #f1f5f9; border-radius: 999px; padding: 1px 8px; margin-left: 6px; color: #475569; }
  .qq { margin: 4px 0; font-weight: 600; }
  .st { list-style: none; margin: 6px 0; padding: 8px 12px; background: #f8fafc; border-left: 3px solid #86efac; border-radius: 8px; }
  .st li { margin: 4px 0; }
  table.mt { margin: 6px 0 8px; font-size: .95rem; }
  table.mt th { background: #f0fdf4; }
  .opts { margin: 4px 0 8px 1.2em; padding: 0; }
  .opts li { margin: 2px 0; }
  details summary { cursor: pointer; color: #166534; font-weight: 600; }
  .ans { font-weight: 700; color: #14532d; margin: 6px 0 2px; }
  .ans.del { color: #b91c1c; }
</style>
