---
import Base from '../layouts/Base.astro';
import { SITE } from '../data/site';
---
<Base title="गोपनीयता नीति (Privacy Policy)" description={`${SITE.name} की गोपनीयता नीति — हम कौन सी जानकारी एकत्र करते हैं और उसका उपयोग कैसे होता है।`}>
  <h1>गोपनीयता नीति (Privacy Policy)</h1>
  <p class="muted">प्रभावी तिथि: 16 नवंबर 2026</p>
  <p>{SITE.name} ({SITE.url}) आपकी गोपनीयता का सम्मान करता है। यह नीति बताती है कि इस वेबसाइट पर कौन सी जानकारी एकत्र होती है और उसका उपयोग कैसे किया जाता है।</p>
  <h2>हम कौन सी जानकारी एकत्र करते हैं</h2>
  <ul>
    <li><strong>व्यक्तिगत जानकारी:</strong> हम कोई खाता या पंजीकरण नहीं माँगते। यदि आप हमें ईमेल करते हैं, तो केवल उत्तर देने के लिए आपका ईमेल पता उपयोग होता है।</li>
    <li><strong>उपयोग संबंधी जानकारी:</strong> वेबसाइट सुधारने के लिए हम विश्लेषण उपकरण (जैसे Google Analytics) का उपयोग कर सकते हैं, जो ब्राउज़र प्रकार, देखे गए पेज और अनुमानित स्थान जैसी गैर-व्यक्तिगत जानकारी एकत्र करते हैं।</li>
  </ul>
  <h2>कुकीज़ और विज्ञापन</h2>
  <p>इस वेबसाइट पर Google AdSense सहित तृतीय-पक्ष विज्ञापन दिखाए जा सकते हैं। Google सहित तृतीय-पक्ष विक्रेता कुकीज़ का उपयोग करके आपकी इस और अन्य वेबसाइटों की पिछली विज़िट के आधार पर विज्ञापन दिखाते हैं। Google की विज्ञापन कुकीज़ के उपयोग से Google और उसके भागीदार आपकी विज़िट के आधार पर विज्ञापन दिखा पाते हैं।</p>
  <p>आप <a href="https://adssettings.google.com/" rel="noopener" target="_blank">Google विज्ञापन सेटिंग</a> में जाकर वैयक्तिकृत विज्ञापन बंद कर सकते हैं, या <a href="https://www.aboutads.info/" rel="noopener" target="_blank">aboutads.info</a> पर तृतीय-पक्ष विक्रेताओं की कुकीज़ से बाहर निकल सकते हैं।</p>
  <h2>तृतीय-पक्ष लिंक</h2>
  <p>हमारी साइट पर अन्य वेबसाइटों के लिंक हैं। उनकी गोपनीयता नीतियों के लिए हम ज़िम्मेदार नहीं हैं।</p>
  <h2>संपर्क फ़ॉर्म</h2>
  <p>संपर्क फ़ॉर्म में आप जो जानकारी (नाम, ईमेल/मोबाइल, संदेश) देते हैं, वह Google Forms के माध्यम से हमें मिलती है और केवल आपके संदेश का उत्तर देने या पेज सुधारने के लिए उपयोग होती है। इसे किसी तीसरे पक्ष को बेचा या साझा नहीं किया जाता।</p>
  <h2>बच्चों की गोपनीयता</h2>
  <p>हम जानबूझकर 13 वर्ष से कम आयु के बच्चों की व्यक्तिगत जानकारी एकत्र नहीं करते।</p>
  <h2>नीति में बदलाव</h2>
  <p>इस नीति में समय-समय पर बदलाव हो सकते हैं; अद्यतन संस्करण इसी पेज पर प्रकाशित होगा।</p>
  <h2>संपर्क</h2>
  <p>प्रश्नों के लिए <a href="/contact/">संपर्क फ़ॉर्म</a> का उपयोग करें।</p>
</Base>
