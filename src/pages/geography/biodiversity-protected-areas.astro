      <tr><td><b>गोविंद (पशु विहार)</b></td><td>1955</td><td>~481–486</td><td>उत्तरकाशी</td><td>राज्य का सबसे पुराना अभयारण्य</td></tr>
      <tr><td><b>केदारनाथ</b> (कस्तूरी मृग)</td><td>1972</td><td>~957–975</td><td>चमोली, रुद्रप्रयाग</td><td>सबसे बड़ा अभयारण्य; कस्तूरी मृग, मोनाल; चोपता-तुंगनाथ</td></tr>
      <tr><td><b>अस्कोट</b> (कस्तूरी मृग)</td><td>1986</td><td>~600</td><td>पिथौरागढ़</td><td>काली-गोरी घाटियाँ; हिम तेंदुआ, कस्तूरी मृग</td></tr>
      <tr><td><b>सोनानदी</b></td><td>1987</td><td>~301</td><td>पौड़ी</td><td>कॉर्बेट टाइगर रिज़र्व से सटा</td></tr>
      <tr><td><b>बिनसर</b></td><td>1988</td><td>~46</td><td>अल्मोड़ा</td><td>बाँज वनों के संरक्षण हेतु; चंद राजाओं की ग्रीष्म राजधानी</td></tr>
      <tr><td><b>मसूरी (बिनोग)</b></td><td>1993</td><td>~11</td><td>देहरादून</td><td>सबसे छोटा; हिमालयी बटेर (Mountain Quail) से जुड़ा, जो 1876 के बाद विश्वसनीय रूप से नहीं दिखी</td></tr>
      <tr><td><b>नंधौर</b></td><td>2012</td><td>~270</td><td>नैनीताल, चंपावत</td><td>सबसे नया; नेपाल के शुक्लाफाँटा से जुड़ने वाला गलियारा</td></tr>
    </tbody>
  </table></div>
  <div class="box-myth"><strong><span class="tag myth">आँकड़ों में अंतर</span></strong>अभयारण्यों के क्षेत्रफल अधिसूचना, पुनर्सीमांकन और स्रोत के अनुसार बदलते हैं (जैसे केदारनाथ 957 या 975 वर्ग किमी; अस्कोट 1986 या 1987)। ऊपर दिए वर्ष WII राष्ट्रीय वन्यजीव डेटाबेस व अधिकांश स्रोतों के अनुसार हैं।</div>
  <p>हमारी गणना: 6 राष्ट्रीय उद्यान (~4,915 वर्ग किमी) + 7 अभयारण्य (~2,670 वर्ग किमी) ≈ 7,585 वर्ग किमी — राज्य के क्षेत्रफल का लगभग <b>14%</b> (संरक्षण आरक्षित जोड़कर ~14.6%)।</p>
</section>

