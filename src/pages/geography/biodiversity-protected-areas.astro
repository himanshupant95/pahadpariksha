  <div class="table-wrap"><table>
    <thead><tr><th>श्रेणी</th><th>कानून / संस्था</th><th>मानवीय गतिविधि</th><th>उत्तराखंड में संख्या</th></tr></thead>
    <tbody>
      <tr><td><b>राष्ट्रीय उद्यान</b></td><td>वन्यजीव (संरक्षण) अधिनियम 1972</td><td>सबसे कठोर — चराई, अधिकार-उपयोग प्रायः नहीं</td><td>6</td></tr>
      <tr><td><b>वन्यजीव अभयारण्य</b></td><td>वन्यजीव (संरक्षण) अधिनियम 1972</td><td>कुछ नियंत्रित गतिविधियाँ अनुमत</td><td>7</td></tr>
      <tr><td><b>संरक्षण आरक्षित</b></td><td>WPA संशोधन 2002 — सरकारी भूमि पर, समुदाय-परामर्श से</td><td>गलियारे/बफ़र; स्थानीय उपयोग संभव</td><td>4</td></tr>
      <tr><td><b>टाइगर रिज़र्व</b></td><td>NTCA (प्रोजेक्ट टाइगर 1973)</td><td>कोर (कठोर) + बफ़र</td><td>2</td></tr>
      <tr><td><b>बायोस्फ़ीयर रिज़र्व</b></td><td>भारत सरकार; UNESCO MAB नेटवर्क</td><td>कोर, बफ़र, संक्रमण क्षेत्र</td><td>1 (नंदा देवी)</td></tr>
      <tr><td><b>रामसर स्थल</b></td><td>रामसर संधि 1971 (आर्द्रभूमि)</td><td>विवेकपूर्ण उपयोग</td><td>1 (आसन)</td></tr>
      <tr><td><b>विश्व धरोहर (प्राकृतिक)</b></td><td>UNESCO</td><td>—</td><td>1 (नंदा देवी व फूलों की घाटी रा.उ.)</td></tr>
    </tbody>
  </table></div>
</section>

<section id="naksha">
  <h2>संरक्षित क्षेत्र मानचित्र</h2>
  <GeoMap name="g08-protected-areas" w={1500} h={1393} alt="उत्तराखंड का संरक्षित क्षेत्र मानचित्र: गहरे हरे राष्ट्रीय उद्यान, हल्के हरे अभयारण्य और नीले बिंदुओं में संरक्षण आरक्षित" caption="दो स्पष्ट समूह: दक्षिण में शिवालिक-तराई (राजाजी, कॉर्बेट, सोनानदी, नंधौर — बाघ-हाथी) और उत्तर में ऊँचा हिमालय (गोविंद, गंगोत्री, केदारनाथ, फूलों की घाटी, नंदा देवी, अस्कोट — हिम तेंदुआ, कस्तूरी मृग)।" source="मानचित्र: पहाड़ परीक्षा · सीमाएँ © OpenStreetMap contributors (ODbL) — अधिसूचित सीमाओं से भिन्न हो सकती हैं · राज्य/ज़िला सीमाएँ DataMeet (CC BY 4.0)" eager />
  <div class="box-myth"><strong><span class="tag myth">मानचित्र की सीमा</span></strong>OpenStreetMap में नंधौर अभयारण्य और चारों संरक्षण आरक्षितों की सीमाएँ उपलब्ध नहीं थीं, इसलिए वे अनुमानित बिंदुओं (*) से दिखाए गए हैं। आधिकारिक सीमाएँ वन विभाग की अधिसूचनाओं में हैं।</div>
