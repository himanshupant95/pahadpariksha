const faq = [
  { q: 'उत्तराखंड में कितने हिमनद हैं?', a: 'कोई एक "सरकारी" संख्या नहीं है। भारतीय भूवैज्ञानिक सर्वेक्षण (GSI) के लिए Raina और Srivastava (2008) की हिमनद सूची में उत्तराखंड के 968 हिमनद (2,888 वर्ग किमी) गिने गए। वाडिया हिमालय भूविज्ञान संस्थान (WIHG) के 2025 में रिपोर्ट किए गए अध्ययन में 1,290 हिमनद गिने गए। अंतर मुख्यतः उपग्रह-चित्रों और "हिमनद" की परिभाषा (छोटे हिमनद, टूटकर अलग हुए हिस्से) के कारण है। परीक्षा में प्रश्न के विकल्पों के अनुसार उत्तर दें और स्रोत का ध्यान रखें।' },
  { q: 'गंगोत्री हिमनद कितना लंबा है और कितना पीछे हटा है?', a: 'लगभग 30 किमी लंबा और 0.5–2.5 किमी चौड़ा। 1935 से 2022 के बीच इसका मुहाना (गोमुख) लगभग 1,700 मीटर पीछे हटा; 1935–96 में औसत लगभग 20 मी/वर्ष और बाद के कुछ वर्षों में इससे अधिक दर दर्ज हुई।' },
  { q: 'क्या 2021 की चमोली आपदा GLOF थी?', a: 'नहीं। विस्तृत वैज्ञानिक अध्ययन (Shugar et al., Science 2021) के अनुसार यह रौंती चोटी से गिरे लगभग 2.7 करोड़ घन मीटर चट्टान और हिमनद-बर्फ़ के हिमस्खलन से बनी मलबा-बाढ़ थी। शुरुआती मीडिया रिपोर्टों में इसे "ग्लेशियर फटना" या GLOF कहा गया था, जो सही नहीं था।' },
  { q: 'हिमनद और हिमस्खलन में क्या अंतर है?', a: 'हिमनद (glacier) सैकड़ों-हज़ारों वर्षों में जमी बर्फ़ की वह धीमी गति से बहने वाली "नदी" है जो हर वर्ष टिकी रहती है। हिमस्खलन (avalanche) ढाल पर से बर्फ़/चट्टान का अचानक, तेज़ गिरना है — कुछ सेकंड-मिनट की घटना।' },
  { q: 'रूपकुंड को "कंकाल झील" क्यों कहते हैं?', a: 'चमोली में लगभग 5,000 मीटर पर स्थित इस छोटी हिमनदीय झील के किनारे सैकड़ों मानव कंकाल मिले हैं। 2019 के एक आनुवंशिक अध्ययन (Harney et al., Nature Communications) के अनुसार ये एक घटना के नहीं, बल्कि लगभग 1,000 वर्ष के अंतर पर अलग-अलग समूहों के हैं — इसलिए इनकी मृत्यु का कारण अभी शोध का विषय है।' },
];

const sources = [
