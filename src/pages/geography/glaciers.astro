  { label: 'वाडिया हिमालय भूविज्ञान संस्थान (WIHG) के अध्ययन पर समाचार रिपोर्ट, 26 जून 2025 — उत्तराखंड में 1,290 हिमनद (पहले 1,266); हिमनदीय झीलों का क्षेत्रफल 8.1% बढ़ा' },
  { label: 'गंगोत्री हिमनद का पीछे हटना (1935–2022, ~1,700 मी) — GSI/WIHG मापनों पर आधारित प्रकाशित अध्ययन व रिपोर्टें; वाडिया संस्थान', url: 'https://www.wihg.res.in/' },
  { label: 'NDMA — Glacial Lake Outburst Floods: Management Guidelines व 188 संभावित ख़तरनाक झीलों का राष्ट्रीय कार्यक्रम (उत्तराखंड 13, श्रेणी-A 5)', url: 'https://ndma.gov.in/' },
  { label: 'Shugar et al. (2021), "A massive rock and ice avalanche caused the 2021 disaster at Chamoli, Indian Himalaya", Science 373', url: 'https://www.science.org/doi/10.1126/science.abh4455' },
  { label: 'Harney et al. (2019), "Ancient DNA from the skeletons of Roopkund Lake…", Nature Communications 10', url: 'https://www.nature.com/articles/s41467-019-11357-9' },
  { label: 'Dobhal et al. — डोकरियानी व चोराबाड़ी हिमनदों पर WIHG के द्रव्यमान-संतुलन अध्ययन (Current Science)' },
  { label: 'UNESCO World Heritage — Nanda Devi and Valley of Flowers National Parks (1988, विस्तार 2005)', url: 'https://whc.unesco.org/en/list/335/' },
  { label: 'हिमनद मानचित्र: हिमनद-आकृतियाँ © OpenStreetMap contributors (ODbL); सीमाएँ DataMeet/Survey of India (CC BY 4.0)' },
];

const img = (w: number) => `https://upload.wikimedia.org/wikipedia/commons/thumb/6/63/Gaumukh_-_gangotri_national_park.jpg/${w}px-Gaumukh_-_gangotri_national_park.jpg`;
---
<GeographyChapter
  name="हिमनद (ग्लेशियर)" nameEn="Glaciers of Uttarakhand" slug="glaciers"
  sub="बर्फ़ की धीमी नदियाँ — कितनी हैं, कहाँ हैं, कैसे घाटियाँ गढ़ती हैं, क्यों पीछे हट रही हैं और कब ख़तरा बनती हैं"
  title="उत्तराखंड के हिमनद: गंगोत्री, मिलम, पिंडारी, GLOF"
  description="उत्तराखंड के हिमनद: गंगोत्री, सतोपंथ, मिलम, पिंडारी, डोकरियानी। हिमनदों की संख्या पर स्रोतों का अंतर, पीछे हटना और GLOF ख़तरा। क्विज़ सहित।"
  image={img(960)} heroSrcset={`${img(500)} 500w, ${img(960)} 960w, ${img(1280)} 1280w`}
  imageAlt="गंगोत्री हिमनद का मुहाना गोमुख — मलबे से ढकी बर्फ़ की ऊँची दीवार और उसके नीचे से निकलती भागीरथी"
  heroCredit={{ text: 'गोमुख, गंगोत्री हिमनद — Gauravkaintura1234, CC BY-SA 4.0, Wikimedia Commons', url: 'https://commons.wikimedia.org/wiki/File:Gaumukh_-_gangotri_national_park.jpg' }}
  published="2026-11-19" toc={toc} facts={facts} faq={faq} sources={sources}
>

<p class="pull">गंगा, यमुना, अलकनंदा, काली — उत्तराखंड की हर बड़ी नदी किसी हिमनद की बेटी है। गर्मियों में जब मैदान सूखते हैं, तब यही बर्फ़ पिघलकर नदियों को बहता रखती है।</p>

<section id="kya">
  <h2>हिमनद क्या है?</h2>
  <ol class="steps">
    <li><b>क्या</b>बर्फ़ का विशाल, स्थायी पिंड जो अपने भार से धीरे-धीरे ढाल की ओर बहता है — "बर्फ़ की नदी"। हिमनद की गति आमतौर पर कुछ सेंटीमीटर से कुछ मीटर प्रतिदिन होती है।</li>
    <li><b>कैसे बनता है</b>हिम-रेखा (snowline) से ऊपर हर वर्ष गिरने वाली बर्फ़ पूरी नहीं पिघलती; परत-दर-परत दबकर पहले दानेदार <b>फ़र्न/नेवे</b> और फिर ठोस नीली <b>हिमनद-बर्फ़</b> बनती है।</li>
    <li><b>कहाँ</b>उत्तराखंड में मुख्यतः <b>वृहत हिमालय</b> में — उत्तरकाशी, चमोली, रुद्रप्रयाग, बागेश्वर और पिथौरागढ़ के उत्तरी भागों में (<a href="/geography/physiographic-divisions/#vrihat">अध्याय 3</a>)।</li>
    <li><b>क्यों महत्वपूर्ण</b>नदियों का बारहमासी प्रवाह, जलविद्युत, पेयजल-सिंचाई, जलवायु-परिवर्तन के संकेतक, और आपदा-जोखिम (GLOF)।</li>
  </ol>
</section>

<section id="sanrachna">
  <h2>हिमनद की संरचना</h2>
  <GlacierAnatomy />
  <dl class="kv">
    <dt>संचय क्षेत्र (Accumulation zone)</dt><dd>ऊपरी भाग जहाँ वर्ष में जितनी बर्फ़ पिघलती है उससे अधिक गिरती है।</dd>
    <dt>अपक्षय/क्षरण क्षेत्र (Ablation zone)</dt><dd>निचला भाग जहाँ पिघलना अधिक है।</dd>
    <dt>संतुलन रेखा (ELA)</dt><dd>दोनों क्षेत्रों की सीमा — मोटे तौर पर हिम-रेखा।</dd>
    <dt>स्नाउट / मुहाना (Snout)</dt><dd>हिमनद का निचला सिरा, जहाँ से नदी निकलती है — जैसे <b>गोमुख</b>।</dd>
    <dt>दरारें (Crevasses)</dt><dd>बहते हिमनद में बनी गहरी खाइयाँ — पर्वतारोहियों के लिए ख़तरनाक।</dd>
    <dt>मोरेन (Moraine)</dt><dd>हिमनद द्वारा लाया-छोड़ा गया चट्टानी मलबा (पार्श्व, मध्यस्थ, अंतस्थ)।</dd>
    <dt>द्रव्यमान-संतुलन</dt><dd>वर्ष में बर्फ़ की कुल कमाई − कुल हानि; ऋणात्मक हो तो हिमनद पतला/छोटा होता है।</dd>
  </dl>
  <div class="box-exam"><strong><span class="tag exam">परीक्षा बिंदु</span></strong>उत्तराखंड के कई हिमनद (गंगोत्री, मिलम, चोराबाड़ी) के निचले भाग <b>मलबे से ढके</b> (debris-covered) हैं — इसलिए ऊपर से सफ़ेद नहीं, भूरे-काले दिखते हैं। मोटा मलबा बर्फ़ को कुछ हद तक पिघलने से बचाता है, पतला मलबा पिघलना तेज़ करता है।</div>
</section>

<section id="sankhya">
  <h2>कितने हिमनद? — आँकड़े और उनका अंतर</h2>
  <div class="table-wrap"><table>
    <thead><tr><th>स्रोत</th><th>हिमनद</th><th>क्षेत्रफल</th><th>टिप्पणी</th></tr></thead>
    <tbody>
      <tr><td>Raina &amp; Srivastava (2008), GSI हिमनद सूची</td><td><b>968</b></td><td>2,888.37 वर्ग किमी</td><td>बर्फ़ का आयतन ~213.74 घन किमी; हिमनद 3,860–6,600 मी के बीच</td></tr>
      <tr><td>WIHG अध्ययन (जून 2025 में रिपोर्ट)</td><td><b>1,290</b></td><td>—</td><td>पिछली गणना 1,266; हिमनदीय झीलों का क्षेत्रफल 8.1% बढ़ा</td></tr>
      <tr><td>OpenStreetMap (हमारी गणना, 2026)</td><td>—</td><td>~1,891 वर्ग किमी</td><td>केवल OSM में चिह्नित हिमनद-आकृतियाँ — <b>आधिकारिक आँकड़ा नहीं</b>; कई हिमनद अधूरे मैप हैं</td></tr>
    </tbody>
  </table></div>
  <div class="box-myth"><strong><span class="tag myth">आँकड़ों में अंतर क्यों?</span></strong>(1) अलग-अलग उपग्रह-चित्र और वर्ष; (2) छोटे हिमनदों (&lt;0.01–0.1 वर्ग किमी) को गिनने का नियम; (3) पीछे हटने से एक हिमनद का दो में टूट जाना संख्या बढ़ा देता है — जबकि कुल बर्फ़ घटती है। इसलिए <b>"संख्या बढ़ी" का अर्थ "हिमनद बढ़े" नहीं</b>।</div>
</section>

<section id="naksha">
  <h2>हिमनद मानचित्र</h2>
  <GeoMap name="g05-glaciers" w={1600} h={981} alt="उत्तराखंड के उत्तरी भाग का मानचित्र जिसमें हिमनद हल्के नीले रंग में और गंगोत्री, सतोपंथ, भागीरथ खरक, चोराबाड़ी, डोकरियानी, पिंडारी, मिलम आदि प्रमुख हिमनद नाम सहित दिखाए गए हैं" caption="हिमनद वृहत हिमालय की एक पतली पट्टी में केंद्रित हैं — पश्चिम में गंगोत्री समूह, बीच में नंदा देवी पुंजक, पूर्व में मिलम-पंचाचूली समूह।" source="मानचित्र: पहाड़ परीक्षा · हिमनद-आकृतियाँ © OpenStreetMap contributors (ODbL) · सीमाएँ: DataMeet/Survey of India (CC BY 4.0)" eager />
</section>

<section id="pramukh">
  <h2>प्रमुख हिमनद</h2>
  <div class="table-wrap"><table>
    <thead><tr><th>हिमनद</th><th>ज़िला</th><th>नदी (स्रोत)</th><th>लंबाई (लगभग)</th><th>विशेष</th></tr></thead>
    <tbody>
      <tr><td><b>गंगोत्री</b></td><td>उत्तरकाशी</td><td>भागीरथी</td><td>~30 किमी</td><td>राज्य का सबसे बड़ा; सहायक हिमनद — चतुरंगी, रक्तवर्ण, कीर्ति</td></tr>
      <tr><td><b>भागीरथ खरक</b></td><td>चमोली</td><td>अलकनंदा</td><td>~18.5 किमी</td><td>स्नाउट ~3,796 मी</td></tr>
      <tr><td><b>सतोपंथ</b></td><td>चमोली</td><td>अलकनंदा</td><td>~13 किमी</td><td>स्नाउट ~3,870 मी; सतोपंथ ताल ऊपर</td></tr>
      <tr><td><b>मिलम</b></td><td>पिथौरागढ़</td><td>गोरी गंगा</td><td>~16 किमी</td><td>कुमाऊँ का सबसे लंबा; जोहार घाटी</td></tr>
      <tr><td><b>पिंडारी</b></td><td>बागेश्वर</td><td>पिंडर</td><td>~3–3.2 किमी</td><td>सबसे प्रसिद्ध ट्रेक; नंदा कोट के नीचे</td></tr>
      <tr><td><b>कफनी</b></td><td>बागेश्वर</td><td>कफनी (→ पिंडर)</td><td>~3 किमी</td><td>पिंडारी के पास</td></tr>
      <tr><td><b>डोकरियानी</b></td><td>उत्तरकाशी</td><td>दिन गाड़ (→ भागीरथी)</td><td>~5 किमी</td><td>WIHG का "बेंचमार्क" अध्ययन-हिमनद; 1995 से ~15–20 मी/वर्ष पीछे</td></tr>
      <tr><td><b>चोराबाड़ी</b></td><td>रुद्रप्रयाग</td><td>मंदाकिनी</td><td>—</td><td>केदारनाथ के ऊपर; 2003–14 में ~9–11 मी/वर्ष पीछे; चोराबाड़ी ताल 2013 में टूटा</td></tr>
      <tr><td>यमुनोत्री (चंपासर)</td><td>उत्तरकाशी</td><td>यमुना</td><td>—</td><td>बंदरपूँछ के पश्चिमी ढाल पर</td></tr>
      <tr><td>खतलिंग</td><td>टिहरी</td><td>भिलंगना</td><td>—</td><td>भिलंगना का स्रोत</td></tr>
      <tr><td>सुंदरढुंगा, नामिक</td><td>बागेश्वर / पिथौरागढ़</td><td>सुंदरढुंगा (→ पिंडर), पूर्वी रामगंगा</td><td>—</td><td>नामिक — पूर्वी रामगंगा का स्रोत</td></tr>
