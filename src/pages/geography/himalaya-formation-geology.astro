---
import GeographyChapter from '../../layouts/GeographyChapter.astro';
import GeoMap from '../../components/geo/GeoMap.astro';
import ChapterEnd from '../../components/geo/ChapterEnd.astro';
import EarthLayers from '../../components/geo/diagrams/EarthLayers.astro';
import IndiaJourney from '../../components/geo/diagrams/IndiaJourney.astro';
import HimalayaSection from '../../components/geo/diagrams/HimalayaSection.astro';
import Quiz from '../../components/Quiz.astro';
import questions from '../../data/quizzes/geo-himalaya.json';

const toc = [
  { id: 'at-a-glance', label: 'एक नज़र में' },
  { id: 'kyon', label: 'भूगर्भ क्यों पढ़ें?' },
  { id: 'prithvi', label: 'पृथ्वी की संरचना' },
  { id: 'visthapan', label: 'महाद्वीपीय विस्थापन' },
  { id: 'plate', label: 'प्लेट विवर्तनिकी' },
  { id: 'yatra', label: 'भारत की उत्तर-यात्रा' },
  { id: 'nirman', label: 'हिमालय कैसे बना' },
  { id: 'sanrachna', label: 'उत्तराखंड की भूगर्भीय पट्टियाँ' },
  { id: 'kaal', label: 'भूवैज्ञानिक समय-मापक्रम' },
  { id: 'bhukamp', label: 'भूकंपीयता: पहली झलक' },
  { id: 'trans', label: 'ट्रांस-हिमालय और टेथिस' },
  { id: 'seekha', label: 'सारांश व याद रखें' },
  { id: 'chitra-abhyas', label: 'चित्र अभ्यास' },
  { id: 'quiz', label: 'क्विज़ (10 MCQ)' },
  { id: 'faq', label: 'FAQ' },
];

const facts = [
  { k: 'हिमालय का प्रकार', v: '<b>नवीन वलित पर्वत</b> (Young fold mountains) — महाद्वीप-महाद्वीप टक्कर से बने' },
  { k: 'टक्कर कब?', v: 'भारतीय व यूरेशियाई प्लेट की टक्कर लगभग <b>5 करोड़ वर्ष</b> पहले शुरू' },
  { k: 'आज की गति', v: 'भारत ~<b>4–5 सेमी/वर्ष</b> उत्तर-पूर्व; इसमें से ~2 सेमी/वर्ष हिमालय में "खप" जाता है' },
  { k: 'मुख्य क्षेप (दक्षिण→उत्तर)', v: '<b>HFT → MBT → MCT → STD</b>' },
  { k: 'उत्तराखंड में MCT', v: '<b>मुनस्यारी थ्रस्ट</b> (MCT-I) व <b>वैकृता थ्रस्ट</b> (MCT-II); हेलंग (अलकनंदा) के पास स्पष्ट' },
  { k: 'सबसे पुरानी चट्टानें', v: 'लघु हिमालय की <b>प्रोटेरोज़ोइक</b> तलछटी-कायांतरित चट्टानें (लगभग 50–250 करोड़ वर्ष)' },
  { k: 'सबसे नई चट्टानें', v: '<b>शिवालिक</b> समूह (मायोसीन–प्लीस्टोसीन) और दून-भाबर के कंकड़' },
  { k: 'भूकंपीय क्षेत्र (लागू मानक)', v: 'IS 1893:2016 — <b>ज़ोन IV व V</b> (2025 का ज़ोन VI वाला कोड मार्च 2026 में वापस)' },
];

const faq = [
  { q: 'हिमालय को "नवीन वलित पर्वत" क्यों कहते हैं?', a: 'क्योंकि यह भूवैज्ञानिक दृष्टि से नया है — इसका निर्माण भारत-यूरेशिया टक्कर (लगभग 5 करोड़ वर्ष पहले) के बाद हुआ और अभी जारी है — तथा इसकी चट्टानें दबाव से मुड़ी (वलित) और एक-दूसरे पर खिसकी (क्षेपित) हैं। तुलना में अरावली जैसे पर्वत करोड़ों वर्ष पुराने और घिसे हुए हैं।' },
  { q: 'MBT और MCT क्या हैं और उत्तराखंड में कहाँ हैं?', a: 'ये हिमालय के बड़े क्षेप-भ्रंश (thrust faults) हैं। MBT (मुख्य सीमांत क्षेप) शिवालिक को लघु हिमालय से अलग करता है — देहरादून के उत्तर में मसूरी की तलहटी, ऋषिकेश के पास और कुमाऊँ में काठगोदाम-हल्द्वानी के उत्तर से गुज़रता है। MCT (मुख्य केंद्रीय क्षेप) लघु हिमालय को वृहत हिमालय से अलग करता है — अलकनंदा घाटी में हेलंग-जोशीमठ के पास और गोरी घाटी में मुनस्यारी के पास, जिसके नाम पर इसे मुनस्यारी थ्रस्ट कहा जाता है।' },
  { q: 'क्या हिमालय अब भी ऊँचा हो रहा है?', a: 'हाँ, भारतीय प्लेट अब भी उत्तर की ओर खिसक रही है, इसलिए हिमालय में संकुचन और उत्थान जारी है। पर अपरदन (नदियों, हिमनदों, भूस्खलनों से) उतनी ही तेज़ी से पहाड़ों को घिसता भी है, इसलिए "हर वर्ष कितने मिमी ऊँचा" — इसका एक निश्चित उत्तर नहीं; स्थान और मापन-पद्धति के अनुसार अनुमान बदलते हैं।' },
  { q: 'उत्तराखंड किस भूकंपीय क्षेत्र में है?', a: 'वर्तमान में लागू मानक IS 1893 (भाग 1):2016 के अनुसार उत्तराखंड ज़ोन IV और V में है। नवंबर 2025 में BIS ने नया कोड (IS 1893:2025) जारी कर पूरे हिमालय को नए ज़ोन VI में रखा था, पर 3 मार्च 2026 की गज़ट अधिसूचना से वह वापस ले लिया गया और 2016 का मानक फिर लागू है।' },
  { q: 'टेथिस सागर का उत्तराखंड से क्या संबंध है?', a: 'भारत और एशिया के बीच टेथिस महासागर था। उसकी तली में करोड़ों वर्षों में जमी समुद्री तलछट टक्कर के बाद उठकर पहाड़ बनी। उत्तराखंड के उत्तरी सीमांत (मलारी-मिलम क्षेत्र) की "टेथिस हिमालय" की चट्टानों में समुद्री जीवों के जीवाश्म मिलना इसका प्रमाण है।' },
];

const sources = [
  { label: 'Geological Society, London — Continental/Continental collision: The Himalayas (भारत की गति, टक्कर ~5 करोड़ वर्ष)', url: 'https://www.geolsoc.org.uk/Plate-Tectonics/Chap3-Plate-Margins/Convergent/Continental-Collision.html' },
  { label: 'Dal Zilio, Hetényi, Hubbard & Bollinger (2021), "Building the Himalaya from tectonic to earthquake scales", Nature Reviews Earth & Environment', url: 'https://serval.unil.ch/resource/serval:BIB_F44B058396C2.P001/REF.pdf' },
  { label: 'Gupta & Gahalaut (2014), "Seismotectonics and large earthquake generation in the Himalayan region", Gondwana Research (भारत ~5 सेमी/वर्ष, हिमालय में ~2 सेमी/वर्ष)', url: 'https://www.geophysik.uni-muenchen.de/~kaeser/Literature/SeismotectonicsHimalaya_Gupta&Gahalaut_GondwRes2014.pdf' },
  { label: 'Jain et al. (2014), "The Higher Himalayan Crystallines, Alaknanda–Dhauli Ganga Valleys", Journal of the Virtual Explorer (MCT = मुनस्यारी व वैकृता थ्रस्ट, हेलंग–मलारी)', url: 'https://virtualexplorer.com.au/article/2014/349/the-higher-himalayan-crystallines/background.html' },
  { label: 'Patel (2011), "Geology, Structural and Exhumation History of the Higher Himalayan Crystallines in Kumaon Himalaya", J. Geol. Soc. India 77', url: 'https://springerlink.bibliotecabuap.elogim.com/content/pdf/10.1007/s12594-011-0008-5.pdf' },
  { label: 'K.S. Valdiya — "Geodynamic history of Uttarakhanda Himalaya" (Nepal Geological Society)', url: 'https://ngs.org.np/geodynamic-history-of-uttarakhanda-himalaya/' },
  { label: 'Bilham — Past and future M>8 earthquakes in the Himalaya (केंद्रीय भूकंपीय अंतराल, 1803)', url: 'https://cires1.colorado.edu/~bilham/HimSeismicGaps.html' },
  { label: 'Drishti IAS — Rollback of Seismic Code of 2025 (13 मार्च 2026): IS 1893:2016 पुनः लागू', url: 'https://www.drishtiias.com/daily-updates/daily-news-analysis/rollback-of-seismic-code-of-2025' },
  { label: 'International Commission on Stratigraphy — International Chronostratigraphic Chart (समय-सीमाएँ)', url: 'https://stratigraphy.org/chart' },
  { label: 'NCERT — भौतिक भूगोल के मूल सिद्धांत (कक्षा 11), अध्याय "महासागरों और महाद्वीपों का वितरण"' },
];

const img = (w: number) => `https://upload.wikimedia.org/wikipedia/commons/thumb/c/c6/Kamet_Closeup.jpg/${w}px-Kamet_Closeup.jpg`;
---
<GeographyChapter
  name="हिमालय का निर्माण और भूगर्भीय संरचना" nameEn="Formation of the Himalaya and Geology of Uttarakhand" slug="himalaya-formation-geology"
  sub="पृथ्वी की परतों से प्लेटों की टक्कर तक — और उत्तराखंड की चट्टानें दक्षिण से उत्तर कैसे बदलती हैं"
  title="हिमालय का निर्माण और उत्तराखंड की भूगर्भीय संरचना"
  description="हिमालय कैसे बना: प्लेट विवर्तनिकी, टेथिस सागर, भारत की उत्तर-यात्रा, HFT, MBT, MCT जैसी भ्रंश रेखाएँ और भूकंप। उत्तराखंड भूगोल अध्याय 2।"
  image={img(960)} heroSrcset={`${img(500)} 500w, ${img(960)} 960w, ${img(1280)} 1280w`}
  imageAlt="चमोली ज़िले में कामेट पर्वत की खड़ी, हिमाच्छादित चट्टानी दीवार"
  heroCredit={{ text: 'कामेट (7,756 मी), चमोली — Rohit Gosain, CC BY-SA 4.0, Wikimedia Commons', url: 'https://commons.wikimedia.org/wiki/File:Kamet_Closeup.jpg' }}
  published="2026-11-19" toc={toc} facts={facts} faq={faq} sources={sources}
>

<p class="pull">उत्तराखंड में भूस्खलन क्यों होते हैं, भूकंप क्यों आते हैं, नदियाँ गहरे गॉर्ज क्यों काटती हैं, और ऊँची चोटियों पर समुद्री जीवों के जीवाश्म क्यों मिलते हैं? सबका उत्तर एक कहानी में है — भारत के उत्तर की ओर खिसकने की कहानी।</p>

<section id="kyon">
  <h2>भूगर्भ क्यों पढ़ें?</h2>
  <p>भूगर्भ (geology) यानी धरती के भीतर की बनावट। उत्तराखंड के लगभग हर भौगोलिक प्रश्न की जड़ यहीं है:</p>
  <div class="table-wrap"><table>
    <thead><tr><th>भूगर्भीय कारण</th><th>उत्तराखंड पर असर</th><th>आगे कहाँ पढ़ें</th></tr></thead>
    <tbody>
      <tr><td>प्लेटों का लगातार टकराना</td><td>भूकंप; नए पर्वतों का उठना</td><td>अध्याय 13</td></tr>
      <tr><td>भ्रंश व टूटी-फूटी चट्टानें</td><td>भूस्खलन, सड़कें धँसना</td><td>अध्याय 12</td></tr>
      <tr><td>ऊँचे पर्वत, तीखे ढाल</td><td>तेज़ नदियाँ, गहरी घाटियाँ, जलविद्युत क्षमता</td><td><a href="/geography/rivers-drainage/">अध्याय 4</a></td></tr>
      <tr><td>दक्षिण से उत्तर बदलती चट्टानें</td><td>तराई-भाबर-शिवालिक-लघु-वृहत हिमालय की पट्टियाँ</td><td><a href="/geography/physiographic-divisions/">अध्याय 3</a></td></tr>
    </tbody>
  </table></div>
</section>

<section id="prithvi">
  <h2>पृथ्वी की संरचना</h2>
  <EarthLayers />
  <ul>
    <li><b>भूपर्पटी (Crust)</b> — सबसे ऊपरी, पतली ठोस परत। महाद्वीपीय भूपर्पटी मोटी व हल्की (ग्रेनाइट जैसी), महासागरीय पतली व भारी (बेसाल्ट जैसी)।</li>
    <li><b>स्थलमंडल (Lithosphere)</b> — भूपर्पटी + ऊपरी मेंटल का ठोस भाग; यही टुकड़ों (<b>प्लेटों</b>) में बँटा है।</li>
    <li><b>दुर्बलतामंडल (Asthenosphere)</b> — उसके नीचे का अर्ध-तरल, धीरे बहने वाला भाग; प्लेटें इसी पर सरकती हैं।</li>
  </ul>
  <div class="box-exam"><strong><span class="tag exam">परीक्षा बिंदु</span></strong>हल्की महाद्वीपीय भूपर्पटी आसानी से नीचे नहीं धँसती — इसीलिए भारत-एशिया टक्कर में भारत पूरा "डूबा" नहीं, बल्कि भूपर्पटी मुड़कर, परतों में खिसककर और मोटी होकर ऊपर उठी।</div>
</section>

<section id="visthapan">
  <h2>महाद्वीपीय विस्थापन (Continental Drift)</h2>
  <ol class="steps">
    <li><b>किसने कहा?</b>जर्मन वैज्ञानिक <b>अल्फ्रेड वेगनर</b> (1912 में प्रस्तुत, 1915 की पुस्तक में विस्तार)।</li>
    <li><b>क्या कहा?</b>लगभग 30 करोड़ वर्ष पहले सारे महाद्वीप एक महाद्वीप <b>पैंजिया</b> थे, चारों ओर महासागर <b>पैंथालसा</b>। पैंजिया टूटकर उत्तर में <b>लॉरेशिया</b> और दक्षिण में <b>गोंडवाना लैंड</b> बना; दोनों के बीच <b>टेथिस</b> सागर।</li>
    <li><b>प्रमाण</b>महाद्वीपों के किनारों का मेल (जिग-सॉ जैसा), एक जैसे जीवाश्म (ग्लॉसोप्टेरिस पौधा, मेसोसॉरस), एक जैसी चट्टानें और प्राचीन हिमनदी जमाव (टिलाइट)।</li>
    <li><b>कमज़ोरी</b>वेगनर महाद्वीपों को खिसकाने वाला बल ठीक से नहीं समझा सके। यह कमी 1960 के दशक में <b>सागर-तल प्रसार</b> और <b>प्लेट विवर्तनिकी</b> ने पूरी की।</li>
  </ol>
  <div class="box-hist"><strong><span class="tag hist">वैज्ञानिक तथ्य</span></strong>भारत <b>गोंडवाना लैंड</b> का भाग था — अफ्रीका, अंटार्कटिका, ऑस्ट्रेलिया, दक्षिण अमेरिका के साथ। इसीलिए भारत के गोंडवाना कोयला-क्षेत्रों में मिलने वाले पौधों के जीवाश्म अंटार्कटिका-ऑस्ट्रेलिया में भी मिलते हैं।</div>
</section>

<section id="plate">
  <h2>प्लेट विवर्तनिकी (Plate Tectonics)</h2>
  <p>स्थलमंडल लगभग सात बड़ी और कई छोटी प्लेटों में बँटा है। प्लेटों की सीमाएँ तीन प्रकार की होती हैं:</p>
  <div class="table-wrap"><table>
    <thead><tr><th>सीमा</th><th>क्या होता है</th><th>उदाहरण</th></tr></thead>
    <tbody>
      <tr><td>अपसारी (Divergent)</td><td>प्लेटें दूर हटती हैं, नई भूपर्पटी बनती है</td><td>मध्य-अटलांटिक कटक</td></tr>
      <tr><td>अभिसारी (Convergent)</td><td>प्लेटें टकराती हैं — एक नीचे धँसती है या दोनों मुड़कर उठती हैं</td><td><b>हिमालय</b> (महाद्वीप-महाद्वीप), एंडीज़ (महासागर-महाद्वीप)</td></tr>
      <tr><td>संरक्षी / रूपांतर (Transform)</td><td>प्लेटें एक-दूसरे के बगल से सरकती हैं</td><td>सैन एंड्रियास भ्रंश (अमेरिका)</td></tr>
    </tbody>
  </table></div>
  <div class="box-exam"><strong><span class="tag exam">परीक्षा बिंदु</span></strong>हिमालय <b>महाद्वीप-महाद्वीप अभिसरण</b> का सबसे बड़ा उदाहरण है। ऐसी टक्कर में ज्वालामुखी लगभग नहीं बनते (महासागर-महाद्वीप टक्कर के विपरीत), इसलिए उत्तराखंड में सक्रिय ज्वालामुखी नहीं हैं।</div>
</section>

<section id="yatra">
  <h2>भारत की उत्तर-यात्रा</h2>
  <IndiaJourney />
  <ul>
    <li>गोंडवाना से अलग होकर भारतीय प्लेट उत्तर की ओर चली। Geological Society (लंदन) के अनुसार लगभग 8 करोड़ वर्ष पहले भारत एशिया से लगभग <b>6,400 किमी</b> दक्षिण में था और <b>9–16 सेमी/वर्ष</b> की तेज़ गति से बढ़ रहा था।</li>
    <li>लगभग <b>5 करोड़ वर्ष</b> पहले टक्कर शुरू हुई; उसके बाद गति घटकर लगभग 4–6 सेमी/वर्ष रह गई।</li>
    <li>आज भारत लगभग <b>5 सेमी/वर्ष</b> उत्तर-पूर्व की ओर बढ़ रहा है; इसमें से लगभग <b>2 सेमी/वर्ष</b> का संकुचन हिमालय में होता है (शेष तिब्बत और आगे)। यही खिंचाव-दबाव भूकंपों का स्रोत है।</li>
    <li>टक्कर के बाद से तिब्बत पठार ने 1,400 किमी से अधिक उत्तर-दक्षिण संकुचन सहा है (Dal Zilio et al., 2021)।</li>
  </ul>
  <div class="box-myth"><strong><span class="tag myth">मत-भेद</span></strong>टक्कर की सटीक शुरुआत पर शोधकर्ताओं में मत-भेद है — अनुमान लगभग 5.5 से 4.5 करोड़ वर्ष के बीच हैं, और कुछ शोध इससे पहले की छोटी टक्करों (द्वीप-चापों से) की बात करते हैं। परीक्षा में "लगभग 5 करोड़ वर्ष" लिखना सुरक्षित है।</div>
</section>

<section id="nirman">
  <h2>हिमालय कैसे बना — चार चरणों में</h2>
  <ol class="steps">
    <li><b>टेथिस में तलछट</b>करोड़ों वर्षों तक नदियाँ टेथिस सागर में मिट्टी, बालू, चूना जमा करती रहीं — मोटी तलछटी परतें बनीं।</li>
    <li><b>महासागर बंद होना</b>भारत के उत्तर बढ़ने पर टेथिस की महासागरीय भूपर्पटी एशिया के नीचे धँसती गई (subduction) और सागर सिकुड़ता गया।</li>
    <li><b>टक्कर और मुड़ना</b>महासागर खत्म होने पर दो महाद्वीप सीधे टकराए। हल्की भूपर्पटी नीचे नहीं जा सकी — वह मुड़ी (वलन), टूटी और परतों में एक-दूसरे पर चढ़ी (क्षेप/थ्रस्ट)।</li>
    <li><b>दक्षिण की ओर बढ़ता पहाड़</b>पहले उत्तर में बड़े क्षेप सक्रिय हुए (MCT), फिर क्रम से दक्षिण में (MBT, फिर HFT)। यानी हिमालय दक्षिण की ओर "फैलता" गया — सबसे नया व आज सक्रिय मोर्चा HFT है।</li>
  </ol>
  <HimalayaSection />
  <div class="table-wrap"><table>
    <thead><tr><th>क्षेप (Thrust)</th><th>क्या अलग करता है</th><th>उत्तराखंड में कहाँ (लगभग)</th><th>सक्रियता (अनुमानित)</th></tr></thead>
    <tbody>
      <tr><td><b>HFT</b> — हिमालयी अग्र क्षेप</td><td>गंगा मैदान | शिवालिक</td><td>शिवालिक की दक्षिणी तलहटी (देहरादून-हरिद्वार-रामनगर-टनकपुर के दक्षिणी किनारे)</td><td>सबसे नया; आज भी सक्रिय</td></tr>
      <tr><td><b>MBT</b> — मुख्य सीमांत क्षेप</td><td>शिवालिक | लघु हिमालय</td><td>मसूरी पहाड़ी की तलहटी, ऋषिकेश के पास, हल्द्वानी-काठगोदाम के उत्तर</td><td>HFT से पुराना</td></tr>
      <tr><td><b>MCT</b> — मुख्य केंद्रीय क्षेप (मुनस्यारी / वैकृता)</td><td>लघु हिमालय | वृहत हिमालय</td><td>हेलंग-जोशीमठ (अलकनंदा), मुनस्यारी (गोरी घाटी), भटवाड़ी-गंगोत्री मार्ग के आसपास (भागीरथी)</td><td>मुख्य सक्रियता मायोसीन (~2 करोड़ वर्ष पूर्व) में</td></tr>
      <tr><td><b>STD</b> — दक्षिण तिब्बत विच्छेद</td><td>वृहत हिमालय | टेथिस हिमालय</td><td>मलारी (धौलीगंगा घाटी) के पास; ऊपरी मिलम क्षेत्र</td><td>सामान्य भ्रंश (normal fault) — ऊपर की परत उत्तर की ओर फिसली</td></tr>
    </tbody>
  </table></div>
  <div class="box-trap"><strong><span class="tag trap">सावधान</span></strong>क्रम याद रखें — <b>दक्षिण से उत्तर: HFT → MBT → MCT → STD</b>; पर <b>उम्र में पुराने से नए: MCT → MBT → HFT</b> (उत्तर वाला पुराना, दक्षिण वाला नया)। STD क्षेप नहीं, सामान्य भ्रंश है। सिंधु-सांगपो सीवन (ITSZ) — जहाँ भारत और एशिया वास्तव में जुड़े — उत्तराखंड में नहीं, तिब्बत में है।</div>
</section>

<section id="sanrachna">
  <h2>उत्तराखंड की भूगर्भीय पट्टियाँ (दक्षिण से उत्तर)</h2>
  <GeoMap name="g03-profile-garhwal" w={1400} h={560} alt="हरिद्वार से माणा दर्रे तक धरातल की ऊँचाई का परिच्छेद, जिसमें मैदान, शिवालिक, लघु हिमालय, वृहत हिमालय और टेथिस हिमालय की पट्टियाँ रंगों से दिखाई गई हैं" caption="वास्तविक ऊँचाई-आँकड़ों (SRTM) से बना परिच्छेद: हरिद्वार (~285 मी) से माणा दर्रे (~5,500 मी) तक लगभग 220 किमी में ज़मीन 5 किमी ऊपर उठ जाती है। पट्टियों की सीमाएँ सरलीकृत हैं।" source="मानचित्र: पहाड़ परीक्षा · ऊँचाई: NASA SRTM (90 मी.) · OpenStreetMap" />
  <div class="table-wrap"><table>
    <thead><tr><th>पट्टी</th><th>मुख्य चट्टानें</th><th>आयु (लगभग)</th><th>उत्तराखंड के उदाहरण</th></tr></thead>
    <tbody>
      <tr><td><b>उप-हिमालय (शिवालिक)</b></td><td>बलुआ पत्थर, कंकड़-पिंडशिला (conglomerate), मृत्तिका — ढीली, कम संगठित</td><td>मायोसीन–प्लीस्टोसीन (लगभग 2 करोड़ से कुछ लाख वर्ष)</td><td>मोहंड (देहरादून-सहारनपुर मार्ग), राजाजी, शिवालिक में स्तनधारी जीवाश्म</td></tr>
      <tr><td><b>लघु हिमालय</b></td><td>चूना पत्थर, डोलोमाइट, स्लेट, क्वार्टज़ाइट (क्रोल, ताल, नागथात, चंदपुर संरचनाएँ) + ऊपर खिसकी कायांतरित चट्टानों की परतें (अल्मोड़ा नप्पे)</td><td>मुख्यतः प्रोटेरोज़ोइक (50–250 करोड़ वर्ष)</td><td>मसूरी-नैनीताल का क्रोल पट्टा, गढ़वाल सिंकलाइन, अल्मोड़ा क्रिस्टलीय पट्टी</td></tr>
      <tr><td><b>वृहत हिमालय</b> (उच्च हिमालयी क्रिस्टलीय)</td><td>नाइस, शिस्ट, माइग्मेटाइट; नए ल्यूकोग्रेनाइट</td><td>चट्टानें पुरानी, पर कायांतरण व ग्रेनाइट हिमालयी काल (मायोसीन) के</td><td>हेलंग से मलारी तक 20 किमी से मोटी पट्टी; गंगोत्री-बद्रीनाथ ग्रेनाइट</td></tr>
      <tr><td><b>टेथिस हिमालय</b></td><td>जीवाश्मयुक्त समुद्री तलछट — चूना पत्थर, शेल</td><td>पुराजीवी–मध्यजीवी (लगभग 54 से 6.6 करोड़ वर्ष)</td><td>मलारी (मारतोली संरचना), नीति, ऊपरी मिलम-जोहार</td></tr>
    </tbody>
  </table></div>
  <div class="box-exam"><strong><span class="tag exam">परीक्षा बिंदु</span></strong><b>उलटा क्रम:</b> लघु हिमालय की चट्टानें (प्रोटेरोज़ोइक) शिवालिक से <b>बहुत पुरानी</b> हैं, फिर भी वे MBT के सहारे शिवालिक के <b>ऊपर</b> चढ़ी हैं। यह क्षेपण (thrusting) का स्पष्ट प्रमाण है।</div>
</section>

<section id="kaal">
  <h2>भूवैज्ञानिक समय-मापक्रम (उत्तराखंड के संदर्भ में)</h2>
  <div class="table-wrap"><table>
    <thead><tr><th>महाकल्प / कल्प</th><th>समय (करोड़ वर्ष पूर्व)</th><th>उत्तराखंड में क्या हुआ</th></tr></thead>
    <tbody>
      <tr><td>प्रोटेरोज़ोइक</td><td>250 – 53.9</td><td>लघु हिमालय की तलछटी परतें (चंदपुर, नागथात, ब्लेनी, क्रोल) जमीं; अल्मोड़ा-क्षेत्र के क्रिस्टलीय आधार</td></tr>
      <tr><td>पुराजीवी (Paleozoic)</td><td>53.9 – 25.2</td><td>टेथिस के किनारे समुद्री तलछट — आज के टेथिस हिमालय की निचली परतें</td></tr>
      <tr><td>मध्यजीवी (Mesozoic)</td><td>25.2 – 6.6</td><td>गोंडवाना का टूटना; भारत की उत्तर-यात्रा; टेथिस में जीवाश्मयुक्त परतें</td></tr>
      <tr><td>नवजीवी — पैलियोजीन</td><td>6.6 – 2.3</td><td>~5 करोड़ वर्ष पूर्व भारत-एशिया टक्कर; भूपर्पटी मोटी होने लगी</td></tr>
      <tr><td>नवजीवी — नियोजीन (मायोसीन–प्लायोसीन)</td><td>2.3 – 0.26</td><td>MCT सक्रिय, वृहत हिमालय उठा, गंगोत्री-बद्रीनाथ ल्यूकोग्रेनाइट बने; शिवालिक की तलछट जमने लगी; बाद में MBT सक्रिय</td></tr>
      <tr><td>चतुर्थक (Quaternary)</td><td>0.26 – आज</td><td>HFT सक्रिय; दून घाटी के कंकड़, भाबर-तराई का निर्माण; हिमयुगों में हिमनद नीचे तक आए; आज की नदी-घाटियाँ</td></tr>
    </tbody>
  </table></div>
  <p class="muted">समय-सीमाएँ International Chronostratigraphic Chart के अनुसार; घटनाओं के समय वैज्ञानिक अनुमान हैं।</p>
</section>

<section id="bhukamp">
  <h2>भूकंपीयता: पहली झलक</h2>
  <ul>
    <li>भारतीय प्लेट हिमालय के नीचे <b>मुख्य हिमालयी क्षेप (MHT)</b> पर खिसकती है। जहाँ यह तल "अटका" (locked) रहता है, वहाँ ऊर्जा जमा होती रहती है और अचानक छूटने पर बड़ा भूकंप आता है।</li>
    <li><b>उत्तराखंड के प्रमुख भूकंप:</b> 1803 गढ़वाल (परिमाण अनुमान ~7.5–7.8; कुछ पुनर्मूल्यांकन ≤7.7), 20 अक्टूबर 1991 उत्तरकाशी (M 6.8), 29 मार्च 1999 चमोली (M 6.6)।</li>
    <li><b>"केंद्रीय भूकंपीय अंतराल"</b> — कई वैज्ञानिक मानते हैं कि मध्य हिमालय (पश्चिमी नेपाल–उत्तराखंड) में लंबे समय से बहुत बड़ा भूकंप नहीं आया, इसलिए यहाँ ऊर्जा जमा है। कुछ शोध इस धारणा पर प्रश्न भी उठाते हैं।</li>
    <li><b>भूकंपीय क्षेत्र:</b> लागू मानक IS 1893:2016 में उत्तराखंड <b>ज़ोन IV और V</b> में है। BIS ने नवंबर 2025 में पूरे हिमालय को नए ज़ोन VI में रखने वाला कोड जारी किया था, पर 3 मार्च 2026 को उसे वापस ले लिया गया।</li>
    <li>भूकंप की <b>भविष्यवाणी (तारीख-समय-स्थान)</b> आज विज्ञान के लिए संभव नहीं; केवल संभावित जोखिम का आकलन होता है। विस्तार अध्याय 13 में।</li>
  </ul>
  <div class="box-myth"><strong><span class="tag myth">अभी शोध जारी</span></strong>1803 के भूकंप का परिमाण और "केंद्रीय अंतराल" कितना परिपक्व है — दोनों पर वैज्ञानिक सहमत नहीं हैं। उत्तर में "स्रोतों के अनुसार" लिखें।</div>
</section>

<section id="trans">
  <h2>ट्रांस-हिमालय और टेथिस हिमालय</h2>
  <ul>
    <li><b>ट्रांस-हिमालय</b> — वृहत हिमालय के उत्तर में फैली श्रेणियाँ (काराकोरम, लद्दाख, कैलाश)। इनका मुख्य भाग तिब्बत-लद्दाख में है।</li>
    <li>उत्तराखंड के उत्तरी सीमांत की ऊँची, सूखी श्रेणियाँ <b>टेथिस हिमालय</b> हैं — इन्हें ज़ास्कर श्रेणी का पूर्वी विस्तार भी माना जाता है। NCERT ज़ास्कर को ट्रांस-हिमालयी श्रेणियों के साथ गिनता है।</li>
    <li>ये क्षेत्र वृहत हिमालय की <b>वृष्टि-छाया</b> में हैं — कम वर्षा, ठंडा मरुस्थल जैसा दृश्य (नीति, माणा के ऊपर, ऊपरी दारमा-व्यास घाटियाँ)।</li>
  </ul>
  <div class="box-myth"><strong><span class="tag myth">वर्गीकरण में अंतर</span></strong>कुछ पुस्तकें उत्तराखंड के उत्तरी भाग को "ट्रांस-हिमालय" कहती हैं, कुछ "टेथिस हिमालय"। भूवैज्ञानिक दृष्टि से STD के उत्तर की तलछटी पट्टी "टेथिस हिमालय" है; "ट्रांस-हिमालय" भौगोलिक नाम है।</div>
</section>

