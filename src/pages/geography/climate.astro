---
import GeographyChapter from '../../layouts/GeographyChapter.astro';
import GeoMap from '../../components/geo/GeoMap.astro';
import ChapterEnd from '../../components/geo/ChapterEnd.astro';
import MonsoonWD from '../../components/geo/diagrams/MonsoonWD.astro';
import Orographic from '../../components/geo/diagrams/Orographic.astro';
import AltitudeTemp from '../../components/geo/diagrams/AltitudeTemp.astro';
import Quiz from '../../components/Quiz.astro';
import questions from '../../data/quizzes/geo-climate.json';

const toc = [
  { id: 'at-a-glance', label: 'एक नज़र में' },
  { id: 'kya', label: 'मौसम बनाम जलवायु' },
  { id: 'niyantrak', label: 'जलवायु के नियंत्रक' },
  { id: 'rituyen', label: 'चार ऋतुएँ' },
  { id: 'mansoon', label: 'मानसून व पश्चिमी विक्षोभ' },
  { id: 'varsha', label: 'वर्षा का वितरण' },
  { id: 'tapman', label: 'तापमान व रिकॉर्ड' },
  { id: 'kshetra', label: 'जलवायु क्षेत्र (कोपेन)' },
  { id: 'badal', label: 'बादल फटना व चरम घटनाएँ' },
  { id: 'parivartan', label: 'जलवायु परिवर्तन' },
  { id: 'prabhav', label: 'जीवन पर प्रभाव' },
  { id: 'seekha', label: 'सारांश व याद रखें' },
  { id: 'chitra-abhyas', label: 'मानचित्र अभ्यास' },
  { id: 'quiz', label: 'क्विज़ (10 MCQ)' },
  { id: 'faq', label: 'FAQ' },
];

const facts = [
  { k: 'सामान्य वार्षिक वर्षा', v: '<b>1,326.1 मिमी</b> (~63 वर्षा-दिवस) — IMD सामान्य 1961–2010' },
  { k: 'वर्षा का ऋतु-वार हिस्सा', v: 'मानसून (जून–सित.) <b>~78%</b> · मानसून-पूर्व ~10% · शीत ~9% · मानसून-पश्चात ~3%' },
  { k: 'सर्वाधिक / न्यूनतम वर्षा (ज़िला)', v: '<b>पिथौरागढ़</b> 1,775 मिमी · <b>अल्मोड़ा</b> 966 मिमी' },
  { k: 'उच्चतम तापमान (रिकॉर्ड)', v: '<b>47.4°C</b> — रुड़की, 22 मई 1978' },
  { k: 'न्यूनतम तापमान (रिकॉर्ड)', v: '<b>−15.1°C</b> — जोशीमठ, 15 जनवरी 1974' },
  { k: '24 घंटे में सर्वाधिक वर्षा', v: '<b>495.3 मिमी</b> — हरिद्वार, 18 सितंबर 1880' },
  { k: 'कोपेन जलवायु प्रकार', v: '<b>Cwa, Cwb, Dfb, ET</b> — नीचे से ऊपर' },
];

const faq = [
  { q: 'उत्तराखंड की सामान्य वार्षिक वर्षा कितनी है?', a: 'भारत मौसम विज्ञान विभाग (IMD) की प्रकाशित "Climate of Uttarakhand" के अनुसार 1961–2010 के आधार पर राज्य की सामान्य वार्षिक वर्षा 1,326.1 मिमी (लगभग 133 सेमी) है, जो औसतन 63 दिनों में होती है। इसका लगभग 78% भाग दक्षिण-पश्चिम मानसून (जून–सितंबर) में होता है।' },
  { q: 'उत्तराखंड में सबसे अधिक वर्षा वाला ज़िला कौन-सा है?', a: 'IMD के ज़िलेवार सामान्य (1961–2010) के अनुसार पिथौरागढ़ (1,775.4 मिमी), उसके बाद देहरादून (1,632.1 मिमी)। सबसे कम अल्मोड़ा (965.9 मिमी)। ध्यान दें — ज़िले के भीतर भी स्थान-स्थान पर बहुत अंतर होता है; यह ज़िले का औसत है।' },
  { q: 'पश्चिमी विक्षोभ क्या है?', a: 'भूमध्य सागर-पश्चिम एशिया की ओर से आने वाले निम्न-दाब तंत्र, जो सर्दियों में उत्तर भारत तक पहुँचकर वर्षा, हिमपात, कोहरा और शीत-लहर लाते हैं। IMD के अनुसार सर्दियों में हर महीने लगभग 3–6 विक्षोभ उत्तराखंड से गुज़रते हैं, प्रत्येक 2–4 दिन रहता है। यही रबी फसलों और हिमनदों के पोषण के लिए महत्वपूर्ण है।' },
  { q: 'बादल फटना किसे कहते हैं?', a: 'IMD की परिभाषा के अनुसार लगभग 20–30 वर्ग किमी के छोटे क्षेत्र में एक घंटे में 100 मिमी या उससे अधिक वर्षा। व्यवहार में अनेक बाढ़ों को "बादल फटना" कह दिया जाता है जबकि वर्षा-आँकड़े इसकी पुष्टि नहीं करते — जैसे अगस्त 2025 की धराली (उत्तरकाशी) बाढ़, जिस पर IMD और वैज्ञानिकों ने बादल फटने की बात पर संदेह जताया।' },
  { q: 'पहाड़ों में ऊँचाई के साथ तापमान कितना घटता है?', a: 'औसतन लगभग 6.5°C प्रति किलोमीटर (सामान्य ताप-ह्रास दर)। पर वास्तविक तापमान ढाल-दिशा, घाटी की बनावट, हवा और नमी पर भी निर्भर है; सर्दी की रातों में घाटियों में तापमान-व्युत्क्रमण से घाटी-तल ऊपर की ढालों से अधिक ठंडा हो जाता है।' },
];

const sources = [
  { label: 'IMD, Pune — "Climate of Uttarakhand" (राज्य/ज़िलेवार सामान्य 1961–2010, रिकॉर्ड तापमान व वर्षा, कोपेन वर्गीकरण, पश्चिमी विक्षोभ)', url: 'https://imdpune.gov.in/library/public/Climate%20of%20Uttarakhand.pdf' },
  { label: 'मौसम विज्ञान केंद्र देहरादून — दक्षिण-पश्चिम मानसून 2024: उत्तराखंड ऋतु-अंत रिपोर्ट', url: 'https://mausam.imd.gov.in/dehradun/mcdata/MONSOON_REPORT.pdf' },
  { label: 'MAUSAM जर्नल (IMD) — "Analysis of the trend of heavy rainfall over Uttarakhand" (1983–2023, देहरादून, पंतनगर, टिहरी, मुक्तेश्वर)', url: 'https://mausamjournal.imd.gov.in/index.php/MAUSAM/article/view/6839' },
  { label: 'Mongabay India (अगस्त 2025) — बादल फटना: IMD परिभाषा व हिमालयी कारण', url: 'https://india.mongabay.com/2025/08/what-are-cloudbursts-why-do-they-occur-and-how-can-cloudburst-risks-be-reduced-explainer/' },
  { label: 'The Print (6 अगस्त 2025) — धराली बाढ़ पर IMD महानिदेशक का वक्तव्य', url: 'https://theprint.in/environment/flash-floods-due-to-heavy-rainfall-in-uttarkashis-dharali-but-imd-yet-to-confirm-cloudburst/2715087' },
  { label: 'The Wire — धराली बाढ़ का कारण अनिश्चित: वैज्ञानिकों की राय', url: 'https://thewire.in/environment/dharali-floods-cause-missing-early-warning-system-scientists-asks' },
  { label: 'NCERT — भारत: भौतिक पर्यावरण (कक्षा 11), अध्याय 4 "जलवायु" (मानसून, पश्चिमी विक्षोभ, कोपेन वर्गीकरण)' },
  { label: 'मानचित्र: पहाड़ परीक्षा — ज़िला वर्षा IMD सामान्य से; ऊँचाई-क्षेत्र NASA SRTM से; सीमाएँ DataMeet/Survey of India (CC BY 4.0)' },
];

const img = (w: number) => `https://upload.wikimedia.org/wikipedia/commons/thumb/1/11/Auli_mountains.jpg/${w}px-Auli_mountains.jpg`;
---
<GeographyChapter
  name="जलवायु" nameEn="Climate of Uttarakhand" slug="climate"
  sub="एक ही दिन में तराई में 40°C और नीति घाटी में बर्फ़ — मानसून, पश्चिमी विक्षोभ, ऊँचाई और ढाल से बनी उत्तराखंड की जलवायु"
  title="उत्तराखंड की जलवायु: वर्षा, मानसून, पश्चिमी विक्षोभ, तापमान रिकॉर्ड, बादल फटना (UKPSC)"
  description="उत्तराखंड भूगोल अध्याय 6 — IMD आँकड़ों के साथ: सामान्य वार्षिक वर्षा 1,326 मिमी, ज़िलेवार वर्षा मानचित्र, मानसून व पश्चिमी विक्षोभ, ऊँचाई के साथ तापमान, कोपेन जलवायु प्रकार, रिकॉर्ड तापमान व वर्षा, बादल फटना, जलवायु परिवर्तन। 10 MCQ सहित।"
  image={img(960)} heroSrcset={`${img(500)} 500w, ${img(960)} 960w, ${img(1280)} 1280w`}
  imageAlt="औली (चमोली) में बर्फ़ से ढकी ढलानें और पीछे हिमालय की चोटियाँ"
  heroCredit={{ text: 'औली, चमोली — Navi8apr, CC BY-SA 4.0, Wikimedia Commons', url: 'https://commons.wikimedia.org/wiki/File:Auli_mountains.jpg' }}
  published="2026-11-20" toc={toc} facts={facts} faq={faq} sources={sources}
>

<p class="pull">उत्तराखंड में "एक जलवायु" नहीं है। 300 मीटर की तराई से 7,800 मीटर की चोटियों तक — 200 किमी के भीतर — आपको उपोष्ण गर्मी से टुंड्रा जैसी ठंड तक सब मिलता है।</p>

<section id="kya">
  <h2>मौसम बनाम जलवायु</h2>
  <dl class="kv">
    <dt>मौसम (Weather)</dt><dd>किसी स्थान की <b>कुछ घंटों/दिनों</b> की वायुमंडलीय दशा — आज की बारिश, आज का तापमान।</dd>
    <dt>जलवायु (Climate)</dt><dd><b>लंबी अवधि (प्रायः 30 वर्ष या अधिक)</b> के मौसम का औसत व उतार-चढ़ाव। IMD के "सामान्य" (normal) मान इसी तरह निकाले जाते हैं — इस अध्याय के अधिकांश आँकड़े <b>1961–2010</b> के सामान्य हैं।</dd>
    <dt>LPA (Long Period Average)</dt><dd>दीर्घकालिक औसत वर्षा — किसी वर्ष की वर्षा को इसके प्रतिशत में बताया जाता है (जैसे 2024 का मानसून उत्तराखंड में LPA का 109%, "सामान्य")।</dd>
  </dl>
</section>

<section id="niyantrak">
  <h2>उत्तराखंड की जलवायु के नियंत्रक</h2>
  <div class="table-wrap"><table>
    <thead><tr><th>कारक</th><th>कैसे असर डालता है</th><th>उदाहरण</th></tr></thead>
    <tbody>
      <tr><td><b>अक्षांश</b></td><td>28°43′–31°28′ उ. — उपोष्ण कटिबंध; कर्क रेखा से उत्तर</td><td>सर्दी-गर्मी का स्पष्ट अंतर</td></tr>
      <tr><td><b>ऊँचाई</b></td><td>सबसे बड़ा नियंत्रक — औसतन ~6.5°C/किमी तापमान घटता है</td><td>देहरादून (~640 मी) बनाम मसूरी (~2,000 मी)</td></tr>
      <tr><td><b>हिमालय की दीवार</b></td><td>मानसूनी हवा को रोककर वर्षा कराती है; उत्तर की ठंडी हवा रोकती है</td><td>दक्षिणी ढालों पर भारी वर्षा</td></tr>
      <tr><td><b>ढाल-दिशा (aspect)</b></td><td>दक्षिणमुखी ढाल धूप वाले गर्म-सूखे; उत्तरमुखी ठंडे-नम</td><td>एक ही ऊँचाई पर चीड़ (दक्षिण) बनाम बाँज (उत्तर)</td></tr>
      <tr><td><b>मानसून व पश्चिमी विक्षोभ</b></td><td>वर्षा के दो मुख्य स्रोत</td><td>गर्मी में मानसून, सर्दी में हिमपात</td></tr>
      <tr><td><b>वृष्टि-छाया</b></td><td>ऊँची श्रेणियों के पीछे कम वर्षा</td><td>नीति, माणा, नेलांग, ऊपरी व्यास घाटी</td></tr>
      <tr><td><b>वनस्पति व हिम-आवरण</b></td><td>स्थानीय नमी, तापमान और परावर्तन पर असर</td><td>हिमनद क्षेत्रों की ठंडी हवा</td></tr>
    </tbody>
  </table></div>
  <AltitudeTemp />
</section>

<section id="rituyen">
  <h2>चार ऋतुएँ (IMD के अनुसार)</h2>
  <div class="table-wrap"><table>
    <thead><tr><th>ऋतु</th><th>महीने</th><th>वार्षिक वर्षा में हिस्सा</th><th>मुख्य विशेषताएँ</th></tr></thead>
    <tbody>
      <tr><td><b>शीत ऋतु</b></td><td>दिसंबर–फ़रवरी</td><td>~9%</td><td>पश्चिमी विक्षोभ से वर्षा व हिमपात (जनवरी में सर्वाधिक हिमपात); घाटियों में पाला व कोहरा; शीत-लहर</td></tr>
      <tr><td><b>ग्रीष्म / मानसून-पूर्व</b></td><td>मार्च–मई</td><td>~10%</td><td>तराई-घाटियों में तीव्र गर्मी; ओलावृष्टि व आँधी-तूफ़ान; वनाग्नि का मौसम (15 फ़रवरी–15 जून)</td></tr>
      <tr><td><b>दक्षिण-पश्चिम मानसून</b></td><td>जून–सितंबर</td><td><b>~78%</b></td><td>भारी वर्षा, बादल फटना, भूस्खलन, नदी-बाढ़; चारधाम यात्रा मार्ग बाधित</td></tr>
      <tr><td><b>मानसून-पश्चात</b></td><td>अक्टूबर–नवंबर</td><td>~3%</td><td>साफ़ आसमान, सबसे अच्छी दृश्यता — ट्रेकिंग का मौसम</td></tr>
    </tbody>
  </table></div>
  <div class="box-myth"><strong><span class="tag myth">आँकड़ों में अंतर</span></strong>IMD की "Climate of Uttarakhand" मानसून का हिस्सा <b>लगभग 78%</b> बताती है, जबकि IMD के MAUSAM जर्नल का 1983–2023 का अध्ययन <b>लगभग 79%</b> लिखता है — अवधि अलग होने से। परीक्षा में "लगभग चार-पाँचवाँ भाग" सुरक्षित उत्तर है।</div>
</section>

<section id="mansoon">
  <h2>मानसून व पश्चिमी विक्षोभ</h2>
  <MonsoonWD />
  <ol class="steps">
    <li><b>मानसून का आगमन</b>बंगाल की खाड़ी शाखा पूर्व से आकर हिमालय के साथ पश्चिम की ओर बढ़ती है; उत्तराखंड में सामान्यतः जून के उत्तरार्ध में पहुँचता है। उदाहरण: 2024 में मानसून 27 जून को अधिकांश भाग में आया, 28 जून तक पूरा राज्य, और 2 अक्टूबर को लौटा।</li>
    <li><b>हिमालय से टकराव</b>नम हवा पहाड़ों पर चढ़ती है, ठंडी होकर बरसती है — <b>पर्वतीय (उच्चावच) वर्षा</b>। यही कारण है कि पिथौरागढ़, देहरादून, रुद्रप्रयाग, नैनीताल में अधिक वर्षा होती है।</li>
    <li><b>पश्चिमी विक्षोभ</b>सर्दियों में हर महीने लगभग 3–6 विक्षोभ, हर एक 2–4 दिन का। ऊँचाई पर हिमपात (हिमनदों का पोषण), नीचे वर्षा (गेहूँ जैसी रबी फ़सल के लिए उपयोगी), साथ ही कोहरा और शीत-लहर।</li>
    <li><b>मानसून + विक्षोभ का मेल</b>मानसून के दौरान जब पश्चिमी विक्षोभ भी सक्रिय हो जाए तो अत्यधिक वर्षा हो सकती है — जून 2013 की केदारनाथ आपदा के पीछे ऐसी ही अंतःक्रिया को व्यापक रूप से कारण माना गया।</li>
  </ol>
  <Orographic />
</section>

<section id="varsha">
  <h2>वर्षा का वितरण</h2>
