const faq = [
  { q: 'उत्तराखंड में वन कितने प्रतिशत हैं — 71% या 45%?', a: 'दोनों आँकड़े सही हैं, पर अलग चीज़ें मापते हैं। "अभिलिखित वन क्षेत्र" (Recorded Forest Area) कानूनी/राजस्व अभिलेखों में वन के रूप में दर्ज भूमि है — 38,000 वर्ग किमी, लगभग 71%। "वन आवरण" (Forest Cover) उपग्रह से मापी गई वह भूमि है जिस पर 10% से अधिक वृक्ष-छत्र घनत्व है — ISFR 2023 में 24,304 वर्ग किमी, लगभग 45.4%। दर्ज वन-भूमि में बहुत-सा भाग बुग्याल, चट्टान, हिम या विरल वन है।' },
  { q: 'उत्तराखंड की मिट्टी को ICAR किस श्रेणी में रखता है?', a: 'मुख्यतः पर्वतीय (mountain) या वन (forest) मिट्टी — जो कम विकसित, ढालों पर पतली और प्रायः अम्लीय होती है। तराई-भाबर व दून घाटियों में जलोढ़ मिट्टी है, जबकि ऊँचे बुग्यालों में कार्बनिक पदार्थ से भरपूर पर्वतीय घास-मैदानी मिट्टी।' },
