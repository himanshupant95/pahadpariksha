const facts = [
  { k: 'नदी बेसिन', v: 'पूरा उत्तराखंड <b>गंगा बेसिन</b> में (यमुना, रामगंगा, काली-घाघरा सब अंततः गंगा में)' },
  { k: 'गंगा का जन्म', v: '<b>देवप्रयाग</b> (टिहरी) — भागीरथी + अलकनंदा' },
  { k: 'भागीरथी', v: 'गोमुख (गंगोत्री हिमनद) से देवप्रयाग तक लगभग <b>205 किमी</b>' },
  { k: 'अलकनंदा', v: 'सतोपंथ-भागीरथ खरक हिमनद से देवप्रयाग तक लगभग <b>190 किमी</b>' },
  { k: 'पंच प्रयाग (ऊपर→नीचे)', v: '<b>विष्णु → नंद → कर्ण → रुद्र → देव</b> (स्मृति: वि-नं-क-रु-दे)' },
  { k: 'अंतरराष्ट्रीय सीमा-नदी', v: '<b>काली (महाकाली/शारदा)</b> — भारत-नेपाल सीमा' },
  { k: 'सबसे बड़ा बाँध', v: '<b>टिहरी</b> (भागीरथी) — 260.5 मी ऊँचा; टिहरी परिसर कुल 2,400 MW (अप्रैल 2026 से)' },
];

const faq = [
  { q: 'गंगा का उद्गम कहाँ से माना जाता है?', a: 'परंपरा में गोमुख (गंगोत्री हिमनद का मुहाना, उत्तरकाशी) से निकलने वाली भागीरथी को गंगा का स्रोत माना जाता है। पर "गंगा" नाम देवप्रयाग में भागीरथी और अलकनंदा के संगम के बाद मिलता है। जल-आयतन और लंबाई के आधार पर अलकनंदा को भी मुख्य धारा माना जाता है — इस पर भूगोलवेत्ताओं में मत-भेद है।' },
  { q: 'पंच प्रयाग कौन-से हैं और किस क्रम में?', a: 'अलकनंदा पर ऊपर से नीचे: विष्णुप्रयाग (धौलीगंगा), नंदप्रयाग (नंदाकिनी), कर्णप्रयाग (पिंडर), रुद्रप्रयाग (मंदाकिनी), देवप्रयाग (भागीरथी)। पहले तीन चमोली, चौथा रुद्रप्रयाग और पाँचवाँ टिहरी गढ़वाल ज़िले में है।' },
  { q: 'उत्तराखंड में दो धौलीगंगा क्यों हैं?', a: 'एक पश्चिमी धौलीगंगा (चमोली) — नीति दर्रे के पास से निकलकर विष्णुप्रयाग में अलकनंदा से मिलती है; दूसरी पूर्वी धौलीगंगा (पिथौरागढ़, दारमा घाटी) — तवाघाट में काली से मिलती है। इसी तरह दो रामगंगा भी हैं: पश्चिमी (गंगा में, कन्नौज के पास) और पूर्वी (सरयू में, रामेश्वर पर)।' },
  { q: 'टोंस नदी यमुना से कहाँ मिलती है?', a: 'देहरादून ज़िले में कालसी-डाकपत्थर के पास। टोंस यमुना की सबसे बड़ी सहायक नदी मानी जाती है और कई जगह इसका जल-प्रवाह संगम पर यमुना से अधिक बताया जाता है।' },
  { q: 'काली नदी को शारदा कब कहा जाता है?', a: 'मैदान में उतरने पर — टनकपुर-बनबसा (चंपावत) के आसपास से काली को शारदा कहते हैं। आगे उत्तर प्रदेश में यह घाघरा (करनाली) में मिलती है, जो अंततः गंगा में मिलती है।' },
];

const sources = [
  { label: 'NCERT — भारत: भौतिक पर्यावरण (कक्षा 11), अध्याय 3 "अपवाह तंत्र" (गंगा तंत्र, अपवाह प्रतिरूप, पूर्ववर्ती नदियाँ)' },
  { label: 'उत्तराखंड जल विद्युत निगम / THDC India Ltd. — टिहरी बाँध (260.5 मी, 1,000 MW) व टिहरी PSP', url: 'https://www.thdc.co.in/' },
  { label: 'THDC/PIB विज्ञप्तियाँ, अप्रैल 2026 — टिहरी पंप स्टोरेज प्लांट (4×250 = 1,000 MW) की अंतिम इकाई का वाणिज्यिक संचालन (12 अप्रैल 2026)' },
  { label: 'MoEFCC — भागीरथी इको-सेंसिटिव ज़ोन अधिसूचना S.O. 2930(E), 18 दिसंबर 2012 (4,179.59 वर्ग किमी)', url: 'https://moef.gov.in/' },
  { label: 'भारत-नेपाल महाकाली संधि, 1996 (पंचेश्वर, टनकपुर, शारदा बैराज) — विदेश मंत्रालय', url: 'https://www.mea.gov.in/' },
  { label: 'Shugar et al. (2021), "A massive rock and ice avalanche caused the 2021 disaster at Chamoli, Indian Himalaya", Science 373', url: 'https://www.science.org/doi/10.1126/science.abh4455' },
  { label: 'मानचित्र: पहाड़ परीक्षा — नदियाँ © OpenStreetMap contributors (ODbL); सीमाएँ DataMeet/Survey of India (CC BY 4.0); प्रयाग-ऊँचाई NASA SRTM से' },
];

const img = (w: number) => `https://upload.wikimedia.org/wikipedia/commons/thumb/e/ee/Devprayag_Confluence_Oct_2019.jpg/${w}px-Devprayag_Confluence_Oct_2019.jpg`;
---
<GeographyChapter
  name="नदियाँ और अपवाह तंत्र" nameEn="Rivers and Drainage System of Uttarakhand" slug="rivers-drainage"
  sub="छह नदी तंत्र, पंच प्रयाग, उद्गम-संगम, अपवाह प्रतिरूप और बाँध — नक्शे पर एक-एक नदी"
  title="उत्तराखंड की नदियाँ और अपवाह तंत्र: पंच प्रयाग, उद्गम, सहायक नदियाँ, बाँध (UKPSC)"
  description="उत्तराखंड की नदियाँ: यमुना, भागीरथी, अलकनंदा, रामगंगा, काली तंत्र; पंच प्रयाग, उद्गम-संगम तालिकाएँ और झीलें। मानचित्र और क्विज़ सहित।"
  image={img(960)} heroSrcset={`${img(500)} 500w, ${img(960)} 960w, ${img(1280)} 1280w`}
  imageAlt="देवप्रयाग में भागीरथी और अलकनंदा का संगम, जहाँ दो रंगों की धाराएँ मिलकर गंगा बनती हैं"
  heroCredit={{ text: 'देवप्रयाग संगम, अक्टूबर 2019 — Ashishjalan8, CC BY-SA 4.0, Wikimedia Commons', url: 'https://commons.wikimedia.org/wiki/File:Devprayag_Confluence_Oct_2019.jpg' }}
  published="2026-11-19" toc={toc} facts={facts} faq={faq} sources={sources}
>

<p class="pull">उत्तराखंड को "गंगा-यमुना का मायका" कहा जाता है — दोनों के उद्गम यहीं हैं। पर परीक्षा में असली कठिनाई है: कौन-सी नदी किसमें, कहाँ मिलती है। यह अध्याय उसी को नक्शे पर सुलझाता है।</p>

<section id="shabd">
  <h2>मूल शब्दावली</h2>
  <dl class="kv">
    <dt>अपवाह (Drainage)</dt><dd>किसी क्षेत्र का पानी नदियों के जाल से बहकर निकलना।</dd>
    <dt>अपवाह बेसिन / जलग्रहण क्षेत्र</dt><dd>वह पूरा क्षेत्र जिसका पानी एक ही नदी में जाता है।</dd>
    <dt>जल-विभाजक (Watershed)</dt><dd>दो बेसिनों को अलग करने वाली ऊँची रेखा/श्रेणी — जैसे बंदरपूँछ श्रेणी यमुना और भागीरथी के बीच।</dd>
    <dt>सहायक नदी</dt><dd>किसी बड़ी नदी में मिलने वाली नदी।</dd>
    <dt>प्रयाग</dt><dd>दो नदियों का संगम (गढ़वाल में विशेष रूप से अलकनंदा के पाँच संगम)।</dd>
    <dt>गाड़ / गधेरा</dt><dd>गढ़वाली-कुमाऊँनी में छोटी पहाड़ी नदी या नाला (जैसे दिन गाड़, नयार)।</dd>
  </dl>
</section>

<section id="tantra">
  <h2>छह नदी तंत्र — एक नक्शे पर</h2>
  <GeoMap name="g04-river-systems" w={1600} h={1487} alt="उत्तराखंड का नदी तंत्र मानचित्र: यमुना-टोंस बैंगनी, भागीरथी आसमानी, अलकनंदा हरी, गंगा गहरी नीली, रामगंगा-कोसी नारंगी, काली-सरयू लाल रंग में" caption="छह रंग, छह तंत्र। ध्यान दें — भागीरथी (आसमानी) और अलकनंदा (हरी) देवप्रयाग में मिलकर गंगा (गहरी नीली) बनती हैं; रामगंगा और काली तंत्र सीधे उत्तर प्रदेश में निकल जाते हैं।" source="मानचित्र: पहाड़ परीक्षा · नदियाँ © OpenStreetMap contributors (ODbL) · सीमाएँ: DataMeet/Survey of India (CC BY 4.0)" eager />
  <div class="table-wrap"><table>
    <thead><tr><th>तंत्र</th><th>मुख्य नदी</th><th>उद्गम</th><th>राज्य से बाहर</th><th>मुख्य ज़िले</th></tr></thead>
    <tbody>
      <tr><td>यमुना–टोंस</td><td>यमुना</td><td>यमुनोत्री (चंपासर) हिमनद, बंदरपूँछ, उत्तरकाशी</td><td>हिमाचल सीमा के साथ, डाकपत्थर-पांवटा के आगे मैदान</td><td>उत्तरकाशी, देहरादून</td></tr>
      <tr><td>भागीरथी</td><td>भागीरथी</td><td>गोमुख (गंगोत्री हिमनद)</td><td>— (देवप्रयाग में गंगा)</td><td>उत्तरकाशी, टिहरी</td></tr>
      <tr><td>अलकनंदा</td><td>अलकनंदा</td><td>सतोपंथ व भागीरथ खरक हिमनद</td><td>— (देवप्रयाग में गंगा)</td><td>चमोली, रुद्रप्रयाग, पौड़ी, टिहरी</td></tr>
      <tr><td>गंगा</td><td>गंगा</td><td>देवप्रयाग संगम</td><td>हरिद्वार के बाद उत्तर प्रदेश</td><td>टिहरी, पौड़ी, देहरादून, हरिद्वार</td></tr>
      <tr><td>रामगंगा–कोसी</td><td>(पश्चिमी) रामगंगा</td><td>दूधातोली श्रेणी</td><td>कालागढ़ के बाद उत्तर प्रदेश; कन्नौज के पास गंगा में</td><td>चमोली, अल्मोड़ा, पौड़ी, नैनीताल</td></tr>
      <tr><td>काली–सरयू</td><td>काली (शारदा)</td><td>कालापानी, व्यास घाटी, पिथौरागढ़</td><td>बनबसा के बाद उत्तर प्रदेश; घाघरा में</td><td>पिथौरागढ़, बागेश्वर, चंपावत, अल्मोड़ा</td></tr>
    </tbody>
  </table></div>
</section>

<section id="yamuna">
  <h2>1. यमुना–टोंस तंत्र (पश्चिम)</h2>
  <ul>
    <li><b>यमुना:</b> बंदरपूँछ श्रेणी के यमुनोत्री (चंपासर) हिमनद से; यमुनोत्री धाम उत्तरकाशी में। बड़कोट, नौगाँव होते हुए दक्षिण-पश्चिम; कुल लंबाई लगभग <b>1,376 किमी</b> (प्रयागराज में गंगा संगम तक)।</li>
    <li><b>टोंस:</b> सुपिन और रूपिन नदियाँ नैटवार के पास मिलकर टोंस बनती हैं (हर की दून क्षेत्र)। लगभग <b>148 किमी</b>; यमुना की सबसे बड़ी सहायक — <b>कालसी-डाकपत्थर</b> के पास मिलती है। जौनसार-बावर क्षेत्र इसी के आसपास।</li>
    <li><b>अन्य सहायक:</b> हनुमान गंगा (हनुमान चट्टी), कमल नदी (पुरोला), अगलाड़ (मसूरी के उत्तर), गिरि (हिमाचल से, पांवटा के पास), आसन (देहरादून घाटी, पश्चिमी भाग)।</li>
  </ul>
  <div class="box-exam"><strong><span class="tag exam">परीक्षा बिंदु</span></strong>यमुना पर <b>लखवाड़</b> (300 MW, राष्ट्रीय परियोजना) और टोंस पर <b>किशाऊ</b> (उत्तराखंड-हिमाचल संयुक्त) बहुउद्देशीय परियोजनाएँ प्रस्तावित/निर्माणाधीन हैं — इनकी स्थिति बदलती रहती है, उत्तर लिखते समय नवीनतम समाचार देखें। आसन-यमुना संगम पर <b>आसन संरक्षण आरक्षित</b> — उत्तराखंड का पहला रामसर स्थल (2020)।</div>
</section>

<section id="bhagirathi">
  <h2>2. भागीरथी</h2>
  <figure class="fig">
    <img src="https://upload.wikimedia.org/wikipedia/commons/thumb/6/63/Gaumukh_-_gangotri_national_park.jpg/960px-Gaumukh_-_gangotri_national_park.jpg" alt="गंगोत्री हिमनद का मुहाना गोमुख, जहाँ बर्फ़ की गुफा से भागीरथी नदी निकलती है" width="960" height="640" loading="lazy" referrerpolicy="no-referrer" />
    <figcaption>गोमुख — गंगोत्री हिमनद का स्नाउट, भागीरथी का उद्गम (गंगोत्री राष्ट्रीय उद्यान)।<span class="cr">चित्र: <a href="https://commons.wikimedia.org/wiki/File:Gaumukh_-_gangotri_national_park.jpg" target="_blank" rel="noopener nofollow">Gauravkaintura1234, CC BY-SA 4.0, Wikimedia Commons</a></span></figcaption>
  </figure>
  <div class="table-wrap"><table>
    <thead><tr><th>स्थान (ऊपर→नीचे)</th><th>मिलने वाली नदी</th><th>टिप्पणी</th></tr></thead>
    <tbody>
      <tr><td>गोमुख</td><td>—</td><td>उद्गम; गंगोत्री धाम यहाँ से ~18–19 किमी नीचे</td></tr>
      <tr><td>गंगोत्री</td><td>केदार गंगा</td><td>केदार ताल से</td></tr>
      <tr><td>भैरोंघाटी</td><td>जाड़ गंगा (जाह्नवी)</td><td>नेलांग घाटी (तिब्बत सीमा) से; गहरा गॉर्ज</td></tr>
      <tr><td>गंगोरी (उत्तरकाशी के पास)</td><td>असी गंगा</td><td>डोडीताल क्षेत्र से</td></tr>
      <tr><td>मनेरी / उत्तरकाशी</td><td>—</td><td>मनेरी भाली चरण I व II जलविद्युत</td></tr>
      <tr><td>टिहरी (गणेशप्रयाग, अब जलमग्न)</td><td>भिलंगना</td><td>खतलिंग हिमनद से; संगम पर टिहरी बाँध</td></tr>
      <tr><td>देवप्रयाग</td><td>अलकनंदा</td><td>गंगा का जन्म</td></tr>
    </tbody>
  </table></div>
  <div class="box-hist"><strong><span class="tag hist">तथ्य</span></strong><b>भागीरथी इको-सेंसिटिव ज़ोन</b> — 18 दिसंबर 2012 को अधिसूचित; गोमुख से उत्तरकाशी तक लगभग 100 किमी नदी-खंड, 4,179.59 वर्ग किमी। इसमें नई जलविद्युत परियोजनाएँ और खनन प्रतिबंधित हैं (इसी कारण लोहारीनाग-पाला जैसी परियोजनाएँ पहले ही, 2010 में, रोकी गई थीं)।</div>
</section>

<section id="alaknanda">
  <h2>3. अलकनंदा</h2>
  <ul>
    <li><b>उद्गम:</b> बद्रीनाथ के ऊपर सतोपंथ और भागीरथ खरक हिमनदों का संयुक्त जल (अलकापुरी हिमनद/बाँक)।</li>
    <li><b>केशवप्रयाग</b> (माणा के पास) — सरस्वती नदी (माणा दर्रे की ओर से) मिलती है। बद्रीनाथ धाम अलकनंदा के तट पर।</li>
    <li>इसके बाद पंच प्रयाग — नीचे देखें। बीच में <b>बिरही गंगा</b> (बिरही के पास; 1893–94 का गोहना ताल / बिरही बाढ़ प्रसंग) और <b>नयार</b> (पौड़ी, व्यासघाट के पास) भी मिलती हैं।</li>
    <li><b>धौलीगंगा (पश्चिमी)</b> की सहायक <b>ऋषिगंगा</b> रैणी के पास मिलती है — फ़रवरी 2021 की चमोली आपदा इसी घाटी में (रौंती चोटी से चट्टान-बर्फ़ हिमस्खलन; GLOF नहीं — Shugar et al., 2021)।</li>
    <li><b>मंदाकिनी:</b> चोराबाड़ी हिमनद (केदारनाथ) से; सोनप्रयाग में सोन गंगा (वासुकी गंगा) मिलती है; जून 2013 की केदारनाथ आपदा इसी घाटी में।</li>
  </ul>
</section>

