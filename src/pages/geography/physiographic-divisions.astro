const img = (w: number) => `https://upload.wikimedia.org/wikipedia/commons/thumb/2/20/Panorama_of_Himalayas_from_Ranikhet.jpg/${w}px-Panorama_of_Himalayas_from_Ranikhet.jpg`;
---
<GeographyChapter
  name="भौतिक विभाजन: तराई से टेथिस तक" nameEn="Physiographic Divisions of Uttarakhand" slug="physiographic-divisions"
  sub="200 किमी में 300 मीटर से 7,800 मीटर — उत्तराखंड की सात भौतिक पट्टियाँ, उनकी चोटियाँ, घाटियाँ, दर्रे और बुग्याल"
  title="उत्तराखंड के भौतिक विभाग: तराई से टेथिस हिमालय तक"
  description="उत्तराखंड के भौतिक विभाग: तराई, भाबर, शिवालिक, दून, लघु, वृहत और टेथिस हिमालय; प्रमुख चोटियाँ, दर्रे और बुग्याल। मानचित्र और क्विज़ सहित।"
  image={img(1280)} heroSrcset={`${img(960)} 960w, ${img(1280)} 1280w, ${img(1920)} 1920w`} heroContain
  imageAlt="रानीखेत से दिखती हिमालय की बर्फ़ीली चोटियों की लंबी शृंखला, आगे देवदार-चीड़ से ढकी लघु हिमालय की पहाड़ियाँ"
  heroCredit={{ text: 'रानीखेत (लघु हिमालय) से वृहत हिमालय का दृश्य — Harshit SR, CC BY-SA 4.0, Wikimedia Commons', url: 'https://commons.wikimedia.org/wiki/File:Panorama_of_Himalayas_from_Ranikhet.jpg' }}
  published="2026-11-19" toc={toc} facts={facts} faq={faq} sources={sources}
>

<p class="pull">ऊपर का चित्र ही पूरा अध्याय है: आगे हरी, गोल पहाड़ियाँ (लघु हिमालय), पीछे बर्फ़ की दीवार (वृहत हिमालय)। रानीखेत से नंदा देवी तक सीधी दूरी 100 किमी से कम है, पर ऊँचाई का अंतर लगभग 6 किमी।</p>

<section id="saar">
  <h2>सात पट्टियाँ: पूरी तस्वीर</h2>
  <p><b>क्या?</b> भौतिक विभाजन (physiographic division) यानी ऊँचाई, ढाल, चट्टान और भू-आकृति के आधार पर प्रदेश को पट्टियों में बाँटना। <b>क्यों पट्टियाँ?</b> क्योंकि <a href="/geography/himalaya-formation-geology/">अध्याय 2</a> के क्षेप-भ्रंश (HFT, MBT, MCT, STD) पूर्व-पश्चिम दिशा में चलते हैं — इसलिए भू-आकृतियाँ भी पूर्व-पश्चिम पट्टियों में बँटी हैं।</p>
  <Belts />
  <div class="table-wrap"><table>
    <thead><tr><th>पट्टी</th><th>ऊँचाई (लगभग)</th><th>भूगर्भीय सीमा</th><th>मुख्य ज़िले / स्थान</th><th>पहचान</th></tr></thead>
    <tbody>
      <tr><td><b>तराई</b></td><td>~200–300 मी</td><td>गंगा जलोढ़</td><td>ऊधम सिंह नगर, हरिद्वार व नैनीताल का दक्षिणी भाग</td><td>दलदल, महीन मिट्टी, धान-गन्ना, उद्योग</td></tr>
      <tr><td><b>भाबर</b></td><td>~300–500 मी</td><td>HFT के ठीक दक्षिण</td><td>हल्द्वानी, रामनगर, कोटद्वार, टनकपुर</td><td>कंकड़-पत्थर, नदियाँ भूमिगत</td></tr>
      <tr><td><b>शिवालिक</b></td><td>~700–1,200 मी</td><td>HFT और MBT के बीच</td><td>मोहंड, राजाजी, लैंसडाउन के दक्षिण की पहाड़ियाँ</td><td>ढीली चट्टानें, तेज़ अपरदन, चो/रौ</td></tr>
      <tr><td><b>दून</b></td><td>~400–1,000 मी</td><td>शिवालिक के उत्तर, MBT से सटी</td><td>देहरादून, कोठरी दून, पातली दून</td><td>चौड़ी समतल घाटी, कंकड़ के पंख (fans)</td></tr>
      <tr><td><b>लघु हिमालय</b></td><td>~1,200–3,000+ मी</td><td>MBT और MCT के बीच</td><td>मसूरी, नैनीताल, अल्मोड़ा, पौड़ी, टिहरी, चंपावत</td><td>सबसे बड़ी पट्टी; हिल स्टेशन, सीढ़ीदार खेत, ताल</td></tr>
      <tr><td><b>वृहत हिमालय</b></td><td>~4,000 से 7,816 मी</td><td>MCT और STD के बीच</td><td>उत्तरकाशी, चमोली, रुद्रप्रयाग, पिथौरागढ़ व बागेश्वर का उत्तरी भाग</td><td>हिमनद, चोटियाँ, बुग्याल, तीर्थ</td></tr>
      <tr><td><b>टेथिस हिमालय</b></td><td>~3,500–6,000 मी</td><td>STD के उत्तर</td><td>नीति, माणा, नेलांग, ऊपरी जोहार-दारमा-व्यास</td><td>वृष्टि-छाया, ठंडा मरुस्थल, दर्रे</td></tr>
    </tbody>
  </table></div>
  <p class="muted">ऊँचाइयाँ स्थूल हैं — विभिन्न पुस्तकों में पट्टियों की ऊँचाई-सीमाएँ अलग-अलग दी गई हैं। लघु हिमालय के ऊँचे भाग (जैसे नाग टिब्बा, ~3,000 मी) 3,000 मी से ऊपर भी जाते हैं।</p>
  <div class="box-trap"><strong><span class="tag trap">सावधान</span></strong>NCERT (कक्षा 9) "हिमाचल" (लघु हिमालय) की ऊँचाई 3,700–4,500 मी और औसत चौड़ाई 50 किमी बताता है — यह <b>पूरे हिमालय</b> के लिए सामान्यीकरण है। उत्तराखंड में अधिकांश बसावट वाला लघु हिमालय इससे काफ़ी नीचे (1,000–2,500 मी) है। प्रश्न में "उत्तराखंड" लिखा हो तो राज्य-विशेष उत्तर दें।</div>
</section>

<section id="terai">
  <h2>1. तराई</h2>
  <ol class="steps">
    <li><b>क्या</b>भाबर के दक्षिण की समतल, नम, दलदली पट्टी — "तराई" का अर्थ ही नम/तर भूमि।</li>
    <li><b>कैसे बनी</b>भाबर में भूमिगत हुआ पानी ढाल कम होते ही फिर सतह पर आता है (झरने/स्रोत), और नदियाँ महीन मिट्टी बिछाती हैं।</li>
    <li><b>प्रभाव</b>पहले घना जंगल, ऊँची घास, मलेरिया; थारू और बोक्सा जनजातियों का पारंपरिक क्षेत्र। 1950 के दशक के बाद जंगल साफ़ कर बसावट और खेती बढ़ी (पंतनगर विश्वविद्यालय 1960)।</li>
    <li><b>आज</b>राज्य का "अन्न-कटोरा" — धान, गेहूँ, गन्ना; रुद्रपुर-सितारगंज-काशीपुर के औद्योगिक क्षेत्र।</li>
  </ol>
  <div class="box-exam"><strong><span class="tag exam">परीक्षा बिंदु</span></strong>ऊधम सिंह नगर उत्तराखंड का सबसे स्पष्ट तराई ज़िला है — यहीं थारू (खटीमा-सितारगंज) और बोक्सा (बाजपुर-काशीपुर-गदरपुर) बसे हैं। जनजातियों का विस्तार अध्याय 9 में।</div>
</section>

<section id="bhabar">
  <h2>2. भाबर</h2>
  <BhabarTerai />
  <ul>
    <li><b>क्या:</b> शिवालिक की तलहटी की ढलवाँ पट्टी जहाँ पहाड़ से उतरी नदियाँ बड़े कंकड़-पत्थर (गोलाश्म) छोड़ देती हैं। NCERT के अनुसार भाबर की चौड़ाई सामान्यतः <b>8–16 किमी</b>।</li>
    <li><b>क्यों नदियाँ गायब होती हैं:</b> मोटे कंकड़ों के बीच खाली जगह (छिद्रिलता) अधिक है, इसलिए छोटी नदियों का पानी नीचे रिस जाता है — सतह पर सूखी नदी-तल (रौ/गधेरे) दिखते हैं।</li>
    <li><b>प्रभाव:</b> खेती और पेयजल कठिन; पर पर्वत और मैदान का "प्रवेश-द्वार" — हल्द्वानी, रामनगर, कोटद्वार, टनकपुर जैसे मंडी-नगर यहीं बसे।</li>
    <li><b>ऐतिहासिक प्रवास:</b> सर्दियों में पहाड़ के लोग पशुओं सहित भाबर उतरते थे (घाम-तापो/माल जाना) — यह मौसमी प्रवास आज भी कहीं-कहीं दिखता है।</li>
  </ul>
</section>

<section id="shivalik">
  <h2>3. शिवालिक (बाह्य हिमालय)</h2>
  <ul>
    <li><b>स्थान:</b> HFT और MBT के बीच की सबसे बाहरी पहाड़ी शृंखला — हरिद्वार-देहरादून के बीच, कोटद्वार के उत्तर, रामनगर-हल्द्वानी के ऊपर। NCERT सामान्य ऊँचाई 900–1,100 मी और चौड़ाई 10–50 किमी बताता है।</li>
    <li><b>बनावट:</b> नदियों द्वारा लाए गए बालू-कंकड़ से बनी, कम संगठित चट्टानें (मायोसीन–प्लीस्टोसीन)। इसलिए बहुत तेज़ अपरदन, गहरे नाले ("चो"), बरसात में बाढ़ और मलबा।</li>
    <li><b>जीवाश्म:</b> शिवालिक प्राचीन स्तनधारियों (हाथी-वंश, जिराफ़-वंश, घोड़े, वानर) के जीवाश्मों के लिए विश्व-प्रसिद्ध है।</li>
    <li><b>महत्व:</b> राजाजी व कॉर्बेट के जंगल, साल वन, हाथी गलियारे; हरिद्वार में गंगा शिवालिक को काटकर मैदान में प्रवेश करती है।</li>
  </ul>
  <div class="box-hist"><strong><span class="tag hist">नाम</span></strong>"शिवालिक" — शिव की जटाएँ/शिव का घर। प्राचीन ग्रंथों में "मानक पर्वत" नाम भी मिलता है — इस पर स्रोत एकमत नहीं।</div>
</section>

<section id="doon">
  <h2>4. दून घाटियाँ</h2>
  <ul>
    <li><b>क्या:</b> शिवालिक और लघु हिमालय के बीच लंबी, चपटी, अनुदैर्ध्य (longitudinal) घाटियाँ। "दून/द्वार" — पर्वत का द्वार।</li>
    <li><b>कैसे बनी:</b> शिवालिक के उठने से नदियों का मार्ग अवरुद्ध हुआ; पीछे लघु हिमालय से आई तलछट (कंकड़, बजरी) भरती गई और समतल घाटी बनी।</li>
    <li><b>देहरादून:</b> सबसे बड़ी और प्रसिद्ध — दक्षिण में शिवालिक, उत्तर में मसूरी पहाड़ियाँ, पूर्व में गंगा, पश्चिम में यमुना। बीच से सुसवा (पूर्व की ओर) और आसन (पश्चिम की ओर) नदियाँ बहती हैं।</li>
    <li><b>अन्य:</b> कोठरी दून (पौड़ी, कोटद्वार-लैंसडाउन क्षेत्र), पातली दून (कॉर्बेट, रामगंगा घाटी)।</li>
  </ul>
  <div class="box-exam"><strong><span class="tag exam">परीक्षा बिंदु</span></strong>देहरादून घाटी का जल-विभाजक लगभग बीच में है: पूर्वी भाग का पानी <b>सुसवा → गंगा</b>, पश्चिमी भाग का <b>आसन → यमुना</b>। आसन संरक्षण आरक्षित (2020 में रामसर स्थल) इसी आसन-यमुना संगम पर है।</div>
</section>

<section id="laghu">
  <h2>5. लघु (मध्य) हिमालय — हिमाचल</h2>
  <figure class="fig">
    <img src="https://upload.wikimedia.org/wikipedia/commons/thumb/6/64/Terraced_farming%2C_paddy_cultivation_in_Kumaon%2C_Uttarakhand_-_1.jpeg/960px-Terraced_farming%2C_paddy_cultivation_in_Kumaon%2C_Uttarakhand_-_1.jpeg" alt="कुमाऊँ की पहाड़ी ढलान पर धान के हरे सीढ़ीदार खेत" width="960" height="720" loading="lazy" referrerpolicy="no-referrer" />
    <figcaption>कुमाऊँ में सीढ़ीदार खेत — लघु हिमालय की खेती की पहचान।<span class="cr">चित्र: <a href="https://commons.wikimedia.org/wiki/File:Terraced_farming,_paddy_cultivation_in_Kumaon,_Uttarakhand_-_1.jpeg" target="_blank" rel="noopener nofollow">Ramwik, CC BY-SA 3.0, Wikimedia Commons</a></span></figcaption>
  </figure>
  <ul>
    <li><b>सीमा:</b> दक्षिण में MBT, उत्तर में MCT। उत्तराखंड का सबसे चौड़ा भाग — गढ़वाल परिच्छेद में ऋषिकेश से जोशीमठ के पास तक लगभग 135 किमी (नदी-मार्ग के साथ)।</li>
    <li><b>प्रमुख श्रेणियाँ:</b> मसूरी श्रेणी, नाग टिब्बा श्रेणी (टिहरी-देहरादून), गढ़वाल-कुमाऊँ की मध्य श्रेणियाँ (दूधातोली, बिनसर, गागर आदि)।</li>
    <li><b>हिल स्टेशन:</b> मसूरी, नैनीताल, रानीखेत, अल्मोड़ा, लैंसडाउन, पौड़ी, मुक्तेश्वर, चकराता — अधिकतर ब्रिटिश काल में छावनी/ग्रीष्म आवास के रूप में विकसित।</li>
    <li><b>ताल:</b> नैनीताल क्षेत्र — नैनीताल, भीमताल, सातताल, नौकुचियाताल, खुरपाताल। ये भ्रंश/भूस्खलन से अवरुद्ध घाटियों में बनी मानी जाती हैं (उत्पत्ति पर शोध में भिन्न मत)।</li>
    <li><b>जीवन:</b> राज्य की अधिकांश पहाड़ी जनसंख्या, सीढ़ीदार खेत, चीड़-बाँज के जंगल, और सबसे अधिक पलायन वाले गाँव भी यहीं।</li>
  </ul>
</section>

<section id="vrihat">
  <h2>6. वृहत हिमालय — हिमाद्रि</h2>
  <ul>
    <li><b>सीमा:</b> दक्षिण में MCT (मुनस्यारी/वैकृता थ्रस्ट), उत्तर में STD। कठोर क्रिस्टलीय चट्टानें (नाइस, ग्रेनाइट) — इसलिए खड़ी चोटियाँ।</li>
    <li><b>हिम व हिमनद:</b> गंगोत्री, सतोपंथ, मिलम, पिंडारी जैसे हिमनद यहीं से निकलते हैं (<a href="/geography/glaciers/">अध्याय 5</a>)।</li>
    <li><b>नदियों के उद्गम:</b> भागीरथी (गोमुख), अलकनंदा (सतोपंथ-भागीरथ खरक), यमुना (यमुनोत्री/चंपासर हिमनद), मंदाकिनी (चोराबाड़ी), पिंडर, गोरी।</li>
    <li><b>तीर्थ:</b> चारों धाम — यमुनोत्री, गंगोत्री, केदारनाथ, बद्रीनाथ — इसी पट्टी या उसकी दहलीज़ पर; हेमकुंड साहिब भी।</li>
  </ul>
</section>

