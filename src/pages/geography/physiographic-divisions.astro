const faq = [
  { q: 'उत्तराखंड को कितने भौतिक भागों में बाँटा जाता है?', a: 'सामान्यतः दक्षिण से उत्तर सात पट्टियों में — तराई, भाबर, शिवालिक, दून घाटियाँ, लघु (मध्य) हिमालय, वृहत हिमालय और टेथिस (ट्रांस) हिमालय। कुछ पुस्तकें तराई-भाबर को एक साथ "मैदानी भाग" या दून को शिवालिक के साथ गिनकर 4–6 भाग बताती हैं; यह वर्गीकरण का अंतर है, तथ्यों का नहीं।' },
  { q: 'भाबर और तराई में क्या अंतर है?', a: 'भाबर शिवालिक की तलहटी की कंकड़-पत्थर वाली, ढलवाँ, छिद्रिल पट्टी है जहाँ छोटी नदियाँ भूमिगत हो जाती हैं और खेती कठिन है। तराई उसके दक्षिण की समतल, महीन मिट्टी वाली पट्टी है जहाँ वही पानी फिर सतह पर आता है — दलदल, ऊँची घास और बहुत उपजाऊ ज़मीन।' },
  { q: 'उत्तराखंड की सबसे ऊँची चोटी कौन-सी है?', a: 'नंदा देवी (7,816 मीटर), चमोली ज़िले में। यह पूरी तरह भारत में स्थित सबसे ऊँची चोटी है। कंचनजंगा (भारत-नेपाल सीमा पर) इससे ऊँची है, और भारत अपने दावे वाले K2 को देश की सबसे ऊँची चोटी मानता है — इसलिए "भारत में नंदा देवी का स्थान" प्रश्न की शर्त पर निर्भर है।' },
  { q: 'दून घाटी क्या होती है?', a: 'लघु हिमालय और शिवालिक के बीच की लंबी, चौड़ी, अनुदैर्ध्य (श्रेणियों के समानांतर) घाटी। देहरादून इसका सबसे प्रसिद्ध उदाहरण है; पौड़ी की कोठरी दून और कॉर्बेट क्षेत्र की पातली दून भी उल्लेखनीय हैं।' },
  { q: 'बुग्याल क्या हैं?', a: 'वृक्ष-रेखा से ऊपर (मोटे तौर पर 3,000–3,500 मीटर से ऊपर) के ऊँचे घास के मैदान, जो गर्मियों में फूलों से भर जाते हैं और पशुपालकों के ग्रीष्मकालीन चरागाह हैं — जैसे औली, बेदिनी, आली, दयारा।' },
];

const sources = [
  { label: 'अर्थ एवं संख्या निदेशालय, उत्तराखंड — सांख्यिकी डायरी (क्षेत्रफल, पर्वतीय क्षेत्र)', url: 'https://des.uk.gov.in/' },
  { label: 'NCERT — भारत: भौतिक पर्यावरण (कक्षा 11), अध्याय 2 "संरचना तथा भू-आकृति विज्ञान" (भाबर 8–16 किमी, तराई, शिवालिक, दून)' },
  { label: 'NCERT — समकालीन भारत-1 (कक्षा 9), अध्याय 2 "भारत का भौतिक स्वरूप" (हिमाद्रि, हिमाचल, शिवालिक)' },
  { label: 'K.S. Valdiya — "Geodynamic history of Uttarakhanda Himalaya" (Nepal Geological Society)', url: 'https://ngs.org.np/geodynamic-history-of-uttarakhanda-himalaya/' },
  { label: 'The Star / Kathmandu Post (ANN), 6 अगस्त 2026 — लिपुलेख से भारत-चीन व्यापार 1 अगस्त 2026 से शुरू', url: 'https://www.thestar.com.my/aseanplus/aseanplus-news/2026/08/06/india-china-begin-trade-through-lipulekh-pass-despite-nepals-territorial-objections' },
  { label: 'Himal Press, 20 अगस्त 2025 — भारत-चीन 12-सूत्री सहमति: लिपुलेख, शिप्की ला, नाथू ला से व्यापार', url: 'https://en.himalpress.com/?p=76816' },
  { label: 'Kathmandu Post, 1 मई 2026 — कैलाश मानसरोवर यात्रा (जून–अगस्त 2026) लिपुलेख से; नेपाल की आपत्ति', url: 'https://kathmandupost.com/national/2026/05/01/india-china-to-resume-kailash-mansarovar-yatra-via-lipulekh' },
  { label: 'ऊँचाई-परिच्छेद: NASA SRTM 90 मी. DEM; मानचित्र: पहाड़ परीक्षा' },
