---
import Base from '../layouts/Base.astro';
import NewsList from '../components/NewsList.astro';
import { newsByDay, newsUpdated } from '../lib/news';

const days = newsByDay(30);
const cats = [...new Set(days.flatMap(([, l]) => l.map((n) => n.cat)))];
const dayLabel = (d: string) => new Date(d + 'T12:00:00+05:30').toLocaleDateString('hi-IN', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Asia/Kolkata' });
const upd = newsUpdated ? new Date(newsUpdated).toLocaleString('hi-IN', { timeZone: 'Asia/Kolkata', day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }) : '';
---
<Base
  title="उत्तराखंड करेंट अफेयर्स — रोज़ की परीक्षा-उपयोगी ख़बरें"
  description="उत्तराखंड की परीक्षा-उपयोगी ख़बरें एक जगह: योजनाएँ, कैबिनेट फैसले, नियुक्तियाँ, पुरस्कार, रैंकिंग, परियोजनाएँ, पर्यावरण, संस्कृति — UKSSSC/UKPSC के लिए, हर 3 घंटे में अपडेट।"
>
  <h1>उत्तराखंड करेंट अफेयर्स</h1>
  <p>देशभर के समाचार स्रोतों से उत्तराखंड की वे ख़बरें जो परीक्षा में पूछी जा सकती हैं — योजनाएँ, नियुक्तियाँ, पुरस्कार, रैंकिंग, परियोजनाएँ, पर्यावरण और संस्कृति। अपराध, दुर्घटना और राजनीतिक बयानबाज़ी हटा दी जाती है। <strong>★ महत्वपूर्ण</strong> वाली ख़बरें पहले पढ़ें।</p>
  {upd && <p class="muted upd">अंतिम अपडेट: {upd} · हर 3 घंटे में स्वतः अपडेट</p>}

  {days.length === 0 ? <p class="muted">ख़बरें जल्द यहाँ दिखेंगी।</p> : (<>
    <div class="filters">
      <button type="button" class="on" data-c="">सभी</button>
      {cats.map((c) => <button type="button" data-c={c}>{c}</button>)}
    </div>
    {days.map(([d, list]) => (
      <section class="day">
        <h2>{dayLabel(d)} <small class="muted">({list.length})</small></h2>
        <NewsList items={list} />
      </section>
    ))}
  </>)}

  <div class="note">यह स्वचालित सूची है: शीर्षक और लिंक मूल समाचार स्रोतों के हैं (Google News के माध्यम से)। पूरी ख़बर स्रोत की वेबसाइट पर पढ़ें; परीक्षा में तथ्य लिखने से पहले आधिकारिक स्रोत (सरकारी विज्ञप्ति/PIB) से पुष्टि करें।</div>
</Base>

<script>
  const btns = [...document.querySelectorAll<HTMLButtonElement>('.filters button')];
  btns.forEach((b) => b.addEventListener('click', () => {
    btns.forEach((x) => x.classList.toggle('on', x === b));
    const c = b.dataset.c;
    document.querySelectorAll<HTMLElement>('.day').forEach((sec) => {
      let shown = 0;
      sec.querySelectorAll<HTMLElement>('li[data-cat]').forEach((li) => { li.hidden = !!c && li.dataset.cat !== c; if (!li.hidden) shown++; });
      sec.hidden = shown === 0;
    });
  }));
</script>

<style>
  .upd { font-size: .85rem; margin-top: -6px; }
  .filters { display: flex; flex-wrap: wrap; gap: 6px; margin: 8px 0 4px; position: sticky; top: 0; background: var(--bg, #fff); padding: 6px 0; z-index: 2; }
  .filters button { font: inherit; font-size: .88rem; border: 1px solid var(--line); background: var(--card); border-radius: 20px; padding: 3px 12px; cursor: pointer; color: var(--ink); }
  .filters button.on { background: var(--green-2); color: #fff; border-color: var(--green-2); }
  .day h2 { font-size: 1.1rem; margin-top: 22px; }
  .day h2 small { font-size: .8rem; font-weight: 400; }
</style>
