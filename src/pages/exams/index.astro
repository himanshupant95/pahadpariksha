---
import Base from '../../layouts/Base.astro';
import { PAPERS } from '../../data/pyq';
const sssc = ['कनिष्ठ सहायक / आशुलिपिक (JA/Steno)', 'पटवारी / लेखपाल', 'ग्राम विकास अधिकारी (VDO) / ग्राम पंचायत विकास अधिकारी (VPDO)', 'वन आरक्षी (Forest Guard)', 'पुलिस आरक्षी / उपनिरीक्षक'];
const psc = ['सम्मिलित राज्य (सिविल) प्रवर अधीनस्थ सेवा (Upper PCS)', 'सम्मिलित राज्य (सिविल) अवर अधीनस्थ सेवा (Lower PCS)', 'राजस्व उप निरीक्षक (Revenue Inspector)', 'समीक्षा अधिकारी / सहायक समीक्षा अधिकारी (RO/ARO)', 'सहायक वन संरक्षक / वन क्षेत्राधिकारी (ACF/FRO)', 'सहायक अध्यापक (LT) / प्रवक्ता'];
const lssOpen = Date.now() <= Date.parse('2026-11-26T23:59:59+05:30'); // site rebuilds nightly
// LSS-2026: UKPSC advertisement A-1/E-2/DR/LSS/2026-27 (read from the official PDF, 21 Nov 2026)
const lssMap = [
  ['5. सामयिक घटनाएँ', [['/current-affairs/', 'रोज़ का करेंट'], ['/gk/uttarakhand-varsh-2025-26/', 'वर्ष 2025–26']]],
  ['6. उत्तराखंड का इतिहास', [['/history/', 'इतिहास के 9 अध्याय']]],
  ['7. उत्तराखंड की संस्कृति', [['/gk/uttarakhand-sanskriti-janjatiyan/', 'संस्कृति और जनजातियाँ']]],
  ['8. भूगोल और जनांकिकी', [['/geography/', 'भूगोल के 8 अध्याय'], ['/gk/uttarakhand-tulnatmak-talikayen/', 'ज़िलों की तुलना']]],
  ['9. आर्थिक, राजनीतिक व प्रशासनिक परिवेश', [['/polity/', 'राजव्यवस्था'], ['/polity/land-revenue-system/', 'भूमि व्यवस्था']]],
  ['10. आर्थिक व प्राकृतिक संसाधन', [['/gk/uttarakhand-yojanayen/', 'योजनाएँ']]],
] as [string, [string, string][]][];
---
<Base title="UKSSSC और UKPSC परीक्षाएँ: लोअर PCS 2026 पैटर्न, सूची और आधिकारिक लिंक" description="उत्तराखंड की भर्ती परीक्षाएँ: UKSSSC और UKPSC की प्रमुख परीक्षाएँ, लोअर PCS 2026 की तिथियाँ, आयु, परीक्षा पैटर्न, ऋणात्मक अंकन और पाठ्यक्रम के हिसाब से तैयारी।">
  <nav class="crumbs"><a href="/">होम</a> › परीक्षाएँ</nav>
  <h1>UKSSSC और UKPSC परीक्षाएँ</h1>
  <p>उत्तराखंड में राज्य सरकार की ज़्यादातर भर्तियाँ दो आयोग करते हैं: <b>UKSSSC</b> (समूह "ग" के पद) और <b>UKPSC</b> (राज्य सिविल सेवा और ऊँचे पद)। नीचे अभी चल रही बड़ी भर्ती का पूरा पैटर्न है, फिर दोनों आयोगों की प्रमुख परीक्षाएँ।</p>

  <section class="lss">
    <p class="kick">{lssOpen ? 'अभी आवेदन चालू · UKPSC' : 'आवेदन बंद, परीक्षा की तैयारी करें · UKPSC'}</p>
    <h2>लोअर PCS 2026 (सम्मिलित राज्य सिविल अवर अधीनस्थ सेवा)</h2>
    <div class="table-wrap"><table>
      <tbody>
        <tr><th>विज्ञापन संख्या</th><td>A-1/E-2/DR/LSS/2026-27</td></tr>
        <tr><th>कुल पद</th><td><b>54</b> (संख्या घट-बढ़ सकती है)</td></tr>
        <tr><th>ऑनलाइन आवेदन</th><td>6 नवंबर 2026 से <b>26 नवंबर 2026</b> (रात 11:59 तक), फ़ीस भी इसी तारीख़ तक</td></tr>
        <tr><th>आवेदन में सुधार</th><td>3 से 12 दिसंबर 2026 (सिर्फ़ एक बार)</td></tr>
        <tr><th>आयु</th><td>21 से 42 वर्ष, 1 जुलाई 2026 को (आरक्षित वर्गों को छूट)</td></tr>
      </tbody>
    </table></div>
    <h3>परीक्षा के तीन चरण</h3>
    <div class="steps3">
      <div><b>1. प्रारंभिक (वस्तुनिष्ठ)</b><p>एक प्रश्नपत्र, <b>150 प्रश्न, 150 अंक, 2 घंटे</b>। भाग 1 सामान्य अध्ययन (100 प्रश्न), भाग 2 सामान्य बुद्धि परीक्षण (50 प्रश्न)। <b>हर गलत उत्तर पर एक-चौथाई अंक कटेगा</b>; खाली छोड़ने पर कोई कटौती नहीं। प्रारंभिक के अंक मेरिट में नहीं जुड़ते।</p></div>
      <div><b>2. मुख्य (लिखित, वर्णनात्मक)</b><p>सामान्य हिंदी 100, निबंध 100, सामान्य अध्ययन प्रथम 200, सामान्य अध्ययन द्वितीय 200 = <b>600 अंक</b>। सामान्य हिंदी में कम से कम <b>35%</b> ज़रूरी।</p></div>
      <div><b>3. साक्षात्कार</b><p><b>75 अंक</b>।</p></div>
    </div>
    <p class="muted">किसी प्रश्न में छपाई की गलती हो तो अंग्रेज़ी रूप को सही माना जाएगा। सभी तथ्य आयोग के आधिकारिक विज्ञापन से (21 नवंबर 2026 को जाँचे गए)। अंतिम जानकारी के लिए <a href="https://psc.uk.gov.in/" rel="noopener" target="_blank">psc.uk.gov.in</a> देखें।</p>

    <h3>प्रारंभिक पाठ्यक्रम के उत्तराखंड वाले हिस्से, हमारी साइट पर</h3>
    <div class="table-wrap"><table>
      <thead><tr><th>पाठ्यक्रम इकाई</th><th>कहाँ पढ़ें</th></tr></thead>
      <tbody>{lssMap.map(([u, ls]) => <tr><td>{u}</td><td>{ls.map(([h, l], i) => <>{i > 0 && ' · '}<a href={h}>{l}</a></>)}</td></tr>)}</tbody>
    </table></div>
    <p class="muted">अर्थव्यवस्था, कृषि, आपदा, जनसंख्या-पलायन और संस्कृति भाग 2 के अध्याय तैयार हो रहे हैं; प्रगति <a href="/#syl-h">होम पेज</a> पर देखें।</p>
  </section>

  <h2>UKSSSC: उत्तराखंड अधीनस्थ सेवा चयन आयोग</h2>
  <p>समूह "ग" के पदों की भर्ती। आधिकारिक वेबसाइट: <a href="https://sssc.uk.gov.in/" rel="noopener" target="_blank">sssc.uk.gov.in</a></p>
  <ul>{sssc.map((e) => <li>{e}</li>)}</ul>

  <h2>UKPSC: उत्तराखंड लोक सेवा आयोग (हरिद्वार)</h2>
  <p>राज्य सिविल सेवा और दूसरे ऊँचे पदों की भर्ती। आधिकारिक वेबसाइट: <a href="https://psc.uk.gov.in/" rel="noopener" target="_blank">psc.uk.gov.in</a></p>
  <ul>{psc.map((e) => <li>{e}</li>)}</ul>

  <div class="note">परीक्षा तिथि, पदों की संख्या, योग्यता और सिलेबस के लिए हमेशा आयोग की <strong>आधिकारिक विज्ञप्ति</strong> को अंतिम मानें। नई भर्तियाँ और एडमिट कार्ड <a href="/notices/">सूचनाएँ</a> पेज पर रोज़ जुड़ते हैं।</div>

  <h2>तैयारी कहाँ से शुरू करें</h2>
  <div class="cards">
    <a class="card" href="/gk/"><h3>उत्तराखंड सामान्य ज्ञान</h3><p>लगभग हर परीक्षा का सबसे बड़ा हिस्सा। यहीं से शुरुआत करें।</p></a>
    <a class="card" href="/pyq/"><h3>पिछले प्रश्नपत्र</h3><p>UKPSC के {PAPERS.length} प्रश्नपत्र, आधिकारिक उत्तर-कुंजी के साथ।</p></a>
    <a class="card" href="/quiz/"><h3>प्रैक्टिस क्विज़</h3><p>पढ़े हुए अध्याय का तुरंत अभ्यास।</p></a>
    <a class="card" href="/current-affairs/"><h3>करेंट अफेयर्स</h3><p>रोज़ के परीक्षा-उपयोगी बिंदु।</p></a>
  </div>
</Base>
<style>
  .crumbs { font-size: .85rem; color: var(--muted); margin: 4px 0 10px; }
  .lss { margin: 18px 0; padding: 18px; border-radius: 16px; background: linear-gradient(135deg, #eef2ff, #f0fdf4); border: 1px solid var(--line); }
  .lss h2 { margin-top: 2px; }
  .lss .kick { margin: 0; font-size: .8rem; font-weight: 700; color: #15803d; }
  .lss th { text-align: left; width: 34%; }
  .steps3 { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 10px; }
  .steps3 div { background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 10px 14px; }
  .steps3 p { margin: 4px 0 0; font-size: .92rem; line-height: 1.55; }
</style>
