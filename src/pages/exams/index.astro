---
import Base from '../../layouts/Base.astro';
const sssc = ['कनिष्ठ सहायक / आशुलिपिक (JA/Steno)', 'पटवारी / लेखपाल', 'ग्राम विकास अधिकारी (VDO) / ग्राम पंचायत विकास अधिकारी (VPDO)', 'वन आरक्षी (Forest Guard)', 'पुलिस आरक्षी / उपनिरीक्षक'];
const psc = ['सम्मिलित राज्य (सिविल) प्रवर अधीनस्थ सेवा (Upper PCS)', 'सम्मिलित राज्य (सिविल) अवर अधीनस्थ सेवा (Lower PCS)', 'राजस्व उप निरीक्षक (Revenue Inspector)', 'सहायक अध्यापक (LT) / प्रवक्ता'];
---
<Base title="UKSSSC और UKPSC परीक्षाएँ — सूची और आधिकारिक लिंक" description="उत्तराखंड अधीनस्थ सेवा चयन आयोग (UKSSSC) और उत्तराखंड लोक सेवा आयोग (UKPSC) की प्रमुख भर्ती परीक्षाओं की सूची, आधिकारिक वेबसाइट और तैयारी संसाधन।">
  <h1>UKSSSC और UKPSC परीक्षाएँ</h1>
  <p>उत्तराखंड में राज्य सरकार की अधिकांश भर्तियाँ दो आयोग करते हैं। हर परीक्षा का विस्तृत सिलेबस, परीक्षा पैटर्न और कट-ऑफ पेज जल्द जोड़ा जा रहा है।</p>

  <h2>UKSSSC — उत्तराखंड अधीनस्थ सेवा चयन आयोग</h2>
  <p>समूह "ग" के पदों की भर्ती। आधिकारिक वेबसाइट: <a href="https://sssc.uk.gov.in/" rel="noopener" target="_blank">sssc.uk.gov.in</a></p>
  <ul>{sssc.map((e) => <li>{e}</li>)}</ul>

  <h2>UKPSC — उत्तराखंड लोक सेवा आयोग</h2>
  <p>राज्य सिविल सेवा और अन्य उच्च पदों की भर्ती। आधिकारिक वेबसाइट: <a href="https://psc.uk.gov.in/" rel="noopener" target="_blank">psc.uk.gov.in</a></p>
  <ul>{psc.map((e) => <li>{e}</li>)}</ul>

  <div class="note">परीक्षा तिथि, पदों की संख्या, योग्यता और सिलेबस के लिए हमेशा आयोग की <strong>आधिकारिक विज्ञप्ति</strong> को अंतिम मानें।</div>

  <h2>लगभग हर परीक्षा में पूछे जाने वाले विषय</h2>
  <div class="cards">
    <a class="card" href="/gk/"><h3>उत्तराखंड सामान्य ज्ञान</h3><p>सबसे ज़्यादा अंक वाला खंड — यहीं से शुरुआत करें।</p></a>
    <a class="card" href="/quiz/"><h3>प्रैक्टिस क्विज़</h3><p>पढ़े हुए टॉपिक का तुरंत अभ्यास।</p></a>
  </div>
</Base>
