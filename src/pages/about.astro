---
import Base from '../layouts/Base.astro';
import { SITE } from '../data/site';
---
<Base title="हमारे बारे में" description={`${SITE.name} के बारे में — उत्तराखंड प्रतियोगी परीक्षाओं के अभ्यर्थियों के लिए मुफ्त हिंदी अध्ययन सामग्री।`}>
  <h1>हमारे बारे में</h1>
  <p><strong>{SITE.name}</strong> उत्तराखंड की प्रतियोगी परीक्षाओं — UKSSSC और UKPSC — की तैयारी कर रहे अभ्यर्थियों के लिए एक स्वतंत्र, मुफ्त हिंदी वेबसाइट है।</p>
  <h2>हमारा उद्देश्य</h2>
  <p>पहाड़ के हर अभ्यर्थी तक भरोसेमंद, परीक्षा-केंद्रित और सरल भाषा में अध्ययन सामग्री पहुँचाना — चाहे उसके पास महंगी कोचिंग की सुविधा हो या नहीं।</p>
  <h2>हमारी सामग्री कैसे तैयार होती है</h2>
  <ul>
    <li>तथ्य मानक पुस्तकों, सरकारी स्रोतों और पिछले वर्षों के प्रश्न पत्रों से मिलान करके लिखे जाते हैं।</li>
    <li>हर पेज पर "अपडेट" तिथि दी जाती है; नई जानकारी आने पर पेज संशोधित किए जाते हैं।</li>
    <li>त्रुटि की सूचना मिलने पर उसे जल्द से जल्द सुधारा जाता है।</li>
  </ul>
  <p>स्रोत, AI के उपयोग और तथ्य-जाँच की पूरी प्रक्रिया: <a href="/methodology/">हमारी कार्यप्रणाली</a></p>
  <p>लेखक के बारे में: <a href={SITE.author.url}>{SITE.author.name}</a></p>
</Base>
