---
import Base from '../../layouts/Base.astro';
import PointList from '../../components/PointList.astro';
import { points, byDay, weeks, months, weekLabel, monthLabel, fmtDay, digestUpdated } from '../../lib/digest';

const all = points();
const days = byDay(all).slice(0, 10);
const ws = weeks().slice(0, 8);
const ms = months().slice(0, 12);
const cats = [...new Set(days.flatMap(([, l]) => l.map((p) => p.cat)))];
const upd = digestUpdated ? new Date(digestUpdated).toLocaleString('hi-IN', { timeZone: 'Asia/Kolkata', day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }) : '';
---
<Base
  title="उत्तराखंड करेंट अफेयर्स — रोज़ के परीक्षा बिंदु, साप्ताहिक व मासिक PDF"
  description="उत्तराखंड करेंट अफेयर्स केवल परीक्षा-उपयोगी बिंदुओं में: योजनाएँ, नियुक्तियाँ, पुरस्कार, रैंकिंग, परियोजनाएँ। हर दिन अपडेट, साप्ताहिक व मासिक संकलन PDF के साथ — UKSSSC/UKPSC के लिए।"
>
  <h1>उत्तराखंड करेंट अफेयर्स</h1>
  <p>रोज़ की सैकड़ों ख़बरों में से केवल वे बिंदु जो <strong>परीक्षा में पूछे जा सकते हैं</strong>। <strong>किसी भी बिंदु पर क्लिक करें</strong> — उसके मुख्य तथ्य (कब, कहाँ, कौन, कितना, क्यों) यहीं खुल जाएँगे; पूरी ख़बर पढ़नी हो तो अंत में स्रोत का लिंक है। <strong>★</strong> वाले बिंदु सबसे महत्वपूर्ण हैं।</p>
  {upd && <p class="muted upd">अंतिम अपडेट: {upd} · हर रात 12 बजे पिछले दिन का संस्करण</p>}

  <div class="compile">
    {ws[0] && <a class="big" href={`/current-affairs/week/${ws[0].key}/`}><strong>इस सप्ताह का संकलन</strong><span>{weekLabel(ws[0].start, ws[0].end)} · {ws[0].items.length} बिंदु · PDF</span></a>}
    {ms[0] && <a class="big" href={`/current-affairs/month/${ms[0].key}/`}><strong>{monthLabel(ms[0].key)} — मासिक संकलन</strong><span>{ms[0].items.length} बिंदु · PDF</span></a>}
  </div>

  {days.length === 0 ? <p class="muted">बिंदु जल्द यहाँ दिखेंगे।</p> : (<>
    <div class="filters">
      <button type="button" class="on" data-c="">सभी</button>
      {cats.map((c) => <button type="button" data-c={c}>{c}</button>)}
      <button type="button" class="toggle-all" aria-pressed="false">सभी खोलें ▾</button>
    </div>
    {days.map(([d, list]) => (
      <section class="day">
        <h2>{fmtDay(d)} <small class="muted">({list.length})</small></h2>
        <PointList items={list} collapsible />
      </section>
    ))}
  </>)}

  <h2>संग्रह (Archive)</h2>
  <div class="arch">
    <div><h3>साप्ताहिक</h3><ul>{ws.map((w) => <li><a href={`/current-affairs/week/${w.key}/`}>{weekLabel(w.start, w.end)}</a> <small class="muted">({w.items.length})</small></li>)}</ul></div>
    <div><h3>मासिक</h3><ul>{ms.map((m) => <li><a href={`/current-affairs/month/${m.key}/`}>{monthLabel(m.key)}</a> <small class="muted">({m.items.length})</small></li>)}</ul></div>
  </div>

  <div class="note">बिंदु देशभर के समाचार शीर्षकों (Google News के माध्यम से) से AI सहायता द्वारा चुने और संक्षेपित किए जाते हैं; हर बिंदु मूल ख़बर से जुड़ा है। परीक्षा में लिखने से पहले आधिकारिक स्रोत (सरकारी विज्ञप्ति/PIB) से पुष्टि करें।</div>
</Base>

<script>
  const btns = [...document.querySelectorAll<HTMLButtonElement>('.filters button[data-c]')];
  const tog = document.querySelector<HTMLButtonElement>('.toggle-all');
  tog?.addEventListener('click', () => {
    const open = tog.getAttribute('aria-pressed') !== 'true';
    document.querySelectorAll<HTMLDetailsElement>('.points.coll details').forEach((d) => { d.open = open; });
    tog.setAttribute('aria-pressed', String(open));
    tog.textContent = open ? 'सभी बंद करें ▴' : 'सभी खोलें ▾';
  });
  btns.forEach((b) => b.addEventListener('click', () => {
    btns.forEach((x) => x.classList.toggle('on', x === b));
    const c = b.dataset.c;
    document.querySelectorAll<HTMLElement>('.day').forEach((sec) => {
      let shown = 0;
      sec.querySelectorAll<HTMLElement>('li[data-cat]').forEach((li) => { li.hidden = !!c && li.dataset.cat !== c; if (!li.hidden) shown++; });
      sec.hidden = shown === 0;
    });
  }));
</script>

<style>
  .upd { font-size: .85rem; margin-top: -6px; }
  .compile { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 10px; margin: 12px 0; }
  .compile .big { display: block; text-decoration: none; background: linear-gradient(135deg, var(--green), var(--green-2)); color: #fff; border-radius: 12px; padding: 14px 16px; }
  .compile .big strong { display: block; font-size: 1.05rem; }
  .compile .big span { font-size: .85rem; opacity: .9; }
  .filters { display: flex; flex-wrap: wrap; gap: 6px; margin: 8px 0 4px; }
  .filters button { font: inherit; font-size: .88rem; border: 1px solid var(--line); background: var(--card); border-radius: 20px; padding: 3px 12px; cursor: pointer; color: var(--ink); }
  .filters button.on { background: var(--green-2); color: #fff; border-color: var(--green-2); }
  .filters .toggle-all { margin-left: auto; border-color: var(--green-2); color: var(--green-2); font-weight: 600; }
  .day h2 { font-size: 1.1rem; margin-top: 22px; }
  .arch { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 10px; }
</style>
