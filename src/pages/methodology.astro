---
import Base from '../layouts/Base.astro';
import { SITE } from '../data/site';
const updated = '17 नवंबर 2026';
const schema = [{
  '@context': 'https://schema.org', '@type': 'AboutPage', name: 'हमारी कार्यप्रणाली — सामग्री कैसे तैयार और जाँची जाती है',
  url: `${SITE.url}/methodology/`, inLanguage: 'hi-IN', dateModified: '2026-11-17',
  publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url + '/' },
}];
---
<Base title="हमारी कार्यप्रणाली: सामग्री कैसे तैयार और जाँची जाती है" description="पहाड़ परीक्षा पर भर्ती सूचनाएँ, करेंट अफेयर्स, उत्तराखंड GK व इतिहास कैसे तैयार होते हैं — स्रोत, AI का उपयोग, तथ्य-जाँच और त्रुटि-सुधार की पूरी प्रक्रिया।" schema={schema}>
  <h1>हमारी कार्यप्रणाली</h1>
  <p class="lead">यह पेज बताता है कि इस साइट की हर तरह की सामग्री कहाँ से आती है, कैसे जाँची जाती है, और गलती मिलने पर क्या होता है। <small>अंतिम अद्यतन: {updated}</small></p>

  <div class="note"><strong>ध्यान दें:</strong> {SITE.name} एक स्वतंत्र वेबसाइट है — इसका UKSSSC, UKPSC या उत्तराखंड सरकार से कोई संबंध नहीं है। भर्ती, तिथि या परिणाम से जुड़ा अंतिम निर्णय हमेशा आयोग की आधिकारिक वेबसाइट और विज्ञापन का ही मान्य होता है।</div>

  <h2>1. भर्ती सूचनाएँ, एडमिट कार्ड और परिणाम</h2>
  <ul>
    <li><b>UKSSSC:</b> आयोग की वेबसाइट (sssc.uk.gov.in) और आवेदन पोर्टल को एक स्वचालित प्रोग्राम दिन में कई बार पढ़ता है। नई सूचना मिलते ही वह साइट पर आ जाती है।</li>
    <li><b>UKPSC:</b> आवेदन/एडमिट कार्ड पोर्टल स्वचालित रूप से पढ़ा जाता है। मुख्य वेबसाइट (psc.uk.gov.in) भारत के बाहर के सर्वरों से नहीं खुलती, इसलिए उसके परिणाम, उत्तर कुंजी, एडमिट कार्ड और भर्ती सूचनाएँ <b>हर सुबह</b> जाँचकर जोड़ी जाती हैं।</li>
    <li>हर सूचना सीधे आयोग की मूल PDF या पेज से जुड़ी होती है — हम सूचना का शीर्षक, प्रकाशन-तिथि और अंतिम तिथि वैसे ही दिखाते हैं जैसे आयोग ने दी है।</li>
    <li>"आवेदन चालू" सूची में दिखने वाली अंतिम तिथि आयोग के पोर्टल/विज्ञापन से ली जाती है; तिथि बीतते ही वह प्रविष्टि अपने आप हट जाती है।</li>
  </ul>

  <h2>2. करेंट अफेयर्स</h2>
  <ul>
    <li><b>स्रोत:</b> हर रात उत्तराखंड से जुड़ी खबरें Google News और प्रमुख हिंदी समाचार-पोर्टलों (जैसे अमर उजाला, लाइव हिंदुस्तान) से एकत्र की जाती हैं।</li>
    <li><b>AI का उपयोग:</b> एक AI मॉडल इनमें से केवल परीक्षा-उपयोगी तथ्य चुनता है और उन्हें संक्षिप्त बिंदुओं में लिखता है। फिर <b>दूसरा, अलग AI मॉडल</b> हर बिंदु को खबरों के शीर्षक व सार से मिलाकर जाँचता है — तिथि या संख्या जैसे तथ्य अगर स्रोत में नहीं हैं तो वह बिंदु हटा दिया जाता है।</li>
    <li><b>मानवीय समीक्षा:</b> प्रकाशित बिंदुओं की संपादक समीक्षा करते हैं; गलत या अप्रासंगिक बिंदु हटाए या सुधारे जाते हैं।</li>
    <li>हर बिंदु के अंत में मूल समाचार का स्रोत दिया जाता है, ताकि आप पूरी खबर स्वयं पढ़ सकें।</li>
    <li>साप्ताहिक/मासिक संकलन तभी खोज-इंजन के लिए खोले जाते हैं जब उनमें पर्याप्त बिंदु हों।</li>
  </ul>

  <h2>3. उत्तराखंड GK, जिले और इतिहास</h2>
  <ul>
    <li>लेख मानक स्रोतों के आधार पर लिखे जाते हैं — उत्तराखंड मुक्त विश्वविद्यालय की पाठ्य-पुस्तकें, जिला गजेटियर, भारतीय पुरातत्व सर्वेक्षण (ASI), Epigraphia Indica, जनगणना 2011 और जिलों की आधिकारिक वेबसाइटें।</li>
    <li>हर लेख के अंत में उसके स्रोत दिए जाते हैं। जहाँ विद्वानों में मतभेद है (जैसे किसी राजा की तिथि), वहाँ "मत-भेद" लिखकर सभी प्रमुख मत दिए जाते हैं।</li>
    <li>प्रकाशित लेखों की समय-समय पर दोबारा तथ्य-जाँच होती है। उदाहरण: 17 नवंबर 2026 की जाँच में इतिहास व जिला-पृष्ठों के एक दर्जन से अधिक तथ्य प्राथमिक स्रोतों से मिलाकर सुधारे गए।</li>
    <li>चित्र Wikimedia Commons से उनके लाइसेंस और लेखक-श्रेय के साथ लिए जाते हैं।</li>
  </ul>

  <h2>4. टूल्स और क्विज़</h2>
  <ul>
    <li>टूल्स (जैसे <a href="/tools/nali-calculator/">नाली कैलकुलेटर</a>) में प्रयुक्त मानों का स्रोत टूल के पेज पर ही लिखा होता है; जो मान अनुमानित हैं उन्हें स्पष्ट रूप से "अनुमानित" चिह्नित किया जाता है।</li>
    <li>क्विज़ के प्रश्न उसी पेज की सामग्री से बनाए जाते हैं और हर उत्तर के साथ व्याख्या दी जाती है।</li>
  </ul>

  <h2>5. गलती दिखे तो</h2>
  <p>कोई तथ्य गलत लगे, कोई लिंक टूटा हो या कोई सूचना छूट गई हो — कृपया <a href="/contact/">संपर्क फ़ॉर्म</a> से बताएँ। पुष्टि होने पर सुधार जल्द से जल्द किया जाता है।</p>

  <p class="muted">यह भी देखें: <a href="/about/">हमारे बारे में</a> · <a href="/disclaimer/">अस्वीकरण</a> · <a href={SITE.author.url}>लेखक</a></p>
</Base>

<style>
  .lead small { color: var(--muted); font-size: .85em; }
  .note { background: #fffbeb; border-left: 5px solid #f59e0b; border-radius: 10px; padding: 10px 14px; margin: 14px 0; }
  .muted { color: var(--muted); font-size: .92rem; margin-top: 28px; }
</style>
