---
import Article from '../../../layouts/Article.astro';

const garhwal = [
  ['<a href="/gk/districts/dehradun/">देहरादून →</a>', 'देहरादून', 'राज्य की अस्थायी राजधानी; FRI, IMA, LBSNAA (मसूरी) यहीं'],
  ['<a href="/gk/districts/haridwar/">हरिद्वार →</a>', 'हरिद्वार', '1988 में सहारनपुर से अलग; सर्वाधिक जनसंख्या व जनघनत्व'],
  ['<a href="/gk/districts/tehri-garhwal/">टिहरी गढ़वाल →</a>', 'नई टिहरी', 'टिहरी बाँध (भागीरथी–भिलंगना संगम के पास)'],
  ['<a href="/gk/districts/uttarkashi/">उत्तरकाशी →</a>', 'उत्तरकाशी', 'सबसे कम जनघनत्व (41); क्षेत्रफल में चमोली के लगभग बराबर; गंगोत्री व यमुनोत्री'],
  ['<a href="/gk/districts/chamoli/">चमोली →</a>', 'गोपेश्वर', 'बद्रीनाथ, फूलों की घाटी, हेमकुंड साहिब'],
  ['<a href="/gk/districts/rudraprayag/">रुद्रप्रयाग →</a>', 'रुद्रप्रयाग', '1997 में गठित; केदारनाथ; सबसे कम जनसंख्या'],
  ['<a href="/gk/districts/pauri-garhwal/">पौड़ी गढ़वाल →</a>', 'पौड़ी', 'गढ़वाल मंडल का मुख्यालय'],
];
const kumaon = [
  ['<a href="/gk/districts/nainital/">नैनीताल →</a>', 'नैनीताल', 'कुमाऊँ मंडल मुख्यालय; उत्तराखंड उच्च न्यायालय'],
  ['<a href="/gk/districts/almora/">अल्मोड़ा →</a>', 'अल्मोड़ा', 'चंद राजवंश की राजधानी रहा; सर्वाधिक लिंगानुपात'],
  ['<a href="/gk/districts/pithoragarh/">पिथौरागढ़ →</a>', 'पिथौरागढ़', 'चीन (तिब्बत) और नेपाल दोनों से सीमा'],
  ['<a href="/gk/districts/bageshwar/">बागेश्वर →</a>', 'बागेश्वर', '1997 में गठित; सरयू–गोमती संगम, उत्तरायणी मेला'],
  ['<a href="/gk/districts/champawat/">चंपावत →</a>', 'चंपावत', '1997 में गठित; क्षेत्रफल में सबसे छोटा जिला'],
  ['<a href="/gk/districts/udham-singh-nagar/">ऊधम सिंह नगर →</a>', 'रुद्रपुर', '1995 में नैनीताल से अलग; तराई क्षेत्र, औद्योगिक केंद्र'],
];

const faq = [
  { q: 'उत्तराखंड में कुल कितने जिले हैं?', a: 'उत्तराखंड में कुल 13 जिले हैं — गढ़वाल मंडल में 7 और कुमाऊँ मंडल में 6।' },
  { q: 'उत्तराखंड का सबसे बड़ा और सबसे छोटा जिला कौन सा है?', a: 'क्षेत्रफल की दृष्टि से उत्तरकाशी सबसे बड़ा और चंपावत सबसे छोटा जिला है।' },
  { q: 'किस जिले की सीमा चीन और नेपाल दोनों से लगती है?', a: 'पिथौरागढ़ जिले की सीमा चीन (तिब्बत) और नेपाल दोनों से लगती है।' },
  { q: 'कौन से जिले किसी अन्य राज्य या देश से सीमा नहीं बनाते?', a: 'टिहरी गढ़वाल, रुद्रप्रयाग, अल्मोड़ा और बागेश्वर — ये चारों आंतरिक जिले हैं।' },
];
---
<Article
  title="उत्तराखंड के 13 जिले: मंडल, मुख्यालय और महत्वपूर्ण तथ्य"
  description="उत्तराखंड के सभी 13 जिलों की सूची — गढ़वाल और कुमाऊँ मंडल, जिला मुख्यालय, सबसे बड़ा/छोटा जिला, अंतरराष्ट्रीय सीमा वाले जिले। UKSSSC/UKPSC के लिए परीक्षा उपयोगी तथ्य।"
  breadcrumbs={[{ name: 'उत्तराखंड GK', href: '/gk/' }]}
  published="2026-11-16"
  image="/images/uttarakhand-hills.webp"
  imageAlt="उत्तराखंड के पहाड़, घाटियाँ और तराई का विहंगम दृश्य — चित्रांकन"
  faq={faq}
>
  <div class="keypoints">
    <h2>एक नज़र में</h2>
    <ul>
      <li>राज्य गठन: <strong>9 नवंबर 2000</strong> (भारत का 27वाँ राज्य; 2007 तक नाम "उत्तरांचल")</li>
      <li>कुल जिले: <strong>13</strong> — गढ़वाल मंडल 7, कुमाऊँ मंडल 6</li>
      <li>मंडल मुख्यालय: गढ़वाल — <strong>पौड़ी</strong>, कुमाऊँ — <strong>नैनीताल</strong></li>
      <li>राजधानी: देहरादून (अस्थायी); ग्रीष्मकालीन राजधानी — <strong>गैरसैंण (भराड़ीसैंण)</strong>, 2020 में घोषित</li>
      <li>उच्च न्यायालय: <strong>नैनीताल</strong></li>
    </ul>
  </div>

  <h2>गढ़वाल मंडल के 7 जिले</h2>
  <table>
    <thead><tr><th>#</th><th>जिला</th><th>मुख्यालय</th><th>परीक्षा उपयोगी तथ्य</th></tr></thead>
    <tbody>{garhwal.map((d, i) => <tr><td>{i + 1}</td><td><strong set:html={d[0]} /></td><td>{d[1]}</td><td>{d[2]}</td></tr>)}</tbody>
  </table>

  <h2>कुमाऊँ मंडल के 6 जिले</h2>
  <table>
    <thead><tr><th>#</th><th>जिला</th><th>मुख्यालय</th><th>परीक्षा उपयोगी तथ्य</th></tr></thead>
    <tbody>{kumaon.map((d, i) => <tr><td>{i + 1}</td><td><strong set:html={d[0]} /></td><td>{d[1]}</td><td>{d[2]}</td></tr>)}</tbody>
  </table>

  <div class="note">याद रखने की ट्रिक: जिन जिलों का मुख्यालय जिले के नाम से अलग है — <strong>टिहरी (नई टिहरी), चमोली (गोपेश्वर), पौड़ी गढ़वाल (पौड़ी), ऊधम सिंह नगर (रुद्रपुर)</strong>।</div>

  <h2>अंतरराष्ट्रीय सीमा वाले जिले</h2>
  <ul>
    <li><strong>चीन (तिब्बत) से सीमा:</strong> उत्तरकाशी, चमोली, पिथौरागढ़</li>
    <li><strong>नेपाल से सीमा:</strong> पिथौरागढ़, चंपावत, ऊधम सिंह नगर</li>
    <li><strong>दोनों देशों से सीमा:</strong> केवल पिथौरागढ़</li>
    <li><strong>हिमाचल प्रदेश से सीमा:</strong> उत्तरकाशी, देहरादून</li>
    <li><strong>आंतरिक जिले</strong> (किसी राज्य/देश से सीमा नहीं): टिहरी गढ़वाल, रुद्रप्रयाग, अल्मोड़ा, बागेश्वर</li>
  </ul>

  <h2>जिलों का गठन — महत्वपूर्ण वर्ष</h2>
  <ul>
    <li><strong>1960:</strong> उत्तरकाशी, चमोली, पिथौरागढ़ (सीमांत जिले)</li>
    <li><strong>1988:</strong> हरिद्वार (सहारनपुर से अलग)</li>
    <li><strong>1995:</strong> ऊधम सिंह नगर (नैनीताल से अलग)</li>
    <li><strong>1997:</strong> रुद्रप्रयाग, बागेश्वर, चंपावत</li>
  </ul>

  <h2>जनगणना 2011 के अनुसार प्रमुख तथ्य</h2>
  <table>
    <thead><tr><th>मापदंड</th><th>सर्वाधिक</th><th>न्यूनतम</th></tr></thead>
    <tbody>
      <tr><td>जनसंख्या</td><td>हरिद्वार</td><td>रुद्रप्रयाग</td></tr>
      <tr><td>जनघनत्व</td><td>हरिद्वार</td><td>उत्तरकाशी</td></tr>
      <tr><td>लिंगानुपात</td><td>अल्मोड़ा</td><td>हरिद्वार</td></tr>
      <tr><td>साक्षरता</td><td>देहरादून</td><td>ऊधम सिंह नगर</td></tr>
    </tbody>
  </table>
  <p class="muted">राज्य स्तर (2011): जनसंख्या लगभग 1.01 करोड़, लिंगानुपात 963, साक्षरता 78.82%।</p>

  <p><a class="btn" href="/quiz/uttarakhand-districts-rivers/">इस विषय पर क्विज़ हल करें →</a></p>
</Article>
