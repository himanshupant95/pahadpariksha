---
import Article from '../../layouts/Article.astro';
import Quiz from '../../components/Quiz.astro';
import questions from '../../data/quizzes/varsh-2025-26.json';

const CHECKED = '21 नवंबर 2026';

// [date, what happened, source numbers]
const timeline: [string, string, string][] = [
  ['23 जनवरी 2025', 'नगर निकाय चुनाव (मतगणना 25 जनवरी)।', '18'],
  ['27 जनवरी 2025', '<b>समान नागरिक संहिता (UCC) लागू।</b> स्वतंत्र भारत में ऐसा करने वाला पहला राज्य। यह दिन अब "UCC दिवस" के रूप में मनाया जाता है।', '9'],
  ['28 जनवरी–14 फ़रवरी 2025', '<b>38वें राष्ट्रीय खेल</b>, पहली बार उत्तराखंड में। उद्घाटन देहरादून (राजीव गांधी अंतरराष्ट्रीय क्रिकेट स्टेडियम) में प्रधानमंत्री ने किया, समापन हल्द्वानी में। शुभंकर "मौली" (मोनाल)।', '11,12'],
  ['24 और 28 जुलाई 2025', '<b>त्रिस्तरीय पंचायत चुनाव</b>, हरिद्वार को छोड़कर 12 ज़िलों में, दो चरणों में। मतदान लगभग 69.16%, परिणाम 31 जुलाई।', '13'],
  ['5 अगस्त 2025', '<b>धराली आपदा</b> (उत्तरकाशी, हर्षिल क्षेत्र): खीर गंगा (खीर गाड) में अचानक आई बाढ़ और मलबे से गंगोत्री मार्ग का यह पड़ाव तबाह हुआ।', '14'],
  ['अक्टूबर 2025', '<b>उत्तराखंड अल्पसंख्यक शिक्षा विधेयक 2025</b> को राज्यपाल की स्वीकृति। मदरसा बोर्ड समाप्त करने वाला पहला राज्य।', '10'],
  ['9 नवंबर 2025', '<b>राज्य स्थापना की रजत जयंती (25 वर्ष)।</b> FRI देहरादून में प्रधानमंत्री ने ₹8,000 करोड़ से अधिक की परियोजनाओं का लोकार्पण-शिलान्यास किया, स्मारक डाक टिकट जारी किया और फ़सल बीमा के ₹62 करोड़ लगभग 28,000 किसानों को भेजे।', '15'],
  ['28 नवंबर 2025', 'हरिद्वार में गंगा तट पर 13 अखाड़ों के संतों के साथ बैठक में <b>कुंभ 2027 की स्नान तिथियाँ</b> घोषित।', '16'],
  ['जनवरी 2026', 'श्री नंदा देवी राजजात 2026 को 2027 तक स्थगित करने का निर्णय।', '19'],
  ['25 जनवरी 2026', '<b>पद्म पुरस्कार 2026:</b> पूर्व मुख्यमंत्री भगत सिंह कोश्यारी को पद्म भूषण (सार्वजनिक कार्य)।', '17'],
  ['26–27 जनवरी 2026', 'UCC का एक वर्ष पूरा। <b>UCC (संशोधन) अध्यादेश 2026</b> (अनुच्छेद 213) तुरंत लागू; बाद में इसे संशोधन अधिनियम 2026 का रूप मिला।', '9'],
  ['5 मार्च 2026', '<b>आर्थिक सर्वेक्षण 2025-26</b> जारी (NCAER के सहयोग से)।', '1,2'],
  ['9 मार्च 2026', '<b>बजट 2026-27</b> (₹1,11,703.21 करोड़) भराड़ीसैंण (गैरसैंण) में पेश। पहली बार बजट सत्र के पहले ही दिन, राज्यपाल के अभिभाषण के बाद।', '3,4'],
  ['11 मार्च 2026', 'NITI आयोग का <b>राजकोषीय स्वास्थ्य सूचकांक 2026</b>: पूर्वोत्तर व हिमालयी राज्यों में उत्तराखंड दूसरा।', '6'],
  ['1 जुलाई 2026', 'मदरसा शिक्षा बोर्ड अधिनियम 2016 और 2019 की मदरसा मान्यता नियमावली समाप्त; नया अल्पसंख्यक शिक्षा प्राधिकरण।', '10'],
  ['8 जुलाई 2026', '<b>उत्तराखंड देश का छठा "पूर्ण साक्षर राज्य"</b> (ULLAS कार्यक्रम)। मंत्रिमंडल ने 19 जून को प्रस्ताव पास किया, राज्यपाल ने 8 जुलाई को स्वीकृति दी।', '7'],
  ['4 अक्टूबर 2026', 'बनबसा (चंपावत) में मंत्रिमंडल बैठक: FRBM (संशोधन) विधेयक 2026 और 1873 के नहर-अपवाह अधिनियम की जगह नया सिंचाई एवं अपवाह विधेयक 2026 मंज़ूर।', '20'],
  ['19 अक्टूबर 2026', '<b>डॉ. ढाल सिंह बिसेन</b> ने 9वें राज्यपाल के रूप में लोक भवन, देहरादून में शपथ ली (नियुक्ति 12 अक्टूबर)।', '8'],
  ['27 अक्टूबर 2026', 'गैरसैंण सत्र में ₹7,844.18 करोड़ का <b>अनुपूरक बजट</b>; 2026-27 का कुल बजट ₹1,19,547.39 करोड़।', '5'],
];
const srcNums = (s: string) => s.split(',').map((x) => `[${x}]`).join('');

const faq = [
  { q: 'उत्तराखंड का 2026-27 का बजट कितना है?', a: 'मूल बजट ₹1,11,703.21 करोड़ (9 मार्च 2026)। 27 अक्टूबर 2026 को ₹7,844.18 करोड़ के अनुपूरक बजट के बाद कुल ₹1,19,547.39 करोड़।' },
  { q: 'उत्तराखंड का वर्तमान राज्यपाल कौन है?', a: 'डॉ. ढाल सिंह बिसेन, जिन्होंने 19 अक्टूबर 2026 को 9वें राज्यपाल के रूप में शपथ ली। उनसे पहले लेफ्टिनेंट जनरल गुरमीत सिंह (से.नि.) 15 सितंबर 2021 से 19 अक्टूबर 2026 तक राज्यपाल रहे।' },
  { q: 'उत्तराखंड पूर्ण साक्षर राज्य कब बना?', a: '8 जुलाई 2026 को राज्यपाल की स्वीकृति के साथ, ULLAS कार्यक्रम के तहत देश का छठा पूर्ण साक्षर राज्य। मानक: 15 वर्ष से ऊपर की आबादी में कम से कम 95% साक्षरता।' },
];
---
<Article
  title="उत्तराखंड वर्ष 2025–26: अर्थव्यवस्था, बजट, सूचकांक और प्रमुख घटनाएँ"
  description="उत्तराखंड करेंट अफेयर्स 2025–26 एक जगह: आर्थिक सर्वेक्षण 2025-26, बजट 2026-27 और अनुपूरक बजट, NITI आयोग सूचकांक, UCC, अल्पसंख्यक शिक्षा अधिनियम, पूर्ण साक्षर राज्य, नए राज्यपाल, राष्ट्रीय खेल, रजत जयंती और कुंभ 2027 — आधिकारिक स्रोतों सहित, क्विज़ के साथ।"
  breadcrumbs={[{ name: 'उत्तराखंड GK', href: '/gk/' }]}
  published="2026-11-21"
  hideHero={true}
  faq={faq}
>
  <div class="keypoints">
    <h2>यह पेज क्यों</h2>
    <ul>
      <li>UKPSC और UKSSSC के पेपरों में पिछले 12–18 महीनों की राज्य से जुड़ी घटनाएँ लगभग हर बार पूछी जाती हैं। रोज़ की ख़बरें <a href="/current-affairs/">करेंट अफेयर्स</a> पेज पर हैं; यहाँ जनवरी 2025 से नवंबर 2026 तक की <b>सबसे ज़रूरी बातें</b> छाँटकर रखी गई हैं।</li>
      <li>आँकड़े पहले सरकारी स्रोतों (बजट दस्तावेज़, NITI आयोग, आकाशवाणी, PIB) से, फिर PRS जैसे भरोसेमंद विश्लेषण से लिए गए हैं। जहाँ केवल समाचार स्रोत मिले, वहाँ यह लिखा है।</li>
      <li>जाँच: {CHECKED}। नई घटनाएँ जुड़ने पर यह पेज अपडेट होगा।</li>
    </ul>
  </div>

  <h2 id="arthvyavastha">1. अर्थव्यवस्था: आर्थिक सर्वेक्षण 2025-26</h2>
  <p>राज्य का आर्थिक सर्वेक्षण 2025-26 मार्च 2026 में बजट सत्र से पहले जारी हुआ। इस बार इसे <b>NCAER</b> (राष्ट्रीय व्यावहारिक आर्थिक अनुसंधान परिषद) के साथ मिलकर तैयार किया गया [1][2]।</p>
  <table>
    <thead><tr><th>संकेतक</th><th>आँकड़ा</th><th>तुलना</th></tr></thead>
    <tbody>
      <tr><td>GSDP (2024-25, वर्तमान मूल्य)</td><td><b>₹3,81,889 करोड़</b> (लगभग ₹3.82 लाख करोड़)</td><td>2021-22 में ₹2.54 लाख करोड़, यानी लगभग डेढ़ गुना [1]</td></tr>
      <tr><td>प्रति व्यक्ति आय (2024-25)</td><td><b>₹2,73,921</b></td><td>2021-22 में ₹1,94,670 [1]</td></tr>
      <tr><td>आर्थिक वृद्धि दर (2024-25)</td><td><b>7.23%</b></td><td>2026-27 के लिए अनुमान 8.2% [1]</td></tr>
      <tr><td>बहुआयामी गरीबी (MPI)</td><td><b>6.92%</b> (2024-25)</td><td>2021-22 में 9.7% [1]</td></tr>
      <tr><td>अर्थव्यवस्था में हिस्सा</td><td>कृषि लगभग 10%, उद्योग/विनिर्माण 41%, सेवा 49%</td><td>वर्तमान मूल्यों पर [4]</td></tr>
      <tr><td>GSDP अनुमान 2026-27</td><td><b>₹4,27,716 करोड़</b></td><td>2025-26 से 12% अधिक (बजट अनुमान) [4]</td></tr>
    </tbody>
  </table>
  <div class="box-trap">
    <strong>ध्यान दें: दो अलग "प्रति व्यक्ति" आँकड़े</strong>
    आर्थिक सर्वेक्षण की "प्रति व्यक्ति आय" ₹2,73,921 है, जबकि PRS ने बजट विश्लेषण में "प्रति व्यक्ति GSDP" ₹2,96,012 (2024-25) बताया है [4]। दोनों अलग पैमाने हैं: प्रति व्यक्ति आय शुद्ध राज्य घरेलू उत्पाद (NSDP) से निकलती है, प्रति व्यक्ति GSDP सकल उत्पाद से। प्रश्न में जो शब्द हो, वही आँकड़ा चुनें।
  </div>

  <h2 id="bajat">2. बजट 2026-27</h2>
  <ul>
    <li><b>कब और कहाँ:</b> 9 मार्च 2026, विधानसभा भवन भराड़ीसैंण (गैरसैंण, ग्रीष्मकालीन राजधानी) [3]।</li>
    <li><b>किसने:</b> मुख्यमंत्री पुष्कर सिंह धामी, जिनके पास वित्त विभाग भी है। राज्य के इतिहास में पहली बार बजट सत्र के पहले दिन, राज्यपाल के अभिभाषण के बाद ही बजट पेश हुआ [3]।</li>
    <li><b>आकार:</b> ₹1,11,703.21 करोड़, पिछले वर्ष से लगभग 10% अधिक; राज्य का अब तक का सबसे बड़ा बजट [3][4]।</li>
    <li><b>थीम:</b> "GYAN" मॉडल, यानी गरीब, युवा, अन्नदाता (किसान) और नारी [3]।</li>
    <li><b>मुख्य आँकड़े (PRS):</b> पूँजीगत परिव्यय ₹18,153 करोड़ (22% वृद्धि); राजस्व अधिशेष ₹2,536 करोड़ (GSDP का 0.6%); राजकोषीय घाटा ₹15,989 करोड़ (GSDP का 3.7%) [4]।</li>
    <li><b>अनुपूरक बजट:</b> 27 अक्टूबर 2026 को गैरसैंण में ₹7,844.18 करोड़; कुल बजट बढ़कर <b>₹1,19,547.39 करोड़</b> [5]।</li>
    <li><b>FRBM संशोधन:</b> अक्टूबर 2026 में मंत्रिमंडल ने 1 अप्रैल 2026 से 31 मार्च 2031 तक राजकोषीय घाटे की सीमा GSDP का 3% और कुल बकाया कर्ज़ की सीमा 30% रखने वाला संशोधन विधेयक मंज़ूर किया [20]।</li>
  </ul>

  <h2 id="suchkank">3. राष्ट्रीय सूचकांकों में उत्तराखंड</h2>
  <table>
    <thead><tr><th>सूचकांक</th><th>उत्तराखंड</th><th>याद रखें</th></tr></thead>
    <tbody>
      <tr><td>SDG इंडिया इंडेक्स 2023-24 (NITI आयोग, जुलाई 2024)</td><td><b>पहला</b>, केरल के साथ संयुक्त (स्कोर 79)</td><td>यही अब तक का नवीनतम संस्करण है; भारत का स्कोर 71 [21]</td></tr>
      <tr><td>राजकोषीय स्वास्थ्य सूचकांक 2026 (NITI आयोग, 11 मार्च 2026; वर्ष 2023-24 के आँकड़े)</td><td>पूर्वोत्तर व हिमालयी राज्यों में <b>दूसरा</b> (स्कोर 52.5)</td><td>पहला अरुणाचल प्रदेश (59.5)। बड़े राज्यों में पहला ओडिशा [6]</td></tr>
      <tr><td>पूर्ण साक्षरता (ULLAS)</td><td><b>छठा</b> पूर्ण साक्षर राज्य (8 जुलाई 2026)</td><td>पहले: मिज़ोरम, गोवा, त्रिपुरा, हिमाचल, सिक्किम। मानक 95% [7]</td></tr>
      <tr><td>38वें राष्ट्रीय खेल (2025)</td><td><b>सातवाँ</b> स्थान, 103 पदक (24 स्वर्ण)</td><td>2023 (गोवा) में 25वाँ। पहला सर्विसेज़ (68 स्वर्ण) [11]</td></tr>
    </tbody>
  </table>

  <h2 id="kanoon">4. कानून और नीतियाँ</h2>
  <h3>समान नागरिक संहिता (UCC)</h3>
  <ul>
    <li><b>27 जनवरी 2025</b> से लागू; स्वतंत्र भारत में UCC लागू करने वाला पहला राज्य [9]।</li>
    <li>पहली वर्षगाँठ (27 जनवरी 2026) "UCC दिवस" के रूप में मनाई गई। उसी समय <b>UCC (संशोधन) अध्यादेश 2026</b> अनुच्छेद 213 के तहत लागू हुआ: विवाह और लिव-इन से जुड़े नियम सख़्त हुए, दंड प्रावधानों में IPC/CrPC की जगह नए आपराधिक कानून (BNS, BNSS) जोड़े गए [9]।</li>
    <li>अक्टूबर 2026 में मंत्रिमंडल ने "UCC, उत्तराखंड (संशोधन) अधिनियम 2026" को लागू करने वाले संशोधित नियम मंज़ूर किए [20]।</li>
  </ul>
  <h3>उत्तराखंड अल्पसंख्यक शिक्षा अधिनियम 2025</h3>
  <ul>
    <li>राज्यपाल की स्वीकृति अक्टूबर 2025 में। <b>मदरसा बोर्ड समाप्त करने वाला देश का पहला राज्य</b> [10]।</li>
    <li>मदरसा शिक्षा बोर्ड अधिनियम 2016 और अरबी-फ़ारसी मदरसा मान्यता नियमावली 2019, <b>1 जुलाई 2026</b> से समाप्त [10]।</li>
    <li>अब सभी अल्पसंख्यक संस्थानों (मुस्लिम, ईसाई, सिख, बौद्ध, जैन, पारसी) को "उत्तराखंड अल्पसंख्यक शिक्षा प्राधिकरण" से मान्यता और उत्तराखंड विद्यालयी शिक्षा परिषद से संबद्धता लेनी होगी। पहले यह मान्यता केवल मुस्लिम समुदाय तक सीमित थी [10]।</li>
  </ul>

