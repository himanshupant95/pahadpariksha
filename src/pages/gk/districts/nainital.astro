const facts = [
  { k: 'मंडल', v: 'कुमाऊँ (मंडल मुख्यालय भी नैनीताल)' },
  { k: 'जिला मुख्यालय', v: 'नैनीताल — राज्य की <b>न्यायिक राजधानी</b> (उच्च न्यायालय)' },
  { k: 'गठन', v: '<b>1891</b> (कुमाऊँ जिले से अलग; जिला प्रशासन के अनुसार 15 अक्टूबर 1891)' },
  { k: 'क्षेत्रफल', v: 'लगभग 4,251 वर्ग किमी (जनगणना 2011) — कुछ स्रोतों में 3,860' },
  { k: 'जनसंख्या (2011)', v: '9,54,605 — राज्य में चौथा' },
  { k: 'साक्षरता (2011)', v: '83.88% — <b>राज्य में दूसरा</b> (देहरादून के बाद)' },
  { k: 'लिंगानुपात (2011)', v: '934' },
  { k: 'जनघनत्व (2011)', v: 'लगभग 225 व्यक्ति/वर्ग किमी' },
  { k: 'विकासखंड', v: '8 — हल्द्वानी, भीमताल, रामगढ़, धारी, ओखलकांडा, बेतालघाट, कोटाबाग, रामनगर' },
  { k: 'विधानसभा सीटें', v: '6' },
  { k: 'प्रमुख नदियाँ', v: 'कोसी, गौला, दाबका, भाखड़ा, निहाल' },
  { k: 'पड़ोसी', v: 'अल्मोड़ा, चंपावत, ऊधम सिंह नगर, पौड़ी गढ़वाल; बिजनौर (उ.प्र.)' },
  { k: 'वाहन कोड', v: 'UK-04' },
  { k: 'उपनाम', v: '"झीलों का शहर / Lake District of India"; हल्द्वानी — "कुमाऊँ का प्रवेश द्वार"' },
];

const faq = [
  { q: 'नैनीताल का नाम कैसे पड़ा?', a: 'पौराणिक मान्यता है कि सती का "नैन" (नेत्र) यहाँ गिरा, जिससे "नैन + ताल" (आँख के आकार की झील) नाम बना; झील के उत्तरी किनारे पर नैना देवी मंदिर है। स्कंद पुराण के मानसखंड में इसे "त्रि-ऋषि सरोवर" (अत्रि, पुलस्त्य, पुलह) कहा गया है।' },
  { q: 'नैनीताल की "खोज" किसने की?', a: 'शाहजहाँपुर के चीनी व्यापारी पी. बैरन ने 18 नवंबर 1841 को यहाँ पहुँचकर "पिलग्रिम लॉज" बनाया और "पिलग्रिम" उपनाम से आगरा अखबार में इसके बारे में लिखा। हालांकि कमिश्नर जी.डब्ल्यू. ट्रेल व स्थानीय लोग झील से पहले से परिचित थे।' },
  { q: 'नैनीताल जिला कब बना?', a: '1891 में कुमाऊँ जिले को विभाजित कर नैनीताल जिला बना; शेष कुमाऊँ जिला अपने मुख्यालय के नाम पर अल्मोड़ा जिला कहलाया। 30 सितंबर/अक्टूबर 1995 में तराई क्षेत्र अलग होकर ऊधम सिंह नगर जिला बना।' },
  { q: 'भारत का पहला राष्ट्रीय उद्यान कौन सा है और उसका कितना भाग नैनीताल में है?', a: 'जिम कॉर्बेट राष्ट्रीय उद्यान (1936, हेली नेशनल पार्क)। जिला प्रशासन के अनुसार 521 वर्ग किमी में से लगभग 312.86 वर्ग किमी पौड़ी गढ़वाल और 208.14 वर्ग किमी नैनीताल जिले में है।' },
  { q: 'देश की सबसे बड़ी ऑप्टिकल दूरबीन कहाँ है?', a: 'नैनीताल जिले के देवस्थल में ARIES की 3.6 मीटर देवस्थल ऑप्टिकल टेलीस्कोप (DOT) — भारत-बेल्जियम सहयोग; 30 मार्च 2016 को दोनों देशों के प्रधानमंत्रियों ने ब्रसेल्स से तकनीकी रूप से सक्रिय की।' },
];

const sources = [
  { label: 'जिला प्रशासन नैनीताल — इतिहास (nainital.nic.in)', url: 'https://nainital.nic.in/?p=2733' },
  { label: 'जिला प्रशासन नैनीताल — कॉर्बेट टाइगर रिज़र्व', url: 'https://nainital.nic.in/corbett-tiger-reserve' },
  { label: 'कुमाऊँ मंडल (kumaon.gov.in) — नैनीताल, नंदा देवी मेला', url: 'https://kumaon.gov.in/pages/display/84-nanda-devi-fair' },
  { label: 'भारत की जनगणना 2011 — जिला आँकड़े (नैनीताल)' },
  { label: 'ARIES नैनीताल — 3.6m DOT', url: 'https://www.aries.res.in/node/145' },
  { label: 'ICAR-IVRI — मुक्तेश्वर परिसर का इतिहास', url: 'https://ivri.nic.in/Campuses/Mukteswar/' },
  { label: 'Wikipedia — Nainital, Nainital district, 1880 Nainital landslide, Haldwani, Kathgodam, Naukuchiatal', url: 'https://en.wikipedia.org/wiki/Nainital_district' },
  { label: 'मानचित्र: Wikimedia Commons (Nainital district.svg — GDibyendu, Public domain); OpenStreetMap contributors', url: 'https://commons.wikimedia.org/wiki/File:Nainital_district.svg' },
  { label: 'मुख्य चित्र: Nainital lake — Kishan Mundhra, CC BY-SA 4.0', url: 'https://commons.wikimedia.org/wiki/File:Nainital_lake.jpg' },
];

const img = (w: number) => `https://thumb.wikimedia.org/wikipedia/commons/thumb/c/cf/Nainital_lake.jpg/${w}px-Nainital_lake.jpg`;
---
<District
  name="नैनीताल" nameEn="Nainital" slug="nainital" division="कुमाऊँ"
  title="नैनीताल जिला: इतिहास, झीलें, कॉर्बेट, भूगोल, मेले, संस्थान व परीक्षा बिंदु"
  description="नैनीताल जिले का संपूर्ण सामान्य ज्ञान — नैना देवी व त्रि-ऋषि सरोवर, पी. बैरन (1841), 1880 का भूस्खलन, ग्रीष्मकालीन राजधानी, झीलें (भीमताल, नौकुचियाताल, सातताल), कॉर्बेट पार्क, ARIES-देवस्थल, कैंची धाम, नंदा देवी महोत्सव और 15 प्रश्नों का क्विज़। UKSSSC/UKPSC के लिए।"
  image={img(1280)}
  heroSrcset={`${img(960)} 960w, ${img(1280)} 1280w`}
  imageAlt="नैनी झील, नैनीताल — नावें और चारों ओर की पहाड़ियाँ"
  heroCredit={{ text: 'नैनी झील — Kishan Mundhra, CC BY-SA 4.0, Wikimedia Commons', url: 'https://commons.wikimedia.org/wiki/File:Nainital_lake.jpg' }}
  published="2026-11-16" toc={toc} facts={facts} faq={faq} sources={sources}
>

<section id="naam">
  <h2>नाम की कहानी: "नैन" + "ताल"</h2>
  <div class="box-myth">
    <strong><span class="tag myth">पौराणिक / जनश्रुति</span></strong>
    दक्ष यज्ञ में सती के आत्मदाह के बाद शिव जब उनका शरीर लेकर विचरण कर रहे थे, तब जहाँ-जहाँ अंग गिरे वहाँ शक्तिपीठ बने। मान्यता है कि यहाँ सती का <b>"नैन" (नेत्र)</b> गिरा — इसलिए <b>नैन-ताल</b> (आँख के आकार की झील) नाम पड़ा। झील के उत्तरी छोर पर <b>नैना देवी मंदिर</b> नगर की अधिष्ठात्री देवी का स्थान है; झील को "पन्ने जैसी आँख" के आकार का बताया जाता है।
  </div>
  <div class="box-hist">
    <strong><span class="tag hist">ग्रंथों में</span></strong>
    स्कंद पुराण के <b>मानसखंड</b> (कुमाऊँ का पौराणिक नाम "मानसखंड") में इस झील को <b>"त्रि-ऋषि सरोवर"</b> कहा गया है — कथा के अनुसार ऋषि <b>अत्रि, पुलस्त्य और पुलह</b> यहाँ आए, जल न मिलने पर गड्ढा खोदा और उसमें <b>मानसरोवर</b> का जल भरा।
  </div>
  <ul>
    <li>ब्रिटिश वर्तनी <b>"Naini Tal"</b>; उपनाम <b>"Lake District of India"</b>, <b>"Jewel of Kumaon"</b>।</li>
    <li>नगर दो भागों में — झील के उत्तर में <b>मल्लीताल</b> (ऊपरी) और दक्षिण में <b>तल्लीताल</b> (निचला)।</li>
    <li><b>हल्द्वानी</b> का नाम "हल्दू" वृक्ष से — पुराना नाम "हल्दूवनी"; कमिश्नर <b>जी.डब्ल्यू. ट्रेल</b> ने 1834 में "हल्द्वानी" नाम दिया। <b>काठगोदाम</b> = "लकड़ी का गोदाम"।</li>
  </ul>
  <div class="box-trap">
    <strong><span class="tag trap">सावधान</span></strong>
    <b>नैना देवी</b> नाम का प्रसिद्ध शक्तिपीठ <b>हिमाचल प्रदेश (बिलासपुर)</b> में भी है। प्रश्न में "नैनीताल झील के किनारे" लिखा हो, तभी उत्तराखंड वाला मंदिर चुनें।
  </div>
</section>

<section id="itihas">
  <h2>इतिहास</h2>

  <h3>प्राचीन व मध्यकाल</h3>
  <ul>
    <li>क्षेत्र प्राचीन <b>मानसखंड (कुमाऊँ)</b> का भाग; कत्यूरी शासन के बाद <b>चंद राजवंश</b> (राजधानी चंपावत, फिर 1563 के आसपास से अल्मोड़ा) के अधीन। नैनीताल झील क्षेत्र राज्य की पश्चिमी सीमा के निकट घने वनों से ढका था।</li>
    <li><span class="tag hist">ऐतिहासिक</span> <b>भीमताल</b> का <b>भीमेश्वर महादेव मंदिर</b> चंद राजा <b>बाज बहादुर चंद</b> (17वीं सदी) से जोड़ा जाता है; भाबर-तराई पर नियंत्रण के लिए चंदों ने कई अभियान किए।</li>
    <li><b>1790–1815</b> — <b>गोरखा शासन</b> (कुमाऊँ पर 1790 में अधिकार); आंग्ल-गोरखा युद्ध के बाद <b>1815</b> में कुमाऊँ अंग्रेजों के अधीन, <b>सुगौली संधि (1816)</b>।</li>
  </ul>

  <h3>ब्रिटिश काल — हिल स्टेशन का जन्म</h3>
  <ul>
    <li>कुमाऊँ के कमिश्नर <b>जी.डब्ल्यू. ट्रेल</b> (1816–1835) झील से परिचित थे, पर इसे बाहरी लोगों से दूर रखना चाहते थे (स्थानीय धार्मिक भावनाओं के कारण)।</li>
    <li><span class="tag exam">परीक्षा बिंदु</span> <b>18 नवंबर 1841</b> — शाहजहाँपुर के चीनी व्यापारी <b>पी. (पीटर) बैरन</b> पहुँचे; पहला यूरोपीय भवन <b>"पिलग्रिम लॉज"</b> बनाया और <b>"पिलग्रिम"</b> उपनाम से <b>आगरा अखबार</b> में लेख लिखे — इससे नैनीताल प्रसिद्ध हुआ। (कुमाऊँ मंडल की वेबसाइट कैप्टन वेलर का नाम भी साथ में देती है।)</li>
    <li><b>1844</b> — <b>सेंट जॉन इन द विल्डरनेस चर्च</b> (नगर का सबसे पुराना चर्च)।</li>
    <li><span class="tag exam">परीक्षा बिंदु</span> <b>3 अक्टूबर 1850</b> — <b>नैनीताल नगरपालिका</b> — उत्तर-पश्चिमी प्रांत की दूसरी नगरपालिका। बसावट बढ़ाने के लिए प्रशासन ने अल्मोड़ा के <b>साह समुदाय</b> को इस शर्त पर भूमि दी कि वे मकान बनाएँगे।</li>
    <li><b>1857</b> — रोहिलखंड के विद्रोहियों ने हल्द्वानी पर कब्ज़ा किया; कमिश्नर <b>हेनरी रैमज़े</b> ने मार्शल लॉ लगाया; पकड़े गए विद्रोहियों को नैनीताल के <b>फाँसी गधेरा</b> में फाँसी दी गई।</li>
    <li><b>1858</b> — नैनीताल में <b>भारत का पहला मेथोडिस्ट चर्च</b>।</li>
    <li><span class="tag exam">परीक्षा बिंदु</span> <b>1862</b> — नैनीताल <b>उत्तर-पश्चिमी प्रांत (बाद में संयुक्त प्रांत) की ग्रीष्मकालीन राजधानी</b>।</li>
    <li><span class="tag exam">परीक्षा बिंदु</span> <b>18 सितंबर 1880 — महा भूस्खलन ("Landslip of 1880")</b>: लगातार भारी वर्षा के बाद अल्मा पहाड़ी (शेर का डांडा) की ढलान ढही; <b>151 लोग</b> (108 भारतीय, 43 ब्रिटिश) दबकर मरे। विक्टोरिया होटल, असेंबली रूम्स और पुराना <b>नैना देवी मंदिर</b> नष्ट हुए। मलबे से बना समतल मैदान आज <b>"द फ्लैट्स"</b> है; इसके बाद पहाड़ियों पर लगभग 79 किमी लंबी जल-निकासी नालियों का जाल बनाया गया। मंदिर बाद में (1883) पुनर्निर्मित हुआ।</li>
    <li><b>1882</b> — रैमज़े ने काठगोदाम–नैनीताल सड़क बनवाई; <b>24 अप्रैल 1884</b> — पहली रेल हल्द्वानी पहुँची, फिर <b>1884</b> में ही <b>काठगोदाम</b> तक (रुहेलखंड एंड कुमाऊँ रेलवे)।</li>
    <li><b>1891</b> — <b>नैनीताल जिला</b> बना।</li>
    <li><b>1893</b> — पुणे से <b>इंपीरियल बैक्टीरियोलॉजिकल लैबोरेटरी</b> मुक्तेश्वर स्थानांतरित (आज IVRI)।</li>
    <li><b>1899–1900</b> — <b>राजभवन</b> (गवर्नमेंट हाउस) — वास्तुकार <b>एफ.डब्ल्यू. स्टीवंस</b>, विक्टोरियन गोथिक शैली; बकिंघम पैलेस से तुलना की जाती है।</li>
    <li><b>1936</b> — <b>हेली नेशनल पार्क</b> (आज कॉर्बेट) — भारत का पहला राष्ट्रीय उद्यान।</li>
  </ul>

  <h3>स्वतंत्रता के बाद</h3>
  <ul>
    <li><b>1955</b> — उत्तर प्रदेश राजकीय वेधशाला (स्थापना 20 अप्रैल 1954, वाराणसी) नैनीताल आई; <b>1961</b> में मनोरा पीक; 2004 में <b>ARIES</b>।</li>
    <li><b>23 नवंबर 1973</b> — <b>कुमाऊँ विश्वविद्यालय</b> (DSB कॉलेज नैनीताल व अल्मोड़ा राजकीय कॉलेज को मिलाकर)।</li>
    <li><b>1995</b> — तराई क्षेत्र अलग होकर <b>ऊधम सिंह नगर</b> जिला।</li>
    <li><b>9 नवंबर 2000</b> — उत्तराखंड गठन; उसी दिन <b>नैनीताल में उच्च न्यायालय</b> स्थापित (मल्लीताल के पुराने सचिवालय भवन में)।</li>
  </ul>
</section>

<section id="samayrekha">
  <h2>प्रशासनिक समयरेखा</h2>
  <ol class="timeline">
    <li><span class="yr">1815</span><span class="ev">गोरखों की पराजय के बाद "कुमाऊँ जिला" बना, मुख्यालय अल्मोड़ा; नैनीताल क्षेत्र इसी का भाग।</span></li>
    <li><span class="yr">1850</span><span class="ev">नैनीताल नगरपालिका (3 अक्टूबर)।</span></li>
    <li><span class="yr">1862</span><span class="ev">उत्तर-पश्चिमी प्रांत की ग्रीष्मकालीन राजधानी।</span></li>
    <li><span class="yr">1891</span><span class="ev">कुमाऊँ जिले का विभाजन — नैनीताल जिला बना; शेष "अल्मोड़ा जिला" कहलाया। (जिला प्रशासन: 15 अक्टूबर 1891)</span></li>
    <li><span class="yr">1942</span><span class="ev">हल्द्वानी-काठगोदाम नगरपालिका (21 सितंबर)।</span></li>
    <li><span class="yr">1995</span><span class="ev">तराई भाग अलग होकर ऊधम सिंह नगर जिला (30 सितंबर 1995 से प्रभावी)।</span></li>
    <li><span class="yr">9 नवंबर 2000</span><span class="ev">उत्तराखंड गठन; नैनीताल में उच्च न्यायालय।</span></li>
    <li><span class="yr">2011</span><span class="ev">हल्द्वानी-काठगोदाम नगर निगम बना।</span></li>
  </ol>
