  { k: 'जिला मुख्यालय', v: '<b>पिथौरागढ़</b> (सोर घाटी, लगभग 1,645 मी.)' },
  { k: 'गठन', v: '<b>24 फ़रवरी 1960</b> — अल्मोड़ा जिले से' },
  { k: 'क्षेत्रफल', v: 'लगभग 7,090 वर्ग किमी (जनगणना 2011); जिला प्रशासन ~7,218' },
  { k: 'जनसंख्या (2011)', v: '4,83,439 — राज्य में आठवाँ' },
  { k: 'लिंगानुपात (2011)', v: '1020' },
  { k: 'दशकीय वृद्धि (2001–11)', v: '4.58%' },
  { k: 'साक्षरता (2011)', v: '82.25% (पुरुष 92.75%, महिला 72.29%)' },
  { k: 'जनघनत्व (2011)', v: 'लगभग 68 व्यक्ति/वर्ग किमी' },
  { k: 'विकासखंड', v: '8' },
  { k: 'विधानसभा सीटें', v: '4' },
  { k: 'प्रमुख नदियाँ', v: 'काली (शारदा), गोरी गंगा, धौलीगंगा (पूर्वी), कुटी यांग्ती, रामगंगा (पूर्वी), सरयू' },
  { k: 'पड़ोसी', v: '<b>तिब्बत (चीन) व नेपाल</b>; चमोली, बागेश्वर, अल्मोड़ा, चंपावत' },
  { k: 'वाहन कोड', v: 'UK-05' },
];

const faq = [
  { q: 'पिथौरागढ़ जिला कब और क्यों बना?', a: '24 फ़रवरी 1960 को अल्मोड़ा जिले की पिथौरागढ़ तहसील को जिला बनाया गया। चीन से लगी सीमा पर प्रशासन व सुरक्षा मज़बूत करने के लिए उसी दिन चमोली और उत्तरकाशी जिले भी बने। 15 सितंबर 1997 को इसकी चंपावत तहसील से अलग चंपावत जिला बना।' },
  { q: 'पिथौरागढ़ उत्तराखंड का अकेला ऐसा जिला क्यों है जो दो देशों से सीमा बनाता है?', a: 'उत्तर में तिब्बत (चीन) और पूर्व में नेपाल — काली नदी भारत-नेपाल सीमा बनाती है। उत्तरकाशी व चमोली केवल चीन से और चंपावत-ऊधम सिंह नगर केवल नेपाल से सीमा बनाते हैं।' },
  { q: 'कैलाश मानसरोवर यात्रा पिथौरागढ़ के किस दर्रे से होती है?', a: 'लिपुलेख दर्रे से (धारचूला–गुंजी–कालापानी मार्ग)। 2020 से रुकी यात्रा 2025 में फिर शुरू हुई — लिपुलेख मार्ग पर कुमाऊँ मंडल विकास निगम (KMVN) ने 50-50 यात्रियों के 5 दल भेजे; जुलाई 2025 में पहला दल सीमा पार गया। दूसरा मार्ग सिक्किम के नाथू ला से है।' },
  { q: 'हिलजात्रा कहाँ मनाई जाती है?', a: 'सोर घाटी (पिथौरागढ़) के कुमौड़ और बजेटी गाँवों में, भाद्रपद में — मुखौटा पहनकर कृषि-पशुपालन से जुड़ा लोक-नाट्य; "लखिया भूत" इसका मुख्य पात्र। जिला प्रशासन के अनुसार यह परंपरा पश्चिमी नेपाल से आई; अस्कोट-कनालीछीना में इसका रूप "हिरन-चित्तल" है।' },
  { q: 'जौलजीबी मेला कब और कहाँ लगता है?', a: 'हर वर्ष 14 नवंबर से काली और गोरी गंगा के संगम पर जौलजीबी (धारचूला क्षेत्र) में। अस्कोट के रजवार पुष्कर पाल ने 1871 में इसे धार्मिक मेले के रूप में शुरू किया; बाद में यह भारत-नेपाल-तिब्बत के व्यापार का बड़ा केंद्र बना।' },
];

const sources = [
  { label: 'NHPC — धौलीगंगा पावर स्टेशन (280 MW, 2005)', url: 'https://www.nhpcindia.com/welcome/project_detail/24/index.php' },
  { label: 'PIB — धारचूला-लिपुलेख सड़क का उद्घाटन (8 मई 2020)', url: 'https://pib.gov.in/PressReleasePage.aspx?PRID=1622091' },
  { label: 'जिला प्रशासन पिथौरागढ़ (pithoragarh.nic.in) — इतिहास, संस्कृति व मेले', url: 'https://pithoragarh.nic.in/' },
  { label: 'भारत की जनगणना 2011 — उत्तराखंड के जिलों के आँकड़े', url: 'https://census2011.co.in/census/state/districtlist/uttarakhand.html' },
  { label: 'PMO — प्रधानमंत्री की पार्वती कुंड (जोलिंगकोंग) व गुंजी यात्रा, 12 अक्टूबर 2023', url: 'https://pmindia.gov.in/?p=16297409' },
  { label: 'The Tribune — जौलजीबी मेला: 1871 में अस्कोट के रजवार द्वारा आरंभ', url: 'https://www.tribuneindia.com/news/archive/uttarakhand/jauljibi-trade-was-a-religious-fair-earlier-157836' },
  { label: 'Wikipedia — Pithoragarh district; Askot Musk Deer Sanctuary; Nain Singh Rawat; Kailash Mansarovar Yatra', url: 'https://en.wikipedia.org/wiki/Pithoragarh_district' },
  { label: 'मानचित्र: Wikimedia Commons (Pithoragarh district.svg — GDibyendu, Public domain); OpenStreetMap contributors', url: 'https://commons.wikimedia.org/wiki/File:Pithoragarh_district.svg' },
  { label: 'मुख्य चित्र: Panchachuli peaks — Arjunhaarith16, CC BY-SA 4.0', url: 'https://commons.wikimedia.org/wiki/File:Panchachuli_peaks.jpg' },
];

const img = (w: number) => `https://thumb.wikimedia.org/wikipedia/commons/thumb/d/de/Panchachuli_peaks.jpg/${w}px-Panchachuli_peaks.jpg`;
---
<District
  name="पिथौरागढ़" nameEn="Pithoragarh" slug="pithoragarh" division="कुमाऊँ"
  title="पिथौरागढ़ जिला: सोर घाटी, पंचाचूली, लिपुलेख व कैलाश मार्ग, हिलजात्रा, जौलजीबी व परीक्षा बिंदु"
  description="पिथौरागढ़ जिले का संपूर्ण सामान्य ज्ञान — 24 फ़रवरी 1960 गठन, सोर घाटी व अस्कोट के रजवार, चीन-नेपाल दोनों से सीमा, लिपुलेख दर्रा व कैलाश मानसरोवर यात्रा (2025), आदि कैलाश, जोहार-दारमा-ब्यांस घाटियाँ, शौका व वनरावत, हिलजात्रा, जौलजीबी मेला, पाताल भुवनेश्वर, नैन सिंह रावत और 15 प्रश्नों का क्विज़।"
  image={img(1280)}
  heroSrcset={`${img(960)} 960w, ${img(1280)} 1280w`}
  imageAlt="मुनस्यारी से दिखती बर्फ़ से ढकी पंचाचूली चोटियाँ"
  heroCredit={{ text: 'पंचाचूली चोटियाँ — Arjunhaarith16, CC BY-SA 4.0, Wikimedia Commons', url: 'https://commons.wikimedia.org/wiki/File:Panchachuli_peaks.jpg' }}
  published="2026-11-18" toc={toc} facts={facts} faq={faq} sources={sources}
>

<section id="naam">
  <h2>नाम की कहानी: "पिथौरा गढ़"</h2>
  <div class="box-myth">
    <strong><span class="tag myth">मत-भेद</span></strong>
    नाम के मत — (1) सबसे प्रचलित परंपरा: चंद काल में <b>पीरू उर्फ़ पृथ्वी गोसाईं</b> ने यहाँ किला बनाकर उसे <b>"पृथ्वीगढ़"</b> कहा, जो बिगड़कर पिथौरागढ़ हुआ; (2) <b>पिथौरा चंद / पिथौरा शाही</b> नामक शासक से; (3) लोकमान्यता में दिल्ली के <b>पृथ्वीराज चौहान (राय पिथौरा)</b> से — इसका ठोस प्रमाण नहीं। परीक्षा में पहला मत सबसे सुरक्षित।
  </div>
  <ul>
    <li>पिथौरागढ़ नगर <b>सोर घाटी</b> में — चार ओर पहाड़ियों से घिरा कटोरानुमा मैदान; इसलिए उपनाम <b>"छोटा कश्मीर"</b>।</li>
    <li>नगर के बाहर पहाड़ी पर <b>पिथौरागढ़ किला</b> — जिला प्रशासन के अनुसार <b>गोरखों ने 1789</b> में बनाया; अंग्रेजों ने इसका नाम <b>"लंदन फोर्ट"</b> रखा।</li>
  </ul>
</section>

<section id="itihas">
  <h2>इतिहास — सोर घाटी, अस्कोट और चंद</h2>
  <ul>
    <li>प्रारंभ में कत्यूरी प्रभाव; कत्यूरियों के पतन के बाद <b>अस्कोट</b> में कत्यूरी शाखा <b>पाल (रजवार)</b> वंश का शासन — "अस्सी कोट" (80 किलों) से अस्कोट नाम माना जाता है।</li>
    <li><b>सोर घाटी</b> पर <b>बम</b> राजाओं का शासन (डोटी, पश्चिमी नेपाल से संबद्ध); बाद में चंद राजाओं ने इसे कुमाऊँ में मिलाया।</li>
    <li><b>गंगोली</b> (गंगोलीहाट) — मणकोटी शासकों का क्षेत्र; बाद में चंद राज्य में।</li>
    <li><b>1790</b> — कुमाऊँ पर गोरखा अधिकार; <b>1815</b> — संगौली संधि के बाद ब्रिटिश कुमाऊँ (अल्मोड़ा जिले) का भाग; काली नदी भारत-नेपाल सीमा तय हुई।</li>
    <li>ब्रिटिश काल में पिथौरागढ़ <b>अल्मोड़ा जिले की तहसील</b>; जोहार, दारमा, ब्यांस के शौका व्यापारी तिब्बत से व्यापार करते रहे।</li>
    <li><span class="tag exam">परीक्षा बिंदु</span> <b>24 फ़रवरी 1960</b> — चीन से सीमा की संवेदनशीलता के कारण पिथौरागढ़ जिला बना। <b>1962</b> के युद्ध के बाद तिब्बत व्यापार बंद।</li>
    <li><b>15 सितंबर 1997</b> — चंपावत तहसील अलग होकर <b>चंपावत जिला</b> बना।</li>
  </ul>
</section>

<section id="samayrekha">
  <h2>प्रशासनिक समयरेखा</h2>
  <ol class="timeline">
    <li><span class="yr">1789–90</span><span class="ev">गोरखा आक्रमण व शासन; पिथौरागढ़ किला (1789)।</span></li>
    <li><span class="yr">1815</span><span class="ev">ब्रिटिश कुमाऊँ; संगौली संधि (1816) से काली नदी सीमा।</span></li>
    <li><span class="yr">1871</span><span class="ev">जौलजीबी मेला आरंभ (अस्कोट के रजवार पुष्कर पाल)।</span></li>
    <li><span class="yr">1960</span><span class="ev">पिथौरागढ़ जिला बना (24 फ़रवरी)।</span></li>
    <li><span class="yr">1962</span><span class="ev">भारत-चीन युद्ध; तिब्बत व्यापार बंद।</span></li>
    <li><span class="yr">1981</span><span class="ev">लिपुलेख मार्ग से कैलाश मानसरोवर यात्रा आरंभ।</span></li>
    <li><span class="yr">1986</span><span class="ev">अस्कोट कस्तूरी मृग अभयारण्य।</span></li>
    <li><span class="yr">1997</span><span class="ev">चंपावत जिला अलग (15 सितंबर)।</span></li>
    <li><span class="yr">2020</span><span class="ev">लिपुलेख तक सड़क (8 मई); नेपाल का आपत्ति वाला नया नक्शा; कैलाश यात्रा स्थगित।</span></li>
    <li><span class="yr">2023</span><span class="ev">प्रधानमंत्री की आदि कैलाश/पार्वती कुंड व गुंजी यात्रा (12 अक्टूबर)।</span></li>
    <li><span class="yr">2025</span><span class="ev">लिपुलेख से कैलाश मानसरोवर यात्रा पुनः शुरू।</span></li>
  </ol>
</section>

<section id="bhugol">
  <h2>भूगोल</h2>
  <div class="map-grid">
    <figure>
      <img src="https://upload.wikimedia.org/wikipedia/commons/0/0d/Pithoragarh_district.svg" alt="उत्तराखंड के मानचित्र में पिथौरागढ़ जिले की स्थिति (लाल रंग में)" width="1250" height="1125" loading="lazy" referrerpolicy="no-referrer" />
      <figcaption>उत्तराखंड में पिथौरागढ़ जिले की स्थिति (लाल) — ★ जिला मुख्यालय। स्रोत: <a href="https://commons.wikimedia.org/wiki/File:Pithoragarh_district.svg" target="_blank" rel="noopener nofollow">GDibyendu, Wikimedia Commons</a> (Public domain)</figcaption>
    </figure>
    <figure>
      <iframe title="पिथौरागढ़ जिले का मानचित्र (OpenStreetMap)" loading="lazy" src="https://www.openstreetmap.org/export/embed.html?bbox=79.75%2C29.35%2C81.10%2C30.80&amp;layer=mapnik"></iframe>
      <figcaption>इंटरैक्टिव मानचित्र — पिथौरागढ़, धारचूला, मुनस्यारी, डीडीहाट, गंगोलीहाट, बेरीनाग, जौलजीबी, गुंजी देखें। © <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener nofollow">OpenStreetMap contributors</a> · <a href="https://www.openstreetmap.org/#map=9/29.95/80.40" target="_blank" rel="noopener nofollow">बड़ा मानचित्र खोलें</a></figcaption>
    </figure>
  </div>
  <ul>
    <li><b>सीमाएँ:</b> उत्तर में <b>तिब्बत (चीन)</b>, पूर्व में <b>नेपाल</b> (काली नदी), दक्षिण में चंपावत, पश्चिम में अल्मोड़ा-बागेश्वर, उत्तर-पश्चिम में चमोली।</li>
    <li><b>पंचाचूली</b> (उच्चतम ~6,904 मी.) — मुनस्यारी व दारमा घाटी से दिखने वाली पाँच चोटियाँ; पौराणिक मान्यता — पांडवों के स्वर्गारोहण से पहले के "पाँच चूल्हे"।</li>
    <li><b>ग्लेशियर:</b> <b>मिलम</b> (गोरी गंगा का उद्गम; कुमाऊँ का सबसे बड़ा), <b>रालम</b>, <b>नामिक</b> (पूर्वी रामगंगा का उद्गम), <b>पंचाचूली</b>।</li>
  </ul>

  <h3>नदियाँ व घाटियाँ</h3>
  <table>
    <thead><tr><th>नदी / घाटी</th><th>मुख्य तथ्य</th></tr></thead>
    <tbody>
      <tr><td><b>काली (शारदा)</b></td><td>कालापानी क्षेत्र से; <b>भारत-नेपाल सीमा</b>; धारचूला (भारत) और दार्चुला (नेपाल) इसके आर-पार जुड़वाँ नगर।</td></tr>
      <tr><td><b>गोरी गंगा</b></td><td>मिलम ग्लेशियर से; मुनस्यारी-मदकोट होते हुए <b>जौलजीबी</b> में काली से संगम। घाटी — <b>जोहार</b>।</td></tr>
      <tr><td><b>धौलीगंगा (पूर्वी)</b></td><td>दारमा घाटी; तवाघाट में काली से संगम। (चमोली की धौलीगंगा अलग है।)</td></tr>
      <tr><td><b>कुटी यांग्ती</b></td><td>कुटी घाटी (आदि कैलाश क्षेत्र) से; गुंजी के पास काली में।</td></tr>
      <tr><td><b>रामगंगा (पूर्वी)</b></td><td>नामिक ग्लेशियर से; थल होते हुए रामेश्वर के पास सरयू में।</td></tr>
      <tr><td><b>सरयू</b></td><td>बागेश्वर से आकर पिथौरागढ़-अल्मोड़ा सीमा; पंचेश्वर (चंपावत) में काली से संगम।</td></tr>
    </tbody>
  </table>
  <p><b>शौका घाटियाँ:</b> <b>जोहार</b> (गोरी), <b>दारमा</b> (धौली), <b>ब्यांस</b> (काली ऊपरी — गुंजी, कुटी), <b>चौंदास</b> (दारमा व ब्यांस के बीच)।</p>
