---
import District from '../../../layouts/District.astro';
import Quiz from '../../../components/Quiz.astro';
import questions from '../../../data/quizzes/uttarkashi.json';

const toc = [
  { id: 'at-a-glance', label: 'एक नज़र में' },
  { id: 'naam', label: 'नाम की कहानी: "उत्तर की काशी"' },
  { id: 'itihas', label: 'इतिहास (बाड़ाहाट से जिले तक)' },
  { id: 'samayrekha', label: 'प्रशासनिक समयरेखा' },
  { id: 'bhugol', label: 'भूगोल, नदियाँ व ग्लेशियर' },
  { id: 'dham', label: 'गंगोत्री-यमुनोत्री धाम' },
  { id: 'prashasan', label: 'प्रशासन' },
  { id: 'janankiki', label: 'जनसांख्यिकी' },
  { id: 'samaj', label: 'समाज: रवाईं, जाड़ व परंपराएँ' },
  { id: 'mele', label: 'मेले व त्योहार' },
  { id: 'sthal', label: 'पर्यटन स्थल, ट्रेक व बुग्याल' },
  { id: 'sansthan', label: 'संस्थान व संरक्षित क्षेत्र' },
  { id: 'andolan', label: 'तिलाड़ी कांड व जन आंदोलन' },
  { id: 'aapda', label: 'आपदाएँ: 1991 से धराली तक' },
  { id: 'vyaktitva', label: 'प्रमुख व्यक्तित्व' },
  { id: 'arthvyavastha', label: 'अर्थव्यवस्था' },
  { id: 'pariksha', label: 'परीक्षा बिंदु (One-liners)' },
  { id: 'quiz', label: 'क्विज़ (15 प्रश्न)' },
  { id: 'faq', label: 'FAQ' },
];

const facts = [
  { k: 'मंडल', v: 'गढ़वाल' },
  { k: 'जिला मुख्यालय', v: '<b>उत्तरकाशी</b> (प्राचीन बाड़ाहाट), भागीरथी तट' },
  { k: 'गठन', v: '<b>24 फ़रवरी 1960</b> — टिहरी गढ़वाल की रवाईं तहसील के रवाईं व उत्तरकाशी परगनों से' },
  { k: 'क्षेत्रफल', v: 'लगभग 8,016 वर्ग किमी — परीक्षाओं में <b>राज्य का सबसे बड़ा जिला</b> (देखें सावधान बॉक्स)' },
  { k: 'जनसंख्या (2011)', v: '3,30,086 — राज्य में दसवाँ' },
  { k: 'लिंगानुपात (2011)', v: '958' },
  { k: 'दशकीय वृद्धि (2001–11)', v: '11.89%' },
  { k: 'साक्षरता (2011)', v: '75.81% (पुरुष 88.79%, महिला 62.35%)' },
  { k: 'जनघनत्व (2011)', v: '<b>41</b> व्यक्ति/वर्ग किमी — राज्य में सबसे कम' },
  { k: 'विकासखंड', v: '6' },
  { k: 'विधानसभा सीटें', v: '3' },
  { k: 'प्रमुख नदियाँ', v: 'भागीरथी, यमुना, टोंस, जाड़ गंगा (जाह्नवी), असी गंगा, केदार गंगा' },
  { k: 'पड़ोसी', v: 'तिब्बत (चीन); हिमाचल प्रदेश; चमोली, रुद्रप्रयाग, टिहरी, देहरादून' },
  { k: 'वाहन कोड', v: 'UK-10' },
];

const faq = [
  { q: 'उत्तरकाशी को "उत्तर की काशी" क्यों कहते हैं?', a: 'वाराणसी (काशी) की तरह यहाँ भी काशी विश्वनाथ मंदिर है, नगर दो नदियों — वरुणा और असी — के बीच बसा है और गंगा (भागीरथी) उत्तरवाहिनी है। प्राचीन नाम बाड़ाहाट था; स्कंद पुराण के केदारखंड में इसे "सौम्य काशी" कहा गया है।' },
  { q: 'उत्तराखंड का सबसे बड़ा जिला कौन-सा है — उत्तरकाशी या चमोली?', a: 'राज्य की परीक्षाओं में मानक उत्तर उत्तरकाशी (~8,016 वर्ग किमी) है। जनगणना 2011 की कुछ तालिकाओं में चमोली का क्षेत्रफल 8,030 वर्ग किमी दिखता है, जो 1997 में रुद्रप्रयाग अलग होने से पहले का आँकड़ा माना जाता है; राज्य स्रोत चमोली को लगभग 7,692 वर्ग किमी बताते हैं।' },
  { q: 'सिल्क्यारा सुरंग हादसा क्या था?', a: '12 नवंबर 2023 (दीपावली) की सुबह चारधाम मार्ग पर बन रही सिल्क्यारा-बड़कोट सुरंग का भाग ढहने से 41 मज़दूर फँस गए। 17 दिन चले बचाव अभियान में अंतिम हिस्सा "रैट-होल" खनिकों ने हाथ से खोदा और 28 नवंबर 2023 को सभी 41 मज़दूर सुरक्षित निकाले गए।' },
  { q: 'तिलाड़ी कांड कहाँ और कब हुआ?', a: '30 मई 1930 को टिहरी रियासत के रवाईं क्षेत्र में, बड़कोट के पास यमुना तट पर तिलाड़ी मैदान में — वन-अधिकारों के लिए जुटे लोगों पर दीवान चक्रधर जुयाल के आदेश पर गोली चली। इसे "उत्तराखंड का जलियाँवाला बाग" कहा जाता है। स्थल आज उत्तरकाशी जिले में है।' },
  { q: 'धराली आपदा कब आई?', a: '5 अगस्त 2025 को दोपहर में खीर गंगा के जलग्रहण क्षेत्र से आए मलबे व सैलाब ने हर्षिल घाटी के धराली गाँव/बाज़ार को भारी क्षति पहुँचाई; गंगोत्री मार्ग पर हर्षिल क्षेत्र में भी नुकसान हुआ।' },
];

const sources = [
  { label: 'जिला प्रशासन उत्तरकाशी (uttarkashi.nic.in) — इतिहास', url: 'https://uttarkashi.nic.in/history/' },
  { label: 'भारत की जनगणना 2011 — उत्तराखंड के जिलों के आँकड़े', url: 'https://census2011.co.in/census/state/districtlist/uttarakhand.html' },
  { label: 'Wikipedia — Uttarkashi district; 1991 Uttarkashi earthquake; Uttarakhand tunnel rescue; Gangotri National Park; Nehru Institute of Mountaineering', url: 'https://en.wikipedia.org/wiki/Uttarkashi_district' },
  { label: 'Business Standard — Silkyara tunnel rescue timeline (12–28 नवंबर 2023)', url: 'https://business-standard.com/india-news/uttarakhand-tunnel-collapse-how-workers-are-being-rescued-after-17-days-123112801079_1.html' },
  { label: 'डॉ. एस. श्रीकंठ शास्त्री — Uttara Kasi Pillar Inscription of Guha', url: 'https://www.srikanta-sastri.org/articles-1/uttara-kasi-pillar-inscription-of-guha' },
  { label: 'मानचित्र: Wikimedia Commons (Uttarkashi district.svg — GDibyendu, Public domain); OpenStreetMap contributors', url: 'https://commons.wikimedia.org/wiki/File:Uttarkashi_district.svg' },
  { label: 'मुख्य चित्र: Gangotri temple — Atarax42, CC BY-SA 3.0', url: 'https://commons.wikimedia.org/wiki/File:Gangotri_temple.jpg' },
];

const img = (w: number) => `https://thumb.wikimedia.org/wikipedia/commons/thumb/0/04/Gangotri_temple.jpg/${w}px-Gangotri_temple.jpg`;
---
<District
  name="उत्तरकाशी" nameEn="Uttarkashi" slug="uttarkashi" division="गढ़वाल"
  title="उत्तरकाशी जिला: गंगोत्री-यमुनोत्री, सबसे बड़ा जिला, तिलाड़ी कांड, सिल्क्यारा, धराली व परीक्षा बिंदु"
  description="उत्तरकाशी जिले का संपूर्ण सामान्य ज्ञान — बाड़ाहाट व गुह का शक्ति-स्तंभ अभिलेख, 24 फ़रवरी 1960 गठन, सबसे बड़ा व सबसे कम घनत्व वाला जिला, गंगोत्री-गोमुख-यमुनोत्री, टोंस व हर की दून, तिलाड़ी कांड (1930), NIM (1965), गंगोत्री व गोविंद राष्ट्रीय उद्यान, 1991 भूकंप, सिल्क्यारा सुरंग (2023), धराली आपदा (2025) और 15 प्रश्नों का क्विज़।"
  image={img(1280)}
  heroSrcset={`${img(960)} 960w, ${img(1280)} 1280w`}
  imageAlt="देवदार के पेड़ों के बीच सफ़ेद पत्थर का गंगोत्री मंदिर"
  heroCredit={{ text: 'गंगोत्री मंदिर — Atarax42, CC BY-SA 3.0, Wikimedia Commons', url: 'https://commons.wikimedia.org/wiki/File:Gangotri_temple.jpg' }}
  published="2026-11-18" toc={toc} facts={facts} faq={faq} sources={sources}
>

<section id="naam">
  <h2>नाम की कहानी: "उत्तर की काशी"</h2>
  <ul>
    <li><b>उत्तरकाशी</b> = उत्तर की काशी — वाराणसी की तरह <b>काशी विश्वनाथ मंदिर</b>, नगर <b>वरुणा</b> और <b>असी</b> नदियों के बीच, और यहाँ भागीरथी उत्तरवाहिनी।</li>
    <li><span class="tag exam">परीक्षा बिंदु</span> प्राचीन नाम <b>बाड़ाहाट</b> (बड़ा हाट — तिब्बत व्यापार की बड़ी मंडी)। स्कंद पुराण (केदारखंड) में <b>"सौम्य काशी"</b>।</li>
    <li>नगर के ऊपर <b>वरुणावत पर्वत</b>; जिले को "गंगा-यमुना का मायका" भी कहा जाता है।</li>
  </ul>
  <div class="box-trap"><strong><span class="tag trap">सावधान</span></strong>काशीपुर (ऊधम सिंह नगर) का नाम काशीनाथ अधिकारी से है — उत्तरकाशी से उसका कोई संबंध नहीं। "गुप्तकाशी" रुद्रप्रयाग जिले में है।</div>
</section>

<section id="itihas">
  <h2>इतिहास — बाड़ाहाट से जिले तक</h2>
  <ul>
    <li><span class="tag exam">परीक्षा बिंदु</span> <b>शक्ति स्तंभ (त्रिशूल) अभिलेख:</b> काशी विश्वनाथ मंदिर के सामने के विशाल त्रिशूल पर शासक <b>गुह</b> की विजयों का संस्कृत लेख — लगभग <b>6ठी सदी</b> की उत्तर-गुप्त लिपि (डॉ. एस. श्रीकंठ शास्त्री ने विस्तार से पढ़ा)।</li>
    <li>महाभारत की परंपरा में यह क्षेत्र किरात-कुलिंद क्षेत्र; परशुराम और जमदग्नि से जुड़ी कथाएँ।</li>
    <li>मध्यकाल में गढ़वाल के पंवार राज्य का भाग; <b>1803–1815</b> गोरखा शासन; <b>1815</b> के बाद <b>टिहरी रियासत</b> में (रवाईं व उत्तरकाशी क्षेत्र)।</li>
    <li><b>रवाईं</b> (यमुना-टोंस घाटी) — रियासत के विरुद्ध <b>ढंडक</b> परंपरा; <b>30 मई 1930 — तिलाड़ी कांड</b>।</li>
    <li><b>1 अगस्त 1949</b> — टिहरी रियासत के साथ उत्तर प्रदेश में विलय।</li>
    <li><span class="tag exam">परीक्षा बिंदु</span> <b>24 फ़रवरी 1960</b> — टिहरी गढ़वाल जिले की रवाईं तहसील के रवाईं व उत्तरकाशी परगनों से <b>उत्तरकाशी जिला</b> बना (चीन सीमा के कारण, चमोली-पिथौरागढ़ के साथ)।</li>
  </ul>
  <p>पृष्ठभूमि के लिए देखें: <a href="/gk/districts/tehri-garhwal/">टिहरी गढ़वाल जिला</a> व <a href="/history/parmar-dynasty/">परमार वंश</a>।</p>
</section>

<section id="samayrekha">
  <h2>प्रशासनिक समयरेखा</h2>
  <ol class="timeline">
    <li><span class="yr">~6ठी सदी</span><span class="ev">गुह का शक्ति-स्तंभ अभिलेख।</span></li>
    <li><span class="yr">1815</span><span class="ev">टिहरी रियासत का भाग।</span></li>
    <li><span class="yr">1930</span><span class="ev">तिलाड़ी कांड (30 मई)।</span></li>
    <li><span class="yr">1949</span><span class="ev">उत्तर प्रदेश में विलय (1 अगस्त)।</span></li>
    <li><span class="yr">1955</span><span class="ev">गोविंद पशु विहार अभयारण्य।</span></li>
    <li><span class="yr">1960</span><span class="ev">उत्तरकाशी जिला बना (24 फ़रवरी)।</span></li>
    <li><span class="yr">1965</span><span class="ev">नेहरू पर्वतारोहण संस्थान (14 नवंबर)।</span></li>
    <li><span class="yr">1989</span><span class="ev">गंगोत्री राष्ट्रीय उद्यान।</span></li>
    <li><span class="yr">1991</span><span class="ev">उत्तरकाशी भूकंप (20 अक्टूबर, 6.8 Mw)।</span></li>
    <li><span class="yr">2003</span><span class="ev">वरुणावत भूस्खलन (24 सितंबर से)।</span></li>
    <li><span class="yr">2023</span><span class="ev">सिल्क्यारा सुरंग हादसा व बचाव (12–28 नवंबर)।</span></li>
    <li><span class="yr">2025</span><span class="ev">धराली आपदा (5 अगस्त)।</span></li>
  </ol>
</section>

<section id="bhugol">
  <h2>भूगोल</h2>
  <div class="map-grid">
    <figure>
      <img src="https://upload.wikimedia.org/wikipedia/commons/7/7f/Uttarkashi_district.svg" alt="उत्तराखंड के मानचित्र में उत्तरकाशी जिले की स्थिति (लाल रंग में)" width="1250" height="1125" loading="lazy" referrerpolicy="no-referrer" />
      <figcaption>उत्तराखंड में उत्तरकाशी जिले की स्थिति (लाल) — ★ जिला मुख्यालय। स्रोत: <a href="https://commons.wikimedia.org/wiki/File:Uttarkashi_district.svg" target="_blank" rel="noopener nofollow">GDibyendu, Wikimedia Commons</a> (Public domain)</figcaption>
    </figure>
    <figure>
      <iframe title="उत्तरकाशी जिले का मानचित्र (OpenStreetMap)" loading="lazy" src="https://www.openstreetmap.org/export/embed.html?bbox=77.80%2C30.40%2C79.40%2C31.45&amp;layer=mapnik"></iframe>
      <figcaption>इंटरैक्टिव मानचित्र — उत्तरकाशी, गंगोत्री, हर्षिल, यमुनोत्री, बड़कोट, पुरोला, मोरी, चिन्यालीसौड़ देखें। © <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener nofollow">OpenStreetMap contributors</a> · <a href="https://www.openstreetmap.org/#map=9/30.90/78.50" target="_blank" rel="noopener nofollow">बड़ा मानचित्र खोलें</a></figcaption>
    </figure>
  </div>
  <ul>
    <li><b>सीमाएँ:</b> उत्तर में <b>तिब्बत (चीन)</b>, पश्चिम-उत्तर-पश्चिम में <b>हिमाचल प्रदेश</b> (किन्नौर, शिमला), पूर्व में चमोली, दक्षिण-पूर्व में रुद्रप्रयाग, दक्षिण में टिहरी, दक्षिण-पश्चिम में देहरादून।</li>
    <li><b>शिखर:</b> बंदरपूँछ, कालानाग (ब्लैक पीक), श्रीकंठ, भागीरथी समूह, शिवलिंग, केदारडोम।</li>
    <li><b>दर्रे:</b> <b>थागला</b>, <b>मुलिंग ला</b> (नेलांग-जादुंग की ओर, तिब्बत), <b>बोरासू</b> व <b>यमुनोत्री दर्रा</b> (हिमाचल/आंतरिक मार्ग)।</li>
  </ul>
  <div class="box-trap"><strong><span class="tag trap">सावधान: सबसे बड़ा जिला</span></strong>मानक उत्तर — <b>उत्तरकाशी (~8,016 वर्ग किमी)</b>, फिर चमोली, पिथौरागढ़। जनगणना 2011 की कुछ तालिकाएँ चमोली को 8,030 वर्ग किमी दिखाती हैं (रुद्रप्रयाग बनने से पहले का क्षेत्र)। <b>सबसे कम जनघनत्व (41)</b> — उत्तरकाशी, यह निर्विवाद है। सबसे छोटा जिला — चंपावत।</div>

  <h3>नदियाँ व ग्लेशियर</h3>
  <table>
    <thead><tr><th>नदी / ग्लेशियर</th><th>मुख्य तथ्य</th></tr></thead>
    <tbody>
      <tr><td><b>भागीरथी</b></td><td><b>गोमुख</b> (गंगोत्री ग्लेशियर का मुहाना, ~3,900 मी.) से; गंगोत्री से ~18 किमी ऊपर; उत्तरकाशी, मनेरी होते हुए टिहरी।</td></tr>
      <tr><td><b>गंगोत्री ग्लेशियर</b></td><td>~30 किमी लंबा — उत्तराखंड का सबसे बड़ा/लंबा ग्लेशियर; सहायक — चतुरंगी, रक्तवर्ण, कीर्ति।</td></tr>
      <tr><td><b>यमुना</b></td><td><b>यमुनोत्री ग्लेशियर / चंपासर ताल</b> (बंदरपूँछ-कालिंद पर्वत) से; यमुनोत्री धाम।</td></tr>
      <tr><td><b>टोंस (तमसा)</b></td><td><b>सुपिन + रूपिन</b> के नैटवाड़ में मिलने से; हर की दून घाटी; यमुना की सबसे बड़ी सहायक; कालसी के पास यमुना में (देहरादून)।</td></tr>
      <tr><td><b>जाड़ गंगा (जाह्नवी)</b></td><td>नेलांग घाटी से; <b>भैरोंघाटी</b> के पास भागीरथी में।</td></tr>
      <tr><td><b>असी गंगा</b></td><td><b>डोडीताल</b> से; उत्तरकाशी के पास भागीरथी में।</td></tr>
      <tr><td><b>केदार गंगा</b></td><td>गंगोत्री में भागीरथी से संगम।</td></tr>
    </tbody>
  </table>
</section>

<section id="dham">
  <h2>गंगोत्री-यमुनोत्री धाम</h2>
  <table>
    <thead><tr><th>मापदंड</th><th>गंगोत्री</th><th>यमुनोत्री</th></tr></thead>
    <tbody>
      <tr><td>नदी</td><td>भागीरथी (गंगा)</td><td>यमुना</td></tr>
      <tr><td>ऊँचाई</td><td>~3,100 मी.</td><td>~3,290 मी.</td></tr>
      <tr><td>मंदिर</td><td>गंगा मंदिर — 18वीं सदी के अंत/19वीं सदी के आरंभ में गोरखा सेनापति <b>अमर सिंह थापा</b> द्वारा बनवाया माना जाता है; बाद में जयपुर राजघराने ने जीर्णोद्धार कराया।</td><td>यमुना मंदिर — <b>टिहरी के राजा</b> द्वारा बनवाया माना जाता है; <b>सूर्य कुंड</b> (गर्म जल, चावल पकाना), <b>दिव्य शिला</b>।</td></tr>
      <tr><td>शीतकालीन गद्दी</td><td><b>मुखबा</b> (मुखीमठ)</td><td><b>खरसाली</b> (खुशीमठ)</td></tr>
      <tr><td>कपाट</td><td>अक्षय तृतीया को खुलते; दीपावली के आसपास बंद</td><td>अक्षय तृतीया को खुलते; भैया दूज को बंद</td></tr>
      <tr><td>पौराणिक प्रसंग</td><td>राजा <b>भगीरथ</b> की तपस्या; भगीरथ शिला</td><td>सूर्यपुत्री यमुना; ऋषि असित</td></tr>
    </tbody>
  </table>
  <div class="box-trap"><strong><span class="tag trap">सावधान</span></strong>गंगोत्री धाम ≠ गंगा का उद्गम। भागीरथी गोमुख से निकलती है; "गंगा" नाम <b>देवप्रयाग (टिहरी)</b> से। छोटा चार धाम में से <b>दो (गंगोत्री, यमुनोत्री) उत्तरकाशी</b> में, केदारनाथ रुद्रप्रयाग में, बद्रीनाथ चमोली में।</div>
</section>

