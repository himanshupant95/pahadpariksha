const img = (w: number) => `https://thumb.wikimedia.org/wikipedia/commons/thumb/d/d2/Jageshwar_Temple_DSCN8010_1.jpg/${w}px-Jageshwar_Temple_DSCN8010_1.jpg`;
---
<District
  name="अल्मोड़ा" nameEn="Almora" slug="almora" division="कुमाऊँ"
  title="अल्मोड़ा जिला: इतिहास, चंद राजवंश, जागेश्वर, भूगोल, मेले, संस्थान व परीक्षा बिंदु"
  description="अल्मोड़ा ज़िला GK: चंद राजधानी, जागेश्वर, कटारमल सूर्य मंदिर, लखुडियार, रानीखेत, सल्ट-खुमाड़ आंदोलन, जनगणना तथ्य और 15+ प्रश्नों की क्विज़।"
  image={img(1280)}
  heroSrcset={`${img(960)} 960w, ${img(1280)} 1280w`}
  imageAlt="जागेश्वर धाम — देवदार के वन के बीच प्राचीन पत्थर के मंदिर, अल्मोड़ा"
  heroCredit={{ text: 'जागेश्वर धाम — Sumita Roy Dutta, CC BY-SA 4.0, Wikimedia Commons', url: 'https://commons.wikimedia.org/wiki/File:Jageshwar_Temple_DSCN8010_1.jpg' }}
  published="2026-11-17" toc={toc} facts={facts} faq={faq} sources={sources}
>

<section id="naam">
  <h2>नाम की कहानी: "किल्मोड़ा" से अल्मोड़ा</h2>
  <div class="box-myth">
    <strong><span class="tag myth">जनश्रुति</span></strong>
    प्रचलित मान्यता है कि इस पहाड़ी पर उगने वाली <b>"किल्मोड़ा / कल्मोड़ा"</b> नाम की वनस्पति से नगर का नाम पड़ा। कहा जाता है कि पास के <b>कटारमल सूर्य मंदिर</b> के बर्तन साफ़ करने के लिए यह वनस्पति यहीं से ले जाई जाती थी, और इसे लाने वाले "अल्मोड़िया" कहलाए।
  </div>
  <div class="box-hist">
    <strong><span class="tag hist">ग्रंथों व अभिलेखों में</span></strong>
    स्कंद पुराण के <b>मानसखंड</b> में इस पर्वत को <b>"कषाय पर्वत"</b> कहा गया है, जो <b>कोसी (कौशिकी)</b> और <b>सुयाल (शाल्मली)</b> नदियों के बीच स्थित है। चंद काल में नगर का नाम <b>"राजापुर"</b> था — कई ताम्रपत्रों पर यही नाम मिलता है।
  </div>
  <ul>
    <li>नगर घोड़े की काठी (<b>horse-saddle</b>) के आकार की पहाड़ी पर बसा है, ऊँचाई लगभग <b>1,640 मीटर</b>।</li>
    <li>उपनाम: <b>"कुमाऊँ की सांस्कृतिक राजधानी"</b> (Cultural Capital of Kumaon)।</li>
  </ul>
</section>

<section id="itihas">
  <h2>इतिहास</h2>

  <h3>प्रागैतिहासिक काल — शैलचित्र</h3>
  <ul>
    <li><span class="tag exam">परीक्षा बिंदु</span> <b>लखुडियार</b> ("लाखों गुफाएँ") — अल्मोड़ा–बाड़ेछीना मार्ग पर <b>सुयाल नदी</b> के तट पर प्रागैतिहासिक शैलाश्रय; मानव, पशु व ज्यामितीय आकृतियों के लाल, काले व सफ़ेद रंग के चित्र। उत्तराखंड के सबसे प्रसिद्ध शैलचित्र स्थल।</li>
    <li>आसपास के अन्य शैलाश्रय: <b>फड़कानौली, फलसीमा, पेटशाल, कसार देवी</b> क्षेत्र (कसार देवी में शिलालेख भी)।</li>
  </ul>

  <h3>कत्यूरी काल</h3>
  <ul>
    <li>कत्यूरी राजवंश (राजधानी कार्तिकेयपुर — बैजनाथ घाटी, आज बागेश्वर जिला) का प्रभाव; <b>द्वाराहाट</b>, <b>जागेश्वर</b> और <b>कटारमल</b> के मंदिर इसी काल की स्थापत्य परंपरा से जुड़े।</li>
    <li><span class="tag hist">ऐतिहासिक</span> अल्मोड़ा की भूमि कत्यूरी राजा <b>बैचलदेव</b> के अधीन थी, जिन्होंने इसका अधिकांश भाग <b>श्री चंद तिवारी</b> नामक गुजराती ब्राह्मण को दान दिया (जिला प्रशासन)।</li>
  </ul>

  <h3>चंद राजवंश — अल्मोड़ा राजधानी</h3>
  <ul>
    <li>चंद राजवंश की स्थापना <b>चंपावत</b> में हुई (सोमचंद को संस्थापक माना जाता है)।</li>
    <li><span class="tag exam">परीक्षा बिंदु</span> राजा <b>बालो कल्याण चंद</b> ने राजधानी <b>चंपावत से अल्मोड़ा</b> स्थानांतरित की — अधिकांश पुस्तकों में <b>1563</b>, जबकि जिला प्रशासन <b>1568</b> बताता है।</li>
    <li><b>रुद्र चंद</b> — अकबर के समकालीन; तराई पर अधिकार।</li>
    <li><b>बाज बहादुर चंद</b> (17वीं सदी) — गढ़वाल अभियान के बाद <b>नंदा देवी</b> की मूर्ति अल्मोड़ा लाने की परंपरा उन्हीं से जोड़ी जाती है; तब से नंदा चंदों की कुलदेवी।</li>
    <li>अल्मोड़ा के चंद काल के भवन: <b>मल्ला महल</b> (आज कलेक्ट्रेट परिसर), <b>लाल मंडी किला</b>; ग्रीष्मकालीन आवास <b>बिनसर</b>।</li>
  </ul>

  <h3>गोरखा व ब्रिटिश काल</h3>
  <ul>
    <li><span class="tag exam">परीक्षा बिंदु</span> <b>1790</b> — गोरखों ने अल्मोड़ा पर अधिकार किया (<b>हवालबाग</b> के पास निर्णायक युद्ध); अंतिम चंद शासक <b>महेंद्र चंद</b>। कुमाऊँ में लगभग 25 वर्ष गोरखा शासन।</li>
    <li><b>अप्रैल 1815</b> — अल्मोड़ा के युद्ध में अंग्रेजों (कर्नल निकोल्स, गार्डनर) ने गोरखा सेनापति <b>बमशाह</b> को पराजित किया; लाल मंडी किले का नाम <b>"फोर्ट मोयरा"</b> रखा गया। <b>सुगौली संधि (1815–16)</b>।</li>
    <li><b>1815</b> — <b>"कुमाऊँ जिला"</b> बना, मुख्यालय अल्मोड़ा; पहले कमिश्नर <b>ई. गार्डनर</b>, फिर <b>जी.डब्ल्यू. ट्रेल</b>।</li>
    <li>कमिश्नर <b>हेनरी रैमज़े</b> (1856–1884) — "कुमाऊँ का बिना ताज का राजा"।</li>
    <li><b>1869</b> — <b>रानीखेत छावनी</b> की स्थापना।</li>
    <li><span class="tag exam">परीक्षा बिंदु</span> <b>1871</b> — <b>"अल्मोड़ा अखबार"</b> (संस्थापक <b>बुद्धिबल्लभ पंत</b>) — कुमाऊँ का प्रसिद्ध आरंभिक हिंदी साप्ताहिक। (ध्यान दें: उत्तराखंड का पहला देशी भाषा का पत्र नैनीताल का हिंदी-उर्दू <b>"समय विनोद"</b> (1868) था।) 1918 में अंग्रेज़ों द्वारा बंद कराए जाने के बाद <b>बद्रीदत्त पांडे</b> ने <b>"शक्ति"</b> (1918) निकाला।</li>
    <li><b>1890</b> — <b>स्वामी विवेकानंद</b> ने <b>काकड़ीघाट</b> (कोसी तट, पीपल वृक्ष) में ध्यान किया; बाद में 1897–98 में भी अल्मोड़ा आए।</li>
    <li><b>1891</b> — नैनीताल जिला अलग हुआ; शेष कुमाऊँ जिला मुख्यालय के नाम पर <b>अल्मोड़ा जिला</b> कहलाया।</li>
    <li><b>1938</b> — नृत्य सम्राट <b>उदय शंकर</b> ने अल्मोड़ा के पास <b>सिमतोला</b> में <b>इंडिया कल्चर सेंटर</b> खोला (कुछ स्रोत 1939 बताते हैं)।</li>
  </ul>

  <h3>स्वतंत्रता के बाद</h3>
  <ul>
    <li><b>24 फ़रवरी 1960</b> — <b>पिथौरागढ़</b> जिला अल्मोड़ा से अलग।</li>
    <li><b>15 सितंबर 1997</b> — <b>बागेश्वर</b> जिला अल्मोड़ा से अलग।</li>
    <li>2011 में <b>रानीखेत</b> को अलग जिला बनाने की घोषणा हुई, पर अभी तक अस्तित्व में नहीं (नवंबर 2026)।</li>
  </ul>
</section>

<section id="samayrekha">
  <h2>प्रशासनिक समयरेखा</h2>
  <ol class="timeline">
    <li><span class="yr">1563/1568</span><span class="ev">कल्याण चंद ने चंद राजधानी अल्मोड़ा (तब "राजापुर") स्थानांतरित की।</span></li>
    <li><span class="yr">1790</span><span class="ev">गोरखा शासन आरंभ।</span></li>
    <li><span class="yr">1815</span><span class="ev">गोरखों की पराजय; "कुमाऊँ जिला" बना, मुख्यालय अल्मोड़ा।</span></li>
    <li><span class="yr">1837/1840</span><span class="ev">गढ़वाल अलग जिला बना (मुख्यालय पौड़ी)।</span></li>
    <li><span class="yr">1891</span><span class="ev">नैनीताल जिला अलग; शेष जिला "अल्मोड़ा जिला" कहलाया।</span></li>
    <li><span class="yr">1960</span><span class="ev">पिथौरागढ़ जिला अलग (24 फ़रवरी)।</span></li>
    <li><span class="yr">1997</span><span class="ev">बागेश्वर जिला अलग (15 सितंबर)।</span></li>
    <li><span class="yr">2000</span><span class="ev">उत्तराखंड गठन (9 नवंबर); अल्मोड़ा कुमाऊँ मंडल का भाग।</span></li>
  </ol>
