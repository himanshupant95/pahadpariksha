      <tr><td><b>काकड़ीघाट</b></td><td>कोसी तट</td><td>स्वामी विवेकानंद को पीपल वृक्ष के नीचे ज्ञान-अनुभूति (1890)।</td></tr>
      <tr><td><b>बिनसर</b></td><td>अल्मोड़ा से ~33 किमी</td><td>चंद ग्रीष्मकालीन राजधानी; वन्यजीव अभयारण्य (1988); बिनेश्वर मंदिर; हिमालय दर्शन ("ज़ीरो पॉइंट")।</td></tr>
      <tr><td><b>रानीखेत</b></td><td>~1,869 मी.</td><td>छावनी (1869); <b>कुमाऊँ रेजीमेंट सेंटर (KRC)</b>; <b>चौबटिया</b> के सरकारी फल उद्यान; गोल्फ मैदान (उपट); नाम राजा सुधारदेव की रानी <b>पद्मिनी</b> से जोड़ा जाता है।</td></tr>
      <tr><td><b>द्वाराहाट</b></td><td>रानीखेत से ~35 किमी</td><td>कत्यूरी मंदिर समूह (गूजरदेव, मृत्युंजय, रतनदेव आदि) — "उत्तर की द्वारिका"; पास में <b>दूनागिरी</b> (द्रोणगिरि — संजीवनी बूटी की कथा) व <b>पांडुखोली</b>।</td></tr>
      <tr><td><b>सोमेश्वर</b></td><td>कोसी घाटी</td><td>चंद राजा <b>सोमचंद</b> से जोड़ा जाने वाला सोमेश्वर महादेव मंदिर।</td></tr>
      <tr><td><b>लखुडियार</b></td><td>सुयाल नदी, बाड़ेछीना मार्ग</td><td>प्रागैतिहासिक शैलचित्र।</td></tr>
      <tr><td><b>मरचूला, शीतलाखेत, जलना</b></td><td>सल्ट / रानीखेत / लमगड़ा</td><td>मरचूला — रामगंगा तट (कॉर्बेट के पास); शीतलाखेत — स्याही देवी।</td></tr>
    </tbody>
  </table>
