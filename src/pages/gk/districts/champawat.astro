const facts = [
  { k: 'मंडल', v: 'कुमाऊँ' },
  { k: 'जिला मुख्यालय', v: '<b>चंपावत</b> (समुद्र तल से ~1,615 मी.)' },
  { k: 'गठन', v: '<b>15 सितंबर 1997</b> — पिथौरागढ़ जिले से (1972 तक यह क्षेत्र अल्मोड़ा जिले में था)' },
  { k: 'क्षेत्रफल', v: '1,766 वर्ग किमी — <b>राज्य का सबसे छोटा जिला</b>' },
  { k: 'जनसंख्या (2011)', v: '2,59,648 — रुद्रप्रयाग के बाद दूसरा सबसे कम' },
  { k: 'लिंगानुपात (2011)', v: '980' },
  { k: 'दशकीय वृद्धि (2001–11)', v: '15.63%' },
  { k: 'साक्षरता (2011)', v: '79.83% (पुरुष 91.61%, महिला 68.05%)' },
  { k: 'जनघनत्व (2011)', v: '147 व्यक्ति/वर्ग किमी' },
  { k: 'विकासखंड', v: '4 — चंपावत, लोहाघाट, पाटी, बाराकोट' },
  { k: 'विधानसभा सीटें', v: '2 — चंपावत, लोहाघाट' },
