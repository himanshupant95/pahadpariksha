  { k: 'पड़ोसी', v: 'नेपाल (पूर्व, काली नदी); पिथौरागढ़, अल्मोड़ा, नैनीताल, ऊधम सिंह नगर' },
  { k: 'वाहन कोड', v: 'UK-03' },
