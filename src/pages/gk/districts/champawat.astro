const faq = [
  { q: 'चंपावत जिला कब बना?', a: '15 सितंबर 1997 को पिथौरागढ़ जिले से अलग करके। यह क्षेत्र 1972 तक अल्मोड़ा जिले में था, फिर पिथौरागढ़ में गया। उसी दिन अल्मोड़ा से बागेश्वर जिला भी बना।' },
  { q: 'उत्तराखंड का क्षेत्रफल में सबसे छोटा जिला कौन-सा है?', a: 'चंपावत (लगभग 1,766 वर्ग किमी)। जनसंख्या में सबसे छोटा जिला रुद्रप्रयाग है; चंपावत दूसरे स्थान पर है।' },
  { q: 'देवीधुरा का बग्वाल मेला क्या है?', a: 'रक्षाबंधन के दिन चंपावत के देवीधुरा में माँ वाराही (बाराही) धाम के प्रांगण में चार खामों — वालिक, चम्याल, गहड़वाल और लमगड़िया — के बीच होने वाला पारंपरिक "पत्थर युद्ध"। 2013 में उत्तराखंड उच्च न्यायालय के आदेश के बाद पत्थरों की जगह फल-फूल से बग्वाल खेली जाती है।' },
  { q: 'मायावती अद्वैत आश्रम किसने और कब स्थापित किया?', a: 'स्वामी विवेकानंद की प्रेरणा से उनके अंग्रेज़ शिष्य कैप्टन जेम्स हेनरी सेवियर और चार्लोट सेवियर ने स्वामी स्वरूपानंद के साथ 19 मार्च 1899 को (लोहाघाट के पास) स्थापित किया। "प्रबुद्ध भारत" पत्रिका यहीं से प्रकाशित होने लगी; विवेकानंद 3–18 जनवरी 1901 को यहाँ आए।' },
  { q: 'उत्तराखंड के प्रथम स्वतंत्रता सेनानी किसे माना जाता है?', a: 'चंपावत (लोहाघाट क्षेत्र, बिसुंग) के कालू सिंह महरा को — 1857 के विद्रोह में काली कुमाऊँ में अंग्रेज़ों के विरुद्ध संघर्ष किया; साथी आनंद सिंह फर्त्याल और बिशन सिंह करायत।' },
];

const sources = [
  { label: 'NHPC — टनकपुर पावर स्टेशन (94.2 MW, डीरेट)', url: 'https://www.nhpcindia.com/welcome/project/2' },
  { label: 'Kathmandu Post — पंचेश्वर परियोजना (5,040 MW, 315 मी.; अगस्त 2026)', url: 'https://kathmandupost.com/national/2026/08/07/nepal-india-seek-breakthrough-in-stalled-pancheshwar-project' },
  { label: 'जिला प्रशासन चंपावत (champawat.gov.in / champawat.nic.in) — परिचय, प्रशासनिक ढाँचा', url: 'https://champawat.nic.in/administrative-setup/' },
  { label: 'भारत की जनगणना 2011 — चंपावत जिला', url: 'https://www.census2011.co.in/census/district/583-champawat.html' },
  { label: 'NHPC — टनकपुर पावर स्टेशन (मूल 120 MW, 1992-93)', url: 'https://www.nhpcindia.com/welcome/project_detail/8/2' },
  { label: 'Wikipedia — Advaita Ashrama; Kalu Singh Mahara; Baleshwar Temple; Champawat Tiger', url: 'https://en.wikipedia.org/wiki/Advaita_Ashrama' },
  { label: 'मुख्य चित्र: बालेश्वर मंदिर, चंपावत — Pranavspn, CC BY-SA 3.0', url: 'https://commons.wikimedia.org/wiki/File:Baleshwar_temple%2C_champawat.JPG' },
  { label: 'मानचित्र: Wikimedia Commons (Champawat district.svg — GDibyendu); OpenStreetMap contributors', url: 'https://commons.wikimedia.org/wiki/File:Champawat_district.svg' },
];
const img = (w: number) => `https://thumb.wikimedia.org/wikipedia/commons/thumb/8/8a/Baleshwar_temple%2C_champawat.JPG/${w}px-Baleshwar_temple%2C_champawat.JPG`;
---
<District
  name="चंपावत" nameEn="Champawat" slug="champawat" division="कुमाऊँ"
  title="चंपावत जिला: चंद वंश की राजधानी, देवीधुरा बग्वाल, पूर्णागिरि, मायावती आश्रम व परीक्षा बिंदु"
  description="चंपावत ज़िला GK: क्षेत्रफल में सबसे छोटा ज़िला, चंद वंश की पहली राजधानी, बालेश्वर मंदिर, देवीधुरा बग्वाल, एक हथिया नौला और क्विज़।"
  image={img(1280)}
  heroSrcset={`${img(1280)} 1280w, ${img(3840)} 3840w`}
  imageAlt="चंपावत के चंद कालीन बालेश्वर मंदिर समूह का विस्तृत दृश्य"
  heroCredit={{ text: 'बालेश्वर मंदिर, चंपावत — Pranavspn, CC BY-SA 3.0, Wikimedia Commons', url: 'https://commons.wikimedia.org/wiki/File:Baleshwar_temple%2C_champawat.JPG' }}
  published="2026-11-19" toc={toc} facts={facts} faq={faq} sources={sources}
>

<section id="naam">
  <h2>नाम की कहानी: चंपावती</h2>
  <ul>
    <li>परंपरा के अनुसार नाम राजा <b>अर्जुन देव</b> की पुत्री <b>चंपावती</b> से पड़ा; नगर के पास <b>चंपावती नदी</b> भी है और बालेश्वर मंदिर समूह में <b>चंपावती दुर्गा</b> का मंदिर है।</li>
    <li>यह पूरा क्षेत्र ऐतिहासिक रूप से <b>काली कुमाऊँ</b> कहलाता है — काली नदी के किनारे का कुमाऊँ। मान्यता है कि <b>"कुमाऊँ" नाम</b> भी यहीं के <b>कूर्मांचल</b> (कांतेश्वर/कानदेव पर्वत पर विष्णु के कूर्म अवतार) से निकला।</li>
  </ul>
  <div class="box-exam"><strong><span class="tag exam">परीक्षा बिंदु</span></strong>"काली कुमाऊँ" = वर्तमान चंपावत जिला। "कूर्मांचल" नाम की कथा चंपावत के कांतेश्वर (कानदेव) पर्वत से जुड़ी है।</div>
</section>

<section id="itihas">
  <h2>इतिहास: काली कुमाऊँ और चंद राजधानी</h2>
  <ul>
    <li><span class="tag exam">परीक्षा बिंदु</span> <b>चंद राजवंश की पहली राजधानी चंपावत</b> (राजबुंगा किला) — संस्थापक <b>सोमचंद</b> (झूसी, प्रयाग के पास से आए); स्थापना-तिथि पर मतभेद — वंशावलियाँ 685/700 ई., इतिहासकार लगभग 1020–1025 ई.।</li>
    <li>चंद शासक पहले नेपाल के <b>डोटी</b> राज्य के अधीन रहे, बाद में स्वतंत्र हुए; राजधानी आगे चलकर <b>अल्मोड़ा</b> ले जाई गई (भीष्मचंद का प्रयास, बालो कल्याणचंद ने स्थापित की)।</li>
    <li><b>बालेश्वर मंदिर समूह</b> — चंद शासकों द्वारा निर्मित; उत्कृष्ट शिल्प; मंदिर के ताम्रपत्र के अनुसार 1423 ई. के आसपास जीर्णोद्धार।</li>
    <li><b>1790–1815</b> — गोरखा शासन; <b>1815</b> से अंग्रेज़ी शासन (कुमाऊँ कमिश्नरी, अल्मोड़ा जिला)।</li>
    <li><b>1857</b> — <b>कालू महरा</b> के नेतृत्व में काली कुमाऊँ में अंग्रेज़ों के विरुद्ध विद्रोह — उत्तराखंड में 1857 का प्रमुख प्रतिरोध।</li>
    <li><b>1899</b> — मायावती में अद्वैत आश्रम; <b>1907</b> — जिम कॉर्बेट ने <b>चंपावत की आदमखोर बाघिन</b> मारी (लगभग 436 मौतें — कॉर्बेट का पहला आदमखोर)।</li>
    <li><b>1972</b> — क्षेत्र अल्मोड़ा से पिथौरागढ़ जिले में; <b>15 सितंबर 1997</b> — चंपावत अलग जिला।</li>
  </ul>
  <p>विस्तार के लिए देखें: <a href="/history/chand-dynasty/">चंद राजवंश — सोमचंद से अल्मोड़ा तक</a>।</p>
</section>

<section id="samayrekha">
  <h2>प्रशासनिक समयरेखा</h2>
  <ol class="timeline">
    <li><span class="yr">700 / ~1025 (मत-भेद)</span><span class="ev">सोमचंद — चंपावत में चंद राज्य की स्थापना।</span></li>
    <li><span class="yr">1790</span><span class="ev">गोरखा आक्रमण — कुमाऊँ पर गोरखा शासन।</span></li>
    <li><span class="yr">1815</span><span class="ev">अंग्रेज़ी शासन (सुगौली संधि 1816 से काली नदी सीमा)।</span></li>
    <li><span class="yr">1857</span><span class="ev">कालू महरा का विद्रोह।</span></li>
    <li><span class="yr">1899</span><span class="ev">मायावती अद्वैत आश्रम (19 मार्च)।</span></li>
    <li><span class="yr">1907</span><span class="ev">कॉर्बेट ने चंपावत की बाघिन मारी।</span></li>
    <li><span class="yr">1928</span><span class="ev">बनबसा में शारदा बैराज (शारदा नहर)।</span></li>
    <li><span class="yr">1972</span><span class="ev">अल्मोड़ा से पिथौरागढ़ जिले में।</span></li>
    <li><span class="yr">1992</span><span class="ev">NHPC टनकपुर पावर स्टेशन (मूल 120 MW; अब 94.2 MW) चालू।</span></li>
    <li><span class="yr">1996</span><span class="ev">भारत-नेपाल महाकाली संधि (शारदा बैराज, टनकपुर, पंचेश्वर)।</span></li>
    <li><span class="yr">1997</span><span class="ev">चंपावत जिला बना (15 सितंबर)।</span></li>
    <li><span class="yr">2013</span><span class="ev">उच्च न्यायालय — बग्वाल में पत्थरों पर रोक।</span></li>
    <li><span class="yr">2022</span><span class="ev">मुख्यमंत्री धामी चंपावत उपचुनाव में रिकॉर्ड 55,025 मतों से विजयी (परिणाम 3 जून)।</span></li>
  </ol>
</section>

<section id="bhugol">
  <h2>भूगोल</h2>
  <div class="map-grid">
    <figure>
      <img src="https://upload.wikimedia.org/wikipedia/commons/4/4f/Champawat_district.svg" alt="उत्तराखंड के मानचित्र में चंपावत जिले की स्थिति (लाल रंग में)" width="1250" height="1125" loading="lazy" referrerpolicy="no-referrer" />
      <figcaption>उत्तराखंड में चंपावत जिले की स्थिति (लाल) — ★ जिला मुख्यालय। स्रोत: <a href="https://commons.wikimedia.org/wiki/File:Champawat_district.svg" target="_blank" rel="noopener nofollow">GDibyendu, Wikimedia Commons</a></figcaption>
    </figure>
    <figure>
      <iframe title="चंपावत जिले का मानचित्र (OpenStreetMap)" loading="lazy" src="https://www.openstreetmap.org/export/embed.html?bbox=79.70%2C28.95%2C80.40%2C29.60&amp;layer=mapnik"></iframe>
      <figcaption>इंटरैक्टिव मानचित्र — चंपावत, लोहाघाट, मायावती, देवीधुरा, पंचेश्वर, टनकपुर, बनबसा, पूर्णागिरि देखें। © <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener nofollow">OpenStreetMap contributors</a> · <a href="https://www.openstreetmap.org/#map=10/29.30/80.05" target="_blank" rel="noopener nofollow">बड़ा मानचित्र खोलें</a></figcaption>
    </figure>
  </div>
  <ul>
    <li><b>सीमाएँ:</b> पूर्व में <b>नेपाल</b> (काली/महाकाली नदी अंतरराष्ट्रीय सीमा); उत्तर में पिथौरागढ़, उत्तर-पश्चिम में अल्मोड़ा, पश्चिम में नैनीताल, दक्षिण में ऊधम सिंह नगर।</li>
    <li><b>ऊँचाई:</b> लगभग 200 मी. (टनकपुर-बनबसा तराई) से 2,000 मी. से ऊपर (मायावती, एबट माउंट) — एक ही जिले में तराई, भाबर और पहाड़।</li>
    <li><b>वन:</b> लगभग दो-तिहाई क्षेत्र वनाच्छादित; शुद्ध बोया क्षेत्र 10% से कम।</li>
    <li><b>श्यामलाताल</b> — टनकपुर से ~30 किमी; विवेकानंद आश्रम (भूमि चार्लोट सेवियर ने खरीदी)।</li>
  </ul>

  <h3>नदियाँ</h3>
  <table>
    <thead><tr><th>नदी / संगम</th><th>मुख्य तथ्य</th></tr></thead>
    <tbody>
      <tr><td><b>काली (शारदा / महाकाली)</b></td><td>भारत-नेपाल सीमा; <b>पंचेश्वर</b> तक "काली", उसके बाद मैदान में "शारदा"; नेपाल में "महाकाली"।</td></tr>
      <tr><td><b>पंचेश्वर</b></td><td><b>काली + सरयू</b> का संगम; पंचेश्वर महादेव मंदिर; प्रस्तावित भारत-नेपाल पंचेश्वर बहुउद्देशीय बाँध (5,040 MW प्रस्तावित)।</td></tr>
      <tr><td><b>लोहावती</b></td><td>लोहाघाट नगर इसी के तट पर; आगे काली में।</td></tr>
      <tr><td><b>लधिया</b></td><td>दक्षिणी पहाड़ियों से; चूका के पास काली में।</td></tr>
    </tbody>
  </table>
