  { k: 'प्रमुख नदियाँ', v: 'अलकनंदा, मंदाकिनी, सोनगंगा (वासुकी गंगा), मधुगंगा' },
  { k: 'पड़ोसी', v: 'उत्तरकाशी (उत्तर), चमोली (पूर्व), पौड़ी गढ़वाल (दक्षिण), टिहरी गढ़वाल (पश्चिम)' },
