const faq = [
  { q: 'रुद्रप्रयाग जिला कब और किन जिलों से बना?', a: '16 सितंबर 1997 को। चमोली के अगस्त्यमुनि व ऊखीमठ विकासखंड पूरे तथा पोखरी व कर्णप्रयाग विकासखंड के भाग, टिहरी के जखोली व कीर्तिनगर विकासखंड के भाग और पौड़ी के खिर्सू विकासखंड का भाग मिलाकर यह जिला बना।' },
  { q: 'रुद्रप्रयाग में कौन-सी नदियाँ मिलती हैं?', a: 'अलकनंदा और मंदाकिनी। यह पंच प्रयाग में से एक है — विष्णुप्रयाग, नंदप्रयाग, कर्णप्रयाग (चमोली), रुद्रप्रयाग (रुद्रप्रयाग) और देवप्रयाग (टिहरी)।' },
  { q: 'पंच केदार में से कौन-से रुद्रप्रयाग जिले में हैं?', a: 'तीन — केदारनाथ, तुंगनाथ और मध्यमहेश्वर। शेष दो — रुद्रनाथ और कल्पेश्वर — चमोली में हैं।' },
  { q: 'शीतकाल में केदारनाथ की पूजा कहाँ होती है?', a: 'कपाट बंद होने के बाद बाबा केदार की पंचमुखी डोली ऊखीमठ के ओंकारेश्वर मंदिर लाई जाती है और छह माह वहीं पूजा होती है।' },
  { q: 'केदारनाथ आपदा कब हुई थी?', a: '16–17 जून 2013 को भारी वर्षा के बीच चोराबाड़ी ताल (गांधी सरोवर) के टूटने और मंदाकिनी की बाढ़ से केदारनाथ, रामबाड़ा, गौरीकुंड सहित पूरी घाटी तबाह हुई; मंदिर के पीछे अटकी विशाल शिला ("भीम शिला") ने मंदिर को बचाया।' },
];

const sources = [
  { label: 'CEA — सिंगोली-भटवाड़ी (99 MW) इकाइयों का चालू होना', url: 'https://cea.nic.in/wp-content/uploads/hydro/2021/01/hydro_commissioned.pdf' },
  { label: 'जिला प्रशासन रुद्रप्रयाग (rudraprayag.gov.in) — जिले का गठन (16 सितंबर 1997)', url: 'https://rudraprayag.gov.in/page/7' },
  { label: 'भारत की जनगणना 2011 — रुद्रप्रयाग जिला', url: 'https://www.census2011.co.in/census/district/576-rudraprayag.html' },
  { label: 'PIB / केंद्रीय मंत्रिमंडल — सोनप्रयाग-केदारनाथ रोपवे (5 मार्च 2025)', url: 'https://www.drishtiias.com/state-pcs-current-affairs/ropeway-projects-approved-in-uttarakhand/print_manually' },
  { label: 'Wikipedia — Rudraprayag district; Kedarnath Temple; Leopard of Rudraprayag', url: 'https://en.wikipedia.org/wiki/Leopard_of_Rudraprayag' },
  { label: 'मुख्य चित्र: केदारनाथ मंदिर — Naresh Balakrishnan, CC BY-SA 4.0', url: 'https://commons.wikimedia.org/wiki/File:Kedarnath_Temple_-_OCT_2014.jpg' },
  { label: 'मानचित्र: Wikimedia Commons (Rudraprayag district.svg — GDibyendu); OpenStreetMap contributors', url: 'https://commons.wikimedia.org/wiki/File:Rudraprayag_district.svg' },
];
const img = (w: number) => `https://thumb.wikimedia.org/wikipedia/commons/thumb/b/b6/Kedarnath_Temple_-_OCT_2014.jpg/${w}px-Kedarnath_Temple_-_OCT_2014.jpg`;
---
<District
  name="रुद्रप्रयाग" nameEn="Rudraprayag" slug="rudraprayag" division="गढ़वाल"
  title="रुद्रप्रयाग जिला: केदारनाथ, पंच केदार, अलकनंदा-मंदाकिनी संगम, 2013 आपदा व परीक्षा बिंदु"
  description="रुद्रप्रयाग ज़िला GK: 1997 में गठन, अलकनंदा-मंदाकिनी संगम, केदारनाथ व पंच केदार, तुंगनाथ, त्रियुगीनारायण, 2013 आपदा और क्विज़।"
  image={img(1280)}
  heroSrcset={`${img(960)} 960w, ${img(1280)} 1280w`}
  imageAlt="केदारनाथ मंदिर और पीछे बर्फ़ से ढकी केदारनाथ श्रेणी"
  heroCredit={{ text: 'केदारनाथ मंदिर — Naresh Balakrishnan, CC BY-SA 4.0, Wikimedia Commons', url: 'https://commons.wikimedia.org/wiki/File:Kedarnath_Temple_-_OCT_2014.jpg' }}
  published="2026-11-19" toc={toc} facts={facts} faq={faq} sources={sources}
>

<section id="naam">
  <h2>नाम की कहानी: "रुद्र" का प्रयाग</h2>
  <ul>
    <li>मान्यता है कि यहीं संगम पर <b>नारद मुनि</b> ने तप किया और शिव ने उन्हें <b>रुद्र</b> रूप में दर्शन दिए — इसलिए संगम का नाम <b>रुद्रप्रयाग</b>। संगम पर <b>रुद्रनाथ मंदिर</b> और पास में <b>चामुंडा देवी</b> मंदिर है।</li>
    <li>जिला अपने मुख्यालय नगर के नाम पर है — रुद्रप्रयाग नगर <b>अलकनंदा</b> और <b>मंदाकिनी</b> के संगम पर बसा है।</li>
    <li>केदारनाथ घाटी (मंदाकिनी घाटी) पारंपरिक रूप से <b>केदारखंड</b> कहलाती है।</li>
  </ul>
  <div class="box-trap"><strong><span class="tag trap">सावधान</span></strong>"रुद्रनाथ" नाम के दो स्थल हैं — संगम पर बना <b>रुद्रनाथ मंदिर (रुद्रप्रयाग नगर)</b> और पंच केदार का <b>रुद्रनाथ (चमोली, गोपेश्वर क्षेत्र)</b>। पंच केदार वाला प्रश्न हो तो उत्तर चमोली।</div>
</section>

<section id="gathan">
  <h2>गठन: तीन जिलों से बना जिला</h2>
  <p><b>16 सितंबर 1997</b> को रुद्रप्रयाग जिला बना (एक दिन पहले, 15 सितंबर 1997 को बागेश्वर और चंपावत बने थे)। यह तीन जिलों के भागों से बना:</p>
  <table>
    <thead><tr><th>पुराना जिला</th><th>रुद्रप्रयाग में आए क्षेत्र</th></tr></thead>
    <tbody>
      <tr><td><b>चमोली</b></td><td>अगस्त्यमुनि व ऊखीमठ विकासखंड पूरे; पोखरी व कर्णप्रयाग विकासखंड के भाग</td></tr>
      <tr><td><b>टिहरी गढ़वाल</b></td><td>जखोली व कीर्तिनगर विकासखंड के भाग</td></tr>
      <tr><td><b>पौड़ी गढ़वाल</b></td><td>खिर्सू विकासखंड का भाग</td></tr>
    </tbody>
  </table>
  <div class="box-exam"><strong><span class="tag exam">परीक्षा बिंदु</span></strong>1997 में बने तीन जिले — <b>बागेश्वर</b> (अल्मोड़ा से) और <b>चंपावत</b> (पिथौरागढ़ से) 15 सितंबर को, <b>रुद्रप्रयाग</b> (चमोली-टिहरी-पौड़ी से) 16 सितंबर को। ये तीनों उत्तराखंड राज्य (9 नवंबर 2000) से पहले, उत्तर प्रदेश के समय बने।</div>
</section>

<section id="itihas">
  <h2>इतिहास</h2>
  <ul>
    <li><b>पौराणिक:</b> केदारखंड (स्कंद पुराण) — केदारनाथ, गुप्तकाशी, त्रियुगीनारायण, कालीमठ की कथाएँ; परंपरा के अनुसार महाभारत के बाद पांडव शिव को खोजते यहाँ आए।</li>
    <li><b>आदि शंकराचार्य</b> — परंपरा के अनुसार केदारनाथ मंदिर का जीर्णोद्धार किया और यहीं समाधि ली (केदारनाथ मंदिर के पीछे समाधि स्थल)।</li>
    <li><b>कत्यूरी काल</b> — मंदाकिनी घाटी के कई प्राचीन मंदिर (गुप्तकाशी, कालीमठ, त्रियुगीनारायण) इसी शैली परंपरा के।</li>
    <li><b>गढ़वाल राज्य</b> — पंवार (परमार) शासकों के अधीन; <b>1803</b> के भूकंप और गोरखा आक्रमण के बाद <b>1815</b> से अंग्रेज़ी शासन — अलकनंदा का पूर्वी भाग ब्रिटिश गढ़वाल (पौड़ी) और पश्चिमी भाग टिहरी रियासत में रहा।</li>
    <li><b>1918–1926</b> — रुद्रप्रयाग का आदमखोर गुलदार: केदारनाथ-बद्रीनाथ तीर्थमार्ग पर 125 से अधिक लोगों की मौत; <b>2 मई 1926</b> को <b>जिम कॉर्बेट</b> ने इसे मारा।</li>
    <li><b>1921</b> — कुली बेगार विरोध गढ़वाल में भी; रुद्रप्रयाग-चमोली पैदल मार्ग पर ककोड़ाखाल में अंग्रेज़ अधिकारियों को बेगार देने से इनकार।</li>
  </ul>
</section>

<section id="samayrekha">
  <h2>प्रशासनिक समयरेखा</h2>
  <ol class="timeline">
    <li><span class="yr">1803</span><span class="ev">गढ़वाल का भीषण भूकंप; गोरखा आक्रमण।</span></li>
    <li><span class="yr">1815</span><span class="ev">अंग्रेज़ी शासन — क्षेत्र ब्रिटिश गढ़वाल और टिहरी रियासत में बँटा।</span></li>
    <li><span class="yr">1926</span><span class="ev">जिम कॉर्बेट ने रुद्रप्रयाग का आदमखोर गुलदार मारा (2 मई)।</span></li>
    <li><span class="yr">1949</span><span class="ev">टिहरी रियासत का उत्तर प्रदेश में विलय (1 अगस्त)।</span></li>
    <li><span class="yr">1960</span><span class="ev">चमोली जिला बना — केदारनाथ घाटी चमोली में।</span></li>
    <li><span class="yr">1997</span><span class="ev">रुद्रप्रयाग जिला बना (16 सितंबर)।</span></li>
    <li><span class="yr">2013</span><span class="ev">केदारनाथ आपदा (16–17 जून)।</span></li>
    <li><span class="yr">2021</span><span class="ev">केदारनाथ में आदि शंकराचार्य की 12 फुट प्रतिमा व पुनर्निर्मित समाधि का लोकार्पण (5 नवंबर)।</span></li>
    <li><span class="yr">2025</span><span class="ev">सोनप्रयाग-केदारनाथ रोपवे (12.9 किमी) को केंद्रीय स्वीकृति (5 मार्च)।</span></li>
  </ol>
</section>

<section id="bhugol">
  <h2>भूगोल</h2>
  <div class="map-grid">
    <figure>
      <img src="https://upload.wikimedia.org/wikipedia/commons/e/ef/Rudraprayag_district.svg" alt="उत्तराखंड के मानचित्र में रुद्रप्रयाग जिले की स्थिति (लाल रंग में)" width="1250" height="1125" loading="lazy" referrerpolicy="no-referrer" />
      <figcaption>उत्तराखंड में रुद्रप्रयाग जिले की स्थिति (लाल) — ★ जिला मुख्यालय। स्रोत: <a href="https://commons.wikimedia.org/wiki/File:Rudraprayag_district.svg" target="_blank" rel="noopener nofollow">GDibyendu, Wikimedia Commons</a></figcaption>
    </figure>
    <figure>
      <iframe title="रुद्रप्रयाग जिले का मानचित्र (OpenStreetMap)" loading="lazy" src="https://www.openstreetmap.org/export/embed.html?bbox=78.70%2C30.15%2C79.40%2C30.85&amp;layer=mapnik"></iframe>
      <figcaption>इंटरैक्टिव मानचित्र — रुद्रप्रयाग, अगस्त्यमुनि, गुप्तकाशी, ऊखीमठ, सोनप्रयाग, गौरीकुंड, केदारनाथ, चोपता देखें। © <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener nofollow">OpenStreetMap contributors</a> · <a href="https://www.openstreetmap.org/#map=10/30.50/79.05" target="_blank" rel="noopener nofollow">बड़ा मानचित्र खोलें</a></figcaption>
    </figure>
  </div>
  <ul>
    <li><b>स्थिति:</b> गढ़वाल मंडल के बीच में; उत्तर में उत्तरकाशी, पूर्व में चमोली, दक्षिण में पौड़ी, पश्चिम में टिहरी। <b>किसी अंतरराष्ट्रीय सीमा से नहीं लगता।</b></li>
    <li><b>हिमालय:</b> उत्तर में केदारनाथ श्रेणी — केदारनाथ (लगभग 6,940 मी.), केदार डोम, भरतकुंटा; पूर्वोत्तर में चौखंबा क्षेत्र।</li>
    <li><b>बुग्याल व ताल:</b> चोपता-तुंगनाथ के बुग्याल, <b>देवरिया ताल</b> (सारी गाँव के ऊपर — जल में चौखंबा का प्रतिबिंब), <b>वासुकी ताल</b> (केदारनाथ के ऊपर), <b>चोराबाड़ी ताल / गांधी सरोवर</b>।</li>
    <li><b>केदारनाथ वन्यजीव विहार (1972)</b> — चमोली-रुद्रप्रयाग में फैला; <b>कस्तूरी मृग</b> संरक्षण के लिए प्रसिद्ध।</li>
  </ul>

  <h3>नदियाँ व प्रयाग</h3>
  <table>
    <thead><tr><th>नदी / प्रयाग</th><th>मुख्य तथ्य</th></tr></thead>
    <tbody>
      <tr><td><b>मंदाकिनी</b></td><td>केदारनाथ के पीछे <b>चोराबाड़ी ग्लेशियर</b> से; गौरीकुंड, सोनप्रयाग, गुप्तकाशी, अगस्त्यमुनि होते हुए रुद्रप्रयाग में अलकनंदा से मिलती है।</td></tr>
      <tr><td><b>सोनप्रयाग</b></td><td>मंदाकिनी + <b>सोनगंगा (वासुकी गंगा)</b>; केदारनाथ यात्रा का मुख्य पड़ाव।</td></tr>
      <tr><td><b>रुद्रप्रयाग</b></td><td>अलकनंदा + <b>मंदाकिनी</b> — पंच प्रयाग में चौथा (ऊपर से)।</td></tr>
      <tr><td><b>मधुगंगा</b></td><td>मध्यमहेश्वर क्षेत्र से; कालीमठ घाटी में मंदाकिनी की ओर।</td></tr>
      <tr><td><b>अलकनंदा</b></td><td>चमोली से आकर जिले के दक्षिण-पूर्वी भाग से बहती है; रुद्रप्रयाग के बाद श्रीनगर (पौड़ी) की ओर।</td></tr>
    </tbody>
  </table>
  <div class="box-trap"><strong><span class="tag trap">सावधान</span></strong>पंच प्रयाग का क्रम (ऊपर से नीचे): <b>विष्णुप्रयाग (धौलीगंगा) → नंदप्रयाग (नंदाकिनी) → कर्णप्रयाग (पिंडर) → रुद्रप्रयाग (मंदाकिनी) → देवप्रयाग (भागीरथी)</b>। पहले तीन चमोली में, रुद्रप्रयाग अपने जिले में, देवप्रयाग टिहरी में। "मंदाकिनी" नाम की एक नदी चित्रकूट (उ.प्र./म.प्र.) में भी है।</div>
</section>

