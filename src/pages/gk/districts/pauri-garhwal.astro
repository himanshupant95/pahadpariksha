const faq = [
  { q: 'उत्तराखंड में सबसे अधिक जिलों से सीमा किस जिले की लगती है?', a: 'पौड़ी गढ़वाल — सात जिलों (हरिद्वार, देहरादून, टिहरी, रुद्रप्रयाग, चमोली, अल्मोड़ा, नैनीताल) से, साथ ही दक्षिण में उत्तर प्रदेश के बिजनौर जिले से।' },
  { q: 'पेशावर कांड क्या था?', a: '23 अप्रैल 1930 को पेशावर (अब पाकिस्तान) में 2/18 रॉयल गढ़वाल राइफल्स के हवलदार चंद्र सिंह भंडारी ने निहत्थे पठान सत्याग्रहियों (खुदाई खिदमतगार) पर गोली चलाने के आदेश को मानने से इनकार कर दिया। उन्हें "वीर चंद्र सिंह गढ़वाली" कहा गया। उनका जन्म पौड़ी जिले के रौणसेरा गाँव में हुआ था।' },
  { q: 'कण्वाश्रम क्यों प्रसिद्ध है?', a: 'कोटद्वार के पास मालिनी नदी के तट पर स्थित कण्वाश्रम को महर्षि कण्व का आश्रम माना जाता है — यहीं शकुंतला-दुष्यंत की कथा और उनके पुत्र भरत का जन्म जोड़ा जाता है, जिनके नाम पर देश का नाम "भारत" पड़ा। कालिदास के "अभिज्ञान शाकुंतलम्" की पृष्ठभूमि यही मानी जाती है।' },
  { q: 'लैंसडाउन का पुराना नाम क्या था?', a: '"कालूडांडा" (काली पहाड़ी)। 1887 में गढ़वाल राइफल्स की पहली बटालियन यहाँ आई और छावनी का नाम तत्कालीन वायसराय लॉर्ड लैंसडाउन के नाम पर रखा गया।' },
  { q: 'पौड़ी को गढ़वाल मंडल का मुख्यालय कब बनाया गया?', a: '1969 में गढ़वाल मंडल (कमिश्नरी) बना, जिसका मुख्यालय पौड़ी रखा गया। ब्रिटिश काल में 1840 से ही गढ़वाल जिले का मुख्यालय (श्रीनगर से हटकर) पौड़ी था।' },
];

const sources = [
  { label: 'BHEL — 330 MW श्रीनगर HEP की चारों इकाइयाँ चालू (11 जून 2015)', url: 'https://www.bhel.com/bhel-commissions-all-4-hydro-sets-825-mw-each-330-mw-hydro-power-station-just-60-days' },
  { label: 'सिंचाई विभाग उत्तराखंड — कालागढ़ (रामगंगा) बाँध', url: 'https://uttarakhandirrigation.com/kalagarh' },
  { label: 'Drishti — ऋषिकेश-कर्णप्रयाग रेल व T-8 सुरंग (18 अप्रैल 2025)', url: 'https://www.drishtiias.com/state-pcs-current-affairs/rishikesh-karnaprayag-rail-link-project' },
  { label: 'जिला प्रशासन पौड़ी गढ़वाल — इतिहास (pauri.nic.in)', url: 'https://pauri.nic.in/history/' },
  { label: 'भारत की जनगणना 2011 — जिला आँकड़े (पौड़ी गढ़वाल)', url: 'https://www.census2011.co.in/census/state/districtlist/uttarakhand.html' },
  { label: 'हेमवती नंदन बहुगुणा गढ़वाल विश्वविद्यालय', url: 'https://www.hnbgu.ac.in/' },
  { label: 'Wikipedia — Pauri Garhwal district, Lansdowne, Kanvashram, Peshawar Kand, Garhwal Rifles', url: 'https://en.wikipedia.org/wiki/Pauri_Garhwal_district' },
  { label: 'मानचित्र: Wikimedia Commons (Pauri Garhwal district.svg — GDibyendu, Public domain); OpenStreetMap contributors', url: 'https://commons.wikimedia.org/wiki/File:Pauri_Garhwal_district.svg' },
