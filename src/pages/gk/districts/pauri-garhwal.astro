const img = (w: number) => `https://thumb.wikimedia.org/wikipedia/commons/thumb/f/fe/Pauri_Town.jpg/${w}px-Pauri_Town.jpg`;
---
<District
  name="पौड़ी गढ़वाल" nameEn="Pauri Garhwal" slug="pauri-garhwal" division="गढ़वाल"
  title="पौड़ी गढ़वाल जिला: इतिहास, कण्वाश्रम, लैंसडाउन, पेशावर कांड, भूगोल, मेले व परीक्षा बिंदु"
  description="पौड़ी गढ़वाल ज़िला GK: मंडल मुख्यालय, श्रीनगर राजधानी, कण्वाश्रम, लैंसडाउन व गढ़वाल राइफल्स, वीर चंद्र सिंह गढ़वाली और क्विज़।"
  image={img(1280)}
  heroSrcset={`${img(960)} 960w, ${img(1280)} 1280w`}
  imageAlt="पौड़ी नगर — पहाड़ी ढलान पर बसे घर और पीछे घाटी"
  heroCredit={{ text: 'पौड़ी नगर — Historiansimar, CC BY-SA 4.0, Wikimedia Commons', url: 'https://commons.wikimedia.org/wiki/File:Pauri_Town.jpg' }}
  published="2026-11-17" toc={toc} facts={facts} faq={faq} sources={sources}
>

<section id="naam">
  <h2>नाम की कहानी: "गढ़वाल" — गढ़ों का देश</h2>
  <div class="box-hist">
    <strong><span class="tag hist">ऐतिहासिक</span></strong>
    मध्यकाल में यह क्षेत्र <b>52 छोटे गढ़ों (किलों)</b> में बँटा था, जिन पर अलग-अलग सरदार राज करते थे। 15वीं सदी के अंत में <b>राजा अजयपाल</b> ने इन्हें एक राज्य में मिलाया — तब से यह भूमि <b>"गढ़वाल"</b> (गढ़ों वाला देश) कहलाई।
  </div>
  <div class="box-myth">
    <strong><span class="tag myth">पौराणिक</span></strong>
    पुराणों में गढ़वाल क्षेत्र को <b>"केदारखंड"</b> कहा गया है (कुमाऊँ को "मानसखंड")। कोटद्वार के पास <b>कण्वाश्रम</b> को महर्षि कण्व की तपोभूमि और <b>चक्रवर्ती भरत</b> की जन्मभूमि माना जाता है।
  </div>
  <ul>
    <li><b>कोटद्वार</b> — "गढ़वाल का प्रवेश द्वार"; जिले का सबसे बड़ा नगर व रेल-शीर्ष।</li>
    <li><b>लैंसडाउन</b> — पुराना नाम <b>"कालूडांडा"</b>; 1887 में वायसराय <b>लॉर्ड लैंसडाउन</b> के नाम पर।</li>
    <li>1960 तक पूरा क्षेत्र "गढ़वाल जिला" था; चमोली अलग होने के बाद मुख्यालय के नाम से <b>"पौड़ी गढ़वाल"</b> (सरकारी अभिलेखों में अब भी "गढ़वाल जिला")।</li>
  </ul>
</section>

<section id="itihas">
  <h2>इतिहास</h2>

  <h3>प्राचीन काल</h3>
  <ul>
    <li><span class="tag myth">पौराणिक</span> <b>कण्वाश्रम</b> (मालिनी नदी) — शकुंतला-दुष्यंत की कथा; कालिदास के "अभिज्ञान शाकुंतलम्" की पृष्ठभूमि।</li>
    <li>कत्यूरी शासन (लगभग 8वीं–11वीं सदी) के बाद क्षेत्र अनेक गढ़ों में बँट गया।</li>
    <li>पौड़ी के <b>क्यूंकालेश्वर (कंकालेश्वर) महादेव</b> मंदिर को 8वीं सदी (आदि शंकराचार्य काल) से जोड़ा जाता है।</li>
  </ul>

  <h3>पंवार (परमार) राजवंश — गढ़वाल राज्य</h3>
  <ul>
    <li>पंवार वंश का आरंभ <b>कनकपाल</b> (चाँदपुरगढ़, आज चमोली) से माना जाता है।</li>
    <li><b>जगतपाल</b> (1455–1493) के समय चाँदपुरगढ़ शक्तिशाली हुआ।</li>
    <li><span class="tag exam">परीक्षा बिंदु</span> <b>राजा अजयपाल</b> ने 52 गढ़ों को जीतकर गढ़वाल राज्य बनाया; राजधानी चाँदपुर → <b>देवलगढ़</b> → <b>श्रीनगर</b> (16वीं सदी का आरंभ — जिला प्रशासन: 1506–1519)। श्रीनगर लगभग 300 वर्ष गढ़वाल की राजधानी रहा।</li>
    <li>राजा <b>बलभद्र शाह</b> को "शाह" उपाधि (दिल्ली सल्तनत/मुगल दरबार से) मिलने की परंपरा मानी जाती है।</li>
    <li><span class="tag exam">परीक्षा बिंदु</span> <b>रानी कर्णावती</b> (17वीं सदी) — राजा महीपत शाह की रानी; मुगल सेना को पराजित कर सैनिकों की नाक कटवाई — <b>"नाक-कटी रानी"</b>।</li>
    <li><b>तीलू रौतेली</b> (17वीं सदी) — चौंदकोट क्षेत्र के गुराड़ गाँव की वीरांगना; कम उम्र में कत्यूरी आक्रमणकारियों से युद्ध — "गढ़वाल की लक्ष्मीबाई"।</li>
  </ul>

  <h3>गोरखा व ब्रिटिश काल</h3>
  <ul>
    <li><b>1803</b> — गढ़वाल में विनाशकारी भूकंप; उसी वर्ष गोरखा आक्रमण। <b>1804</b> — <b>खुड़बुड़ा (देहरादून)</b> के युद्ध में राजा <b>प्रद्युम्न शाह</b> मारे गए; लगभग 12 वर्ष गोरखा शासन।</li>
    <li><span class="tag exam">परीक्षा बिंदु</span> <b>21 अप्रैल 1815</b> — अंग्रेजों ने अलकनंदा-मंदाकिनी के पूर्व का गढ़वाल अपने पास रखा (<b>ब्रिटिश गढ़वाल</b>); पश्चिमी भाग <b>सुदर्शन शाह</b> को मिला (राजधानी टिहरी)।</li>
    <li>प्रारंभ में ब्रिटिश गढ़वाल कुमाऊँ जिले का भाग; <b>1839–40</b> में अलग <b>गढ़वाल जिला</b>, सहायक कमिश्नर — मुख्यालय श्रीनगर से <b>पौड़ी</b>।</li>
    <li><span class="tag exam">परीक्षा बिंदु</span> <b>1887</b> — <b>गढ़वाल राइफल्स</b> की पहली बटालियन (अल्मोड़ा में गठित) <b>कालूडांडा</b> आई; छावनी का नाम <b>लैंसडाउन</b>।</li>
    <li><b>1894</b> — <b>गोहना ताल</b> (बिरही, चमोली) के टूटने से आई बाढ़ में पुराना <b>श्रीनगर</b> नगर बह गया; नया नगर दोबारा बसाया गया।</li>
    <li><b>1914–15</b> — प्रथम विश्वयुद्ध (फ्रांस) में गढ़वाल राइफल्स के <b>दरबान सिंह नेगी</b> और <b>गबर सिंह नेगी</b> को <b>विक्टोरिया क्रॉस</b>।</li>
  </ul>

  <h3>स्वतंत्रता के बाद</h3>
  <ul>
    <li><b>1960</b> — गढ़वाल जिले से <b>चमोली</b> अलग।</li>
    <li><b>1969</b> — <b>गढ़वाल मंडल</b> का गठन, मुख्यालय <b>पौड़ी</b>।</li>
    <li><b>1997–98</b> — खिर्सू ब्लॉक के गाँवों सहित पौड़ी, चमोली व टिहरी के भाग मिलाकर <b>रुद्रप्रयाग</b> जिला बना।</li>
    <li><b>1973</b> — श्रीनगर में <b>गढ़वाल विश्वविद्यालय</b>; 2009 में केंद्रीय विश्वविद्यालय।</li>
  </ul>
</section>

<section id="samayrekha">
  <h2>प्रशासनिक समयरेखा</h2>
  <ol class="timeline">
    <li><span class="yr">~1506–1519</span><span class="ev">अजयपाल ने राजधानी देवलगढ़ से श्रीनगर स्थानांतरित की।</span></li>
    <li><span class="yr">1804</span><span class="ev">गोरखा शासन (खुड़बुड़ा युद्ध)।</span></li>
    <li><span class="yr">1815</span><span class="ev">ब्रिटिश गढ़वाल (पूर्वी भाग) बना — कुमाऊँ जिले के अधीन।</span></li>
    <li><span class="yr">1839–40</span><span class="ev">अलग गढ़वाल जिला; मुख्यालय पौड़ी।</span></li>
    <li><span class="yr">1887</span><span class="ev">लैंसडाउन छावनी, गढ़वाल राइफल्स।</span></li>
    <li><span class="yr">1960</span><span class="ev">चमोली जिला अलग।</span></li>
    <li><span class="yr">1969</span><span class="ev">गढ़वाल मंडल — मुख्यालय पौड़ी।</span></li>
    <li><span class="yr">1997–98</span><span class="ev">रुद्रप्रयाग जिले के लिए भाग अलग।</span></li>
  </ol>
