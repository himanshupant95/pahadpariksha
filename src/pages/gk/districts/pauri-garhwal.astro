  { k: 'दशकीय वृद्धि (2001–11)', v: '<b>−1.41% — राज्य में सबसे कम</b> (ऋणात्मक)' },
  { k: 'लिंगानुपात (2011)', v: '1103 — राज्य में तीसरा' },
  { k: 'साक्षरता (2011)', v: '82.02%' },
  { k: 'जनघनत्व (2011)', v: 'लगभग 129 व्यक्ति/वर्ग किमी' },
