  { k: 'जिला मुख्यालय', v: 'पौड़ी (लगभग 1,800 मी.)' },
  { k: 'गठन', v: '<b>1839–40</b> में "गढ़वाल जिला" (ब्रिटिश गढ़वाल); 1960 में चमोली अलग होने के बाद "पौड़ी गढ़वाल"' },
  { k: 'क्षेत्रफल', v: 'लगभग 5,329 वर्ग किमी (जनगणना 2011)' },
