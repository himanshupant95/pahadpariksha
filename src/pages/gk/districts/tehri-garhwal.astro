---
import District from '../../../layouts/District.astro';
import Quiz from '../../../components/Quiz.astro';
import questions from '../../../data/quizzes/tehri-garhwal.json';

const toc = [
  { id: 'at-a-glance', label: 'एक नज़र में' },
  { id: 'naam', label: 'नाम की कहानी' },
  { id: 'itihas', label: 'इतिहास (टिहरी रियासत)' },
  { id: 'samayrekha', label: 'प्रशासनिक समयरेखा' },
  { id: 'bhugol', label: 'भूगोल व नदियाँ' },
  { id: 'bandh', label: 'टिहरी बाँध परियोजना' },
  { id: 'prashasan', label: 'प्रशासन' },
  { id: 'janankiki', label: 'जनसांख्यिकी' },
  { id: 'samaj', label: 'समाज, बोली व परंपराएँ' },
  { id: 'mele', label: 'मेले व त्योहार' },
  { id: 'sthal', label: 'धार्मिक, ऐतिहासिक व पर्यटन स्थल' },
  { id: 'sansthan', label: 'राष्ट्रीय व राज्य संस्थान' },
  { id: 'andolan', label: 'प्रजामंडल व जन आंदोलन' },
  { id: 'vyaktitva', label: 'प्रमुख व्यक्तित्व' },
  { id: 'arthvyavastha', label: 'अर्थव्यवस्था' },
  { id: 'jalvidyut', label: 'अन्य राष्ट्रीय परियोजनाएँ (टिहरी बाँध के अलावा)' },
  { id: 'pariksha', label: 'परीक्षा बिंदु (One-liners)' },
  { id: 'quiz', label: 'क्विज़ (15 प्रश्न)' },
  { id: 'faq', label: 'FAQ' },
