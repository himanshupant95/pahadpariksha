const facts = [
  { k: 'मंडल', v: 'गढ़वाल' },
  { k: 'जिला मुख्यालय', v: '<b>नई टिहरी</b> (पुराना टिहरी नगर 2005–06 में बाँध झील में डूब गया)' },
  { k: 'गठन', v: '<b>1 अगस्त 1949</b> — टिहरी रियासत के उत्तर प्रदेश में विलय से जिला बना' },
  { k: 'क्षेत्रफल', v: 'लगभग 3,642 वर्ग किमी (जनगणना 2011) — कुछ स्रोतों में 4,080' },
  { k: 'जनसंख्या (2011)', v: '6,18,931 — राज्य में सातवाँ' },
  { k: 'लिंगानुपात (2011)', v: '1077' },
  { k: 'दशकीय वृद्धि (2001–11)', v: '2.35%' },
  { k: 'साक्षरता (2011)', v: '76.36% (पुरुष 89.76%, महिला 64.28%)' },
  { k: 'जनघनत्व (2011)', v: 'लगभग 170 व्यक्ति/वर्ग किमी' },
  { k: 'विकासखंड', v: '9' },
  { k: 'विधानसभा सीटें', v: '6' },
  { k: 'प्रमुख नदियाँ', v: 'भागीरथी, भिलंगना, अलकनंदा (देवप्रयाग तक), हेंवल, बालगंगा, अगलाड़' },
  { k: 'पड़ोसी', v: 'उत्तरकाशी, रुद्रप्रयाग, पौड़ी गढ़वाल, देहरादून' },
  { k: 'वाहन कोड', v: 'UK-09' },
];

const faq = [
  { q: 'टिहरी नगर की स्थापना किसने और कब की?', a: 'गोरखों से राज्य वापस मिलने के बाद राजा सुदर्शन शाह ने भागीरथी-भिलंगना संगम पर 28 दिसंबर 1815 को टिहरी को अपनी राजधानी बनाया (कुछ स्रोतों में 29/30 दिसंबर)। पुराना श्रीनगर अंग्रेजों के ब्रिटिश गढ़वाल में चला गया था।' },
  { q: 'टिहरी बाँध की ऊँचाई कितनी है?', a: '260.5 मीटर — भारत का सबसे ऊँचा बाँध (मिट्टी व पत्थर से बना — earth and rockfill)। यह भागीरथी नदी पर, भिलंगना के संगम के पास है। मुख्य बिजलीघर 1000 मेगावाट, कोटेश्वर 400 मेगावाट और पंप स्टोरेज प्लांट 1000 मेगावाट — कुल 2400 मेगावाट का टिहरी हाइड्रो पावर कॉम्प्लेक्स।' },
  { q: 'श्रीदेव सुमन की मृत्यु कब और कैसे हुई?', a: 'टिहरी जेल में 84 दिन के आमरण अनशन के बाद 25 जुलाई 1944 को। वे टिहरी रियासत के निरंकुश शासन के विरुद्ध प्रजामंडल के नेता थे। 25 जुलाई को "सुमन दिवस" मनाया जाता है।' },
  { q: 'टिहरी रियासत का भारत में विलय कब हुआ?', a: '1 अगस्त 1949 को टिहरी रियासत उत्तर प्रदेश में मिलाई गई और टिहरी गढ़वाल जिला बना। अंतिम शासक महाराजा मानवेंद्र शाह थे, जो बाद में कई बार टिहरी से सांसद रहे।' },
  { q: 'तिलाड़ी कांड किस जिले से जुड़ा है?', a: '30 मई 1930 का तिलाड़ी कांड टिहरी रियासत के रवाईं क्षेत्र (बड़कोट के पास, यमुना तट) में हुआ था — यह क्षेत्र आज उत्तरकाशी जिले में है। इसे "उत्तराखंड का जलियाँवाला बाग" कहा जाता है।' },
];

const sources = [
  { label: 'THDC — टिहरी PSP (इकाइयों की COD तिथियाँ)', url: 'https://www.thdc.co.in/en/node/1145' },
  { label: 'THDC इंडिया लिमिटेड — टिहरी हाइड्रो पावर कॉम्प्लेक्स (2400 MW)', url: 'https://www.thdc.co.in/index.php/en/node/258' },
  { label: 'THDC — टिहरी पंप स्टोरेज प्लांट: 12 अप्रैल 2026 को पूर्ण रूप से चालू', url: 'https://www.thdc.co.in/en/node/1145' },
  { label: 'भारत की जनगणना 2011 — जिला आँकड़े (टिहरी गढ़वाल)', url: 'https://www.census2011.co.in/census/district/577-tehri-garhwal.html' },
  { label: 'जिला प्रशासन टिहरी गढ़वाल (tehri.nic.in)', url: 'https://tehri.nic.in/' },
  { label: 'Wikipedia — Tehri Garhwal district, Tehri Garhwal State, Tehri Dam, Sri Dev Suman', url: 'https://en.wikipedia.org/wiki/Tehri_Garhwal_district' },
  { label: 'मानचित्र: Wikimedia Commons (Tehri Garhwal district.svg — GDibyendu, Public domain); OpenStreetMap contributors', url: 'https://commons.wikimedia.org/wiki/File:Tehri_Garhwal_district.svg' },
  { label: 'मुख्य चित्र: Tehri Dam India — Dr Vikramjit Kakati, CC BY-SA 4.0', url: 'https://commons.wikimedia.org/wiki/File:Tehri_Dam_India.jpg' },
];

const img = (w: number) => `https://thumb.wikimedia.org/wikipedia/commons/thumb/0/03/Tehri_Dam_India.jpg/${w}px-Tehri_Dam_India.jpg`;
---
<District
  name="टिहरी गढ़वाल" nameEn="Tehri Garhwal" slug="tehri-garhwal" division="गढ़वाल"
  title="टिहरी गढ़वाल जिला: टिहरी रियासत, टिहरी बाँध, श्रीदेव सुमन, भूगोल, मेले व परीक्षा बिंदु"
  description="टिहरी गढ़वाल जिले का संपूर्ण सामान्य ज्ञान — सुदर्शन शाह व टिहरी रियासत (1815–1949), श्रीदेव सुमन, कीर्तिनगर आंदोलन, 1 अगस्त 1949 विलय, 260.5 मी. टिहरी बाँध व 2400 MW कॉम्प्लेक्स, देवप्रयाग, सुरकंडा-कुंजापुरी-चंद्रबदनी, मौण मेला, डोबरा-चांठी पुल और 15 प्रश्नों का क्विज़।"
  image={img(1280)}
  heroSrcset={`${img(960)} 960w, ${img(1280)} 1280w`}
  imageAlt="टिहरी बाँध और पीछे पहाड़ों के बीच फैली टिहरी झील"
  heroCredit={{ text: 'टिहरी बाँध — Dr Vikramjit Kakati, CC BY-SA 4.0, Wikimedia Commons', url: 'https://commons.wikimedia.org/wiki/File:Tehri_Dam_India.jpg' }}
  published="2026-11-17" toc={toc} facts={facts} faq={faq} sources={sources}
>

<section id="naam">
  <h2>नाम की कहानी: "त्रिहरी"</h2>
  <div class="box-myth">
    <strong><span class="tag myth">जनश्रुति</span></strong>
    टिहरी नाम <b>"त्रिहरी"</b> से माना जाता है — वह स्थान जो <b>तीन प्रकार के पाप</b> (मनसा, वाचा, कर्मणा — मन, वचन, कर्म से किए गए) हर लेता है। एक अन्य मत में तीन नदियों (भागीरथी, भिलंगना और घृतगंगा) के संगम से जोड़ा जाता है।
  </div>
  <ul>
    <li>पुराने टिहरी नगर में भागीरथी-भिलंगना संगम को <b>"गणेश प्रयाग"</b> कहा जाता था — अब यह बाँध झील में डूब चुका है।</li>
    <li>मुख्यालय <b>नई टिहरी</b> (बौराड़ी क्षेत्र) — नियोजित पहाड़ी नगर।</li>
    <li>"गढ़वाल" शब्द के साथ "टिहरी" — क्योंकि यह गढ़वाल राज्य का वह पश्चिमी भाग था जो 1815 के बाद राजा के पास रहा (<b>टिहरी गढ़वाल रियासत</b>), जबकि पूर्वी भाग ब्रिटिश गढ़वाल बना।</li>
  </ul>
</section>

<section id="itihas">
  <h2>इतिहास — टिहरी रियासत (1815–1949)</h2>

  <h3>पृष्ठभूमि</h3>
  <ul>
    <li>गढ़वाल का पंवार (परमार) राजवंश — राजधानी श्रीनगर (16वीं सदी से)।</li>
    <li><b>1803–04</b> — गोरखा आक्रमण; राजा <b>प्रद्युम्न शाह</b> खुड़बुड़ा (देहरादून) में मारे गए; पुत्र <b>सुदर्शन शाह</b> निर्वासन में।</li>
    <li><b>1815</b> — आंग्ल-गोरखा युद्ध के बाद अंग्रेजों ने अलकनंदा-मंदाकिनी के पूर्व का भाग (ब्रिटिश गढ़वाल) अपने पास रखा; <b>पश्चिमी भाग</b> सुदर्शन शाह को लौटाया। देहरादून भी अंग्रेजों ने ले लिया।</li>
  </ul>

  <h3>टिहरी के शासक</h3>
  <table>
    <thead><tr><th>शासक</th><th>प्रमुख तथ्य</th></tr></thead>
    <tbody>
      <tr><td><b>सुदर्शन शाह</b> (1815–1859)</td><td><span class="tag exam">परीक्षा बिंदु</span> <b>28 दिसंबर 1815</b> को टिहरी को राजधानी बनाया; ब्रजभाषा ग्रंथ <b>"सभासार"</b> के रचनाकार; 1857 में अंग्रेजों का साथ दिया।</td></tr>
      <tr><td><b>भवानी शाह</b> (1859–1871)</td><td>—</td></tr>
      <tr><td><b>प्रताप शाह</b> (1871–1886)</td><td><b>प्रतापनगर</b> बसाया (ग्रीष्मकालीन आवास); अंग्रेजी शिक्षा व प्रशासनिक सुधार।</td></tr>
      <tr><td><b>कीर्ति शाह</b> (1886–1913)</td><td><b>कीर्तिनगर</b> बसाया; टिहरी में शिक्षा-स्वास्थ्य सुधार; स्वामी रामतीर्थ इन्हीं के समय टिहरी आए।</td></tr>
      <tr><td><b>नरेंद्र शाह</b> (1913/1919–1946)</td><td><b>नरेंद्रनगर</b> बसाया — <b>1925</b> से राजधानी; "महाराजा" उपाधि। इन्हीं के शासन में तिलाड़ी कांड (1930) और श्रीदेव सुमन का बलिदान (1944)।</td></tr>
      <tr><td><b>मानवेंद्र शाह</b> (1946–1949)</td><td>अंतिम शासक; 1 अगस्त 1949 को विलय; बाद में टिहरी से कई बार लोकसभा सांसद।</td></tr>
    </tbody>
  </table>
  <div class="box-trap"><strong><span class="tag trap">सावधान</span></strong>टिहरी राज्य की "राजधानी" के प्रश्नों में <b>टिहरी (1815)</b> और <b>नरेंद्रनगर (1925)</b> मुख्य उत्तर हैं। प्रतापनगर व कीर्तिनगर राजाओं के बसाए नगर/आवास थे। टिहरी नगर की स्थापना-तिथि स्रोतों में <b>28, 29 या 30 दिसंबर 1815</b> मिलती है।</div>

  <h3>जन-असंतोष और विलय</h3>
  <ul>
    <li><b>ढंडक</b> — रियासत में अन्यायपूर्ण करों/बेगार के विरुद्ध पारंपरिक जन-विरोध (रवाईं, सकलाना आदि)।</li>
    <li><span class="tag exam">परीक्षा बिंदु</span> <b>तिलाड़ी कांड — 30 मई 1930:</b> वन-अधिकारों के लिए रवाईं के लोग <b>तिलाड़ी मैदान</b> (बड़कोट के पास, यमुना तट) में एकत्र थे; दीवान <b>चक्रधर जुयाल</b> के आदेश पर गोली चली — <b>"उत्तराखंड का जलियाँवाला बाग"</b> (स्थल आज उत्तरकाशी जिले में)।</li>
    <li><b>23 जनवरी 1939</b> — देहरादून में <b>टिहरी राज्य प्रजामंडल</b> की स्थापना।</li>
    <li><span class="tag exam">परीक्षा बिंदु</span> <b>श्रीदेव सुमन</b> — 3 मई 1944 से टिहरी जेल में आमरण अनशन; <b>84 दिन</b> बाद <b>25 जुलाई 1944</b> को बलिदान।</li>
    <li><b>1946–47 — सकलाना विद्रोह</b>; <b>1947–48</b> — कड़ाकोट, बडियारगढ़ आदि में आंदोलन।</li>
    <li><span class="tag exam">परीक्षा बिंदु</span> <b>कीर्तिनगर आंदोलन — जनवरी 1948:</b> 10 जनवरी को आंदोलनकारियों ने कीर्तिनगर पर अधिकार कर "आज़ाद पंचायत" घोषित की; <b>11 जनवरी 1948</b> को गोलीबारी में <b>नागेंद्र सकलानी</b> और <b>मोलू भरदारी</b> शहीद। इसके बाद टिहरी में प्रजामंडल की अंतरिम सरकार बनी।</li>
    <li><span class="tag exam">परीक्षा बिंदु</span> <b>1 अगस्त 1949</b> — टिहरी रियासत का <b>उत्तर प्रदेश में विलय</b>; टिहरी गढ़वाल जिला बना।</li>
    <li><b>24 फ़रवरी 1960</b> — <b>उत्तरकाशी</b> जिला टिहरी से अलग।</li>
    <li><b>1997</b> — टिहरी के पूर्वी भाग (पौड़ी व चमोली के भागों के साथ) से <b>रुद्रप्रयाग</b> जिला बना।</li>
  </ul>
</section>

<section id="samayrekha">
  <h2>प्रशासनिक समयरेखा</h2>
  <ol class="timeline">
    <li><span class="yr">1815</span><span class="ev">सुदर्शन शाह — टिहरी राजधानी (28 दिसंबर)।</span></li>
    <li><span class="yr">1925</span><span class="ev">राजधानी नरेंद्रनगर (नरेंद्र शाह)।</span></li>
    <li><span class="yr">1930</span><span class="ev">तिलाड़ी कांड (30 मई)।</span></li>
    <li><span class="yr">1939</span><span class="ev">टिहरी राज्य प्रजामंडल (23 जनवरी, देहरादून)।</span></li>
    <li><span class="yr">1944</span><span class="ev">श्रीदेव सुमन का बलिदान (25 जुलाई)।</span></li>
    <li><span class="yr">1948</span><span class="ev">कीर्तिनगर आंदोलन (11 जनवरी — सकलानी व भरदारी शहीद)।</span></li>
    <li><span class="yr">1949</span><span class="ev">उत्तर प्रदेश में विलय (1 अगस्त) — टिहरी गढ़वाल जिला।</span></li>
    <li><span class="yr">1960</span><span class="ev">उत्तरकाशी जिला अलग (24 फ़रवरी)।</span></li>
    <li><span class="yr">1997</span><span class="ev">रुद्रप्रयाग जिले के लिए भाग अलग।</span></li>
    <li><span class="yr">2005–06</span><span class="ev">पुराना टिहरी नगर बाँध झील में डूबा; मुख्यालय नई टिहरी।</span></li>
  </ol>
</section>

<section id="bhugol">
  <h2>भूगोल</h2>
  <div class="map-grid">
    <figure>
