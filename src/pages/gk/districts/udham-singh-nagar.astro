  published="2026-11-18" toc={toc} facts={facts} faq={faq} sources={sources}
>

<section id="naam">
  <h2>नाम की कहानी: शहीद ऊधम सिंह</h2>
  <ul>
    <li>जिले का नाम <b>शहीद ऊधम सिंह</b> (1899–1940) पर है, जिन्होंने जलियाँवाला बाग (13 अप्रैल 1919) का बदला लेने के लिए <b>13 मार्च 1940</b> को लंदन के कैक्सटन हॉल में <b>माइकल ओ'डायर</b> (तत्कालीन पंजाब का लेफ्टिनेंट गवर्नर) को गोली मारी; 31 जुलाई 1940 को फाँसी।</li>
    <li>ऊधम सिंह का इस क्षेत्र से कोई निजी संबंध नहीं था — 1947 के बाद तराई में बड़ी संख्या में बसे <b>पंजाबी (सिख) समुदाय</b> के कारण यह नाम चुना गया।</li>
    <li>मुख्यालय <b>रुद्रपुर</b> का नाम कुमाऊँ के चंद राजा <b>रुद्रचंद</b> के नाम पर; <b>बाजपुर</b> — राजा <b>बाज बहादुर चंद</b> के नाम पर; <b>काशीपुर</b> — सामंत <b>काशीनाथ अधिकारी</b> के नाम पर।</li>
  </ul>
  <div class="box-myth">
    <strong><span class="tag myth">जनश्रुति</span></strong>
    महाभारत के राजा <b>विराट</b> का राज्य इसी तराई में माना जाता है — पांडवों का अज्ञातवास यहीं बीता और भीम ने विराट के सेनापति <b>कीचक</b> का वध <b>किच्छा</b> के पास किया, इसलिए नाम "किच्छा"। यह परंपरा है, ऐतिहासिक प्रमाण नहीं।
  </div>
</section>

<section id="itihas">
  <h2>इतिहास — गोविषाण से चौरासी माल तक</h2>

  <h3>प्राचीन काल</h3>
  <ul>
    <li><span class="tag exam">परीक्षा बिंदु</span> चीनी यात्री <b>ह्वेनसांग</b> (7वीं सदी, हर्ष के समय) ने काशीपुर क्षेत्र को <b>"गोविषाण"</b> (गोविसाण) कहा। काशीपुर के पास <b>उज्जैन किला / द्रोण सागर</b> के टीले में प्राचीन अवशेष मिले हैं।</li>
    <li>गुप्त काल में तराई-भाबर कुमाऊँ राज्य का भाग; बाद में <b>कत्यूरी</b> प्रभाव। हर्ष के बाद राजनीतिक अस्थिरता व प्राकृतिक आपदाओं से लगभग 1100 ई. तक क्षेत्र उजाड़ हो गया।</li>
    <li>13वीं सदी से दिल्ली के सुल्तानों (नासिरुद्दीन, बलबन, बाद में फ़िरोज़ शाह) के आक्रमण। <b>आइन-ए-अकबरी</b> में तराई के 21 महलों का उल्लेख।</li>
  </ul>

  <h3>चंद राजा और तराई (16वीं–18वीं सदी)</h3>
  <table>
    <thead><tr><th>राजा / व्यक्ति</th><th>तराई से जुड़ा तथ्य</th></tr></thead>
    <tbody>
      <tr><td><b>रुद्रचंद</b> (अकबर के समकालीन)</td><td><span class="tag exam">परीक्षा बिंदु</span> नागौर अभियान में मुगलों का साथ देने पर <b>अकबर</b> ने तराई का भाग <b>"चौरासी माल"</b> दिया (84 कोस लंबा; 9 लाख रुपये वार्षिक आय के कारण <b>"नौलखिया माल"</b>)। रुद्रचंद ने <b>रुद्रपुर</b> बसाया (NIC: 1588 में सैन्य शिविर)।</td></tr>
      <tr><td><b>काशीनाथ अधिकारी</b></td><td>रुद्रचंद का सामंत — <b>काशीपुर</b> नगर बसाया (कुछ स्रोत 1718 ई. बताते हैं)।</td></tr>
      <tr><td><b>बाज बहादुर चंद</b></td><td>शाहजहाँ से समझौता कर चौरासी माल पर पुनः अधिकार; <b>बाजपुर</b> बसाया; <b>1678</b> में औरंगज़ेब से फ़रमान का नवीनीकरण।</td></tr>
      <tr><td><b>कल्याण चंद</b></td><td>रुहेला आक्रमण (1744–48); 1747 में मुगल सम्राट से चौरासी माल पर अधिकार की पुष्टि।</td></tr>
      <tr><td><b>दीपचंद / शिवदेव जोशी</b></td><td>शिवदेव जोशी की सलाह पर <b>रुद्रपुर व काशीपुर में किले</b>; शिवदेव जोशी की <b>1764</b> में काशीपुर में मृत्यु। इसके बाद रुहेलों का प्रभाव बढ़ा।</td></tr>
    </tbody>
  </table>
  <p>चौरासी माल के सात परगने: सहजगीर (जसपुर), कोटा (काशीपुर), मुडिया (बाजपुर), गदरपुर, भुक्सार (रुद्रपुर-किलपुरी), बक्शी (नानकमत्ता), चिंकि (सुबड़ना-बहेड़ी)।</p>

  <h3>ब्रिटिश काल</h3>
  <ul>
    <li><b>1815</b> के बाद अंग्रेजों का अधिकार; 1844 तक काशीपुर-जसपुर <b>मुरादाबाद जिले</b> के राजस्व प्रभाग; <b>अक्टूबर 1870</b> में पूरा काशीपुर परगना तराई में शामिल।</li>
    <li><span class="tag exam">परीक्षा बिंदु</span> <b>1864-65</b> — "तराई एंड भाबर गवर्नमेंट एक्ट" से तराई-भाबर सीधे ब्रिटिश क्राउन के अधीन (जिला NIC); कमिश्नर <b>हेनरी रैमज़े</b> के समय "तराई-भाबर स्टेट" कहलाया।</li>
    <li><b>1891</b> — नैनीताल अलग जिला बना और तराई-भाबर उसके डिप्टी कमिश्नर के अधीन; 1900 से "खाम सुपरिंटेंडेंट" का प्रबंध (1950 तक)।</li>
  </ul>
  <div class="box-trap"><strong><span class="tag trap">सावधान</span></strong>रुद्रपुर <b>रुद्रचंद</b> ने बसाया (रुद्रप्रयाग से न मिलाएँ); बाजपुर <b>बाज बहादुर चंद</b> ने; काशीपुर <b>काशीनाथ अधिकारी</b> ने — "काशी विश्वनाथ" से नहीं। उत्तरकाशी का संबंध काशी (वाराणसी) से है, काशीपुर का नहीं।</div>
</section>

<section id="samayrekha">
  <h2>प्रशासनिक समयरेखा</h2>
  <ol class="timeline">
    <li><span class="yr">7वीं सदी</span><span class="ev">ह्वेनसांग — "गोविषाण" (काशीपुर)।</span></li>
    <li><span class="yr">16वीं सदी</span><span class="ev">अकबर ने रुद्रचंद को चौरासी माल दिया; रुद्रपुर (1588) बसा।</span></li>
    <li><span class="yr">1678</span><span class="ev">बाज बहादुर चंद को औरंगज़ेब का फ़रमान।</span></li>
    <li><span class="yr">1864-65</span><span class="ev">तराई-भाबर सीधे क्राउन के अधीन।</span></li>
    <li><span class="yr">1891</span><span class="ev">नैनीताल जिला बना; तराई उसके अधीन।</span></li>
    <li><span class="yr">1947–50</span><span class="ev">विभाजन के बाद शरणार्थियों का पुनर्वास; जंगल साफ़ कर बस्तियाँ।</span></li>
    <li><span class="yr">1960</span><span class="ev">पंतनगर कृषि विश्वविद्यालय (17 नवंबर)।</span></li>
    <li><span class="yr">1994</span><span class="ev">खटीमा गोलीकांड (1 सितंबर)।</span></li>
    <li><span class="yr">1995</span><span class="ev">ऊधम सिंह नगर जिला बना (सितंबर)।</span></li>
    <li><span class="yr">2000</span><span class="ev">उत्तराखंड का भाग (9 नवंबर)।</span></li>
  </ol>
