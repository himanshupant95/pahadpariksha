---
import District from '../../../layouts/District.astro';
import Quiz from '../../../components/Quiz.astro';
import questions from '../../../data/quizzes/chamoli.json';

const toc = [
  { id: 'at-a-glance', label: 'एक नज़र में' },
  { id: 'naam', label: 'नाम की कहानी' },
  { id: 'itihas', label: 'इतिहास (चाँदपुरगढ़ी से जिले तक)' },
  { id: 'samayrekha', label: 'प्रशासनिक समयरेखा' },
  { id: 'bhugol', label: 'भूगोल, नदियाँ व प्रयाग' },
  { id: 'nandadevi', label: 'नंदा देवी, फूलों की घाटी व राजजात' },
  { id: 'prashasan', label: 'प्रशासन व गैरसैंण' },
  { id: 'janankiki', label: 'जनसांख्यिकी' },
  { id: 'samaj', label: 'समाज, बोली व परंपराएँ' },
  { id: 'mele', label: 'मेले व त्योहार' },
  { id: 'sthal', label: 'धार्मिक, ऐतिहासिक व पर्यटन स्थल' },
  { id: 'sansthan', label: 'संस्थान व परियोजनाएँ' },
  { id: 'andolan', label: 'चिपको आंदोलन' },
  { id: 'aapda', label: 'आपदाएँ: 1803 से जोशीमठ तक' },
  { id: 'vyaktitva', label: 'प्रमुख व्यक्तित्व' },
  { id: 'arthvyavastha', label: 'अर्थव्यवस्था' },
  { id: 'jalvidyut', label: 'जलविद्युत, बाँध व प्रमुख परियोजनाएँ' },
  { id: 'pariksha', label: 'परीक्षा बिंदु (One-liners)' },
  { id: 'quiz', label: 'क्विज़ (15 प्रश्न)' },
  { id: 'faq', label: 'FAQ' },
];

const facts = [
  { k: 'मंडल', v: 'गढ़वाल' },
  { k: 'जिला मुख्यालय', v: '<b>गोपेश्वर</b> (चमोली नगर अलकनंदा तट पर अलग है)' },
  { k: 'गठन', v: '<b>24 फ़रवरी 1960</b> — पौड़ी गढ़वाल की चमोली तहसील से' },
  { k: 'क्षेत्रफल', v: 'जनगणना 2011 में 8,030 वर्ग किमी (राज्य में सबसे अधिक; उत्तरकाशी 8,016)' },
  { k: 'जनसंख्या (2011)', v: '3,91,605 — राज्य में नौवाँ' },
  { k: 'लिंगानुपात (2011)', v: '1019' },
  { k: 'दशकीय वृद्धि (2001–11)', v: '5.74%' },
  { k: 'साक्षरता (2011)', v: '82.65% (पुरुष 93.40%, महिला 72.32%)' },
  { k: 'जनघनत्व (2011)', v: 'लगभग 49 व्यक्ति/वर्ग किमी' },
  { k: 'विकासखंड', v: '9' },
  { k: 'विधानसभा सीटें', v: '3' },
  { k: 'प्रमुख नदियाँ', v: 'अलकनंदा, धौलीगंगा, ऋषिगंगा, नंदाकिनी, पिंडर, बिरही, विष्णुगंगा' },
  { k: 'पड़ोसी', v: 'तिब्बत (चीन); उत्तरकाशी, रुद्रप्रयाग, पौड़ी, अल्मोड़ा, बागेश्वर, पिथौरागढ़' },
  { k: 'वाहन कोड', v: 'UK-11' },
];

const faq = [
  { q: 'चमोली जिला कब बना?', a: '24 फ़रवरी 1960 को पौड़ी गढ़वाल जिले की चमोली तहसील को जिला बनाया गया — उसी दिन चीन से लगी सीमा की सुरक्षा के लिए पिथौरागढ़ और उत्तरकाशी जिले भी बने। 1997 में इसकी दो तहसीलें व दो विकासखंडों के भाग नए रुद्रप्रयाग जिले में गए।' },
  { q: 'गैरसैंण ग्रीष्मकालीन राजधानी कब बनी?', a: 'मुख्यमंत्री त्रिवेंद्र सिंह रावत ने 4 मार्च 2020 को विधानसभा (बजट सत्र) में घोषणा की; राज्यपाल की स्वीकृति के बाद 8 जून 2020 को अधिसूचना जारी हुई — भराड़ीसैंण (गैरसैंण), जिला चमोली ग्रीष्मकालीन राजधानी घोषित। विधानसभा भवन दूधातोली क्षेत्र के भराड़ीसैंण में है।' },
  { q: 'चिपको आंदोलन की नायिका गौरा देवी ने पेड़ कहाँ बचाए?', a: '26 मार्च 1974 को रैणी गाँव (जोशीमठ क्षेत्र, ऋषिगंगा घाटी) में गौरा देवी के नेतृत्व में गाँव की महिलाओं ने पेड़ों से चिपककर ठेकेदार के मज़दूरों को कटान से रोका। इससे पहले अप्रैल 1973 में मंडल गाँव (गोपेश्वर के पास) में चंडी प्रसाद भट्ट के दशोली ग्राम स्वराज्य मंडल के नेतृत्व में पहला चिपको हुआ।' },
  { q: 'फूलों की घाटी की खोज किसने की?', a: '1931 में कामेट अभियान से लौटते ब्रिटिश पर्वतारोही फ्रैंक स्माइथ भ्यूंडार घाटी पहुँचे और बाद में "The Valley of Flowers" पुस्तक लिखी। 1982 में यह राष्ट्रीय उद्यान बनी और 2005 में नंदा देवी राष्ट्रीय उद्यान (UNESCO, 1988) के साथ विश्व धरोहर स्थल में जोड़ी गई।' },
  { q: 'नंदा देवी राजजात कहाँ से कहाँ तक होती है?', a: 'लगभग हर 12 वर्ष में नौटी गाँव (कर्णप्रयाग के पास) से होमकुंड तक लगभग 280 किमी की पैदल यात्रा, जिसकी अगुवाई चार सींग वाला मेढ़ा (चौसिंग्या खाडू) करता है। पिछली राजजात 2014 में हुई; अगली 2026 में होनी थी, पर राजजात समिति ने जनवरी 2026 में इसे 2027 तक टालने की घोषणा की।' },
];

const sources = [
  { label: 'PIB — पर्वतमाला: केदारनाथ व हेमकुंड साहिब रोपवे (10 मार्च 2025)', url: 'https://static.pib.gov.in/WriteReadData/specificdocs/documents/2025/mar/doc2025311518501.pdf' },
  { label: 'Power Peak Digest — तपोवन-विष्णुगाड HRT ब्रेकथ्रू (जुलाई 2026)', url: 'https://powerpeakdigest.com/ntpc-hrt-breakthrough-tapovan-vishnugad-hydro/' },
  { label: 'जिला प्रशासन चमोली (chamoli.nic.in) — इतिहास', url: 'https://chamoli.nic.in/history/' },
  { label: 'भारत की जनगणना 2011 — उत्तराखंड के जिलों के आँकड़े', url: 'https://census2011.co.in/census/state/districtlist/uttarakhand.html' },
  { label: 'उत्तराखंड विधानसभा — भराड़ीसैंण (गैरसैंण) ग्रीष्मकालीन राजधानी (4 मार्च 2020)', url: 'https://ukvidhansabha.uk.gov.in/?p=345' },
  { label: 'UNESCO — Nanda Devi and Valley of Flowers National Parks (1988, 2005)', url: 'https://whc.unesco.org/en/list/335/' },
  { label: 'Wikipedia — Chamoli district; Chipko movement; Valley of Flowers National Park; Nanda Devi Raj Jat', url: 'https://en.wikipedia.org/wiki/Chamoli_district' },
  { label: 'मानचित्र: Wikimedia Commons (Chamoli district.svg — GDibyendu, Public domain); OpenStreetMap contributors', url: 'https://commons.wikimedia.org/wiki/File:Chamoli_district.svg' },
  { label: 'मुख्य चित्र: Badrinath Temple — Harshit SR, CC BY-SA 4.0', url: 'https://commons.wikimedia.org/wiki/File:Badrinath_Temple.jpg' },
];

const img = (w: number) => `https://thumb.wikimedia.org/wikipedia/commons/thumb/1/1a/Badrinath_Temple.jpg/${w}px-Badrinath_Temple.jpg`;
---
<District
  name="चमोली" nameEn="Chamoli" slug="chamoli" division="गढ़वाल"
  title="चमोली जिला: बद्रीनाथ, फूलों की घाटी, नंदा देवी, चिपको, गैरसैंण, पंच प्रयाग व परीक्षा बिंदु"
  description="चमोली जिले का संपूर्ण सामान्य ज्ञान — 24 फ़रवरी 1960 गठन, चाँदपुरगढ़ी व परमार वंश, बद्रीनाथ व पंच बद्री, विष्णु-नंद-कर्णप्रयाग, नंदा देवी व फूलों की घाटी (UNESCO), नंदा राजजात, रैणी चिपको (1974), गैरसैंण ग्रीष्मकालीन राजधानी (2020), जोशीमठ से ज्योतिर्मठ, ऋषिगंगा आपदा और 15 प्रश्नों का क्विज़।"
  image={img(1280)}
  heroSrcset={`${img(960)} 960w, ${img(1280)} 1280w`}
  imageAlt="रंग-बिरंगे अग्रभाग वाला बद्रीनाथ मंदिर और पीछे पहाड़"
  heroCredit={{ text: 'बद्रीनाथ मंदिर — Harshit SR, CC BY-SA 4.0, Wikimedia Commons', url: 'https://commons.wikimedia.org/wiki/File:Badrinath_Temple.jpg' }}
  published="2026-11-18" toc={toc} facts={facts} faq={faq} sources={sources}
>

<section id="naam">
  <h2>नाम की कहानी: "चंद्रमौली"</h2>
  <ul>
    <li>चमोली नाम <b>"चंद्रमौली"</b> (मस्तक पर चंद्रमा धारण करने वाले शिव) से माना जाता है।</li>
    <li>जिले का नाम <b>चमोली नगर</b> (अलकनंदा तट, बद्रीनाथ मार्ग) पर है, पर मुख्यालय ऊपर पहाड़ी पर बसा <b>गोपेश्वर</b> है।</li>
    <li>जिले को <b>"देवभूमि का मुकुट"</b> भी कहा जाता है — बद्रीनाथ, हेमकुंड, पंच बद्री और दो पंच केदार यहीं हैं।</li>
  </ul>
  <div class="box-trap"><strong><span class="tag trap">सावधान</span></strong>मुख्यालय-प्रश्न में उत्तर <b>गोपेश्वर</b> है, "चमोली" नहीं। इसी तरह टिहरी गढ़वाल का मुख्यालय नई टिहरी और पौड़ी गढ़वाल का पौड़ी है।</div>
</section>

<section id="itihas">
  <h2>इतिहास — चाँदपुरगढ़ी से जिले तक</h2>
  <ul>
    <li><b>अभिलेख:</b> <b>पांडुकेश्वर</b> के ताम्रपत्र (कत्यूरी शासक ललितशूर देव आदि), <b>गोपेश्वर</b> के गोपीनाथ मंदिर का त्रिशूल (नेपाल के राजा <b>अशोकचल्ल</b> की विजय का 13वीं सदी का लेख, साथ में पुराने ब्राह्मी अक्षर), <b>सिरोली</b> और <b>चाँदपुरगढ़ी</b> के लेख।</li>
    <li><b>जोशीमठ (ज्योतिर्मठ)</b> — कत्यूरियों की प्रारंभिक राजधानी (कार्तिकेयपुर) से जोड़ा जाता है; <b>आदि शंकराचार्य</b> ने यहाँ उत्तर का <b>ज्योतिर्मठ</b> (चार मठों में एक) स्थापित किया।</li>
    <li><span class="tag exam">परीक्षा बिंदु</span> <b>चाँदपुरगढ़ी</b> (आदिबद्री के पास) — परंपरा के अनुसार यहीं के राजा <b>भानुप्रताप</b> ने अपनी पुत्री का विवाह <b>कनकपाल</b> से किया; यहीं से गढ़वाल के <b>पंवार (परमार) वंश</b> की शुरुआत (परंपरागत तिथि 888 ई.)। बाद में <b>अजयपाल</b> ने राजधानी देवलगढ़ और फिर श्रीनगर ले जाई।</li>
    <li><b>1803</b> — भीषण भूकंप (8 सितंबर); उसी वर्ष गोरखा आक्रमण। <b>1815</b> के बाद यह क्षेत्र <b>ब्रिटिश गढ़वाल</b> (पौड़ी) का भाग।</li>
    <li><b>24 फ़रवरी 1960</b> — चमोली तहसील जिला बनी (1962 के युद्ध से पहले, चीन सीमा की सुरक्षा के लिए उत्तरकाशी व पिथौरागढ़ के साथ)।</li>
    <li><b>1997</b> — दो तहसीलें व दो विकासखंडों के भाग <b>रुद्रप्रयाग</b> जिले में गए।</li>
  </ul>
  <p>विस्तार के लिए देखें: <a href="/history/parmar-dynasty/">गढ़वाल का परमार (पंवार) वंश</a>।</p>
</section>

<section id="samayrekha">
  <h2>प्रशासनिक समयरेखा</h2>
  <ol class="timeline">
    <li><span class="yr">888 (परंपरा)</span><span class="ev">कनकपाल — चाँदपुरगढ़ी से पंवार वंश।</span></li>
    <li><span class="yr">1803</span><span class="ev">गढ़वाल में भीषण भूकंप (8 सितंबर); गोरखा आक्रमण।</span></li>
    <li><span class="yr">1815</span><span class="ev">ब्रिटिश गढ़वाल का भाग।</span></li>
    <li><span class="yr">1960</span><span class="ev">चमोली जिला बना (24 फ़रवरी)।</span></li>
    <li><span class="yr">1974</span><span class="ev">रैणी चिपको (26 मार्च)।</span></li>
    <li><span class="yr">1982</span><span class="ev">फूलों की घाटी व नंदा देवी राष्ट्रीय उद्यान।</span></li>
    <li><span class="yr">1988</span><span class="ev">नंदा देवी राष्ट्रीय उद्यान — UNESCO विश्व धरोहर।</span></li>
    <li><span class="yr">1997</span><span class="ev">रुद्रप्रयाग जिले के लिए भाग अलग।</span></li>
    <li><span class="yr">2005</span><span class="ev">फूलों की घाटी विश्व धरोहर में जोड़ी गई।</span></li>
    <li><span class="yr">2020</span><span class="ev">भराड़ीसैंण (गैरसैंण) ग्रीष्मकालीन राजधानी (घोषणा 4 मार्च, अधिसूचना 8 जून)।</span></li>
    <li><span class="yr">2021</span><span class="ev">ऋषिगंगा-धौलीगंगा आपदा (7 फ़रवरी)।</span></li>
    <li><span class="yr">2023</span><span class="ev">जोशीमठ भू-धँसाव संकट (जनवरी)।</span></li>
    <li><span class="yr">2024</span><span class="ev">जोशीमठ तहसील का नाम ज्योतिर्मठ (केंद्र की स्वीकृति)।</span></li>
  </ol>
</section>

<section id="bhugol">
  <h2>भूगोल</h2>
  <div class="map-grid">
    <figure>
      <img src="https://upload.wikimedia.org/wikipedia/commons/f/f3/Chamoli_district.svg" alt="उत्तराखंड के मानचित्र में चमोली जिले की स्थिति (लाल रंग में)" width="1250" height="1125" loading="lazy" referrerpolicy="no-referrer" />
      <figcaption>उत्तराखंड में चमोली जिले की स्थिति (लाल) — ★ जिला मुख्यालय। स्रोत: <a href="https://commons.wikimedia.org/wiki/File:Chamoli_district.svg" target="_blank" rel="noopener nofollow">GDibyendu, Wikimedia Commons</a> (Public domain)</figcaption>
    </figure>
    <figure>
      <iframe title="चमोली जिले का मानचित्र (OpenStreetMap)" loading="lazy" src="https://www.openstreetmap.org/export/embed.html?bbox=78.90%2C29.90%2C80.15%2C31.10&amp;layer=mapnik"></iframe>
      <figcaption>इंटरैक्टिव मानचित्र — गोपेश्वर, जोशीमठ, बद्रीनाथ, माणा, औली, कर्णप्रयाग, गैरसैंण, थराली देखें। © <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener nofollow">OpenStreetMap contributors</a> · <a href="https://www.openstreetmap.org/#map=9/30.45/79.50" target="_blank" rel="noopener nofollow">बड़ा मानचित्र खोलें</a></figcaption>
    </figure>
  </div>
  <ul>
    <li><b>सीमाएँ:</b> उत्तर में <b>तिब्बत (चीन)</b> — <b>माणा दर्रा</b> व <b>नीति दर्रा</b>; पूर्व में पिथौरागढ़-बागेश्वर; दक्षिण में अल्मोड़ा-पौड़ी; पश्चिम में रुद्रप्रयाग-उत्तरकाशी।</li>
    <li><b>शिखर:</b> <b>नंदा देवी (7,816 मी.)</b> — भारत में पूर्णतः स्थित सबसे ऊँची चोटी (कंचनजंगा सीमा पर है); <b>कामेट (7,756 मी.)</b>, त्रिशूल, द्रोणागिरि, नीलकंठ, चौखंबा (रुद्रप्रयाग-उत्तरकाशी सीमा क्षेत्र)।</li>
    <li><b>बुग्याल:</b> औली, बेदनी, आली, रुद्रनाथ के बुग्याल; <b>रूपकुंड</b> (कंकाल झील) — बेदनी के ऊपर।</li>
  </ul>

  <h3>नदियाँ व प्रयाग</h3>
  <table>
    <thead><tr><th>नदी / प्रयाग</th><th>मुख्य तथ्य</th></tr></thead>
    <tbody>
      <tr><td><b>अलकनंदा</b></td><td>सतोपंथ व भागीरथ खरक ग्लेशियर (बद्रीनाथ के ऊपर) से; माणा के पास <b>सरस्वती</b> मिलती है (केशव प्रयाग)।</td></tr>
      <tr><td><b>विष्णुप्रयाग</b></td><td>अलकनंदा + <b>धौलीगंगा</b> (जोशीमठ के पास)।</td></tr>
      <tr><td><b>नंदप्रयाग</b></td><td>अलकनंदा + <b>नंदाकिनी</b>।</td></tr>
      <tr><td><b>कर्णप्रयाग</b></td><td>अलकनंदा + <b>पिंडर</b> (पिंडारी ग्लेशियर, बागेश्वर से)।</td></tr>
