      <tr><td><b>टोंस</b></td><td>यमुना</td><td>यमुना की सबसे बड़ी सहायक; हिमाचल से सीमा बनाती है; <b>कालसी के पास यमुना से संगम</b>। हनोल (महासू मंदिर) इसके तट पर।</td></tr>
      <tr><td><b>आसन</b></td><td>यमुना</td><td>पश्चिमी दून की धाराओं से बनती है; ऊपरी भाग को स्थानीय रूप से "टोंस" भी कहते हैं (मुख्य टोंस से अलग!)। <b>आसन बैराज (1967)</b>, आसन-यमुना संगम पर रामसर स्थल। कुछ विद्वान इसकी पहचान ऋग्वेद की "अश्मन्वती" से करते हैं।</td></tr>
      <tr><td><b>सौंग</b></td><td>गंगा</td><td>मध्य व पूर्वी दून को सिंचित करती है; सहस्रधारा (बाल्दी), सुसवा आदि इसमें मिलती हैं।</td></tr>
      <tr><td><b>सुसवा</b></td><td>गंगा</td><td>शिवालिक से निकलकर पूर्वी दून बहाती है; रिस्पना, बिंदाल जैसी धाराएँ इसमें; डोईवाला के दक्षिण-पूर्व सौंग से मिलती है।</td></tr>
      <tr><td><b>रिस्पना व बिंदाल</b></td><td>गंगा</td><td>देहरादून नगर की दो प्रमुख धाराएँ (राव); रिस्पना का पौराणिक नाम "ऋषिपर्णा" बताया जाता है।</td></tr>
      <tr><td><b>गंगा</b></td><td>गंगा</td><td>ऋषिकेश के पास जिले के पूर्वी छोर पर; चंद्रभागा यहाँ गंगा से मिलती है।</td></tr>
    </tbody>
