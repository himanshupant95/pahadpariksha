---
import Base from '../../layouts/Base.astro';
import { DISTRICTS, districtHref } from '../../data/districts';
import { TOTAL as PYQ_TOTAL } from '../../data/pyq';

const quizCount = Object.keys(import.meta.glob('../../data/quizzes/*.json')).length;

const subjects = [
  {
    href: '/history/', icon: '🏯', t: 'इतिहास', tone: 'amber',
    d: 'पाषाण युग से टिहरी के विलय और राज्य निर्माण तक',
    ch: [
      ['/history/prehistoric-uttarakhand/', 'प्रागैतिहासिक काल'], ['/history/ancient-uttarakhand/', 'प्राचीन उत्तराखंड'],
      ['/history/kartikeyapur-katyuri/', 'कत्यूरी राजवंश'], ['/history/chand-dynasty/', 'चंद राजवंश'],
      ['/history/parmar-dynasty/', 'परमार (पंवार) राजवंश'], ['/history/gorkha-rule/', 'गोरखा शासन'],
      ['/history/british-rule/', 'ब्रिटिश काल'], ['/history/freedom-struggle/', 'स्वतंत्रता संग्राम'],
      ['/history/statehood-movement/', 'राज्य आंदोलन'],
    ],
  },
  {
    href: '/geography/', icon: '🏔️', t: 'भूगोल', tone: 'teal',
    d: 'अपने मानचित्रों, एटलस और क्विज़ के साथ',
    ch: [
      ['/geography/location-extent-boundaries/', 'स्थिति और विस्तार'], ['/geography/himalaya-formation-geology/', 'हिमालय का निर्माण'],
      ['/geography/physiographic-divisions/', 'भौतिक विभाजन'], ['/geography/rivers-drainage/', 'नदियाँ और अपवाह'],
      ['/geography/glaciers/', 'हिमनद'], ['/geography/climate/', 'जलवायु'],
      ['/geography/soils-vegetation/', 'मृदा और वनस्पति'], ['/geography/biodiversity-protected-areas/', 'जैव विविधता, संरक्षित क्षेत्र'],
    ],
  },
  {
    href: '/polity/', icon: '🏛️', t: 'राजव्यवस्था', tone: 'indigo',
    d: 'राज्य गठन से विधानसभा, उच्च न्यायालय, पंचायत और UCC तक',
    ch: [
      ['/polity/', 'राजव्यवस्था: पूरा अध्याय'], ['/polity/state-formation-constitutional-process/', 'राज्य गठन की संवैधानिक प्रक्रिया'],
      ['/polity/political-evolution/', 'राजनीतिक विकास'],
    ],
  },
];

const special = [
  { href: '/gk/uttarakhand-sanskriti-janjatiyan/', icon: '🪔', t: 'जनजातियाँ और लोक-संस्कृति', d: '5 जनजातियाँ, मेले, पर्व, लोक नृत्य, लोक-देवता, ऐपण, सभी 27 GI उत्पाद' },
  { href: '/gk/uttarakhand-tulnatmak-talikayen/', icon: '📊', t: 'ज़िलों की तुलना और रैंक', d: 'जनगणना 2011 व वन आवरण की तालिकाएँ, क्रम वाले प्रश्नों की ट्रिक' },
  { href: '/gk/uttarakhand-yojanayen/', icon: '📜', t: 'सरकारी योजनाएँ (2000–2026)', d: 'कब, किसने, किसके लिए, कितना लाभ; फ़िल्टर और समयरेखा' },
  { href: '/gk/uttarakhand-rivers/', icon: '🌊', t: 'प्रमुख नदियाँ', d: 'उद्गम, संगम और पंच प्रयाग एक नज़र में' },
  { href: '/gk/uttarakhand-districts/', icon: '🗂️', t: '13 ज़िले: एक तालिका', d: 'मंडल, मुख्यालय, सीमाएँ, गठन वर्ष' },
  { href: '/gk/uttarakhand-maps/', icon: '🗺️', t: 'मानचित्र (HD व PDF)', d: 'राजनीतिक और भौतिक मानचित्र, मुफ़्त डाउनलोड' },
];

const updates = [
  { href: '/gk/uttarakhand-varsh-2025-26/', icon: '📅', t: 'उत्तराखंड वर्ष 2025–26', d: 'आर्थिक सर्वेक्षण, बजट, सूचकांक, नए कानून, कुंभ 2027' },
  { href: '/gk/uttarakhand-pariksha-tathya/', icon: '📌', t: '2025–26 के परीक्षा-तथ्य', d: 'हाल के पेपरों में आए नए तथ्य, स्रोत सहित' },
  { href: '/current-affairs/', icon: '📰', t: 'रोज़ के करेंट अफेयर्स', d: 'हर दिन उत्तराखंड के परीक्षा-उपयोगी बिंदु और क्विज़' },
];

const practice = [
  { href: '/pyq/', icon: '📝', t: 'पिछले वर्षों के प्रश्न', d: `UKPSC 2025–26 के ${PYQ_TOTAL} उत्तराखंड प्रश्न, आधिकारिक उत्तर कुंजी से` },
  { href: '/quiz/', icon: '✅', t: 'अभ्यास क्विज़', d: `${quizCount} विषयवार क्विज़, हर अध्याय के अंत में भी` },
  { href: '/tools/nali-calculator/', icon: '📐', t: 'नाली कैलकुलेटर', d: 'नाली, मुट्ठी, बीसी, बीघा को एकड़, हेक्टेयर में बदलें' },
];

const garhwal = DISTRICTS.filter((d) => d.division === 'गढ़वाल');
const kumaon = DISTRICTS.filter((d) => d.division === 'कुमाऊँ');
const stats = [
  ['13', 'ज़िलों के पूरे पेज'], ['20', 'अध्याय (इतिहास, भूगोल, राजव्यवस्था)'], [String(PYQ_TOTAL), 'पिछले वर्षों के प्रश्न'], [String(quizCount), 'क्विज़'],
];
const jump = [['#mukhya', 'मुख्य विषय'], ['#zile', 'ज़िले'], ['#vishesh', 'विशेष विषय'], ['#update', 'ताज़ा अपडेट'], ['#abhyas', 'अभ्यास']];
---
<Base title="उत्तराखंड सामान्य ज्ञान (Uttarakhand GK) हिंदी में" description="UKSSSC और UKPSC के लिए उत्तराखंड सामान्य ज्ञान: इतिहास, भूगोल, राजव्यवस्था, 13 ज़िले, संस्कृति, योजनाएँ, करेंट अपडेट और पिछले वर्षों के प्रश्न। अध्याय-वार नोट्स और क्विज़।">
  <section class="hero">
    <h1>उत्तराखंड सामान्य ज्ञान</h1>
    <p>UKSSSC और UKPSC की लगभग हर परीक्षा में उत्तराखंड से अच्छी संख्या में प्रश्न आते हैं। यहाँ सब कुछ विषय के हिसाब से एक जगह है: पहले मुख्य विषय पढ़ें, फिर ज़िले, और अंत में पिछले वर्षों के प्रश्नों से अभ्यास करें।</p>
    <div class="stats">{stats.map(([n, l]) => <div><b>{n}</b><span>{l}</span></div>)}</div>
  </section>

  <nav class="jump" aria-label="इस पेज पर">{jump.map(([h, l]) => <a href={h}>{l}</a>)}</nav>

  <h2 id="mukhya" class="sec">📚 मुख्य विषय</h2>
  <div class="subjects">
    {subjects.map((s) => (
      <div class={`subject ${s.tone}`}>
        <a class="subject-head" href={s.href}>
          <span class="ic">{s.icon}</span>
          <span><b>{s.t}</b><small>{s.d}</small></span>
        </a>
        <ol>{s.ch.map(([h, l]) => <li><a href={h}>{l}</a></li>)}</ol>
        <a class="more" href={s.href}>पूरा विषय देखें →</a>
      </div>
    ))}
  </div>

  <h2 id="zile" class="sec">🏞️ देवभूमि दर्पण: 13 ज़िले, 13 कहानियाँ</h2>
  <p class="lead">हर ज़िले का पूरा परीक्षा-दर्पण: इतिहास, भूगोल, मेले, संस्थान, ट्रिक प्रश्न और क्विज़। <a href="/gk/districts/">पूरी शृंखला →</a></p>
  <div class="divisions">
    {[['गढ़वाल मंडल', garhwal], ['कुमाऊँ मंडल', kumaon]].map(([name, list]) => (
      <div class="division">
        <h3>{name as string} <small>({(list as typeof DISTRICTS).length} ज़िले)</small></h3>
        <ul>
          {(list as typeof DISTRICTS).map((d) => (
            <li><a href={districtHref(d)}><span class="part">{d.part}</span><span class="dn"><b>{d.name}</b><small>{d.hook}</small></span></a></li>
          ))}
        </ul>
      </div>
    ))}
  </div>

  <h2 id="vishesh" class="sec">⭐ विशेष विषय</h2>
  <div class="tiles">{special.map((x) => <a class="tile" href={x.href}><span class="ic">{x.icon}</span><span><b>{x.t}</b><small>{x.d}</small></span></a>)}</div>

  <h2 id="update" class="sec">🆕 ताज़ा अपडेट</h2>
  <div class="tiles">{updates.map((x) => <a class="tile hot" href={x.href}><span class="ic">{x.icon}</span><span><b>{x.t}</b><small>{x.d}</small></span></a>)}</div>

  <h2 id="abhyas" class="sec">🎯 अभ्यास और औज़ार</h2>
  <div class="tiles">{practice.map((x) => <a class="tile" href={x.href}><span class="ic">{x.icon}</span><span><b>{x.t}</b><small>{x.d}</small></span></a>)}</div>
</Base>

<style>
  .hero { background: linear-gradient(135deg, #14532d, #166534 55%, #0f766e); color: #ecfdf5; border-radius: 18px; padding: 26px 24px 20px; margin: 8px 0 14px; }
  .hero h1 { color: #fff; margin: 0 0 8px; }
  .hero p { margin: 0 0 16px; max-width: 760px; color: #d1fae5; }
  .stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; }
  .stats div { background: rgba(255,255,255,.1); border: 1px solid rgba(255,255,255,.18); border-radius: 12px; padding: 10px 12px; }
  .stats b { display: block; font-size: 1.5rem; color: #fff; line-height: 1.1; }
  .stats span { font-size: .82rem; color: #d1fae5; }

  .jump { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 6px; padding: 4px 0; }
  .jump a { background: #fff; border: 1px solid var(--line); border-radius: 999px; padding: 4px 14px; text-decoration: none; color: var(--green); font-size: .92rem; }
  .jump a:hover { border-color: var(--green-2); background: var(--green-soft); }

  h2.sec { margin: 28px 0 12px; padding-bottom: 6px; border-bottom: 2px solid var(--green-soft); scroll-margin-top: 60px; }
  .lead { margin: -4px 0 12px; color: var(--muted); }

  .subjects { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
  .subject { background: #fff; border: 1px solid var(--line); border-radius: 16px; overflow: hidden; display: flex; flex-direction: column; }
  .subject-head { display: flex; gap: 12px; align-items: center; padding: 14px 16px; text-decoration: none; color: inherit; }
  .subject-head .ic { font-size: 1.9rem; }
  .subject-head b { display: block; font-size: 1.2rem; }
  .subject-head small { color: var(--muted); font-size: .85rem; }
  .subject.amber .subject-head { background: #fffbeb; } .subject.amber b { color: #92400e; }
  .subject.teal .subject-head { background: #f0fdfa; } .subject.teal b { color: #115e59; }
  .subject.indigo .subject-head { background: #eef2ff; } .subject.indigo b { color: #3730a3; }
  .subject ol { margin: 8px 0 4px; padding: 0 16px 0 2.2em; flex: 1; }
  .subject ol li { margin: 3px 0; font-size: .95rem; }
  .subject ol a { text-decoration: none; color: var(--ink); }
  .subject ol a:hover { color: var(--green-2); text-decoration: underline; }
  .subject .more { padding: 8px 16px 12px; font-size: .9rem; font-weight: 600; text-decoration: none; color: var(--green-2); }

  .divisions { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .division { background: #fff; border: 1px solid var(--line); border-radius: 16px; padding: 12px 14px; }
  .division h3 { margin: 2px 0 8px; color: var(--green); font-size: 1.05rem; }
  .division h3 small { color: var(--muted); font-weight: 400; }
  .division ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 2px 8px; }
  .division li a { display: flex; gap: 10px; align-items: flex-start; padding: 7px 6px; border-radius: 10px; text-decoration: none; color: inherit; }
  .division li a:hover { background: var(--green-soft); }
  .part { flex: none; width: 26px; height: 26px; border-radius: 50%; background: var(--green); color: #fff; font-size: .8rem; display: grid; place-items: center; margin-top: 2px; }
  .dn b { display: block; color: var(--ink); }
  .dn small { color: var(--muted); font-size: .84rem; display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden; }

  .tiles { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 12px; }
  .tile { display: flex; gap: 12px; align-items: flex-start; background: #fff; border: 1px solid var(--line); border-radius: 14px; padding: 14px; text-decoration: none; color: inherit; transition: transform .15s, border-color .15s, box-shadow .15s; }
  .tile:hover, .subject:hover, .division:hover { border-color: var(--green-2); }
  .tile:hover { transform: translateY(-2px); box-shadow: 0 6px 18px rgba(20,83,45,.08); }
  .tile .ic { font-size: 1.6rem; line-height: 1; }
  .tile b { display: block; color: var(--green); margin-bottom: 2px; }
  .tile small { color: var(--muted); font-size: .88rem; }
  .tile.hot { background: linear-gradient(180deg, #fff, #fff7ed); border-color: #fed7aa; }
  .tile.hot b { color: #9a3412; }

  @media (max-width: 860px) {
    .subjects { grid-template-columns: 1fr; }
    .divisions { grid-template-columns: 1fr; }
    .subject ol { columns: 2; column-gap: 24px; }
    .stats { grid-template-columns: repeat(2, 1fr); }
  }
</style>
