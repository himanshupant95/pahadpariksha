---
import Base from '../../layouts/Base.astro';
import Quiz from '../../components/Quiz.astro';
import '../../styles/longform.css';
import questions from '../../data/quizzes/uttarakhand-yojanayen.json';
import { SCHEMES, SECTORS, STATUS, ERAS, sorted, type Sector } from '../../data/schemes';

const list = sorted();
const progs = list.filter((s) => s.sector !== 'law');
const laws = list.filter((s) => s.sector === 'law');
const count = (k: Sector) => list.filter((s) => s.sector === k).length;
const url = 'https://pahadpariksha.in/gk/uttarakhand-yojanayen/';
const updated = '20 नवंबर 2026';

const faq = [
  { q: 'उत्तराखंड की पहली स्वरोजगार योजना कौन-सी है?', a: 'वीर चंद्र सिंह गढ़वाली पर्यटन स्वरोजगार योजना — 1 जून 2002 को पर्यटन क्षेत्र में स्वरोजगार के लिए शुरू हुई।' },
  { q: 'अटल आयुष्मान उत्तराखंड योजना में कितना लाभ मिलता है?', a: '25 दिसंबर 2018 से राज्य के सभी परिवारों को प्रति वर्ष ₹5 लाख तक कैशलेस इलाज। सार्वभौमिक स्वास्थ्य कवरेज देने वाला यह देश का पहला राज्य बताया गया।' },
  { q: 'नंदा गौरा योजना में कुल कितनी राशि मिलती है?', a: 'जन्म पर ₹11,000 और 12वीं उत्तीर्ण करने पर ₹51,000 — कुल ₹62,000, पात्र परिवार की पहली दो बालिकाओं को।' },
  { q: 'उत्तराखंड में समान नागरिक संहिता कब लागू हुई?', a: '27 जनवरी 2025 से। विधेयक 7 फ़रवरी 2024 को पारित हुआ और 11 मार्च 2024 को राष्ट्रपति की स्वीकृति मिली।' },
  { q: 'क्या इस पृष्ठ की सभी योजनाएँ आज भी चालू हैं?', a: 'नहीं। हर योजना पर स्थिति-चिह्न है: "चालू" (2025–26/2026–27 के स्रोत में उल्लिखित), "विलय/नए रूप में", या "ऐतिहासिक — वर्तमान स्थिति अपुष्ट"। आवेदन से पहले संबंधित विभाग की वेबसाइट पर नवीनतम शासनादेश अवश्य देखें।' },
];

const schema = [
  { '@context': 'https://schema.org', '@type': 'Article', headline: 'उत्तराखंड सरकार की प्रमुख योजनाएँ (2000–2026)', inLanguage: 'hi', dateModified: '2026-11-20', author: { '@type': 'Organization', name: 'पहाड़ परीक्षा' }, mainEntityOfPage: url },
  { '@context': 'https://schema.org', '@type': 'ItemList', name: 'उत्तराखंड की प्रमुख योजनाएँ', itemListElement: list.map((s, i) => ({ '@type': 'ListItem', position: i + 1, name: s.name, url: `${url}#${s.id}` })) },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'होम', item: 'https://pahadpariksha.in/' },
    { '@type': 'ListItem', position: 2, name: 'उत्तराखंड GK', item: 'https://pahadpariksha.in/gk/' },
    { '@type': 'ListItem', position: 3, name: 'प्रमुख योजनाएँ', item: url },
  ] },
];

const oneLiners = [
  ['राज्य की पहली स्वरोजगार योजना', 'वीर चंद्र सिंह गढ़वाली पर्यटन स्वरोजगार (1 जून 2002)'],
  ['सार्वभौमिक स्वास्थ्य कवरेज', 'अटल आयुष्मान उत्तराखंड — 25 दिसंबर 2018, ₹5 लाख/परिवार/वर्ष'],
  ['बालिका: जन्म + 12वीं', 'नंदा गौरा — ₹11,000 + ₹51,000 = ₹62,000'],
  ['कोविड में लौटे प्रवासियों हेतु', 'मुख्यमंत्री स्वरोजगार योजना — 9 मई 2020 (अब MSY 2.0)'],
  ['25 kW सौर संयंत्र, 25 वर्ष बिजली ख़रीद', 'मुख्यमंत्री सौर स्वरोजगार — 8 अक्टूबर 2020'],
  ['कोविड अनाथ बच्चे: ₹3,000/माह + 5% आरक्षण', 'मुख्यमंत्री वात्सल्य — 2 अगस्त 2021'],
  ['पशुओं का चारा घर तक (अमित शाह ने शुरू की)', 'मुख्यमंत्री घस्यारी कल्याण — 30 अक्टूबर 2021'],
  ['अंत्योदय: साल में 3 सिलेंडर मुफ़्त', 'मुख्यमंत्री अंत्योदय निःशुल्क गैस रिफ़िल — शुभारंभ 12 फ़रवरी 2023 (पौड़ी)'],
  ['नकल माफ़िया पर आजीवन कारावास, ₹10 करोड़', 'नकल-विरोधी अधिनियम 2023 (अध्यादेश 10 फ़रवरी 2023)'],
  ['एकीकृत ब्रांड', 'हाउस ऑफ़ हिमालयाज़ — दिसंबर 2023, ग्लोबल इन्वेस्टर्स समिट'],
  ['पिरूल ₹50/किग्रा', 'पिरूल लाओ, पैसे पाओ (2024)'],
  ['समान नागरिक संहिता लागू', '27 जनवरी 2025 — स्वतंत्र भारत में पहला राज्य'],
  ['11 ज़िलों में बाहरी लोगों को कृषि भूमि नहीं', 'भू-कानून संशोधन — विधानसभा 21 फ़रवरी 2025'],
  ['एकल महिलाओं को 75% अनुदान (₹2 लाख तक परियोजना)', 'मुख्यमंत्री एकल महिला स्वरोजगार (2025)'],
];
---
<Base title="उत्तराखंड सरकार की प्रमुख योजनाएँ 2000–2026: पूरी सूची, लाभ, पात्रता (UKSSSC/UKPSC)" description="उत्तराखंड राज्य गठन (2000) से 2026 तक की प्रमुख सरकारी योजनाएँ और कानून — शुरू होने की तिथि, मुख्यमंत्री, विभाग, उद्देश्य, पात्रता, लाभ राशि और वर्तमान स्थिति। नंदा गौरा, अटल आयुष्मान, MSY 2.0, घस्यारी, UCC, भू-कानून, नकल-विरोधी कानून सहित। फ़िल्टर, समयरेखा व 15 प्रश्नों का क्विज़।" schema={schema}>
  <nav class="crumbs"><a href="/">होम</a> › <a href="/gk/">उत्तराखंड GK</a> › प्रमुख योजनाएँ</nav>

  <header class="yh">
    <p class="kick">उत्तराखंड GK · Government Schemes of Uttarakhand</p>
    <h1>उत्तराखंड सरकार की प्रमुख योजनाएँ <span>राज्य गठन (2000) से 2026 तक — सरल भाषा में, पूरी जानकारी</span></h1>
    <p>हर योजना एक कार्ड में: <b>कब शुरू हुई, किसने शुरू की, किसके लिए, क्या लाभ, आज की स्थिति</b> — और स्रोत। नीचे विषय या मुख्यमंत्री-काल चुनकर छाँटिए, या नाम से खोजिए।</p>
    <div class="stats">
      <div><b>{progs.length}</b><span>प्रमुख योजनाएँ</span></div>
      <div><b>{laws.length}</b><span>कानून व नीतियाँ</span></div>
      <div><b>26</b><span>वर्ष (2000–2026)</span></div>
      <div><b>{list.filter((s) => s.status === 'active').length}</b><span>2025–26 स्रोतों में चालू</span></div>
    </div>
    <p class="upd">अंतिम अद्यतन: {updated}</p>
  </header>

  <div class="box-exam"><strong><span class="tag exam">इस पृष्ठ का उपयोग कैसे करें</span></strong>
    <ul class="how">
      <li><b>राशियाँ और सीमाएँ बदलती रहती हैं</b> — यहाँ लिखी राशि उस स्रोत/वर्ष की है जो कार्ड में दिया है। आवेदन से पहले विभाग का नवीनतम शासनादेश देखें।</li>
      <li><b>स्थिति-चिह्न:</b> <span class="st st-a">चालू</span> = 2025–26/2026–27 के स्रोत में उल्लेख · <span class="st st-m">विलय</span> = नई योजना में समाहित · <span class="st st-h">ऐतिहासिक</span> = वर्तमान स्थिति हमने सत्यापित नहीं की।</li>
      <li>जहाँ स्रोतों में <b>तिथि या राशि पर मत-भेद</b> है, कार्ड के नोट में स्पष्ट लिखा है।</li>
    </ul>
  </div>

  <section id="khojen" class="flt" aria-label="योजनाएँ छाँटें">
    <input type="search" id="q" placeholder="योजना का नाम, लाभ या विभाग खोजें… (जैसे: बालिका, सब्सिडी, 2021)" aria-label="योजना खोजें" />
    <div class="chips" role="group" aria-label="विषय">
      <button type="button" class="chip on" data-sec="">सभी ({list.length})</button>
      {Object.entries(SECTORS).map(([k, v]) => count(k as Sector) > 0 && (
        <button type="button" class="chip" data-sec={k} style={`--c:${v.color}`}>{v.icon} {v.label} ({count(k as Sector)})</button>
      ))}
    </div>
    <div class="sel">
      <label>मुख्यमंत्री-काल:
        <select id="era">
          <option value="">सभी</option>
          {ERAS.map((e) => <option value={`${e.from}-${e.to}`}>{e.from}–{e.to} · {e.cm}</option>)}
        </select>
      </label>
      <label>स्थिति:
        <select id="st">
          <option value="">सभी</option>
          {Object.entries(STATUS).map(([k, v]) => <option value={k}>{v.label}</option>)}
        </select>
      </label>
      <span id="cnt" class="cnt" aria-live="polite"></span>
    </div>
  </section>

  <section id="yojanayen">
    <h2>योजनाएँ व कानून — कार्ड</h2>
    <div class="cards">
      {list.map((s) => {
        const sec = SECTORS[s.sector];
        return (
          <article class="card" id={s.id} data-sec={s.sector} data-year={s.year} data-st={s.status}
            data-text={`${s.name} ${s.en ?? ''} ${s.aim} ${s.who} ${s.benefit} ${s.dept} ${s.cm} ${s.year} ${s.when}`.toLowerCase()} style={`--c:${sec.color}`}>
            <div class="ch">
              <span class="yr">{s.year}</span>
              <div>
                <h3>{s.name}</h3>
                {s.en && <p class="en">{s.en}</p>}
                <p class="meta"><span class="sec">{sec.icon} {sec.label}</span><span class={`st ${STATUS[s.status].cls}`}>{STATUS[s.status].label}</span></p>
              </div>
            </div>
            <p class="aim">{s.aim}</p>
            <dl class="kv2">
              <dt>📅 कब</dt><dd>{s.when}</dd>
              <dt>👤 मुख्यमंत्री</dt><dd>{s.cm}</dd>
              <dt>🏛️ विभाग</dt><dd>{s.dept}</dd>
              <dt>🎯 किसके लिए</dt><dd>{s.who}</dd>
              <dt>💰 क्या लाभ</dt><dd class="ben">{s.benefit}</dd>
            </dl>
            {s.note && <p class="note"><b>ध्यान दें:</b> {s.note}</p>}
            <details class="src"><summary>स्रोत ({s.src.length})</summary>
              <ul>{s.src.map((x) => <li>{x.u ? <a href={x.u} target="_blank" rel="noopener nofollow">{x.t}</a> : x.t}</li>)}</ul>
            </details>
          </article>
        );
      })}
    </div>
    <p id="none" class="muted" hidden>इस खोज/फ़िल्टर से कोई योजना नहीं मिली — फ़िल्टर बदलकर देखें।</p>
  </section>

  <section id="samayrekha">
    <h2>समयरेखा: किस मुख्यमंत्री के काल में कौन-सी योजना</h2>
    <ol class="tl">
      {ERAS.map((e) => {
        const items = list.filter((s) => s.year >= e.from && (s.year < e.to || (e.to === 2026 && s.year <= 2026)) && !(e.id === 'e5' && s.year === 2021 && s.cm.includes('धामी')) && !(e.id === 'e6' && s.year === 2021 && !s.cm.includes('धामी')));
        return (
          <li>
            <p class="tl-h"><b>{e.from}–{e.to === 2026 ? 'वर्तमान' : e.to}</b> · {e.cm}</p>
            {items.length ? <ul>{items.map((s) => <li><a href={`#${s.id}`}>{s.name}</a> <span class="muted">({s.when.split(';')[0]})</span></li>)}</ul> : <p class="muted">इस अवधि (अंतरिम सरकार, नवंबर 2000–मार्च 2002) की कोई प्रमुख दीर्घकालिक योजना इस सूची में नहीं — राज्य की प्रशासनिक नींव रखने का काल।</p>}
          </li>
        );
      })}
    </ol>
    <p class="muted">काल-विभाजन स्थूल है: 2021 में त्रिवेंद्र सिंह रावत (मार्च 2021 तक), तीरथ सिंह रावत (मार्च–जुलाई 2021) और पुष्कर सिंह धामी (4 जुलाई 2021 से) — तीनों रहे। मुख्यमंत्रियों की पूरी सूची: <a href="/history/statehood-movement/">इतिहास अध्याय 9</a>।</p>
  </section>

  <section id="yaad-rakhen">
    <h2>परीक्षा के लिए वन-लाइनर</h2>
    <div class="table-wrap"><table>
      <thead><tr><th>संकेत / प्रश्न</th><th>उत्तर</th></tr></thead>
      <tbody>{oneLiners.map(([a, b]) => <tr><td>{a}</td><td><b>{b}</b></td></tr>)}</tbody>
    </table></div>
  </section>

  <section id="naam">
    <h2>योजनाओं के नाम किनके नाम पर?</h2>
    <div class="table-wrap"><table>
      <thead><tr><th>नाम</th><th>कौन थे</th><th>योजना</th></tr></thead>
      <tbody>
        <tr><td>वीर चंद्र सिंह गढ़वाली</td><td>पेशावर कांड (1930) में निहत्थे पठानों पर गोली चलाने से इनकार करने वाले गढ़वाली सैनिक</td><td>पर्यटन स्वरोजगार योजना</td></tr>
        <tr><td>गौरा देवी</td><td>चिपको आंदोलन (रैणी, 1974) की नायिका</td><td>गौरा देवी कन्याधन; नंदा गौरा</td></tr>
        <tr><td>तीलू रौतेली</td><td>गढ़वाल की 17वीं सदी की वीरांगना</td><td>तीलू रौतेली पेंशन (व पुरस्कार)</td></tr>
        <tr><td>नंदा देवी</td><td>उत्तराखंड की आराध्य देवी (राजजात यात्रा)</td><td>नंदा देवी कन्या; नंदा गौरा</td></tr>
        <tr><td>अटल बिहारी वाजपेयी</td><td>पूर्व प्रधानमंत्री — उनके कार्यकाल में राज्य बना</td><td>अटल आयुष्मान, अटल उत्कृष्ट विद्यालय, अटल खाद्यान्न</td></tr>
        <tr><td>माधो सिंह भंडारी</td><td>मलेथा की गूल बनाने वाले गढ़वाल के सेनापति</td><td>माधो सिंह भंडारी सहकारी सामूहिक खेती योजना (2023)</td></tr>
      </tbody>
    </table></div>
    <p class="muted">व्यक्तित्वों का विस्तार: <a href="/history/">उत्तराखंड का इतिहास</a>।</p>
  </section>

  <section id="quiz">
    <h2>क्विज़: उत्तराखंड की योजनाएँ (15 प्रश्न)</h2>
    <p>UKSSSC/UKPSC स्तर के अभ्यास प्रश्न — पिछले वर्षों के प्रश्न नहीं। हर उत्तर के साथ व्याख्या।</p>
    <Quiz id="uttarakhand-yojanayen" title="उत्तराखंड की प्रमुख योजनाएँ" questions={questions} />
  </section>

  <section id="faq">
    <h2>अक्सर पूछे जाने वाले प्रश्न</h2>
    {faq.map((f) => (<details class="qa"><summary>{f.q}</summary><p>{f.a}</p></details>))}
  </section>

  <section id="srot">
    <h2>स्रोत व पद्धति</h2>
    <p>हर कार्ड में उसके स्रोत दिए हैं — प्राथमिकता क्रम: सरकारी पोर्टल/PIB/अधिनियम पाठ → प्रमुख समाचार एजेंसियाँ → परीक्षा-समाचार संकलन (Drishti आदि)। विभागवार 2026-27 स्थिति के लिए <a href="https://www.impriindia.com/insights/policy-update/uttarakhand-department-wise-scheme/" target="_blank" rel="noopener nofollow">IMPRI का संकलन</a> देखा गया, जहाँ उसके वर्ष अन्य स्रोतों से टकराए, वहाँ कार्ड में नोट है। केंद्र सरकार की योजनाएँ (PM-JAY, PM किसान, जल जीवन मिशन आदि) इस पृष्ठ में नहीं हैं — यह केवल <b>राज्य सरकार</b> की योजनाओं का संकलन है। कोई त्रुटि दिखे तो <a href="/contact/">हमें बताइए</a>।</p>
  </section>

