<script>
  const q = document.getElementById('q') as HTMLInputElement;
  const era = document.getElementById('era') as HTMLSelectElement;
  const st = document.getElementById('st') as HTMLSelectElement;
  const cnt = document.getElementById('cnt')!;
  const none = document.getElementById('none')!;
  const cards = [...document.querySelectorAll<HTMLElement>('.card')];
  const groups = [...document.querySelectorAll<HTMLElement>('section.grp')];
  let sec = '';
  let scope = '';
  const apply = () => {
    const t = q.value.trim().toLowerCase();
    const [a, b] = era.value ? era.value.split('-').map(Number) : [0, 9999];
    let n = 0;
    cards.forEach((c) => {
      const y = +c.dataset.year!;
      const ok = (!scope || c.dataset.scope === scope) && (!sec || c.dataset.sec === sec) && (!st.value || c.dataset.st === st.value) && y >= a && y <= b && (!t || c.dataset.text!.includes(t));
      c.hidden = !ok; if (ok) n++;
    });
    groups.forEach((g) => { g.hidden = !g.querySelector('.card:not([hidden])'); });
    cnt.textContent = `${n} परिणाम`;
    none.hidden = n > 0;
  };
  document.querySelectorAll<HTMLButtonElement>('.chip').forEach((btn) => btn.addEventListener('click', () => {
    document.querySelectorAll('.chip').forEach((x) => x.classList.remove('on'));
    btn.classList.add('on'); sec = btn.dataset.sec || ''; apply();
  }));
  document.querySelectorAll<HTMLButtonElement>('.sc').forEach((btn) => btn.addEventListener('click', () => {
    document.querySelectorAll('.sc').forEach((x) => x.classList.remove('on'));
    btn.classList.add('on'); scope = btn.dataset.scope || ''; apply();
  }));
  [q, era, st].forEach((el) => el.addEventListener('input', apply));
  apply();
</script>

