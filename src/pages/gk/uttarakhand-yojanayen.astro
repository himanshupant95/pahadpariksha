---
import Base from '../../layouts/Base.astro';
import Quiz from '../../components/Quiz.astro';
import SchemeCard from '../../components/SchemeCard.astro';
import '../../styles/longform.css';
import questions from '../../data/quizzes/uttarakhand-yojanayen.json';
import { SECTORS, STATUS, ERAS, sorted, sortedCentral, type Sector } from '../../data/schemes';

const list = sorted();
const central = sortedCentral();
const all = [...list, ...central];
const progs = list.filter((s) => s.sector !== 'law');
const laws = list.filter((s) => s.sector === 'law');
const count = (k: Sector) => all.filter((s) => s.sector === k).length;
const url = 'https://pahadpariksha.in/gk/uttarakhand-yojanayen/';
const updated = '20 नवंबर 2026';

const faq = [
  { q: 'उत्तराखंड की पहली स्वरोजगार योजना कौन-सी है?', a: 'वीर चंद्र सिंह गढ़वाली पर्यटन स्वरोजगार योजना — 1 जून 2002 को पर्यटन क्षेत्र में स्वरोजगार के लिए शुरू हुई।' },
  { q: 'अटल आयुष्मान उत्तराखंड योजना में कितना लाभ मिलता है?', a: '25 दिसंबर 2018 से राज्य के सभी परिवारों को प्रति वर्ष ₹5 लाख तक कैशलेस इलाज। सार्वभौमिक स्वास्थ्य कवरेज देने वाला यह देश का पहला राज्य बताया गया।' },
  { q: 'नंदा गौरा योजना में कुल कितनी राशि मिलती है?', a: 'जन्म पर ₹11,000 और 12वीं उत्तीर्ण करने पर ₹51,000 — कुल ₹62,000, पात्र परिवार की पहली दो बालिकाओं को।' },
  { q: 'उत्तराखंड में समान नागरिक संहिता कब लागू हुई?', a: '27 जनवरी 2025 से। विधेयक 7 फ़रवरी 2024 को पारित हुआ और 11 मार्च 2024 को राष्ट्रपति की स्वीकृति मिली।' },
  { q: 'उत्तराखंड के आकांक्षी ज़िले कौन-से हैं?', a: 'नीति आयोग के आकांक्षी ज़िला कार्यक्रम (जनवरी 2018) में उत्तराखंड के दो ज़िले हैं — हरिद्वार और ऊधम सिंह नगर। दोनों मैदानी ज़िले हैं।' },
  { q: 'वाइब्रेंट विलेजेज़ प्रोग्राम में उत्तराखंड के कितने गाँव हैं?', a: 'VVP-I में चीन सीमा के 51 गाँव (पिथौरागढ़ 27, चमोली 14, उत्तरकाशी 10) और VVP-II में नेपाल सीमा के 40 गाँव — कुल 91।' },
  { q: 'ऋषिकेश–कर्णप्रयाग रेल लाइन की मुख्य बातें क्या हैं?', a: '125 किमी, 12 स्टेशन, लगभग 83% मार्ग सुरंग में; देवप्रयाग–जनासू के बीच 14.58 किमी की सुरंग देश की सबसे लंबी परिवहन सुरंग है। निर्माण RVNL कर रहा है; पूर्णता-लक्ष्य कई बार बढ़ा (2026 → 2028 → 2029)।' },
  { q: 'क्या इस पृष्ठ की सभी योजनाएँ आज भी चालू हैं?', a: 'नहीं। हर योजना पर स्थिति-चिह्न है: "चालू" (2025–26/2026–27 के स्रोत में उल्लिखित), "विलय/नए रूप में", या "ऐतिहासिक — वर्तमान स्थिति अपुष्ट"। आवेदन से पहले संबंधित विभाग की वेबसाइट पर नवीनतम शासनादेश अवश्य देखें।' },
];

const schema = [
  { '@context': 'https://schema.org', '@type': 'Article', headline: 'उत्तराखंड की प्रमुख योजनाएँ (2000–2026): राज्य सरकार व उत्तराखंड से जुड़ी केंद्रीय योजनाएँ', inLanguage: 'hi', dateModified: '2026-11-20', author: { '@type': 'Organization', name: 'पहाड़ परीक्षा' }, mainEntityOfPage: url },
  { '@context': 'https://schema.org', '@type': 'ItemList', name: 'उत्तराखंड की प्रमुख योजनाएँ', itemListElement: all.map((s, i) => ({ '@type': 'ListItem', position: i + 1, name: s.name, url: `${url}#${s.id}` })) },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'होम', item: 'https://pahadpariksha.in/' },
    { '@type': 'ListItem', position: 2, name: 'उत्तराखंड GK', item: 'https://pahadpariksha.in/gk/' },
    { '@type': 'ListItem', position: 3, name: 'प्रमुख योजनाएँ', item: url },
  ] },
];

const oneLiners = [
  ['राज्य की पहली स्वरोजगार योजना', 'वीर चंद्र सिंह गढ़वाली पर्यटन स्वरोजगार (1 जून 2002)'],
  ['सार्वभौमिक स्वास्थ्य कवरेज', 'अटल आयुष्मान उत्तराखंड — 25 दिसंबर 2018, ₹5 लाख/परिवार/वर्ष'],
  ['बालिका: जन्म + 12वीं', 'नंदा गौरा — ₹11,000 + ₹51,000 = ₹62,000'],
  ['कोविड में लौटे प्रवासियों हेतु', 'मुख्यमंत्री स्वरोजगार योजना — 9 मई 2020 (अब MSY 2.0)'],
  ['25 kW सौर संयंत्र, 25 वर्ष बिजली ख़रीद', 'मुख्यमंत्री सौर स्वरोजगार — 8 अक्टूबर 2020'],
  ['कोविड अनाथ बच्चे: ₹3,000/माह + 5% आरक्षण', 'मुख्यमंत्री वात्सल्य — 2 अगस्त 2021'],
  ['पशुओं का चारा घर तक (अमित शाह ने शुरू की)', 'मुख्यमंत्री घस्यारी कल्याण — 30 अक्टूबर 2021'],
  ['अंत्योदय: साल में 3 सिलेंडर मुफ़्त', 'मुख्यमंत्री अंत्योदय निःशुल्क गैस रिफ़िल — शुभारंभ 12 फ़रवरी 2023 (पौड़ी)'],
  ['नकल माफ़िया पर आजीवन कारावास, ₹10 करोड़', 'नकल-विरोधी अधिनियम 2023 (अध्यादेश 10 फ़रवरी 2023)'],
  ['एकीकृत ब्रांड', 'हाउस ऑफ़ हिमालयाज़ — दिसंबर 2023, ग्लोबल इन्वेस्टर्स समिट'],
  ['पिरूल ₹50/किग्रा', 'पिरूल लाओ, पैसे पाओ (2024)'],
  ['समान नागरिक संहिता लागू', '27 जनवरी 2025 — स्वतंत्र भारत में पहला राज्य'],
  ['11 ज़िलों में बाहरी लोगों को कृषि भूमि नहीं', 'भू-कानून संशोधन — विधानसभा 21 फ़रवरी 2025'],
  ['एकल महिलाओं को 75% अनुदान (₹2 लाख तक परियोजना)', 'मुख्यमंत्री एकल महिला स्वरोजगार (2025)'],
];

const kendraLiners = [
  ['देश की सबसे लंबी परिवहन सुरंग (14.58 किमी)', 'देवप्रयाग–जनासू, ऋषिकेश–कर्णप्रयाग रेल लाइन'],
  ['देश का पहला 4-मंज़िला STP (7.5 MLD)', 'चंद्रेश्वर नगर, मुनि की रेती — नमामि गंगे (लोकार्पण 29 सितंबर 2020)'],
  ['41 श्रमिक, 17 दिन, रैट-होल माइनर्स', 'सिलक्यारा सुरंग, उत्तरकाशी (12–28 नवंबर 2023); ब्रेकथ्रू 16 अप्रैल 2025'],
  ['सिलक्यारा सुरंग किसके नाम पर?', 'स्थानीय देवता बाबा बौखनाग'],
  ['उत्तराखंड के आकांक्षी ज़िले', 'हरिद्वार व ऊधम सिंह नगर (नीति आयोग, 2018)'],
  ['VVP में उत्तराखंड के गाँव', 'VVP-I: 51 (चीन सीमा) + VVP-II: 40 (नेपाल सीमा) = 91'],
  ['सोनप्रयाग–केदारनाथ रोपवे', '12.9 किमी, ₹4,081.28 करोड़, 8–9 घंटे → ~36 मिनट (CCEA 5 मार्च 2025)'],
  ['गोविंदघाट–हेमकुंड साहिब रोपवे', '12.4 किमी, ₹2,730.13 करोड़ (फूलों की घाटी का प्रवेश-द्वार)'],
  ['जमरानी बाँध — नदी व योजना', 'गौला नदी (रामगंगा की सहायक), नैनीताल; PMKSY-AIBP की 7वीं परियोजना (25 अक्टूबर 2023)'],
  ['लखवाड़ — 6 राज्य, 204 मीटर, 300 MW', 'यमुना पर लोहारी (देहरादून) के पास; MoU 28 अगस्त 2018; बिजली पूरी उत्तराखंड को'],
  ['दिल्ली–देहरादून एक्सप्रेसवे', 'लोकार्पण 14 अप्रैल 2026; राजाजी में ~12 किमी एलिवेटेड वन्यजीव गलियारा'],
  ['हर घर जल — शुरुआत बनाम अब', '2019 में 1.30 लाख घर → 2026 में 14.20 लाख / 14.48 लाख (~98%)'],
  ['PM-JAY में उत्तराखंड के पात्र परिवार', '5.37 लाख; बाक़ी ~18 लाख अटल आयुष्मान से (कुल ~23 लाख)'],
  ['PRASHAD की 3 परियोजनाएँ', 'केदारनाथ (2015-16), बद्रीनाथ (2018-19), गंगोत्री-यमुनोत्री (2021-22)'],
];
---
<Base title="उत्तराखंड की प्रमुख योजनाएँ 2000–2026: राज्य + केंद्रीय योजनाएँ, लाभ, पात्रता (UKSSSC/UKPSC)" description="उत्तराखंड राज्य गठन (2000) से 2026 तक की राज्य सरकार की योजनाएँ व कानून, और उत्तराखंड पर बड़ा असर डालने वाली केंद्रीय योजनाएँ — ऋषिकेश-कर्णप्रयाग रेल, चारधाम सड़क, सिलक्यारा सुरंग, केदारनाथ-हेमकुंड रोपवे, वाइब्रेंट विलेज, जल जीवन मिशन, नमामि गंगे, जमरानी, लखवाड़। तिथि, आँकड़े, स्थिति, स्रोत; फ़िल्टर, समयरेखा व 25 प्रश्नों का क्विज़।" schema={schema}>
  <nav class="crumbs"><a href="/">होम</a> › <a href="/gk/">उत्तराखंड GK</a> › प्रमुख योजनाएँ</nav>

  <header class="yh">
    <p class="kick">उत्तराखंड GK · Government Schemes of Uttarakhand</p>
    <h1>उत्तराखंड की प्रमुख योजनाएँ <span>राज्य गठन (2000) से 2026 तक — राज्य सरकार की योजनाएँ + उत्तराखंड से जुड़ी केंद्रीय योजनाएँ व परियोजनाएँ</span></h1>
    <p>हर योजना एक कार्ड में: <b>कब शुरू हुई, किसने शुरू की, किसके लिए, क्या लाभ, आज की स्थिति</b> — और स्रोत। केंद्रीय कार्डों में अलग से <b>“उत्तराखंड में”</b> वाले तथ्य — परीक्षा में वही पूछे जाते हैं। नीचे राज्य/केंद्र, विषय या काल चुनकर छाँटिए, या नाम से खोजिए।</p>
    <div class="stats">
      <div><b>{progs.length}</b><span>राज्य की योजनाएँ</span></div>
      <div><b>{laws.length}</b><span>कानून व नीतियाँ</span></div>
      <div><b>{central.length}</b><span>केंद्रीय योजनाएँ/परियोजनाएँ</span></div>
      <div><b>26</b><span>वर्ष (2000–2026)</span></div>
      <div><b>{list.filter((s) => s.status === 'active').length}</b><span>2025–26 स्रोतों में चालू</span></div>
    </div>
    <p class="upd">अंतिम अद्यतन: {updated}</p>
  </header>

  <div class="box-exam"><strong><span class="tag exam">इस पृष्ठ का उपयोग कैसे करें</span></strong>
    <ul class="how">
      <li><b>राशियाँ और सीमाएँ बदलती रहती हैं</b> — यहाँ लिखी राशि उस स्रोत/वर्ष की है जो कार्ड में दिया है। आवेदन से पहले विभाग का नवीनतम शासनादेश देखें।</li>
      <li><b>स्थिति-चिह्न:</b> <span class="st st-a">चालू</span> = 2025–26/2026–27 के स्रोत में उल्लेख · <span class="st st-b">निर्माणाधीन</span> = स्वीकृत/बन रही परियोजना · <span class="st st-m">विलय</span> = नई योजना में समाहित · <span class="st st-h">ऐतिहासिक</span> = वर्तमान स्थिति हमने सत्यापित नहीं की।</li>
      <li>जहाँ स्रोतों में <b>तिथि या राशि पर मत-भेद</b> है, कार्ड के नोट में स्पष्ट लिखा है।</li>
    </ul>
  </div>

  <section id="khojen" class="flt" aria-label="योजनाएँ छाँटें">
    <input type="search" id="q" placeholder="योजना का नाम, लाभ या विभाग खोजें… (जैसे: बालिका, सब्सिडी, 2021)" aria-label="योजना खोजें" />
    <div class="scope" role="group" aria-label="राज्य या केंद्र">
      <button type="button" class="sc on" data-scope="">सभी ({all.length})</button>
      <button type="button" class="sc" data-scope="state">🏔️ राज्य सरकार ({list.length})</button>
      <button type="button" class="sc" data-scope="central">🇮🇳 केंद्र — उत्तराखंड पर असर ({central.length})</button>
    </div>
    <div class="chips" role="group" aria-label="विषय">
      <button type="button" class="chip on" data-sec="">सभी विषय</button>
      {Object.entries(SECTORS).map(([k, v]) => count(k as Sector) > 0 && (
        <button type="button" class="chip" data-sec={k} style={`--c:${v.color}`}>{v.icon} {v.label} ({count(k as Sector)})</button>
      ))}
    </div>
    <div class="sel">
      <label>मुख्यमंत्री-काल:
        <select id="era">
          <option value="">सभी वर्ष</option>
          {ERAS.map((e) => <option value={`${e.from}-${e.to}`}>{e.from}–{e.to} · {e.cm}</option>)}
        </select>
      </label>
      <label>स्थिति:
        <select id="st">
          <option value="">सभी</option>
          {Object.entries(STATUS).map(([k, v]) => <option value={k}>{v.label}</option>)}
        </select>
      </label>
      <span id="cnt" class="cnt" aria-live="polite"></span>
    </div>
  </section>

  <section id="yojanayen" class="grp">
    <h2>राज्य सरकार की योजनाएँ व कानून</h2>
    <div class="cards">{list.map((s) => <SchemeCard s={s} />)}</div>
  </section>

  <section id="kendra" class="grp">
    <h2>केंद्र सरकार की योजनाएँ व परियोजनाएँ — उत्तराखंड पर बड़ा असर</h2>
    <p>ये योजनाएँ भारत सरकार की हैं, पर UKSSSC/UKPSC में इनके <b>उत्तराखंड वाले तथ्य</b> बार-बार पूछे जाते हैं — कितने गाँव, कितने किमी, कौन-सी नदी, किस ज़िले में, कब स्वीकृत। हर कार्ड का पीला खंड “उत्तराखंड में” वही तथ्य देता है; जहाँ लागत या समय-सीमा बदली है, नोट में पुराना और नया दोनों आँकड़ा है।</p>
    <div class="table-wrap kt"><table>
      <thead><tr><th>परियोजना</th><th>मुख्य आँकड़ा</th><th>ज़िला / स्थान</th><th>स्थिति (नवंबर 2026)</th></tr></thead>
      <tbody>
        <tr><td><a href="#c-rkrail">ऋषिकेश–कर्णप्रयाग रेल</a></td><td>125 किमी · 12 स्टेशन · ~83% सुरंग</td><td>देहरादून, टिहरी, पौड़ी, रुद्रप्रयाग, चमोली</td><td>~78% प्रगति; लक्ष्य दिसंबर 2029</td></tr>
        <tr><td><a href="#c-chardham">चारधाम सड़क</a></td><td>~825 किमी · 53 पैकेज · ~₹12,000 करोड़</td><td>चारों धाम के मार्ग</td><td>अधिकांश पूर्ण, शेष निर्माणाधीन</td></tr>
