<script>
  // click a header to sort (numbers use data-v)
  document.querySelectorAll('table.sortable').forEach((t) => {
    const ths = t.querySelectorAll('thead th');
    ths.forEach((th, i) => {
      th.style.cursor = 'pointer';
      th.title = 'क्रम बदलने के लिए क्लिक करें';
      let asc = false;
      th.addEventListener('click', () => {
        const body = t.querySelector('tbody')!;
        const rows = [...body.querySelectorAll('tr')];
        const total = rows.filter((r) => r.classList.contains('total'));
        const data = rows.filter((r) => !r.classList.contains('total'));
        asc = !asc;
        data.sort((a, b) => {
          const ca = a.children[i] as HTMLElement, cb = b.children[i] as HTMLElement;
          if (th.hasAttribute('data-num')) return (asc ? 1 : -1) * (Number(ca.dataset.v) - Number(cb.dataset.v));
          return (asc ? 1 : -1) * ca.textContent!.localeCompare(cb.textContent!, 'hi');
        });
        [...data, ...total].forEach((r) => body.appendChild(r));
      });
    });
  });
</script>

