  ['कुमाऊँनी रंगवाली पिछौड़ा', 'हस्तशिल्प', '2023', 'शुभ अवसरों का ओढ़ना'],
  ['चमोली के रम्माण मुखौटे', 'हस्तशिल्प', '2023', 'रम्माण उत्सव UNESCO सूची में (2009)'],
