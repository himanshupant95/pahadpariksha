const faq = [
  { q: 'उत्तराखंड की प्रति व्यक्ति आय कितनी है?', a: 'राज्य के आर्थिक सर्वेक्षण 2025-26 के अनुसार 2024-25 में ₹2,73,921। PRS के बजट विश्लेषण में "प्रति व्यक्ति GSDP" ₹2,96,012 लिखा है, जो अलग पैमाना है।' },
  { q: 'उत्तराखंड की अर्थव्यवस्था में सबसे बड़ा हिस्सा किस क्षेत्र का है?', a: 'सेवा क्षेत्र का, लगभग 49%। फिर उद्योग/विनिर्माण लगभग 41% और कृषि लगभग 10% (2024-25, वर्तमान मूल्य)।' },
  { q: 'उत्तराखंड के कितने उत्पादों को GI टैग मिला है?', a: '29। दिसंबर 2023 तक 27 थे; नवंबर 2025 में बेडू और बद्री गाय के घी को GI मिला। राज्य का पहला GI तेजपत्ता (2016) था।' },
  { q: '2025 में उत्तराखंड में कितने पर्यटक आए?', a: 'पर्यटन विभाग के अनुसार 6,03,21,194, जिनमें 1,92,533 विदेशी थे। राज्य बनने के बाद पहली बार 6 करोड़ पार। सबसे ज़्यादा हरिद्वार (लगभग 3.42 करोड़)।' },
