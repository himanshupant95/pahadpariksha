---
import Article from '../../layouts/Article.astro';

const faq = [
  { q: 'क्या ये मानचित्र मुफ़्त हैं?', a: 'हाँ। दोनों मानचित्र पढ़ाई, नोट्स, प्रिंट और कक्षा में उपयोग के लिए पूरी तरह मुफ़्त हैं। HD चित्र या PDF डाउनलोड करें; साझा करते समय pahadpariksha.in का उल्लेख करें।' },
  { q: 'इन मानचित्रों की सीमाएँ किस स्रोत से हैं?', a: 'जिला व राज्य सीमाएँ जनगणना 2011 / भारतीय सर्वेक्षण विभाग (Survey of India) के आधिकारिक आँकड़ों पर आधारित हैं (DataMeet, CC BY 4.0)। भारत की अंतरराष्ट्रीय सीमा भारत के आधिकारिक दावे के अनुसार दिखाई गई है।' },
  { q: 'उत्तराखंड की सबसे ऊँची चोटी कौन-सी है?', a: 'नंदा देवी (7,816 मीटर), चमोली जिले में। यह पूर्णतः भारत में स्थित सबसे ऊँची चोटी है; इसके बाद कामेट (7,756 मीटर)।' },
  { q: 'पंच प्रयाग ऊपर से नीचे किस क्रम में हैं?', a: 'विष्णुप्रयाग (अलकनंदा–धौलीगंगा) → नंदप्रयाग (नंदाकिनी) → कर्णप्रयाग (पिंडर) → रुद्रप्रयाग (मंदाकिनी) → देवप्रयाग (भागीरथी), जहाँ से नदी "गंगा" कहलाती है।' },
  { q: 'प्रिंट के लिए कौन-सी फ़ाइल लें?', a: 'PDF लें — यह A3/A4 पर साफ़ छपती है। मोबाइल पर पढ़ने के लिए HD चित्र बेहतर है।' },
];

const peaks = [
  ['नंदा देवी', '7,816', 'चमोली — नंदा देवी अभयारण्य', 'राज्य की और पूर्णतः भारत में स्थित सबसे ऊँची चोटी'],
  ['कामेट', '7,756', 'चमोली — माणा व नीति घाटियों के बीच', 'राज्य की दूसरी सबसे ऊँची चोटी'],
  ['चौखंबा', '7,138', 'गंगोत्री समूह, बद्रीनाथ के पश्चिम', 'चार स्तंभों जैसा शिखर'],
  ['त्रिशूल', '7,120', 'चमोली — नंदा देवी अभयारण्य के दक्षिण-पश्चिम', 'त्रिशूल के आकार की तीन चोटियाँ'],
  ['सतोपंथ', '7,075', 'गंगोत्री समूह', 'गंगोत्री क्षेत्र की सबसे ऊँची चोटियों में'],
  ['द्रोणागिरि (दूनागिरि)', '7,066', 'चमोली — नंदा देवी अभयारण्य के उत्तर', 'संजीवनी पर्वत की लोककथा'],
  ['केदारनाथ', '6,940', 'गंगोत्री समूह, केदारनाथ धाम के उत्तर', 'केदारनाथ मंदिर के पीछे दिखने वाली चोटी'],
  ['पंचाचूली', '6,904', 'पिथौरागढ़', 'पाँच चोटियों का समूह; मुनस्यारी से दर्शन'],
  ['नंदा कोट', '6,861', 'पिथौरागढ़–बागेश्वर', 'पिंडारी हिमनद के पूर्व'],
  ['नीलकंठ', '6,596', 'चमोली — बद्रीनाथ के पश्चिम', '"गढ़वाल की रानी"'],
  ['शिवलिंग', '6,543', 'उत्तरकाशी — गोमुख-तपोवन', 'शिवलिंग के आकार का शिखर'],
  ['बंदरपूँछ', '6,316', 'उत्तरकाशी', 'यमुनोत्री हिमनद इसी पर्वत समूह में'],
];
---
<Article
  title="उत्तराखंड का मानचित्र: राजनीतिक व भौतिक (HD व PDF मुफ़्त डाउनलोड)"
  description="उत्तराखंड का राजनीतिक और भौतिक मानचित्र: 13 ज़िले, मंडल, मुख्यालय, नदियाँ, हिमनद, चोटियाँ और दर्रे। HD और PDF मुफ़्त डाउनलोड।"
  breadcrumbs={[{ name: 'उत्तराखंड GK', href: '/gk/' }]}
  published="2026-11-18"
  image="/maps/uttarakhand-maps-og.jpg"
  imageAlt="उत्तराखंड के राजनीतिक व भौतिक मानचित्र"
  hideHero={true}
  faq={faq}
>
  <div class="keypoints">
    <h2>एक नज़र में</h2>
    <ul>
      <li>दो मानचित्र — <strong>राजनीतिक</strong> (जिले, मंडल, मुख्यालय) और <strong>भौतिक</strong> (ऊँचाई, नदियाँ, हिमनद, चोटियाँ, दर्रे)</li>
      <li>पूरी तरह <strong>हिंदी</strong> में; सीमाएँ <strong>भारतीय सर्वेक्षण विभाग / जनगणना 2011</strong> के आधिकारिक आँकड़ों से</li>
      <li>मुफ़्त <strong>HD चित्र</strong> (मोबाइल के लिए) और <strong>PDF</strong> (प्रिंट के लिए)</li>
    </ul>
  </div>

  <h2 id="rajnitik">1. उत्तराखंड का राजनीतिक मानचित्र</h2>
  <figure class="map-fig">
    <a href="/maps/uttarakhand-political-hd.png" target="_blank" rel="noopener">
      <img src="/maps/uttarakhand-political.webp" srcset="/maps/uttarakhand-political-800.webp 800w, /maps/uttarakhand-political.webp 1600w" sizes="(max-width: 860px) 100vw, 820px"
        width="1600" height="1488" alt="उत्तराखंड का राजनीतिक मानचित्र: 13 जिले, गढ़वाल और कुमाऊँ मंडल की सीमा, जिला मुख्यालय, राजधानी देहरादून और ग्रीष्मकालीन राजधानी गैरसैंण" />
    </a>
    <figcaption>बड़ा देखने के लिए मानचित्र पर टैप करें। सीमाएँ: जनगणना 2011 / भारतीय सर्वेक्षण विभाग।</figcaption>
  </figure>
  <p class="dl">
    <a class="btn" href="/maps/uttarakhand-political-hd.png" download>⬇ HD चित्र (PNG)</a>
    <a class="btn btn-ghost" href="/maps/uttarakhand-political.pdf" download>⬇ PDF (प्रिंट के लिए)</a>
  </p>
  <h3>इस मानचित्र से याद रखें</h3>
  <ul>
    <li><strong>गढ़वाल मंडल (7):</strong> उत्तरकाशी, चमोली, रुद्रप्रयाग, टिहरी गढ़वाल, देहरादून, पौड़ी गढ़वाल, हरिद्वार — मुख्यालय पौड़ी।</li>
    <li><strong>कुमाऊँ मंडल (6):</strong> पिथौरागढ़, बागेश्वर, अल्मोड़ा, चंपावत, नैनीताल, ऊधम सिंह नगर — मुख्यालय नैनीताल।</li>
    <li><strong>पड़ोसी:</strong> उत्तर में तिब्बत (चीन), पूर्व में नेपाल, पश्चिम-उत्तर-पश्चिम में हिमाचल प्रदेश, दक्षिण में उत्तर प्रदेश।</li>
    <li><strong>चीन से सीमा:</strong> उत्तरकाशी, चमोली, पिथौरागढ़। <strong>नेपाल से सीमा:</strong> पिथौरागढ़, चंपावत, ऊधम सिंह नगर।</li>
    <li><strong>आंतरिक जिले</strong> (किसी राज्य/देश से सीमा नहीं): टिहरी गढ़वाल, रुद्रप्रयाग, अल्मोड़ा, बागेश्वर।</li>
    <li>जिन जिलों का मुख्यालय दूसरे नाम से है: चमोली — <strong>गोपेश्वर</strong>, टिहरी — <strong>नई टिहरी</strong>, पौड़ी गढ़वाल — <strong>पौड़ी</strong>, ऊधम सिंह नगर — <strong>रुद्रपुर</strong>।</li>
  </ul>
  <p>हर जिले का विस्तृत परिचय: <a href="/gk/districts/#ek-nazar">उत्तराखंड के 13 जिले: एक नज़र में</a> · <a href="/gk/districts/">देवभूमि दर्पण शृंखला</a></p>

  <h2 id="bhautik">2. उत्तराखंड का भौतिक मानचित्र</h2>
  <figure class="map-fig">
    <a href="/maps/uttarakhand-physical-hd.jpg" target="_blank" rel="noopener">
      <img src="/maps/uttarakhand-physical.webp" srcset="/maps/uttarakhand-physical-800.webp 800w, /maps/uttarakhand-physical.webp 1600w" sizes="(max-width: 860px) 100vw, 820px"
        width="1600" height="1488" loading="lazy" alt="उत्तराखंड का भौतिक मानचित्र: ऊँचाई के रंग, प्रमुख नदियाँ, गंगोत्री-सतोपंथ-मिलम-पिंडारी हिमनद, नंदा देवी समेत प्रमुख चोटियाँ, माणा-नीति-लिपुलेख दर्रे और पंच प्रयाग" />
    </a>
    <figcaption>ऊँचाई: NASA SRTM · नदियाँ व हिमनद: © OpenStreetMap contributors · सीमाएँ: भारतीय सर्वेक्षण विभाग।</figcaption>
  </figure>
  <p class="dl">
    <a class="btn" href="/maps/uttarakhand-physical-hd.jpg" download>⬇ HD चित्र (JPG)</a>
    <a class="btn btn-ghost" href="/maps/uttarakhand-physical.pdf" download>⬇ PDF (प्रिंट के लिए)</a>
  </p>
  <h3>इस मानचित्र से याद रखें</h3>
  <ul>
    <li><strong>ऊँचाई का क्रम (दक्षिण से उत्तर):</strong> तराई → भाबर → शिवालिक व दून घाटियाँ → लघु (मध्य) हिमालय → महान हिमालय (हिमनद व 6,000 मी. से ऊँची चोटियाँ) → तिब्बत की सीमा।</li>
    <li><strong>पंच प्रयाग</strong> (ऊपर से नीचे): विष्णुप्रयाग → नंदप्रयाग → कर्णप्रयाग → रुद्रप्रयाग → देवप्रयाग। पाँचों अलकनंदा पर हैं।</li>
    <li><strong>प्रमुख हिमनद:</strong> गंगोत्री (भागीरथी), सतोपंथ (अलकनंदा), मिलम (गोरी गंगा), पिंडारी (पिंडर)।</li>
    <li><strong>दर्रे:</strong> माणा व नीति (चमोली), लिपुलेख (पिथौरागढ़ — कैलाश मानसरोवर मार्ग)।</li>
    <li><strong>दो रामगंगा:</strong> पश्चिमी — दूधातोली (चमोली) से, कालागढ़ होते हुए; पूर्वी — नामिक हिमनद (पिथौरागढ़) से, सरयू में।</li>
    <li><strong>काली (शारदा)</strong> नदी भारत–नेपाल सीमा बनाती है।</li>
  </ul>

  <h3>प्रमुख चोटियाँ (ऊँचाई के क्रम में)</h3>
  <div class="table-wrap">
    <table>
      <thead><tr><th>चोटी</th><th>ऊँचाई (मी.)</th><th>क्षेत्र</th><th>परीक्षा बिंदु</th></tr></thead>
      <tbody>{peaks.map(([a, b, c, d]) => <tr><td><strong>{a}</strong></td><td>{b}</td><td>{c}</td><td>{d}</td></tr>)}</tbody>
    </table>
  </div>
  <p>नदियों का विस्तार: <a href="/geography/rivers-drainage/">नदियाँ और अपवाह तंत्र: उद्गम व पंच प्रयाग</a></p>

  <p class="note">और मानचित्र (स्थिति, विस्तार, नदी तंत्र, पंच प्रयाग, हिमनद, ऊँचाई-परिच्छेद, इंटरैक्टिव एटलस): <a href="/geography/">उत्तराखंड का भूगोल — शृंखला</a>।</p>

  <h2 id="upyog">उपयोग की शर्तें व स्रोत</h2>
  <ul>
    <li>ये मानचित्र <strong>पढ़ाई, नोट्स, प्रिंट और कक्षा</strong> के लिए मुफ़्त हैं। कहीं साझा करें तो <strong>pahadpariksha.in</strong> का उल्लेख करें।</li>
    <li>सीमाएँ: <a href="https://github.com/datameet/maps" target="_blank" rel="noopener nofollow">जनगणना 2011 / भारतीय सर्वेक्षण विभाग — DataMeet</a> (CC BY 4.0)। भारत की अंतरराष्ट्रीय सीमा भारत के आधिकारिक दावे के अनुसार।</li>
    <li>ऊँचाई: NASA SRTM (सार्वजनिक डोमेन)। नदियाँ, हिमनद व झीलें: <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener nofollow">© OpenStreetMap contributors</a> (ODbL)।</li>
    <li>जिला सीमाएँ जनगणना 2011 के अनुसार हैं; बाद के छोटे प्रशासनिक बदलाव (नई तहसीलें आदि) इसमें नहीं दिखते। मानचित्र शैक्षिक उपयोग के लिए है, कानूनी/सर्वेक्षण दस्तावेज़ नहीं।</li>
  </ul>
</Article>

<style>
  .map-fig { margin: 1rem 0 .5rem; }
  .map-fig img { width: 100%; height: auto; display: block; border: 1px solid #e2e8f0; border-radius: 10px; }
  .map-fig figcaption { font-size: .85rem; color: #64748b; margin-top: .4rem; }
  .dl { display: flex; flex-wrap: wrap; gap: 10px; margin: .6rem 0 1.2rem; }
  .btn-ghost { background: #fff; color: var(--green-2); border: 2px solid var(--green-2); padding: 8px 16px; }
  .btn-ghost:hover { background: var(--green-soft); color: var(--green); }
  .table-wrap { overflow-x: auto; }
</style>
