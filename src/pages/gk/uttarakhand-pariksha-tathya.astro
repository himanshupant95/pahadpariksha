---
import Article from '../../layouts/Article.astro';
import ExamFacts from '../../components/ExamFacts.astro';
import { GROUPS, CHECKED_ON } from '../../data/exam-facts';

const elsewhere = GROUPS.filter((g) => g.page !== '/gk/uttarakhand-pariksha-tathya/');

const faq = [
  { q: 'ये तथ्य कहाँ से लिए गए हैं?', a: 'ये UKPSC के हाल के प्रश्न-पत्रों (2025–26) में पूछे गए उत्तराखंड-विषयों पर आधारित हैं और सरकारी या भरोसेमंद स्रोतों से जाँचे गए हैं। हर तथ्य के नीचे स्रोत दिया है।' },
  { q: 'क्या ये प्रश्न-पत्र के प्रश्न ही हैं?', a: 'नहीं। यहाँ प्रश्न नहीं, उनसे जुड़े तथ्य हैं, ताकि वही बात किसी भी रूप में पूछी जाए तो आप उत्तर दे सकें। आधिकारिक उत्तर के लिए आयोग की अंतिम उत्तर कुंजी देखें।' },
  { q: 'बजट जैसे आँकड़े बदल गए तो?', a: `ये तथ्य ${CHECKED_ON} को जाँचे गए। नया बजट, आर्थिक सर्वेक्षण या पद में बदलाव आने पर हम इन्हें अपडेट करते हैं। कोई त्रुटि दिखे तो संपर्क पेज से बताएँ।` },
];
---
<Article
  title="UKPSC प्रश्नपत्रों से निकले उत्तराखंड के ख़ास तथ्य"
  description="UKPSC के हाल के प्रश्नपत्रों से जुड़े उत्तराखंड के ख़ास तथ्य: संस्थान, आंदोलन, योजनाएँ और पहली बार वाले तथ्य, एक जगह।"
  breadcrumbs={[{ name: 'उत्तराखंड GK', href: '/gk/' }]}
  published="2026-11-21"
  hideHero={true}
  faq={faq}
>
  <div class="keypoints">
    <h2>यह पेज क्यों</h2>
    <ul>
      <li>UKPSC के हाल के प्रश्न-पत्रों के ज़्यादातर उत्तराखंड-विषय इतिहास, भूगोल, राजव्यवस्था, ज़िलों और योजनाओं वाले अध्यायों में विस्तार से हैं।</li>
      <li>जो बातें किसी अध्याय में फिट नहीं होती थीं (बजट, संस्थान, व्यक्तित्व, "जाल" वाले प्रश्न), वे इस पेज पर हैं।</li>
      <li>हर तथ्य के साथ स्रोत है। जाँच की तारीख: <strong>{CHECKED_ON}</strong>।</li>
    </ul>
  </div>

  <div class="note"><b>यह पेज बनाम वर्ष 2025–26 पेज:</b> यहाँ सिर्फ़ वे तथ्य हैं जो <b>UKPSC के असली प्रश्नों</b> से निकले और किसी अध्याय में फिट नहीं हुए। पूरे साल की घटनाएँ (बजट, सूचकांक, कानून, नियुक्तियाँ) एक जगह पढ़नी हों तो <a href="/gk/uttarakhand-varsh-2025-26/">उत्तराखंड वर्ष 2025–26</a> देखें। असली प्रश्न ख़ुद हल करने हों तो <a href="/pyq/">पिछले प्रश्नपत्र</a>।</div>

  <ExamFacts group="gk-economy" heading="1. अर्थव्यवस्था, बजट और संस्थान" intro={false} />
  <ExamFacts group="gk-people" heading="2. व्यक्तित्व और जन-आंदोलन" intro={false} />
  <ExamFacts group="gk-traps" heading="3. जाल वाले प्रश्न: विकल्पों में उत्तराखंड, पर उत्तर कहीं और" intro={false} />

  <h2>बाकी नए तथ्य किन पेजों पर जोड़े गए</h2>
  <ul>
    {elsewhere.map((g) => <li><a href={`${g.page}#pariksha-${g.id}`}>{g.title}</a> ({g.facts.length} तथ्य)</li>)}
  </ul>
  <p>इसके अलावा उत्तराखंड की <a href="/gk/uttarakhand-yojanayen/">सरकारी योजनाएँ</a>, <a href="/gk/districts/">13 ज़िलों की शृंखला</a>, <a href="/history/">इतिहास</a>, <a href="/geography/">भूगोल</a> और <a href="/polity/">राजव्यवस्था</a> के अध्याय भी देखें।</p>
</Article>
