---
import { SITE, NAV } from '../data/site';
import RelatedLinks from '../components/RelatedLinks.astro';

interface Props {
  title: string;
  description?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  schema?: Record<string, unknown>[];
  image?: string;
}

const { title, description = SITE.description, ogType = 'website', noindex = false, schema = [], image } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const fullTitle = Astro.url.pathname === '/' ? `${SITE.name} — ${SITE.tagline}` : `${title} | ${SITE.name}`;
const ogImage = new URL(image ?? '/og-default.jpg', SITE.url).href;

const siteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  alternateName: SITE.nameEn,
  url: SITE.url + '/',
  inLanguage: 'hi-IN',
  publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url + '/', logo: { '@type': 'ImageObject', url: SITE.url + '/logo.png' } },
};
const allSchema = Astro.url.pathname === '/' ? [siteSchema, ...schema] : schema;
const path = Astro.url.pathname;
const enUrl = `https://pahadpariksha-in.translate.goog${path}?_x_tr_sl=hi&_x_tr_tl=en&_x_tr_hl=en`;
---
<!doctype html>
<html lang="hi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-16.png" type="image/png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#14532d" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- font CSS loads without blocking first paint; text shows in the system font for a moment, then swaps -->
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Noto+Sans+Devanagari:wght@400;600;700&display=swap" onload="this.onload=null;this.rel='stylesheet'" />
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+Devanagari:wght@400;600;700&display=swap" /></noscript>

    {allSchema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
    {SITE.gaId && (
      <>
        <script is:inline define:vars={{ gaId: SITE.gaId }}>
          // Owner opt-out: open any page once with ?notrack=1 on your own browser/phone and analytics stays off
          // there for good (undo with ?track=1). Keeps the owner's visits out of GA on any network/IP.
          let off = false;
          try {
            const q = new URLSearchParams(location.search);
            if (q.has('notrack')) localStorage.setItem('pp_notrack', '1');
            if (q.has('track')) localStorage.removeItem('pp_notrack');
            off = localStorage.getItem('pp_notrack') === '1';
          } catch (e) {}
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          window.gtag = gtag;
          if (off) { window['ga-disable-' + gaId] = true; } else {
          gtag('js', new Date());
          gtag('config', gaId);
          // Load the analytics library after the page is ready (or on first interaction) so it doesn't
          // compete with the page itself; the queued commands above are sent once it arrives.
          let loaded = false;
          const load = () => { if (loaded) return; loaded = true; const s = document.createElement('script'); s.async = true; s.src = 'https://www.googletagmanager.com/gtag/js?id=' + gaId; document.head.appendChild(s); };
          ['scroll', 'pointerdown', 'keydown', 'touchstart'].forEach((e) => addEventListener(e, load, { once: true, passive: true }));
          if (document.readyState === 'complete') setTimeout(load, 2500); else addEventListener('load', () => setTimeout(load, 2500), { once: true });
          }
        </script>
      </>
    )}
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap header-inner">
        <a href="/" class="brand" aria-label={SITE.name}>
          <img src="/images/logo-64.png" width="34" height="34" alt="" class="brand-logo" />
          <span class="brand-text notranslate" translate="no">{SITE.name}<small>{SITE.nameEn}</small></span>
        </a>
        <nav aria-label="Main menu / मुख्य मेनू">
          <ul>
            {NAV.map((n) => (
              <li><a href={n.href} aria-current={(n.href === '/' ? path === '/' : path.startsWith(n.href)) ? 'page' : undefined}><span class="en">{n.label}</span><span class="hi">{n.hi}</span></a></li>
            ))}
            <li><a class="nav-en" href={enUrl} rel="nofollow noopener" target="_blank" lang="en" title="Read this page in English (Google Translate)"><span class="en">English</span><span class="hi">अंग्रेज़ी में पढ़ें</span></a></li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="main" class="wrap" data-pagefind-body={noindex ? undefined : true}>
      <slot />
      <RelatedLinks path={path} />
    </main>

    <footer class="site-footer">
      <div class="wrap footer-grid">
        <div>
          <strong class="f-brand notranslate" translate="no">{SITE.name} <span>· {SITE.nameEn}</span></strong>
          <p>Free Hindi-medium preparation for UKSSSC, UKPSC and other Uttarakhand government exams.</p>
          <p class="f-hi">UKSSSC, UKPSC और उत्तराखंड की अन्य भर्ती परीक्षाओं के लिए मुफ्त अध्ययन सामग्री।</p>
        </div>
        <div>
          <strong>Explore <span>· देखें</span></strong>
          <ul>
            <li><a href="/notices/">Notices &amp; Admit Cards <span>· सूचनाएँ</span></a></li>
            <li><a href="/exams/">Exams <span>· परीक्षाएँ</span></a></li>
            <li><a href="/gk/">Uttarakhand GK <span>· सामान्य ज्ञान</span></a></li>
            <li><a href="/quiz/">Practice Quiz <span>· क्विज़</span></a></li>
            <li><a href="/pyq/">Previous Papers <span>· पिछले प्रश्न</span></a></li>
          </ul>
        </div>
        <div>
          <strong>About <span>· साइट</span></strong>
          <ul>
            <li><a href="/about/">About Us <span>· हमारे बारे में</span></a></li>
            <li><a href="/methodology/">Methodology <span>· कार्यप्रणाली</span></a></li>
            <li><a href="/contact/">Contact <span>· संपर्क</span></a></li>
            <li><a href="/privacy-policy/">Privacy Policy <span>· गोपनीयता नीति</span></a></li>
            <li><a href="/disclaimer/">Disclaimer <span>· अस्वीकरण</span></a></li>
          </ul>
        </div>
        <div>
          <strong>Official Websites <span>· आधिकारिक</span></strong>
          <ul>
            <li><a href="https://sssc.uk.gov.in/" rel="noopener" target="_blank">UKSSSC — sssc.uk.gov.in</a></li>
            <li><a href="https://ukssscrecruitment.in/" rel="noopener" target="_blank">UKSSSC Apply — ukssscrecruitment.in</a></li>
            <li><a href="https://psc.uk.gov.in/" rel="noopener" target="_blank">UKPSC — psc.uk.gov.in</a></li>
          </ul>
        </div>
      </div>
      <p class="wrap copy">© {new Date().getFullYear()} <span class="notranslate" translate="no">{SITE.nameEn}</span>. An independent educational website, not affiliated with any government body. · यह एक स्वतंत्र शैक्षिक वेबसाइट है, किसी सरकारी संस्था से संबद्ध नहीं।</p>
    </footer>
    <script is:inline>
      // phones: tables with 3+ columns become labelled cards; keep the active menu item in view
      document.querySelectorAll('main table').forEach(function (t) {
        var heads = t.querySelectorAll('thead th');
        if (heads.length < 3) return;
        var labels = Array.prototype.map.call(heads, function (h) { return h.textContent.trim(); });
        t.querySelectorAll('tbody tr').forEach(function (tr) {
          Array.prototype.forEach.call(tr.children, function (td, i) { if (labels[i]) td.setAttribute('data-label', labels[i]); });
        });
        t.classList.add('stack');
        if (labels[0].length <= 3) t.classList.add('numfirst'); // "#" / "क्र." serial column
      });
      var cur = document.querySelector('.site-header nav a[aria-current="page"]');
      if (cur && window.innerWidth <= 640) cur.scrollIntoView({ inline: 'center', block: 'nearest' });
    </script>
    <script is:inline>
      // Image safety net: if a (hotlinked) Wikimedia image fails, retry once at a smaller, usually cached size;
      // if that also fails, hide the broken box but keep the caption/credit.
      document.addEventListener('error', function (e) {
        var i = e.target;
        if (!i || i.tagName !== 'IMG') return;
        if (!i.dataset.retry && /wikimedia\.org/.test(i.currentSrc || i.src)) {
          i.dataset.retry = '1';
          i.removeAttribute('srcset');
          i.src = (i.currentSrc || i.src).replace('://thumb.', '://upload.').replace(/\/(?:1280|1920|3840)px-/, '/960px-');
        } else {
          i.classList.add('img-failed');
        }
      }, true);
    </script>
  </body>
</html>

<style is:global>
  img.img-failed { display: none; }
  :root {
    --green: #14532d; --green-2: #166534; --green-soft: #ecfdf3; --ink: #1c1917; --muted: #57534e;
    --line: #e7e5e4; --bg: #fafaf9; --card: #fff; --accent: #c2410c; --radius: 12px;
  }
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body { margin: 0; font-family: 'Noto Sans Devanagari', system-ui, -apple-system, 'Segoe UI', sans-serif; color: var(--ink); background: var(--bg); line-height: 1.75; font-size: 17px; }
  .wrap { max-width: 1040px; margin: 0 auto; padding: 0 18px; }
  a { color: var(--green-2); }
  a:hover { color: var(--accent); }
  img { max-width: 100%; height: auto; }
  .skip { position: absolute; left: -999px; }
  .skip:focus { left: 8px; top: 8px; background: #fff; padding: 6px 10px; z-index: 10; }

  .site-header { background: var(--green); color: #fff; position: sticky; top: 0; z-index: 5; }
  .header-inner { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; padding-top: 10px; padding-bottom: 10px; }
  .brand-logo { border-radius: 8px; display: block; }
  .brand { display: flex; align-items: center; gap: 8px; color: #fff; text-decoration: none; font-weight: 700; font-size: 1.25rem; }
  .site-header ul { list-style: none; display: flex; flex-wrap: wrap; gap: 4px; margin: 0; padding: 0; }
  .site-header nav a { color: #dcfce7; text-decoration: none; padding: 4px 10px; border-radius: 8px; font-size: .95rem; display: flex; flex-direction: column; align-items: center; line-height: 1.25; }
  .site-header nav a .en { font-weight: 600; font-family: system-ui, -apple-system, 'Segoe UI', sans-serif; letter-spacing: .01em; }
  .site-header nav a .hi { font-size: .72rem; opacity: .75; }
  .site-header nav a.nav-en { background: #fef3c7; color: #14532d; }
  .site-header nav a.nav-en:hover { background: #fff; color: #14532d; }
  .brand-text { display: flex; flex-direction: column; line-height: 1.15; }
  .brand-text small { font-size: .7rem; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: #bbf7d0; font-family: system-ui, -apple-system, 'Segoe UI', sans-serif; }
  @media (max-width: 640px) {
    .site-header { position: static; }
    .header-inner { gap: 6px; padding-top: 8px; padding-bottom: 6px; }
    .site-header nav { width: 100%; margin: 0 -16px; padding: 0 16px; overflow-x: auto; scrollbar-width: none; -webkit-overflow-scrolling: touch; mask-image: linear-gradient(90deg, #000 88%, transparent); -webkit-mask-image: linear-gradient(90deg, #000 88%, transparent); }
    .site-header nav::-webkit-scrollbar { display: none; }
    .site-header ul { flex-wrap: nowrap; width: max-content; padding-right: 24px; }
    .site-header nav a .hi { display: none; }
    .site-header nav a { padding: 5px 10px; font-size: .9rem; white-space: nowrap; }
  }
  .site-header nav a:hover, .site-header nav a[aria-current='page'] { background: rgba(255,255,255,.14); color: #fff; }

  main { padding-top: 24px; padding-bottom: 48px; min-height: 60vh; }
  h1 { font-size: clamp(1.6rem, 4vw, 2.2rem); line-height: 1.35; margin: .3em 0 .5em; color: var(--green); }
  h2 { font-size: 1.4rem; margin-top: 1.8em; color: var(--green); border-bottom: 2px solid var(--green-soft); padding-bottom: 4px; }
  h3 { font-size: 1.15rem; margin-top: 1.4em; }
  table { width: 100%; border-collapse: collapse; margin: 1em 0; background: var(--card); font-size: .95rem; display: block; overflow-x: auto; }
  thead { background: var(--green-soft); }
  th, td { border: 1px solid var(--line); padding: 8px 10px; text-align: left; vertical-align: top; }
  .table-wrap { overflow-x: auto; }
  @media (max-width: 600px) {
    table.stack { display: block; border: 0; background: none; font-size: .93rem; }
    table.stack thead { display: none; }
    table.stack tbody, table.stack tr, table.stack td { display: block; width: 100%; }
    table.stack tr { background: var(--card); border: 1px solid var(--line); border-radius: 10px; margin-bottom: 10px; padding: 6px 12px; }
    table.stack td { border: 0; border-bottom: 1px dashed var(--line); padding: 6px 0; }
    table.stack td:last-child { border-bottom: 0; }
    table.stack td:first-child { font-weight: 700; color: var(--green); font-size: 1rem; }
    table.stack.numfirst td:first-child { display: inline-block; width: auto; border: 0; padding: 4px 8px 0 0; font-size: .78rem; color: var(--muted); font-weight: 600; }
    table.stack.numfirst td:first-child::before { content: '#'; }
    table.stack.numfirst td:nth-child(2) { display: inline-block; width: auto; border: 0; font-weight: 700; color: var(--green); font-size: 1.05rem; }
    table.stack.numfirst td:nth-child(2)::before { display: none !important; }
    table.stack.numfirst td:nth-child(3) { border-top: 1px dashed var(--line); }
    table.stack td[data-label]:not(:first-child)::before { content: attr(data-label); display: block; font-size: .74rem; font-weight: 600; color: var(--muted); margin-bottom: 1px; }
  }
  .note { background: #fff7ed; border-left: 4px solid var(--accent); padding: 10px 14px; border-radius: 6px; margin: 1em 0; }
  .keypoints { background: var(--green-soft); border-radius: var(--radius); padding: 12px 18px; margin: 1em 0; }
  .keypoints h2 { border: 0; margin-top: .3em; font-size: 1.15rem; }
  .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 14px; margin: 1em 0; }
  .card { background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); padding: 16px; text-decoration: none; color: inherit; display: block; transition: border-color .15s, transform .15s; }
  a.card:hover { border-color: var(--green-2); transform: translateY(-2px); color: inherit; }
  .card h3 { margin: 0 0 6px; color: var(--green); font-size: 1.08rem; }
  .card p { margin: 0; color: var(--muted); font-size: .93rem; }
  .btn { display: inline-block; background: var(--green-2); color: #fff; padding: 10px 18px; border-radius: 10px; text-decoration: none; font-weight: 600; border: 0; cursor: pointer; font: inherit; }
  .btn:hover { background: var(--green); color: #fff; }
  .muted { color: var(--muted); font-size: .92rem; }

  .site-footer { background: #1c1917; color: #d6d3d1; padding: 28px 0 10px; font-size: .93rem; }
  .site-footer a { color: #bbf7d0; text-decoration: none; }
  .footer-grid { display: grid; grid-template-columns: 1.3fr repeat(3, 1fr); gap: 24px; }
  @media (max-width: 860px) { .footer-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 520px) { .footer-grid { grid-template-columns: 1fr; } }
  .site-footer strong { color: #fff; }
  .site-footer strong span, .footer-grid li a span { color: #a8a29e; font-weight: 400; font-size: .85em; }
  .f-brand { font-size: 1.05rem; }
  .f-hi { color: #a8a29e; font-size: .88rem; }
  .footer-grid li { margin: 4px 0; }
  .footer-grid ul { list-style: none; padding: 0; margin: 6px 0; }
  .copy { border-top: 1px solid #44403c; padding-top: 10px; margin-top: 18px; font-size: .85rem; color: #a8a29e; }
</style>
