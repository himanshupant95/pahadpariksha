---
// Original layered-ridge Himalayan illustration (pure SVG, ~3 KB, no image request).
---
<svg class="hero-art" viewBox="0 0 1200 420" preserveAspectRatio="xMidYMax slice" aria-hidden="true">
  <defs>
    <linearGradient id="sky" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#fef3c7"/><stop offset=".55" stop-color="#fde7c2"/><stop offset="1" stop-color="#ecfdf3"/>
    </linearGradient>
    <linearGradient id="snow" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#ffffff"/><stop offset="1" stop-color="#d6e4ef"/>
    </linearGradient>
    <linearGradient id="fade" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#fffbeb" stop-opacity=".75"/><stop offset=".55" stop-color="#fffbeb" stop-opacity="0"/>
    </linearGradient>
  </defs>
  <rect width="1200" height="420" fill="url(#sky)"/>
  <g transform="translate(0 95)">
  <circle cx="930" cy="120" r="54" fill="#fdba74" opacity=".85"/>
  <!-- birds -->
  <path d="M700 90q8-8 16 0q8-8 16 0M760 120q6-6 12 0q6-6 12 0" fill="none" stroke="#78716c" stroke-width="2" stroke-linecap="round"/>
  <!-- snow peaks -->
  <path d="M0 260 L120 170 L190 215 L330 80 L420 175 L520 110 L640 200 L760 95 L880 190 L1000 130 L1120 200 L1200 160 L1200 420 L0 420Z" fill="#94a3b8"/>
  <path d="M330 80 L370 122 L350 118 L335 132 L318 116 L298 120Z M760 95 L798 135 L776 130 L762 145 L746 128 L726 133Z M520 110 L548 140 L532 137 L520 148 L508 138 L494 141Z M1000 130 L1028 158 L1012 155 L1000 165 L988 156 L974 159Z" fill="url(#snow)"/>
  <!-- far ridge -->
  <path d="M0 290 C120 240 220 270 320 235 C430 200 520 260 640 230 C760 200 860 255 980 225 C1080 200 1150 230 1200 220 L1200 420 L0 420Z" fill="#4d7c5f" opacity=".75"/>
  <!-- mid ridge with pines -->
  <path d="M0 330 C140 285 260 320 380 290 C500 262 600 310 720 285 C860 255 980 310 1200 270 L1200 420 L0 420Z" fill="#2f6b45"/>
  <g fill="#1f5133">
    <path d="M150 312l10-28 10 28zM175 306l8-22 8 22zM860 286l10-28 10 28zM885 292l8-22 8 22zM1040 290l9-26 9 26z"/>
  </g>
  <!-- river -->
  <path d="M520 420 C560 380 600 372 640 350 C690 322 720 330 760 312" fill="none" stroke="#bae6fd" stroke-width="10" stroke-linecap="round" opacity=".9"/>
  <!-- near ridge -->
  <path d="M0 370 C160 335 300 365 460 345 C600 328 700 372 860 350 C1000 332 1100 360 1200 345 L1200 420 L0 420Z" fill="#14532d"/>
  <!-- small temple -->
  <g fill="#0f3d22" transform="translate(260 318)">
    <path d="M10 30V14h20v16Z"/><path d="M8 14 20 0l12 14Z"/><path d="M19 0v-8h2v8"/><path d="M21-8l8 3-8 3"/>
  </g>
  </g>
  <rect width="1200" height="420" fill="url(#fade)"/>
</svg>

<style>
  .hero-art { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 0; }
</style>
