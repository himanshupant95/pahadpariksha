---
import type { NewsItem } from '../lib/news';
interface Props { items: NewsItem[]; compact?: boolean }
const { items, compact = false } = Astro.props;
const time = (d: string) => new Date(d).toLocaleString('hi-IN', { timeZone: 'Asia/Kolkata', ...(compact ? { day: 'numeric', month: 'short' } : { hour: '2-digit', minute: '2-digit' }) });
---
<ul class={`news ${compact ? 'compact' : ''}`}>
  {items.map((n) => (
    <li data-cat={n.cat} class={n.score >= 6 ? 'imp' : undefined}>
      <div class="n-meta">
        <span class="cat">{n.cat}</span>
        {n.score >= 6 && <span class="star" title="परीक्षा की दृष्टि से अधिक महत्वपूर्ण">★ महत्वपूर्ण</span>}
        {n.lang === 'en' && <span class="en">EN</span>}
        <time datetime={n.published}>{time(n.published)}</time>
      </div>
      <a href={n.link} target="_blank" rel="noopener nofollow" lang={n.lang}>{n.title}</a>
      {!compact && <div class="srcs">स्रोत: {n.source}{n.sources?.length ? ` + ${n.sources.length} अन्य` : ''}</div>}
    </li>
  ))}
</ul>

<style is:global>
  .news { list-style: none; margin: 0; padding: 0; }
  .news li { background: var(--card); border: 1px solid var(--line); border-radius: 10px; padding: 10px 14px; margin-bottom: 8px; }
  .news li.imp { border-left: 4px solid var(--accent); }
  .news.compact li { padding: 8px 12px; margin-bottom: 6px; }
  .news .n-meta { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; font-size: .78rem; color: var(--muted); margin-bottom: 2px; }
  .news .cat { background: var(--green-soft); color: var(--green); padding: 0 8px; border-radius: 20px; }
  .news .star { background: #fff7ed; color: #9a3412; padding: 0 8px; border-radius: 20px; font-weight: 700; }
  .news .en { border: 1px solid var(--line); padding: 0 6px; border-radius: 20px; }
  .news a { text-decoration: none; color: var(--ink); font-weight: 600; line-height: 1.55; display: block; }
  .news a:hover { color: var(--green-2); text-decoration: underline; }
  .news.compact a { font-size: .93rem; font-weight: 500; }
  .news .srcs { font-size: .78rem; color: var(--muted); margin-top: 2px; }
</style>
