---
import type { Point } from '../lib/digest';
import { byCategory } from '../lib/digest';
import PointList from './PointList.astro';
interface Props { kind: 'साप्ताहिक' | 'मासिक'; label: string; items: Point[]; prev?: { href: string; label: string }; next?: { href: string; label: string } }
const { kind, label, items, prev, next } = Astro.props;
const top = items.filter((p) => p.imp >= 3).sort((a, b) => a.date.localeCompare(b.date));
const groups = byCategory(items);
const tags = [...new Set(items.filter((p) => p.tag).map((p) => p.tag))];
---
<div class="print-brand">पहाड़ परीक्षा · pahadpariksha.in — उत्तराखंड करेंट अफेयर्स</div>
<h1>उत्तराखंड करेंट अफेयर्स: {kind} संकलन <span class="sub">{label}</span></h1>
<p class="lead">{items.length} परीक्षा-उपयोगी बिंदु, जिनमें <strong>{top.length} अति महत्वपूर्ण (★)</strong>। विषयवार क्रम में, हर बिंदु के साथ तिथि और स्रोत।</p>
<div class="actions no-print">
  <button type="button" class="pdf-btn" onclick="window.print()">⬇ PDF डाउनलोड / प्रिंट करें</button>
  <small class="muted">बटन दबाकर "Save as PDF" चुनें — फ़ोन पर भी काम करता है।</small>
</div>

{items.length === 0 ? <p class="muted">इस अवधि के बिंदु अभी उपलब्ध नहीं।</p> : (<>
  {top.length > 0 && (<section>
    <h2>★ सबसे महत्वपूर्ण ({top.length})</h2>
    <PointList items={top} showDate numbered compact />
  </section>)}

  <h2>विषयवार सभी बिंदु</h2>
  {groups.map(([cat, list]) => (
    <section class="cat-sec">
      <h3>{cat} <small class="muted">({list.length})</small></h3>
      <PointList items={list} showDate showCat={false} numbered />
    </section>
  ))}

  {tags.length > 0 && (<section class="tags-sec">
    <h2>त्वरित दोहराव — मुख्य शब्द</h2>
    <p class="tags">{tags.map((t) => <span>{t}</span>)}</p>
  </section>)}
</>)}

<nav class="pn no-print">
  {prev ? <a href={prev.href}>← {prev.label}</a> : <span />}
  <a href="/current-affairs/">सभी करेंट अफेयर्स</a>
  {next ? <a href={next.href}>{next.label} →</a> : <span />}
</nav>
<p class="note">बिंदु समाचार शीर्षकों से AI सहायता द्वारा संकलित हैं और मूल स्रोत से जुड़े हैं। परीक्षा में लिखने से पहले आधिकारिक स्रोत से पुष्टि करें।</p>
<div class="print-brand foot">© पहाड़ परीक्षा · pahadpariksha.in — मुफ़्त अध्ययन सामग्री, उत्तराखंड की परीक्षाओं के लिए</div>

<style>
  h1 .sub { display: block; font-size: 1.05rem; color: var(--muted); font-weight: 600; margin-top: 4px; }
  .lead { margin-top: 4px; }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin: 10px 0 18px; }
  .pdf-btn { font: inherit; font-weight: 700; background: var(--accent); color: #fff; border: 0; border-radius: 10px; padding: 9px 18px; cursor: pointer; }
  .cat-sec h3 { margin-top: 18px; color: var(--green); }
  .tags span { display: inline-block; background: var(--green-soft); color: var(--green); border-radius: 20px; padding: 2px 10px; margin: 3px; font-size: .88rem; }
  .pn { display: flex; justify-content: space-between; gap: 10px; margin: 24px 0 8px; font-weight: 600; }
  .print-brand { display: none; }
  @media print {
    @page { size: A4; margin: 14mm 12mm; }
    :global(.site-header), :global(.site-footer), :global(.breadcrumbs), .no-print { display: none !important; }
    .print-brand { display: block; font-size: 9pt; color: #555; border-bottom: 1px solid #ccc; padding-bottom: 4px; margin-bottom: 10px; }
    .print-brand.foot { border: 0; border-top: 1px solid #ccc; padding-top: 4px; margin-top: 14px; }
    :global(body) { background: #fff !important; font-size: 10.5pt; }
    :global(.points li) { break-inside: avoid; border: 0 !important; border-bottom: 1px solid #ddd !important; border-radius: 0 !important; margin: 0 !important; padding: 5px 4px 5px 34px !important; }
    :global(.points li::before) { top: 6px !important; left: 4px !important; }
    :global(.points .src a) { color: #555; text-decoration: none; }
    h2, h3 { break-after: avoid; }
    .note { font-size: 8.5pt; }
  }
</style>
