<figure class="diagram">
<svg viewBox="0 0 900 400" role="img" aria-labelledby="at-t"><title id="at-t">ऊँचाई के साथ तापमान घटता है (लगभग 6.5 डिग्री सेल्सियस प्रति किलोमीटर) और सर्दियों की रात में घाटियों में तापमान व्युत्क्रमण होता है; धूप वाला दक्षिणी ढाल गर्म और छायादार उत्तरी ढाल ठंडा रहता है</title>
  <rect width="900" height="400" fill="#f8fafc"/>
  <!-- left: lapse ladder -->
  <g font-size="13.5">
    <text x="30" y="34" font-size="15" font-weight="700" fill="#0f172a">1. ऊँचाई ↑ तापमान ↓</text>
    <line x1="80" y1="60" x2="80" y2="370" stroke="#334155" stroke-width="2"/>
    <g fill="#1f2937">
      <rect x="90" y="62" width="260" height="56" fill="#e0f2fe"/><text x="100" y="86" font-weight="700">~4,000 मी — लगभग 10°C</text><text x="100" y="106" fill="#475569">ठंडा, बुग्याल/हिम क्षेत्र</text>
      <rect x="90" y="138" width="260" height="56" fill="#dcfce7"/><text x="100" y="162" font-weight="700">~2,000 मी — लगभग 23°C</text><text x="100" y="182" fill="#475569">नैनीताल-मसूरी जैसी ठंडक</text>
      <rect x="90" y="214" width="260" height="56" fill="#fef3c7"/><text x="100" y="238" font-weight="700">~1,000 मी — लगभग 30°C</text><text x="100" y="258" fill="#475569">घाटियाँ, निचले पहाड़</text>
      <rect x="90" y="290" width="260" height="56" fill="#fee2e2"/><text x="100" y="314" font-weight="700">~300 मी — लगभग 35°C</text><text x="100" y="334" fill="#475569">तराई-भाबर (उदाहरण: गर्मी की दोपहर)</text>
    </g>
    <text x="30" y="392" font-size="12" fill="#57534e">औसत ताप-ह्रास दर ~6.5°C/किमी — आँकड़े केवल समझाने हेतु उदाहरण</text>
  </g>
  <!-- right: valley inversion -->
  <g transform="translate(420,0)">
    <text x="10" y="34" font-size="15" font-weight="700" fill="#0f172a">2. सर्दी की रात: घाटी में व्युत्क्रमण</text>
    <path d="M10,90 L150,250 C180,290 280,290 310,250 L460,90 L460,330 L10,330 Z" fill="#a8a29e"/>
    <path d="M150,250 C180,290 280,290 310,250 C290,262 170,262 150,250 Z" fill="#cbd5e1" opacity=".9"/>
    <ellipse cx="230" cy="268" rx="90" ry="14" fill="#e2e8f0" opacity=".95"/>
    <text x="230" y="300" font-size="13" text-anchor="middle" fill="#0f172a" font-weight="700">ठंडी भारी हवा + पाला/कोहरा</text>
    <g stroke="#0369a1" stroke-width="2.5" fill="none"><path d="M60,120 C100,170 130,210 160,240"/><path d="M410,120 C370,170 340,210 300,240"/></g>
    <text x="40" y="112" font-size="12.5" fill="#0369a1">ठंडी हवा ढाल से नीचे बहती</text>
    <rect x="160" y="150" width="140" height="40" rx="6" fill="#fef3c7" stroke="#d97706"/>
    <text x="230" y="175" font-size="13" text-anchor="middle" fill="#92400e" font-weight="700">ढाल की बीच ऊँचाई गर्म</text>
    <text x="10" y="356" font-size="13" fill="#1f2937">परिणाम: घाटी-तल पर पाला, ढालों पर बाग़ (सेब/फल) व बस्तियाँ</text>
    <text x="10" y="376" font-size="13" fill="#1f2937">धूप वाला दक्षिणी ढाल गर्म-सूखा, उत्तरी ढाल ठंडा-नम (घने वन)</text>
  </g>
</svg>
<figcaption>पहाड़ों में तापमान केवल ऊँचाई से नहीं, ढाल-दिशा (धूप/छाया) और घाटी की बनावट से भी तय होता है — इसीलिए एक ही ऊँचाई पर दो गाँवों की जलवायु अलग हो सकती है।<span class="cr">चित्र: पहाड़ परीक्षा</span></figcaption>
</figure>
