<figure class="diagram">
<svg viewBox="0 0 900 430" role="img" aria-labelledby="mw-t"><title id="mw-t">उत्तराखंड में वर्षा लाने वाली दो प्रमुख प्रणालियाँ: गर्मियों में बंगाल की खाड़ी से आता दक्षिण-पश्चिम मानसून और सर्दियों में पश्चिम से आते पश्चिमी विक्षोभ</title>
  <defs>
    <marker id="mw-a" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0,0 L10,5 L0,10 z" fill="#0369a1"/></marker>
    <marker id="mw-b" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0,0 L10,5 L0,10 z" fill="#7c3aed"/></marker>
  </defs>
  <rect width="900" height="430" fill="#eff6ff"/>
  <!-- land -->
  <path d="M60,40 L840,40 L860,120 L780,190 L700,250 L640,330 L560,410 L470,410 L420,330 L380,300 L300,300 L230,250 L170,230 L120,170 L60,150 Z" fill="#f5f0e1" stroke="#a8a29e"/>
  <!-- Himalaya band -->
  <path d="M120,96 C260,60 420,70 560,96 C640,110 720,120 800,110 L812,138 C720,150 640,140 560,126 C420,100 260,94 128,124 Z" fill="#a8a29e" opacity=".85"/>
  <text x="640" y="134" font-size="14" font-weight="700" fill="#44403c">हिमालय</text>
  <!-- Uttarakhand -->
  <path d="M400,96 L470,92 L486,118 L452,132 L404,124 Z" fill="#16a34a" stroke="#14532d" stroke-width="1.5"/>
  <text x="440" y="152" font-size="15" font-weight="700" fill="#14532d" text-anchor="middle">उत्तराखंड</text>
  <!-- Bay of Bengal -->
  <text x="760" y="320" font-size="14" fill="#1e3a8a" font-weight="600">बंगाल की खाड़ी</text>
  <text x="140" y="330" font-size="14" fill="#1e3a8a" font-weight="600">अरब सागर</text>
  <!-- monsoon arrows -->
  <path d="M760,290 C720,230 660,190 600,170 C560,158 520,150 490,140" fill="none" stroke="#0369a1" stroke-width="5" marker-end="url(#mw-a)"/>
  <path d="M700,300 C650,240 600,210 540,190" fill="none" stroke="#0369a1" stroke-width="3" stroke-dasharray="8 6" marker-end="url(#mw-a)"/>
  <path d="M190,320 C240,270 300,230 360,190" fill="none" stroke="#0369a1" stroke-width="3" stroke-dasharray="8 6" marker-end="url(#mw-a)"/>
  <!-- WD arrow -->
  <path d="M20,70 C120,60 240,70 360,92" fill="none" stroke="#7c3aed" stroke-width="5" marker-end="url(#mw-b)"/>
  <!-- labels -->
  <g font-size="13.5">
    <rect x="560" y="200" width="320" height="86" rx="8" fill="#fff" fill-opacity=".92" stroke="#0369a1"/>
    <text x="572" y="222" font-weight="700" fill="#0369a1">दक्षिण-पश्चिम मानसून (जून–सितंबर)</text>
    <text x="572" y="242" fill="#1f2937">बंगाल की खाड़ी शाखा पूर्व से पश्चिम की ओर</text>
    <text x="572" y="260" fill="#1f2937">हिमालय के साथ मुड़ती है · वार्षिक वर्षा का ~78%</text>
    <text x="572" y="278" fill="#64748b">(अरब सागर शाखा का योगदान कम — धराशायी तीर)</text>
    <rect x="20" y="164" width="300" height="72" rx="8" fill="#fff" fill-opacity=".92" stroke="#7c3aed"/>
    <text x="32" y="186" font-weight="700" fill="#7c3aed">पश्चिमी विक्षोभ (दिसंबर–मार्च)</text>
    <text x="32" y="206" fill="#1f2937">भूमध्य सागर क्षेत्र से उठे निम्न-दाब तंत्र</text>
    <text x="32" y="224" fill="#1f2937">ऊँचाई पर हिमपात, नीचे वर्षा · रबी के लिए वरदान</text>
  </g>
  <text x="20" y="418" font-size="12" fill="#57534e">रेखाचित्र — पैमाने पर नहीं · मौसमी हिस्सा IMD "Climate of Uttarakhand" (सामान्य 1961–2010) के अनुसार</text>
</svg>
<figcaption>उत्तराखंड की वर्षा के दो इंजन: गर्मियों में बंगाल की खाड़ी से आया मानसून (लगभग 78% वर्षा) और सर्दियों में पश्चिम से आते पश्चिमी विक्षोभ (शीतकालीन वर्षा व हिमपात)।<span class="cr">चित्र: पहाड़ परीक्षा</span></figcaption>
</figure>
