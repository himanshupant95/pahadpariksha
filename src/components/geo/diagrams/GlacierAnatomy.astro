<figure class="diagram">
<svg viewBox="0 0 900 420" role="img" aria-labelledby="ga-t"><title id="ga-t">हिमनद की संरचना — संचय क्षेत्र, हिम-रेखा, अपक्षय क्षेत्र, मोरेन, स्नाउट, हिमनदीय झील</title>
  <rect width="900" height="420" fill="#e0f2fe"/>
  <path d="M0,40 L90,20 L150,60 L210,30 L270,80 L330,60 L400,120 L900,300 L900,420 L0,420 Z" fill="#a8a29e"/>
  <!-- glacier body -->
  <path d="M60,70 Q160,60 260,110 Q420,170 560,236 Q610,258 640,280 Q600,292 540,282 Q420,250 300,200 Q170,150 70,120 Z" fill="#f8fafc" stroke="#0369a1" stroke-width="2"/>
  <!-- ELA -->
  <path d="M330,120 L330,230" stroke="#dc2626" stroke-width="2.5" stroke-dasharray="8 5"/>
  <text x="336" y="128" font-size="13.5" font-weight="700" fill="#b91c1c">हिम-रेखा / संतुलन रेखा (ELA)</text>
  <!-- crevasses -->
  <g stroke="#0c4a6e" stroke-width="1.5"><path d="M380,175 l10,22"/><path d="M405,186 l10,22"/><path d="M430,198 l10,22"/></g>
  <text x="372" y="168" font-size="12" fill="#0c4a6e">दरारें (क्रेवास)</text>
  <!-- moraines -->
  <path d="M300,200 Q420,252 540,282" fill="none" stroke="#57534e" stroke-width="7" stroke-linecap="round" stroke-dasharray="1 9"/>
  <path d="M640,280 Q660,300 650,320 Q630,330 600,322" fill="#78716c"/>
  <!-- proglacial lake + stream -->
  <ellipse cx="700" cy="320" rx="46" ry="14" fill="#38bdf8" stroke="#0369a1"/>
  <path d="M746,322 Q800,330 900,345" fill="none" stroke="#0284c7" stroke-width="5"/>
  <path d="M642,286 Q660,300 670,310" stroke="#0284c7" stroke-width="3" fill="none"/>
  <!-- labels -->
  <g font-size="15" font-weight="700" fill="#0c4a6e">
    <text x="90" y="104">संचय क्षेत्र</text>
    <text x="440" y="270">अपक्षय (क्षरण) क्षेत्र</text>
  </g>
  <g font-size="12.5" fill="#1e293b">
    <text x="90" y="160">यहाँ हर वर्ष जितनी बर्फ गिरती है,</text><text x="90" y="176">उससे कम पिघलती है → हिम जमा होता है</text>
    <text x="440" y="300">यहाँ पिघलना अधिक → बर्फ घटती है</text>
    <text x="610" y="356">अंतिम (अग्र) मोरेन</text>
    <text x="670" y="300">स्नाउट (मुहाना)</text>
    <text x="700" y="372">हिमनदीय झील — मोरेन-बाँध से रुकी</text>
    <text x="780" y="322">नदी</text>
    <text x="210" y="226">पार्श्व मोरेन (किनारे का मलबा)</text>
  </g>
  <g font-size="12.5" fill="#1e293b">
    <text x="20" y="22">↓ बर्फबारी → फ़र्न (दानेदार हिम) → दबकर हिमनद-बर्फ</text>
  </g>
  <path d="M120,96 Q300,150 600,268" fill="none" stroke="#0369a1" stroke-width="2" marker-end="url(#ga-a)" opacity=".7"/>
  <defs><marker id="ga-a" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0,0 L10,5 L0,10 z" fill="#0369a1"/></marker></defs>
  <text x="170" y="138" font-size="12" fill="#0369a1" transform="rotate(16 170 138)">हिम का बहाव →</text>
</svg>
<figcaption>हिमनद के भाग। यदि संचय से अधिक पिघलन हो तो स्नाउट पीछे खिसकता है (glacier retreat)। मोरेन से रुकी झील टूटे तो GLOF (हिमनदीय झील विस्फोट बाढ़) आती है।<span class="cr">चित्र: पहाड़ परीक्षा</span></figcaption>
</figure>
