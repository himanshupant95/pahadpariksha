<figure class="diagram">
<svg viewBox="0 0 900 360" role="img" aria-labelledby="or-t"><title id="or-t">पर्वतीय (उच्चावच) वर्षा: नम हवा पहाड़ से टकराकर ऊपर उठती है, ठंडी होकर बरसती है; पहाड़ के पीछे वृष्टि-छाया में कम वर्षा</title>
  <defs><marker id="or-a" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0,0 L10,5 L0,10 z" fill="#0369a1"/></marker></defs>
  <rect width="900" height="360" fill="#f0f9ff"/>
  <path d="M0,320 L250,320 C330,300 380,220 450,120 C480,80 500,70 520,90 C560,140 600,230 660,280 C700,305 760,315 900,318 L900,360 L0,360 Z" fill="#a8a29e"/>
  <path d="M450,120 C480,80 500,70 520,90 L512,96 C495,82 482,88 462,120 Z" fill="#fff"/>
  <!-- moist air -->
  <path d="M30,290 L230,290 C300,280 350,230 400,170" fill="none" stroke="#0369a1" stroke-width="5" marker-end="url(#or-a)"/>
  <text x="30" y="276" font-size="14" font-weight="700" fill="#0369a1">नम मानसूनी हवा →</text>
  <!-- clouds + rain windward -->
  <g fill="#94a3b8">
    <ellipse cx="380" cy="120" rx="70" ry="30"/><ellipse cx="430" cy="100" rx="55" ry="28"/><ellipse cx="330" cy="135" rx="45" ry="22"/>
  </g>
  <g stroke="#2563eb" stroke-width="2.5" stroke-linecap="round">
    <path d="M320,165 l-8,22"/><path d="M345,162 l-8,22"/><path d="M370,160 l-8,22"/><path d="M395,158 l-8,22"/><path d="M420,150 l-8,22"/><path d="M345,195 l-8,22"/><path d="M380,190 l-8,22"/>
  </g>
  <!-- dry descending air -->
  <path d="M540,95 C600,140 660,200 760,250" fill="none" stroke="#d97706" stroke-width="4" stroke-dasharray="10 6" marker-end="url(#or-a)"/>
  <g font-size="13.5">
    <text x="30" y="40" font-weight="700" fill="#1e3a8a">पवनमुखी ढाल (windward)</text>
    <text x="30" y="58" fill="#1f2937">हवा ऊपर उठी → ठंडी हुई → संघनन → भारी वर्षा</text>
    <text x="590" y="36" font-weight="700" fill="#92400e">पवनविमुखी ढाल / वृष्टि-छाया</text>
    <text x="590" y="54" fill="#1f2937">उतरती हवा गर्म व सूखी → कम वर्षा</text>
    <text x="590" y="72" fill="#64748b">उदा. नीति-माणा, ऊपरी दारमा-व्यास, नेलांग</text>
  </g>
  <text x="20" y="348" font-size="12" fill="#57534e">रेखाचित्र — पैमाने पर नहीं</text>
</svg>
<figcaption>पर्वतीय वर्षा: दक्षिण की ओर खुली ढालों और ऊँचे अवरोधों (जैसे पिथौरागढ़-मुनस्यारी, देहरादून-मसूरी) पर अधिक वर्षा; वृहत हिमालय के उत्तर की घाटियाँ वृष्टि-छाया में सूखी।<span class="cr">चित्र: पहाड़ परीक्षा</span></figcaption>
</figure>
