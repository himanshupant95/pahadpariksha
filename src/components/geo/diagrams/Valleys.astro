<figure class="diagram">
<svg viewBox="0 0 900 300" role="img" aria-labelledby="vv-t"><title id="vv-t">नदी की V-आकार घाटी और हिमनद की U-आकार घाटी, लटकती घाटी, सर्क, अरेत, गिरिशृंग</title>
  <rect width="900" height="300" fill="#f8fafc"/>
  <g transform="translate(20,20)">
    <path d="M0,40 L150,230 L170,230 L320,40 L320,260 L0,260 Z" fill="#d6d3d1" stroke="#57534e" stroke-width="2"/>
    <path d="M148,228 H172" stroke="#2563eb" stroke-width="6"/>
    <text x="160" y="22" text-anchor="middle" font-size="16" font-weight="700" fill="#1c1917">V-आकार घाटी (नदी)</text>
    <text x="160" y="285" text-anchor="middle" font-size="12.5" fill="#334155">नदी नीचे की ओर काटती है — गहरे, संकरे गॉर्ज</text>
  </g>
  <g transform="translate(470,20)">
    <path d="M0,30 L40,30 Q60,220 200,232 Q340,220 360,30 L400,30 L400,260 L0,260 Z" fill="#d6d3d1" stroke="#57534e" stroke-width="2"/>
    <path d="M330,90 L400,90" stroke="#57534e" stroke-width="2"/><path d="M340,90 Q352,150 360,150" fill="none" stroke="#2563eb" stroke-width="3"/>
    <path d="M180,230 H220" stroke="#2563eb" stroke-width="5"/>
    <text x="200" y="14" text-anchor="middle" font-size="16" font-weight="700" fill="#1c1917">U-आकार घाटी (हिमनद)</text>
    <text x="300" y="80" font-size="12" fill="#334155" text-anchor="end">लटकती घाटी →</text>
    <text x="200" y="285" text-anchor="middle" font-size="12.5" fill="#334155">हिमनद पूरी घाटी को घिसकर चौड़ा, सपाट तल बनाता है</text>
  </g>
</svg>
<figcaption>उत्तराखंड में दोनों दिखते हैं: निचले भागों में नदियों की गहरी V-घाटियाँ (जैसे अलकनंदा-भागीरथी के गॉर्ज) और ऊँचाई पर हिमनदों की U-घाटियाँ (जैसे गोमुख-तपोवन, फूलों की घाटी का ऊपरी भाग)।<span class="cr">चित्र: पहाड़ परीक्षा</span></figcaption>
</figure>
