<figure class="diagram">
<svg viewBox="0 0 900 430" role="img" aria-labelledby="hs-t"><title id="hs-t">हिमालय का अनुप्रस्थ काट: दक्षिण में गंगा मैदान से उत्तर में तिब्बत तक — HFT, MBT, MCT, STD</title>
  <rect width="900" height="430" fill="#f8fafc"/>
  <!-- underthrusting Indian plate -->
  <path d="M0,330 L900,250 L900,430 L0,430 Z" fill="#cbd5e1"/>
  <path d="M0,330 Q300,300 520,286 Q700,270 900,250" fill="none" stroke="#334155" stroke-width="2.5" stroke-dasharray="10 6"/>
  <text x="560" y="310" font-size="13" font-weight="700" fill="#1e293b">मुख्य हिमालयी क्षेप (MHT) — भारतीय प्लेट इसी तल पर नीचे खिसकती है</text>
  <text x="40" y="400" font-size="15" font-weight="700" fill="#334155">भारतीय प्लेट →</text>
  <!-- terrains (south→north) -->
  <path d="M0,230 H120 L150,330 L0,330 Z" fill="#d9f99d"/>
  <path d="M120,230 Q150,190 190,205 Q215,190 240,215 L262,318 L150,330 Z" fill="#fde68a"/>
  <path d="M240,215 Q300,150 360,170 Q420,130 470,160 Q520,140 555,170 L560,290 L262,318 Z" fill="#fdba74"/>
  <path d="M555,170 Q600,70 640,90 Q680,40 720,85 L735,272 L560,290 Z" fill="#e2e8f0"/>
  <path d="M720,85 Q760,95 800,110 Q850,120 900,118 L900,250 L735,272 Z" fill="#c4b5fd"/>
  <!-- snow -->
  <path d="M608,96 L640,90 L662,70 L680,40 L700,64 L720,85 L690,82 L660,92 Z" fill="#fff"/>
  <!-- thrust lines -->
  <g stroke="#b91c1c" stroke-width="2.5" fill="none">
    <path d="M120,230 L150,330"/><path d="M240,215 L262,318"/><path d="M555,170 L560,290"/>
  </g>
  <path d="M720,85 L735,272" stroke="#7c3aed" stroke-width="2.5" stroke-dasharray="6 4" fill="none"/>
  <g font-size="14" font-weight="700" fill="#b91c1c" text-anchor="middle">
    <text x="118" y="222">HFT</text><text x="238" y="206">MBT</text><text x="552" y="160">MCT</text>
  </g>
  <text x="722" y="76" font-size="14" font-weight="700" fill="#6d28d9" text-anchor="middle">STD</text>
  <!-- labels -->
  <g font-size="13.5" font-weight="700" fill="#1c1917" text-anchor="middle">
    <text x="60" y="270">गंगा मैदान</text><text x="60" y="288">(तराई-भाबर)</text>
    <text x="192" y="262">शिवालिक</text><text x="192" y="280">(उप-हिमालय)</text>
    <text x="400" y="232">लघु हिमालय</text><text x="400" y="250">(हिमाचल)</text>
    <text x="645" y="190">वृहत हिमालय</text><text x="645" y="208">(हिमाद्रि)</text>
    <text x="815" y="170">टेथिस हिमालय</text><text x="815" y="188">→ तिब्बत</text>
  </g>
  <g font-size="11.5" fill="#334155" text-anchor="middle">
    <text x="192" y="300">नई, ढीली तलछटी चट्टानें</text>
    <text x="400" y="272">पुरानी तलछटी + कायांतरित चट्टानें</text>
    <text x="645" y="232">उच्च कायांतरित क्रिस्टलीय</text><text x="645" y="246">चट्टानें व ग्रेनाइट</text>
    <text x="815" y="208">जीवाश्मयुक्त समुद्री तलछट</text>
  </g>
  <text x="20" y="28" font-size="16" font-weight="700" fill="#14532d">दक्षिण ←</text>
  <text x="880" y="28" font-size="16" font-weight="700" fill="#14532d" text-anchor="end">→ उत्तर</text>
  <g font-size="12" fill="#334155">
    <text x="20" y="50">HFT = हिमालयी अग्र क्षेप (Himalayan Frontal Thrust) · MBT = मुख्य सीमांत क्षेप (Main Boundary Thrust)</text>
    <text x="20" y="66">MCT = मुख्य केंद्रीय क्षेप (Main Central Thrust) · STD = दक्षिण तिब्बत विच्छेद (South Tibetan Detachment, सामान्य भ्रंश)</text>
  </g>
</svg>
<figcaption>हिमालय का सरलीकृत अनुप्रस्थ काट। दक्षिण से उत्तर की ओर हर बड़ा "क्षेप" (thrust) एक भू-खंड को दूसरे पर चढ़ाता है। उत्तराखंड में MCT को मुनस्यारी थ्रस्ट (MCT-I) और वैकृता थ्रस्ट (MCT-II) के रूप में भी पहचाना जाता है।<span class="cr">चित्र: पहाड़ परीक्षा · आधार: Valdiya; Jain et al. (Virtual Explorer, 2014); Dal Zilio et al. (2021)</span></figcaption>
</figure>
