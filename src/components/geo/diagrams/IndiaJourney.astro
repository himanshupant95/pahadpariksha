<figure class="diagram">
<svg viewBox="0 0 760 470" role="img" aria-labelledby="ij-t"><title id="ij-t">भारतीय प्लेट की उत्तर की ओर यात्रा और यूरेशिया से टक्कर</title>
  <rect width="760" height="470" fill="#dbeafe"/>
  <!-- Eurasia -->
  <path d="M0,0 H760 V92 Q640,110 560,96 Q470,82 380,104 Q300,120 220,98 Q120,80 0,96 Z" fill="#d6c7a1" stroke="#8b7355"/>
  <text x="380" y="40" text-anchor="middle" font-size="20" font-weight="700" fill="#57401f">यूरेशियाई प्लेट (एशिया)</text>
  <text x="380" y="64" text-anchor="middle" font-size="13" fill="#57401f">आज का तिब्बत पठार इसी किनारे पर उठा</text>
  <!-- Tethys label -->
  <text x="610" y="170" font-size="15" font-weight="700" fill="#1e40af">टेथिस महासागर</text>
  <text x="610" y="188" font-size="12" fill="#1e40af">(धीरे-धीरे सिकुड़ता गया,</text>
  <text x="610" y="203" font-size="12" fill="#1e40af">तली की तलछट बची रही)</text>
  <!-- India positions -->
  <g fill="#fde68a" stroke="#b45309" stroke-width="1.5" opacity=".95">
    <path id="ind" d="M0,0 L60,-6 L90,14 L84,52 L60,96 L44,128 L30,92 L4,58 L-8,22 Z" transform="translate(330,330) scale(.9)" opacity=".35"/>
    <path d="M0,0 L60,-6 L90,14 L84,52 L60,96 L44,128 L30,92 L4,58 L-8,22 Z" transform="translate(320,248) scale(.9)" opacity=".5"/>
    <path d="M0,0 L60,-6 L90,14 L84,52 L60,96 L44,128 L30,92 L4,58 L-8,22 Z" transform="translate(310,170) scale(.9)" opacity=".7"/>
    <path d="M0,0 L60,-6 L90,14 L84,52 L60,96 L44,128 L30,92 L4,58 L-8,22 Z" transform="translate(305,104) scale(.9)" fill="#f59e0b"/>
  </g>
  <g font-size="13" font-weight="700" fill="#7c2d12">
    <text x="420" y="378">~8 करोड़ वर्ष पहले — तेज़ गति (~9–16 सेमी/वर्ष)</text>
    <text x="410" y="296">~5.5 करोड़ वर्ष पहले</text>
    <text x="400" y="218">~5 करोड़ वर्ष पहले — टक्कर शुरू</text>
    <text x="398" y="152">आज — भारत अब भी ~4–5 सेमी/वर्ष उत्तर-पूर्व खिसक रहा है</text>
  </g>
  <path d="M250,420 V140" stroke="#b45309" stroke-width="3" marker-end="url(#ij-a)"/>
  <defs><marker id="ij-a" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0,0 L10,5 L0,10 z" fill="#b45309"/></marker></defs>
  <text x="240" y="300" font-size="13" fill="#7c2d12" text-anchor="end" font-weight="700">उत्तर की ओर</text>
  <text x="240" y="318" font-size="13" fill="#7c2d12" text-anchor="end" font-weight="700">यात्रा</text>
  <text x="20" y="455" font-size="12" fill="#334155">सरलीकृत चित्र · आकृतियाँ प्रतीकात्मक हैं, पैमाने पर नहीं</text>
</svg>
<figcaption>भारतीय प्लेट गोंडवाना से अलग होकर उत्तर की ओर बढ़ी; लगभग 5 करोड़ वर्ष पहले यूरेशिया से टकराई। समय और गति वैज्ञानिक अनुमान हैं (Geological Society, London; Bilham, Colorado Univ.)।<span class="cr">चित्र: पहाड़ परीक्षा (USGS/Geological Society के प्रचलित आरेखों के आधार पर सरलीकृत)</span></figcaption>
</figure>
