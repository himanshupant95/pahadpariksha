// How a Bill becomes an Act in unicameral Uttarakhand. Stages = Constitution + Assembly rules of procedure.
---
<figure class="pd" aria-labelledby="bf-cap">
  <div class="flow">
    <div class="st"><b>विधेयक का पुरःस्थापन</b><small>सरकारी (मंत्री) या ग़ैर-सरकारी सदस्य · धन विधेयक केवल राज्यपाल की सिफ़ारिश से (अनु. 199, 207)</small></div>
    <div class="ar" aria-hidden="true">▼</div>
    <div class="st"><b>विचार — सामान्य चर्चा</b><small>सदन चाहे तो प्रवर समिति को भेजे (प्रक्रिया नियम) · समिति की रिपोर्ट</small></div>
    <div class="ar" aria-hidden="true">▼</div>
    <div class="st"><b>खंडवार विचार और संशोधन</b><small>हर खंड पर मतदान · गणपूर्ति 10 सदस्य (अनु. 189)</small></div>
    <div class="ar" aria-hidden="true">▼</div>
    <div class="st"><b>पारित करने का प्रस्ताव</b><small>उपस्थित-मतदान करने वालों का बहुमत · धन विधेयक पर अध्यक्ष का प्रमाणपत्र (अनु. 199(4))</small></div>
    <div class="ar" aria-hidden="true">▼</div>
    <div class="st gov"><b>राज्यपाल के पास — अनु. 200</b><small>उत्तराखंड में विधान परिषद नहीं, इसलिए विधानसभा से सीधे राज्यपाल</small></div>
    <div class="branches">
      <div style="border-color:#86efac"><b>✔ अनुमति</b>अधिनियम बनता है → राजपत्र में प्रकाशन → अधिसूचित तिथि से लागू</div>
      <div><b>✖ अनुमति रोकना</b>विधेयक समाप्त</div>
      <div><b>↺ पुनर्विचार हेतु लौटाना</b>(धन विधेयक नहीं) — दोबारा पारित होने पर राज्यपाल अनुमति नहीं रोकेंगे</div>
      <div style="border-color:#fcd34d"><b>⇧ राष्ट्रपति हेतु आरक्षित</b>अनु. 201 — जैसे समान नागरिक संहिता 2024; उच्च न्यायालय की शक्ति घटाने वाला विधेयक अनिवार्यतः</div>
    </div>
  </div>
  <figcaption id="bf-cap">विधेयक से अधिनियम तक। "प्रथम-द्वितीय-तृतीय वाचन" जैसे चरण संविधान में नहीं, विधानसभा की प्रक्रिया नियमावली में हैं — संवैधानिक प्रावधान (अनु. 196–201) और प्रक्रिया-नियम को अलग पहचानें। विधानसभा भंग होने पर लंबित विधेयक समाप्त (अनु. 196(5))।</figcaption>
</figure>
