// Rural (Part IX) and urban (Part IXA) local government in Uttarakhand.
---
<figure class="pd" aria-labelledby="lt-cap">
  <div class="tiers">
    <div>
      <h4>गाँव: पंचायती राज (भाग IX)</h4>
      <div class="tier t1"><b>ज़िला पंचायत</b><small>ज़िला स्तर। अध्यक्ष को सदस्य चुनते हैं</small></div>
      <div class="tier t2"><b>क्षेत्र पंचायत</b><small>ब्लॉक स्तर। प्रमुख को सदस्य चुनते हैं</small></div>
      <div class="tier t3"><b>ग्राम पंचायत</b><small>प्रधान को जनता सीधे चुनती है</small></div>
      <div class="tier t4"><b>ग्राम सभा</b><small>गाँव के सभी मतदाता (अनुच्छेद 243A)</small></div>
    </div>
    <div>
      <h4>शहर: नगर निकाय (भाग IXA)</h4>
      <div class="tier t1"><b>नगर निगम — 11</b><small>बड़े शहर। मेयर को जनता सीधे चुनती है</small></div>
      <div class="tier t2"><b>नगर पालिका परिषद — 45</b><small>छोटे शहर। अध्यक्ष को जनता सीधे चुनती है</small></div>
      <div class="tier t3"><b>नगर पंचायत — 51</b><small>गाँव से शहर बनते क़स्बे। अध्यक्ष सीधे चुना जाता है</small></div>
      <div class="tier t4"><b>वार्ड समितियाँ</b><small>3 लाख से ज़्यादा आबादी वाले निकाय में (अनुच्छेद 243S)</small></div>
    </div>
  </div>
  <div class="under">
    <span>चुनाव: राज्य निर्वाचन आयोग (243K, 243ZA)</span>
    <span>पैसा: छठा राज्य वित्त आयोग (243I, 243Y)</span>
    <span>योजना: ज़िला योजना समिति (243ZD)</span>
    <span>आरक्षण: पंचायतों में 50% महिलाएँ (राज्य कानून)</span>
  </div>
  <figcaption id="lt-cap">उत्तराखंड का स्थानीय शासन। पंचायतें उत्तराखंड पंचायती राज अधिनियम, 2016 से चलती हैं। नगर निकायों की संख्या (कुल 107) शहरी विकास विभाग से ली गई है। राज्य की आबादी 20 लाख से ज़्यादा है, इसलिए बीच का स्तर, यानी क्षेत्र पंचायत, बनाना ज़रूरी है (अनुच्छेद 243B)।</figcaption>
</figure>
