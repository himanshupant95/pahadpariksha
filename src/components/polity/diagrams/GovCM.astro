// Governor – Chief Minister – Council of Ministers – Assembly relationship (Articles 155, 163, 164, 167, 174, 200).
---
<figure class="pd" aria-labelledby="gc-cap">
  <svg viewBox="0 0 760 430" role="img" aria-labelledby="gc-t gc-d">
    <title id="gc-t">राज्यपाल, मुख्यमंत्री, मंत्रिपरिषद और विधानसभा का संबंध</title>
    <desc id="gc-d">राष्ट्रपति राज्यपाल को नियुक्त करते हैं। राज्यपाल मुख्यमंत्री को, और मुख्यमंत्री की सलाह पर बाकी मंत्रियों को नियुक्त करते हैं। मंत्रिपरिषद राज्यपाल को सलाह देती है और मिलकर विधानसभा के प्रति ज़िम्मेदार होती है। विधानसभा को जनता चुनती है।</desc>
    <defs><marker id="gcA" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0L10 5L0 10z" fill="#4f46e5"/></marker></defs>
    <g font-size="15" text-anchor="middle">
      <rect x="290" y="12" width="180" height="46" rx="10" fill="#f1f5f9" stroke="#94a3b8"/><text x="380" y="41" font-weight="700">राष्ट्रपति</text>
      <rect x="270" y="112" width="220" height="56" rx="10" fill="#fef3c7" stroke="#f59e0b"/><text x="380" y="137" font-weight="700">राज्यपाल</text><text x="380" y="157" font-size="12">नाम का प्रमुख (अनुच्छेद 153–154)</text>
      <rect x="40" y="238" width="230" height="56" rx="10" fill="#e0e7ff" stroke="#6366f1"/><text x="155" y="263" font-weight="700">मुख्यमंत्री</text><text x="155" y="283" font-size="12">सरकार के असली प्रमुख</text>
      <rect x="490" y="238" width="230" height="56" rx="10" fill="#e0e7ff" stroke="#6366f1"/><text x="605" y="263" font-weight="700">मंत्रिपरिषद</text><text x="605" y="283" font-size="12">उत्तराखंड में ज़्यादा से ज़्यादा 12</text>
      <rect x="250" y="350" width="260" height="56" rx="10" fill="#dcfce7" stroke="#16a34a"/><text x="380" y="375" font-weight="700">विधानसभा (70)</text><text x="380" y="395" font-size="12">जनता चुनती है (अनुच्छेद 170)</text>
    </g>
    <g stroke="#4f46e5" stroke-width="2" fill="none" marker-end="url(#gcA)">
