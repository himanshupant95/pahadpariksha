      <rect x="490" y="238" width="230" height="56" rx="10" fill="#e0e7ff" stroke="#6366f1"/><text x="605" y="263" font-weight="700">मंत्रिपरिषद</text><text x="605" y="283" font-size="12">उत्तराखंड में अधिकतम 12</text>
      <rect x="250" y="350" width="260" height="56" rx="10" fill="#dcfce7" stroke="#16a34a"/><text x="380" y="375" font-weight="700">विधानसभा (70)</text><text x="380" y="395" font-size="12">जनता द्वारा निर्वाचित · अनु. 170</text>
